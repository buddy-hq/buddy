{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/packages/cspell-types/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "useGitignore": true,
  "files": ["packages/buddy/**/*.md", "packages/web/src/i18n/en.ts"],
  "ignoreRegExpList": [
    "/\\{\\{[^}]+\\}\\}/g",
    "/`[^`]+`/g",
    "/\\b[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)+\\b/gi",
    "/\\b\\w+-\\w+\\b/g"
  ],
  "dictionaries": ["typescript", "node", "npm", "softwareTerms", "project-words"],
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": "./cspell-words.txt",
      "addWords": true
    }
  ]
}
