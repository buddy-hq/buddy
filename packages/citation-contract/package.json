{
  "$schema": "https://json.schemastore.org/package",
  "name": "@buddy/citation-contract",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./rendered-text": "./src/rendered-text.ts",
    "./selection-actions": "./src/selection-actions.ts",
    "./text-fragment": "./src/text-fragment.ts"
  },
  "scripts": {
