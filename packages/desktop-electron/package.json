{
  "name": "@buddy/desktop-electron",
  "version": "0.0.43",
  "private": true,
  "description": "Buddy Electron desktop shell",
  "homepage": "https://github.com/prashantbhudwal/buddy",
  "license": "MIT",
  "author": {
    "name": "Buddy"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "icons:generate": "bun ./scripts/generate-icons.ts",
    "lint": "bun ../../node_modules/oxlint/bin/oxlint",
    "typecheck": "bun ../../script/typecheck-lock.ts -- bun run typecheck:raw",
    "typecheck:raw": "bun ../../node_modules/@typescript/native-preview/bin/tsgo.js -b",
    "predev": "bun ./scripts/predev.ts",
    "dev": "bun ./scripts/dev.ts",
    "prebuild": "bun ./scripts/prebuild.ts",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "smoke:backend-utility": "bun ./scripts/smoke-backend-utility.ts",
    "package": "bun ./scripts/validate-backend-node-artifact.ts && bun ./scripts/smoke-backend-utility.ts && electron-builder --config electron-builder.config.ts",
    "package:mac": "bun ./scripts/validate-backend-node-artifact.ts --platform darwin && bun ./scripts/smoke-backend-utility.ts && electron-builder --mac --config electron-builder.config.ts",
    "package:win": "bun ./scripts/validate-backend-node-artifact.ts --platform win32 && bun ./scripts/smoke-backend-utility.ts && electron-builder --win --config electron-builder.config.ts",
    "prepare:release": "bun ./scripts/prepare.ts",
    "copy:bundles": "bun ./scripts/copy-bundles.ts",
    "build:installable": "bun ./scripts/local-release.ts",
    "finalize:recovery-policy": "bun ./scripts/finalize-recovery-policy.ts",
    "smoke:recovery-policy": "bun ./scripts/smoke-recovery-policy.ts",
    "serve:update:mac-local": "bun ./scripts/serve-local-mac-update.ts",
    "verify:update-signing": "bun ./scripts/verify-update-signing.ts"
  },
  "dependencies": {
    "@bokuweb/zstd-wasm": "^0.0.27",
    "blakejs": "^1.2.1",
    "electron-log": "^5.4.1",
    "electron-store": "^10.1.0",
    "electron-updater": "^6.6.2",
    "electron-window-state": "^5.0.3",
    "marked": "^17.0.1",
    "tree-kill": "^1.2.2"
  },
  "devDependencies": {
    "@buddy/ui": "workspace:*",
    "@buddy/web": "workspace:*",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/router-plugin": "^1.167.22",
    "@tauri-apps/cli": "^2",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript/native-preview": "catalog:",
    "@vitejs/plugin-react": "^4.2.0",
    "electron": "40.4.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "catalog:",
    "vite": "7.1.4"
  }
}
