{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "types": ["bun", "node"]
  },
  "include": [
    "scripts/**/*.ts",
    "src/main/recovery-policy-core.ts",
    "../buddy/script/backend-node-artifact.ts",
    "../../script/desktop-runtime-resources.ts"
  ]
}
