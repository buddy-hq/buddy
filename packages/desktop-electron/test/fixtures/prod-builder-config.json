{
  "copyright": "Copyright © 2026 Prashant Bhudwal",
  "directories": {
    "output": "dist",
    "buildResources": "resources"
  },
  "extraMetadata": {
    "description": "Buddy Electron desktop shell"
  },
  "asarUnpack": [
    "out/main/chunks/chemfig-runtime/**/*",
    "out/main/chunks/node_modules/@llamaindex/liteparse-*/**/*",
    "out/main/chunks/node_modules/@lydell/node-pty-*/**/*",
    "out/main/node_modules/@napi-rs/keyring/**/*",
    "out/main/chunks/node_modules/@primno/dpapi/prebuilds/**/*",
    "out/main/chunks/node_modules/@parcel/watcher-*/**/*"
  ],
  "files": ["out/**/*"],
  "extraResources": [
    {
      "from": "resources/backend",
      "to": "backend",
      "filter": ["**/*"]
    },
    {
      "from": "resources/knowledge-graph",
      "to": "knowledge-graph",
      "filter": ["**/*"]
    },
    {
      "from": "resources/migrations",
      "to": "migrations",
      "filter": ["**/*"]
    },
    {
      "from": "resources/tessdata",
      "to": "tessdata",
      "filter": ["**/*"]
    },
    {
      "from": "/buddy-repository/LICENSE",
      "to": "LICENSE"
    },
    {
      "from": "/buddy-repository/THIRD_PARTY_NOTICES.md",
      "to": "THIRD_PARTY_NOTICES.md"
    },
    {
      "from": "resources",
      "to": "",
      "filter": ["mac-install-update.sh"]
    }
  ],
  "protocols": {
    "name": "Buddy",
    "schemes": ["buddy"]
  },
  "mac": {
    "artifactName": "buddy-v${version}-macos-apple-silicon.${ext}",
    "category": "public.app-category.developer-tools",
    "forceCodeSigning": true,
    "icon": "resources/icons/icon.icns",
    "hardenedRuntime": true,
    "identity": "-",
    "gatekeeperAssess": false,
    "entitlements": "resources/entitlements.plist",
    "entitlementsInherit": "resources/entitlements.plist",
    "notarize": false,
    "target": ["dmg", "zip"]
  },
  "dmg": {
    "sign": true
  },
  "win": {
    "artifactName": "buddy-v${version}-windows-x64.${ext}",
    "icon": "resources/icons/icon.ico",
    "target": ["nsis"],
    "verifyUpdateCodeSignature": false
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "installerIcon": "resources/icons/icon.ico",
    "installerHeaderIcon": "resources/icons/icon.ico"
  },
  "appId": "ai.buddy.desktop",
  "productName": "Buddy",
  "publish": {
    "provider": "github",
    "owner": "prashantbhudwal",
    "repo": "buddy-releases",
    "channel": "latest"
  }
}
