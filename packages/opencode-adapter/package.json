{
  "name": "@buddy/opencode-adapter",
  "version": "0.0.63",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./host": "./src/host.ts",
    "./plugin": "./src/plugin.ts",
    "./gateway/*": "./src/gateway/*.ts",
    "./permission": "./src/permission.ts",
    "./wildcard": "./src/wildcard.ts",
    "./config": "./src/config.ts",
    "./session-tool-presentation": "./src/session-tool-presentation.ts",
    "./file-watcher-native": "./src/file-watcher-native.ts",
    "./theme": "./src/theme.ts",
    "./provider-icon": "./src/provider-icon.ts"
  },
  "scripts": {
    "lint": "bun ../../node_modules/oxlint/bin/oxlint",
    "typecheck": "bun ../../script/typecheck-lock.ts -- bun run typecheck:raw",
    "typecheck:raw": "bun ../../node_modules/@typescript/native-preview/bin/tsgo.js --noEmit",
    "test": "bun ../../script/run-test-command.ts -- bun test --preload ../../script/test-preload.ts test"
  },
  "dependencies": {
    "@buddy/transcript-contract": "workspace:*",
    "@opencode/client": "workspace:*",
    "@opencode/plugin": "workspace:*",
    "@opencode/schema": "workspace:*",
    "@opencode/sdk": "workspace:*",
    "@opencode/util": "workspace:*",
    "@parcel/watcher": "2.5.1",
    "ai": "catalog:",
    "effect": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
