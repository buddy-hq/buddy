{
  "name": "@buddy/backend",
  "version": "0.0.51",
  "private": true,
  "type": "module",
  "imports": {
    "#sqlite": {
      "bun": "./src/sqlite/database.bun.ts",
      "node": "./src/sqlite/database.node.ts",
      "default": "./src/sqlite/database.node.ts"
    }
  },
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts"
  },
  "scripts": {
    "dev": "bun run ensure:advanced-math-runtime && bun --env-file=../../.env run src/dev/start-with-safe-env.ts --watch",
    "build": "bun run build:node",
    "build:node": "bun ./script/build-node.ts",
    "prove:pdf-liteparse-findings": "bun ./script/prove-pdf-liteparse-findings.ts",
    "lint": "bun ../../node_modules/oxlint/bin/oxlint",
    "build:knowledge-graph": "bun ./script/update-knowledge-graph.ts",
    "update:knowledge-graph": "bun ./script/update-knowledge-graph.ts",
    "verify:knowledge-graph": "bun ./script/verify-knowledge-graph.ts",
    "skill:audit": "bun ./script/skill-audit.ts",
    "skill:artifacts:keygen": "bun ./script/skill-artifact-keygen.ts",
    "skill:artifacts:build": "bun ./script/publish-skill-artifacts.ts",
    "skill:artifacts:publish": "bun ./script/publish-skill-artifacts.ts --publish",
    "skill:curate": "bun ./script/skill-curation.ts",
    "skill:bundled:check": "bun ./script/check-bundled-skills.ts",
    "build:advanced-math-runtime": "bun ./script/build-advanced-math-runtime.ts",
    "ensure:advanced-math-runtime": "bun ./script/ensure-advanced-math-runtime.ts",
    "typecheck": "bun ../../script/typecheck-lock.ts -- bun run typecheck:raw",
    "typecheck:raw": "bun ../../node_modules/@typescript/native-preview/bin/tsgo.js --noEmit",
    "start": "bun run ensure:advanced-math-runtime && bun --env-file=../../.env run src/dev/start-with-safe-env.ts",
    "test": "bun test --preload ./test/preload.ts test",
    "test:architecture": "bun test --preload ./test/preload.ts test/architecture",
    "test:config": "bun test --preload ./test/preload.ts test/config",
    "test:curriculum": "bun test --preload ./test/preload.ts test/curriculum",
    "test:learning": "bun test --preload ./test/preload.ts test/learning",
    "test:session": "bun test --preload ./test/preload.ts test/session",
    "test:skills": "bun test --preload ./test/preload.ts test/skills",
    "test:release-skill-artifacts": "bun test --preload ./test/preload.ts test/skills/signed-artifact.test.ts test/skills/system-pack.test.ts test/skills/library.test.ts test/skills/skill-curation.test.ts",
    "test:parity": "bun test --preload ./test/preload.ts test/parity",
    "test:contracts": "bun test --preload ./test/preload.ts test/parity",
    "learner-memory:evaluate": "bun ./script/learner-memory-evaluation.ts",
    "smoke": "bun ./script/smoke.ts",
    "smoke:node": "bun ./script/smoke-node.ts",
    "measure:node-memory": "bun ./script/measure-node-memory.ts",
    "db": "bun drizzle-kit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "2.0.62",
    "@bokuweb/zstd-wasm": "^0.0.27",
    "@buddy/opencode-adapter": "workspace:*",
    "@buddy/workspace-file-policy": "workspace:*",
    "@chonkiejs/core": "^0.0.8",
    "@hono/node-server": "^1.19.9",
    "@hono/standard-validator": "^0.2.2",
    "@llamaindex/liteparse": "2.4.0",
    "@lydell/node-pty": "catalog:",
    "@opencode-ai/plugin": "workspace:*",
    "@opencode-ai/sdk": "workspace:*",
    "@zip.js/zip.js": "^2.8.23",
    "ai": "5.0.124",
    "dedent": "^1.7.2",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "fast-xml-parser": "^5.5.6",
    "gray-matter": "^4.0.3",
    "hono": "^4.6.0",
    "hono-openapi": "1.1.2",
    "jsonc-parser": "^3.3.1",
    "mammoth": "^1.12.0",
    "mime-types": "^3.0.2",
    "node-tikzjax": "1.0.5",
    "pdfjs-dist": "^5.5.207",
    "remeda": "^2.33.0",
    "turndown": "^7.2.2",
    "ulid": "^3.0.1",
    "xdg-basedir": "5.1.0",
    "yaml": "2.9.0",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@buddy/script": "workspace:*",
    "@types/bun": "catalog:",
    "@types/turndown": "^5.0.5",
    "drizzle-kit": "1.0.0-beta.12-a5629fb",
    "typescript": "^5.0.0"
  },
  "optionalDependencies": {
    "@lydell/node-pty-darwin-arm64": "1.2.0-beta.12",
    "@lydell/node-pty-darwin-x64": "1.2.0-beta.12",
    "@lydell/node-pty-linux-arm64": "1.2.0-beta.12",
    "@lydell/node-pty-linux-x64": "1.2.0-beta.12",
    "@lydell/node-pty-win32-arm64": "1.2.0-beta.12",
    "@lydell/node-pty-win32-x64": "1.2.0-beta.12",
    "@parcel/watcher-darwin-arm64": "2.5.1",
    "@parcel/watcher-darwin-x64": "2.5.1",
    "@parcel/watcher-linux-arm64-glibc": "2.5.1",
    "@parcel/watcher-linux-arm64-musl": "2.5.1",
    "@parcel/watcher-linux-x64-glibc": "2.5.1",
    "@parcel/watcher-linux-x64-musl": "2.5.1",
    "@parcel/watcher-win32-arm64": "2.5.1",
    "@parcel/watcher-win32-x64": "2.5.1"
  }
}
