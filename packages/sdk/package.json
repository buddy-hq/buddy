{
  "name": "@buddy/sdk",
  "version": "0.0.63",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/gen/client/index.ts",
    "./types": "./src/gen/types.gen.ts",
    "./sdk": "./src/gen/sdk.gen.ts"
  },
  "scripts": {
    "benchmark:pdf-resources": "bun ./scripts/benchmark-pdf-resources.ts",
    "generate": "bun run scripts/generate.ts && tsc -b --force",
    "lint": "bun ../../node_modules/oxlint/bin/oxlint",
    "typecheck": "bun ../../script/typecheck-lock.ts -- bun run typecheck:raw",
    "typecheck:raw": "bun ../../node_modules/@typescript/native-preview/bin/tsgo.js --noEmit && bun ../../node_modules/@typescript/native-preview/bin/tsgo.js -p tsconfig.scripts.json --noEmit",
    "build": "tsc -b --force"
  },
  "dependencies": {},
  "devDependencies": {
    "@hey-api/openapi-ts": "0.90.10",
    "@types/node": "catalog:",
    "hono-openapi": "1.1.2",
    "typescript": "^5.0.0",
    "zod": "catalog:"
  }
}
