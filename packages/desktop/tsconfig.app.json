{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*", "../web/src/*"]
    },
    "noEmit": true,
    "outDir": "./dist",
    "types": ["vite/client"]
  },
  "include": ["src/**/*", "../web/src/foliate-js.d.ts"]
}
