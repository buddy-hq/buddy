{
  "$schema": "https://json.schemastore.org/package",
  "name": "@buddy/script",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./branding": "./src/branding.ts",
    "./backend-node-runtime": "./src/backend-node-runtime.ts",
    "./channel": "./src/channel.ts",
    "./chemfig-runtime": "./src/chemfig-runtime.ts",
    "./minisign": "./src/minisign.ts",
    "./release-version": "./src/release-version.ts",
    "./storage-env": "./src/storage-env.ts"
  },
  "scripts": {
    "lint": "oxlint",
    "typecheck": "bun ../../script/typecheck-lock.ts -- bun run typecheck:raw",
    "typecheck:raw": "bun ../../node_modules/@typescript/native-preview/bin/tsgo.js --noEmit",
    "test": "bun ../../script/run-test-command.ts -- bun test --preload ../../script/test-preload.ts src"
  },
  "dependencies": {
    "blakejs": "^1.2.1"
  },
  "devDependencies": {
    "@types/bun": "catalog:"
  }
}
