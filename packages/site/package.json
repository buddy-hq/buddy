{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@buddy/site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "bun ../../node_modules/oxlint/bin/oxlint",
    "typecheck": "bun ../../script/typecheck-lock.ts -- bun run typecheck:raw",
    "typecheck:raw": "bun ./node_modules/astro/astro.js check",
    "deploy:dry": "astro build && wrangler deploy --dry-run",
    "deploy": "astro build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "12.6.3",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/starlight": "0.34.3",
    "astro": "5.7.13",
    "cf-workers-og": "^3.0.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.6",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "catalog:",
    "sharp": "^0.35.2",
    "typescript": "catalog:",
    "wrangler": "^4.105.0"
  }
}
