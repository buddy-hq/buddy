{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@buddy/site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && bun ./scripts/validate-compare-pages.ts",
    "validate:compares": "bun ./scripts/validate-compare-pages.ts",
    "preview": "astro preview",
    "lint": "bun ../../node_modules/oxlint/bin/oxlint",
    "typecheck": "bun ../../script/typecheck-lock.ts -- bun run typecheck:raw",
    "typecheck:raw": "astro check",
    "deploy:dry": "bun run build && wrangler deploy --dry-run",
    "deploy": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.2.5",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/starlight": "0.41.10",
    "@buddy/script": "workspace:*",
    "astro": "7.2.9",
    "cf-workers-og": "^3.0.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "catalog:",
    "node-html-parser": "7.1.0",
    "playwright-core": "^1.61.1",
    "sharp": "^0.35.2",
    "typescript": "catalog:",
    "wrangler": "^4.127.1"
  }
}
