---
import Landing from "../layouts/Landing.astro"
import Header from "../components/Header.astro"
import Hero from "../components/Hero.astro"
import PhilosophyNew from "../components/PhilosophyNew.astro"
import FeatureSteps from "../components/features/FeatureSteps.astro"
import CapabilitiesSection from "../components/CapabilitiesSection.astro"
import BringYourOwn from "../components/BringYourOwn.astro"
import InstallSection from "../components/InstallSection.astro"
import Footer from "../components/Footer.astro"

export const prerender = true
---

<Landing>
  <Header />
  <main>
    <Hero />
    <hr />
    <PhilosophyNew />
    <hr style="max-width: 100%" />
    <FeatureSteps />
    <hr />
    <CapabilitiesSection />
    <hr />
    <BringYourOwn />
    <hr />
    <InstallSection />
  </main>
  <Footer />
</Landing>
