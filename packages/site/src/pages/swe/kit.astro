</style>

<script>
  // Jump nav: mark the last section whose top has passed 40% of the viewport,
  // and show it in the "Jump to" bar used on narrow screens.
  const toc = document.querySelector<HTMLElement>(".kit-toc")
  const tocToggle = toc?.querySelector<HTMLButtonElement>(".kit-toc__toggle")
  const tocCurrent = toc?.querySelector<HTMLElement>(".kit-toc__current")
  const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>(".kit-toc a"))
  const tocTargets = tocLinks.map((link) => document.getElementById(link.dataset.toc ?? ""))
  let tocActive = -1
  let tocFrame = 0

  const header = document.querySelector<HTMLElement>(".kit-header")

  const updateToc = () => {
    tocFrame = 0
    if (toc && header) {
      toc.toggleAttribute("data-stuck", toc.getBoundingClientRect().top <= header.offsetHeight + 1)
    }
    const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2
    let current = 0
    tocTargets.forEach((target, index) => {
      if (target && target.getBoundingClientRect().top <= window.innerHeight * 0.4) current = index
    })
    if (atBottom) current = tocTargets.length - 1
    if (current === tocActive) return
    tocActive = current
    tocLinks.forEach((link, index) => link.setAttribute("aria-current", String(index === current)))
    const link = tocLinks[current]
    if (link && tocCurrent) tocCurrent.innerHTML = link.innerHTML
  }

  const setTocOpen = (open: boolean) => {
    toc?.toggleAttribute("data-open", open)
    tocToggle?.setAttribute("aria-expanded", String(open))
  }

  tocToggle?.addEventListener("click", () => setTocOpen(!toc?.hasAttribute("data-open")))
  for (const link of tocLinks) link.addEventListener("click", () => setTocOpen(false))
  document.addEventListener("click", (event) => {
    if (toc && !toc.contains(event.target as Node)) setTocOpen(false)
  })
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setTocOpen(false)
  })

  window.addEventListener(
    "scroll",
    () => {
      if (!tocFrame) tocFrame = requestAnimationFrame(updateToc)
    },
    { passive: true },
  )
  updateToc()

  // Formal / Casual switch: show the chosen message and point Copy at its text.
  for (const tone of document.querySelectorAll<HTMLElement>(".kit-tone")) {
    const block = tone.closest(".kit-block")
    const copyButton = block?.querySelector<HTMLButtonElement>(".kit-block__action[data-copy]")
    const chats = Array.from(block?.querySelectorAll<HTMLElement>(".kit-chat") ?? [])
    const buttons = Array.from(tone.querySelectorAll<HTMLButtonElement>("button"))

    for (const button of buttons) {
      button.addEventListener("click", () => {
        const variant = button.dataset.variant
        for (const other of buttons) other.setAttribute("aria-pressed", String(other === button))
        for (const chat of chats) {
          chat.hidden = chat.dataset.variant !== variant
          if (!chat.hidden && copyButton) copyButton.dataset.copy = chat.dataset.text ?? ""
        }
      })
    }
  }
</script>
