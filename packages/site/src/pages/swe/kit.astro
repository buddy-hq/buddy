  /* === WhatsApp message ===
     Previewed as an outgoing chat bubble so it reads as a group message, not a
     document. The green is WhatsApp's, mixed into the theme surface. */
  .kit-chat {
    display: flex;
    justify-content: flex-end;
    padding: var(--space-5);
    margin: calc(var(--space-5) * -1);
