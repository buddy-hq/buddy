---
/**
 * /swe/kit — the organizer kit for the "Hands-on Agentic Software Engineering" workshop.
 *
 * The reader is the faculty coordinator at a college that has already agreed to
 * host. The page starts with the requirements the college must arrange, then
 * the ready-to-copy assets: the pieces of a poster or circular, the speaker
 * profile, the message for students, text for the event report, and finally
 * the raw workshop facts for anyone writing their own. It is
 * unlisted: sent by email after a yes, and kept out of search and the sitemap.
 */
import { Image } from "astro:assets"
import KitAction from "../../components/swe/KitAction.astro"
import KitBlock from "../../components/swe/KitBlock.astro"
import Landing from "../../layouts/Landing.astro"
import { GITHUB_URL } from "../../lib/constants"
import instructorPhoto from "../../assets/swe/prashant.jpg"

export const prerender = true

const seo = {
  title: "Organizer kit · Hands-on Agentic Software Engineering workshop",
  description:
    "Ready-to-copy text for colleges hosting the Hands-on Agentic Software Engineering workshop: a message for students, poster details, a speaker bio, and text for the event report.",
}

const workshop = {
  title: "Hands-on Agentic Software Engineering",
  subtitle: "How LLMs and coding agents work, and how to build software with them",
  duration: "2 hours (90 min workshop + 30 min Q&A)",
} as const

const speaker = {
  name: "Prashant Bhudwal",
  role: "Founder & CEO, Buddy",
  bio: "Prashant is the Founder & CEO of Buddy, a free and open-source AI agent for students. He has spent the past decade building education ventures. He co-founded FalconAI, founded Medal, and was a founding member of Genius Learning Labs, which was later acquired by Schoolnet India. He now builds Buddy hands-on, bringing both an education entrepreneur’s and a software builder’s perspective to the workshop.",
  showcase: "Work showcased at OpenAI Codex Meetup, Microsoft LocalHost, and AgentCon Bangalore.",
  photo: { href: "/swe/prashant-bhudwal.jpg", filename: "prashant-bhudwal.jpg" },
  profile: {
    href: "/swe/prashant-bhudwal-speaker-profile.pdf",
    filename: "prashant-bhudwal-speaker-profile.pdf",
    label: "Download full profile (PDF)",
  },
} as const

// Shown first: everything a college must arrange, one section each. The card
// and its plain-text copy share these headings.
const requirements = {
  form: {
    heading: "Organizer form",
    instruction:
      "The organizer must fill in this form before the workshop, so we know about your students, the schedule and the venue.",
    name: "Coordination form",
    href: "https://forms.gle/NSA7G19enfGvB8xK7",
  },
  computers: {
    heading: "Computers",
    items: [
      "Every student needs access to a laptop or computer with Wi-Fi.",
      "Students can bring their own, or the college can provide them, for example in a computer lab.",
    ],
  },
  software: {
    heading: "Software to install before the workshop",
    apps: [
      { name: "OpenCode Desktop", href: "https://opencode.ai/download" },
      { name: "Buddy Desktop", href: "https://hibuddy.in/download" },
    ],
    platforms: "Both apps are free and work on macOS and Windows.",
    labComputers: "If the college provides the computers, please install both apps on them before the workshop.",
  },
  accounts: {
    heading: "Accounts",
    items: [
      { name: "ChatGPT account", detail: "Every student needs one, free or paid." },
      { name: "GitHub account", detail: "Every student needs one. A free account works." },
    ],
  },
  venue: {
    heading: "Venue",
    items: ["Wi-Fi that students can connect to", "Power sockets for laptops", "A projector with HDMI"],
  },
  travel: {
    heading: "Travel",
    items: [
      "The college covers Prashant’s cab to the campus and back on the workshop day. There is no workshop fee.",
      "Either the college books the cab, or Prashant books it and the college pays the fare on the day.",
      "Let Prashant know which option suits you, and who will handle it, before the workshop.",
    ],
  },
  clone: {
    heading: "Optional: clone the Buddy repository",
    instruction: "For students who want to go deeper in the hands-on part. Needs Git installed.",
    command: `git clone ${GITHUB_URL}.git`,
  },
} as const

const numbered = (items: readonly string[]) => items.map((item, index) => `${index + 1}. ${item}`).join("\n")
const bulleted = (items: readonly string[]) => items.map((item) => `- ${item}`).join("\n")

const { form, computers, software, accounts, clone, venue, travel } = requirements
const downloadLinks = software.apps.map((app) => `${app.name}: ${app.href}`)
// On a narrow screen the clone command wraps after the host, keeping the repo path whole.
const cloneBreak = clone.command.indexOf("github.com/") + "github.com/".length
const cloneCommandHead = clone.command.slice(0, cloneBreak)
const cloneCommandTail = clone.command.slice(cloneBreak)
const accountLines = accounts.items.map((item) => `${item.name}: ${item.detail}`)

// Plain text with one numbered heading per step, in the card's order, so it
// pastes cleanly into email or WhatsApp.
const requirementsCopy = [
  "Workshop requirements",
  ...[
    { heading: form.heading, body: bulleted([form.instruction, `${form.name}: ${form.href}`]) },
    { heading: computers.heading, body: bulleted(computers.items) },
    {
      heading: software.heading,
      body: `${bulleted(downloadLinks)}\n${software.platforms} ${software.labComputers}`,
    },
    { heading: accounts.heading, body: bulleted(accountLines) },
    { heading: venue.heading, body: bulleted(venue.items) },
    { heading: travel.heading, body: bulleted(travel.items) },
    { heading: clone.heading, body: `${clone.instruction}\n${clone.command}` },
  ].map((step, index) => `${index + 1}. ${step.heading}\n${step.body}`),
].join("\n\n")

const downloadLinksCopy = `Install these apps before the workshop:
${numbered(downloadLinks)}
${software.platforms}`

// The same checklist closes both WhatsApp messages.
const prepSteps = [
  ...software.apps.map((app) => `Install ${app.name}: ${app.href}`),
  "Have a ChatGPT account ready (free or paid)",
  "Have a free GitHub account ready",
]

// Messages the coordinator posts to class WhatsApp groups, in their own voice.
// *Asterisks* are WhatsApp bold.
const whatsappVariants = [
  {
    id: "formal",
    label: "Formal",
    text: `Dear Students,

The Department of [DEPARTMENT] is organising a workshop on *${workshop.title}*.

*Resource person:* ${speaker.name}, ${speaker.role}
*Date:* [DATE]
*Time:* [TIME]
*Venue:* [VENUE]
*Laptop or computer with Wi-Fi:* [BRING YOUR OWN / PROVIDED BY THE COLLEGE]

The workshop covers how LLMs and coding agents work, followed by hands-on practice building and debugging a small feature with OpenCode, Codex, and Claude Code.
For more details, visit https://www.hibuddy.in/swe

Every student needs access to a laptop or computer with Wi-Fi. No prior machine learning background is required.

*Before the workshop, please:*
${numbered(prepSteps)}
${software.platforms}

*Optional:* to go deeper in the hands-on part, clone the Buddy repository:
${clone.command}

Regards,
[COORDINATOR NAME]`,
  },
  {
    id: "casual",
    label: "Casual",
    text: `Hi everyone 👋

We have a workshop on *${workshop.title}* coming up. If you already use AI to write code, this one is for you.

You'll learn how coding agents actually work, then build and debug a small feature with OpenCode, Codex, and Claude Code.
More about it 👉 https://www.hibuddy.in/swe

🎤 ${speaker.name}, Founder & CEO of Buddy
📅 [DATE], [TIME]
📍 [VENUE]
💻 Laptop or computer with Wi-Fi: [BRING YOUR OWN / PROVIDED BY THE COLLEGE]

You'll need one to follow along. No ML background needed.

*Before the workshop:*
${prepSteps.map((step) => `✅ ${step}`).join("\n")}
${software.platforms}

🔧 *Optional:* want to go deeper? Clone Buddy:
${clone.command}`,
  },
] as const

// Preview tokens: *bold* renders bold, [PLACEHOLDERS] are highlighted.
const toChatLines = (message: string) =>
  message.split("\n").map((line) =>
    line
      .split(/(\*[^*]+\*|\[[^\]]+\])/)
      .filter(Boolean)
      .map((part) =>
        part.startsWith("*")
          ? { kind: "bold" as const, text: part.slice(1, -1) }
          : part.startsWith("[")
            ? { kind: "blank" as const, text: part }
            : { kind: "text" as const, text: part },
      ),
  )

const posterLines = [
  { label: "Title", value: workshop.title },
  { label: "Subtitle", value: workshop.subtitle },
  { label: "Resource person", value: speaker.name },
  { label: "Designation", value: speaker.role },
  { label: "Duration", value: workshop.duration },
] as const

const abstract = [
  `Most students now use AI tools to write code, but few understand how these tools work, how to direct them, or how to check what they produce. ${workshop.title} covers that ground in one two-hour, in-person workshop.`,
  "The workshop starts from first principles: what tokens, context windows and prompt caching are, and how they affect cost and response time. It then opens up the agent loop, in which a model reads the task, acts through tools, and uses feedback from tests and errors to correct itself. In the hands-on part, students build a small feature end to end with a coding agent, alongside Prashant, and see OpenCode, Codex, and Claude Code side by side. The final part shows how agents connect to documents, tools and browsers through RAG, agent skills, MCP servers, and computer-use. The workshop closes with 30 minutes of open Q&A on careers, internships, tools, and anything students want to ask.",
].join("\n\n")

const objectives = [
  "Explain how large language models handle text: tokens, context windows and prompt caching.",
  "Show how a coding agent works, through the loop of context, model, tools and feedback.",
  "Give students hands-on practice building and debugging software with coding agents.",
  "Introduce how agents connect to documents, tools and browsers.",
] as const

const outcomes = [
  "Explain what tokens and context windows are, and how they affect an agent’s cost, speed and what it can see.",
  "Describe the agent loop and the role that tools and feedback play in it.",
  "Build a small feature end to end with a coding agent, and debug it.",
  "Decide when to steer an agent and when to take over.",
  "Explain what RAG, agent skills and MCP servers are for.",
] as const

const reportParts = [
  { label: "Abstract", text: abstract },
  { label: "Objectives", text: numbered(objectives) },
  { label: "Learning outcomes", text: `By the end of the workshop, students will be able to:\n${numbered(outcomes)}` },
] as const

const facts = [
  { label: "Title", value: workshop.title },
  { label: "Subtitle", value: workshop.subtitle },
  { label: "Resource person", value: `${speaker.name}, ${speaker.role}` },
  { label: "Duration", value: "~2 hours · 90 min + 30 min Q&A" },
  {
    label: "Audience",
    value: "2nd–4th year CS/IT students. AI/DS, ECE and allied branches welcome. Faculty welcome too.",
  },
  {
    label: "Level",
    value:
      "Beginner friendly. Students should be able to write a basic program in any language. No machine learning background needed.",
  },
  { label: "Laptops", value: `Required. ${computers.items.join(" ")}` },
  {
    label: "Software",
    value: `Install before the workshop: ${software.apps.map((app) => `${app.name} (${app.href})`).join(" and ")}. ${software.platforms}`,
  },
  {
    label: "Accounts",
    value: `Every student needs a ${accounts.items.map((item) => item.name).join(" and a ")}. Free accounts work for both.`,
  },
  {
    label: "Room setup",
    value: "A lab or hall with Wi-Fi that students can connect to, power sockets for laptops, and a projector with HDMI.",
  },
  { label: "Full outline", value: "hibuddy.in/swe" },
] as const

// Jump nav, in page order.
const toc = [
  { id: "requirements", label: "Requirements" },
  { id: "poster", label: "Poster" },
  { id: "speaker", label: "Speaker profile" },
  { id: "whatsapp", label: "WhatsApp message" },
  { id: "report", label: "Event report" },
  { id: "facts", label: "Facts" },
] as const
---

<Landing title={seo.title} description={seo.description} robots="noindex, follow">
  <header class="kit-header">
    <div class="container kit-header__inner">
      <span class="kit-header__title">Organizer kit <span>· {workshop.title}</span></span>
      <a href="/swe" class="btn-secondary">Workshop page</a>
    </div>
  </header>

  <main class="container">
    <div class="kit-column">
      <section class="kit-intro" data-analytics-section="swe_kit_intro">
        <h1 class="kit-intro__title">Workshop organizer kit</h1>
        <p class="kit-intro__lede">Ready-to-copy text for students, posters and reports.</p>
      </section>

      <nav class="kit-toc" aria-label="On this page">
        <button type="button" class="kit-toc__toggle" aria-expanded="false" aria-controls="kit-toc-list">
          <svg class="kit-toc__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <line x1="4" y1="6" x2="20" y2="6" />
            <line x1="4" y1="12" x2="20" y2="12" />
            <line x1="4" y1="18" x2="20" y2="18" />
          </svg>
          <span class="kit-toc__text">
            <span class="kit-toc__title">Go to a section</span>
            <span class="kit-toc__now">
              Now: <span class="kit-toc__current">{toc[0].label}</span>
            </span>
          </span>
          <span class="kit-toc__chevron">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </span>
        </button>
        <ol id="kit-toc-list">
          {
            toc.map((item) => (
              <li>
                <a href={`#${item.id}`} data-toc={item.id}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <section id="requirements" class="kit-section" data-analytics-section="swe_kit_requirements">
        <h2 class="kit-h2">Workshop requirements</h2>
        <KitBlock label="Requirements" copy={requirementsCopy} copyLabel="Copy requirements">
          <ol class="kit-req">
            <li>
              <h3 class="kit-req__heading">{form.heading}</h3>
              <p class="kit-req__instruction">{form.instruction}</p>
              <div class="kit-req__app">
                <div>
                  <p class="kit-req__app-name">{form.name}</p>
                  <a class="kit-req__app-url" href={form.href} target="_blank" rel="noopener">
                    {form.href}
                  </a>
                </div>
                <a class="btn-cta" href={form.href} target="_blank" rel="noopener">
                  Open form
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="7" y1="17" x2="17" y2="7" />
                    <polyline points="7 7 17 7 17 17" />
                  </svg>
                </a>
              </div>
            </li>
            <li>
              <h3 class="kit-req__heading">{computers.heading}</h3>
              <ul class="kit-req__list">
                {computers.items.map((item) => <li>{item}</li>)}
              </ul>
            </li>
            <li>
              <div class="kit-req__heading-row">
                <h3 class="kit-req__heading">{software.heading}</h3>
                <KitAction copy={downloadLinksCopy} label="Copy download links" />
              </div>
              <ul class="kit-req__apps">
                {
                  software.apps.map((app) => (
                    <li class="kit-req__app">
                      <div>
                        <p class="kit-req__app-name">{app.name}</p>
                        <a class="kit-req__app-url" href={app.href} target="_blank" rel="noopener">
                          {app.href}
                        </a>
                      </div>
                      <a class="btn-cta" href={app.href} target="_blank" rel="noopener">
                        Download
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <line x1="7" y1="17" x2="17" y2="7" />
                          <polyline points="7 7 17 7 17 17" />
                        </svg>
                      </a>
                    </li>
                  ))
                }
              </ul>
              <p class="kit-req__note">{software.platforms} {software.labComputers}</p>
            </li>
            <li>
              <h3 class="kit-req__heading">{accounts.heading}</h3>
              <ul class="kit-req__list kit-req__accounts">
                {
                  accounts.items.map((item) => (
                    <li>
                      <strong>{item.name}:</strong> {item.detail}
                    </li>
                  ))
                }
              </ul>
            </li>
            <li>
              <h3 class="kit-req__heading">{venue.heading}</h3>
              <ul class="kit-req__list">
                {venue.items.map((item) => <li>{item}</li>)}
              </ul>
            </li>
            <li>
              <h3 class="kit-req__heading">{travel.heading}</h3>
              <ul class="kit-req__list">
                {travel.items.map((item) => <li>{item}</li>)}
              </ul>
            </li>
            <li>
              <h3 class="kit-req__heading">{clone.heading}</h3>
              <p class="kit-req__instruction">{clone.instruction}</p>
              <div class="kit-req__command">
                <code>{cloneCommandHead}<wbr /><span>{cloneCommandTail}</span></code>
                <KitAction copy={clone.command} />
              </div>
            </li>
          </ol>
        </KitBlock>
      </section>

      <section id="poster" class="kit-section" data-analytics-section="swe_kit_poster">
        <h2 class="kit-h2">Poster and circular</h2>
        <p class="kit-lede">The pieces of a poster, circular or stage introduction.</p>
        <ul class="kit-lines">
          {
            posterLines.map((line) => (
              <li class="kit-line">
                <div>
                  <p class="kit-line__label">{line.label}</p>
                  <p class="kit-line__value">{line.value}</p>
                </div>
                <KitAction copy={line.value} />
              </li>
            ))
          }
        </ul>
      </section>

      <section id="speaker" class="kit-section" data-analytics-section="swe_kit_speaker">
        <h2 class="kit-h2">Speaker profile</h2>
        <p class="kit-lede">Photo, bio and the full profile, for posters, introductions and records.</p>
        <ul class="kit-lines">
          <li class="kit-line">
            <div>
              <p class="kit-line__label">Photo</p>
              <Image src={instructorPhoto} alt="Prashant Bhudwal" class="kit-photo" width={480} height={480} />
            </div>
            <KitAction download={speaker.photo} />
          </li>
          <li class="kit-line">
            <div>
              <p class="kit-line__label">Bio</p>
              <p class="kit-line__text">{`${speaker.bio}\n\n${speaker.showcase}`}</p>
            </div>
            <KitAction copy={`${speaker.bio}\n\n${speaker.showcase}`} />
          </li>
          <li class="kit-line">
            <div>
              <p class="kit-line__label">Full profile</p>
              <p class="kit-line__text">A one-page PDF, for approval files and event records.</p>
            </div>
            <KitAction download={speaker.profile} label="Download PDF" />
          </li>
        </ul>
      </section>

      <section id="whatsapp" class="kit-section" data-analytics-section="swe_kit_message">
        <h2 class="kit-h2">WhatsApp message</h2>
        <p class="kit-lede">Pick the tone that suits your groups, copy it, and fill in the highlighted brackets.</p>
        <KitBlock label="WhatsApp message" copy={whatsappVariants[0].text} primary>
          <div slot="controls" class="kit-tone" role="group" aria-label="Message tone">
            {
              whatsappVariants.map((variant, index) => (
                <button type="button" data-variant={variant.id} aria-pressed={index === 0 ? "true" : "false"}>
                  {variant.label}
                </button>
              ))
            }
          </div>
          {
            whatsappVariants.map((variant, index) => (
              <div class="kit-chat" data-variant={variant.id} data-text={variant.text} hidden={index !== 0}>
                <p class="kit-bubble">
                  {toChatLines(variant.text).map((line) => (
                    <span class="kit-bubble__line">
                      {line.map((part) =>
                        part.kind === "bold" ? (
                          <strong>{part.text}</strong>
                        ) : part.kind === "blank" ? (
                          <mark>{part.text}</mark>
                        ) : (
                          part.text
                        ),
                      )}
                    </span>
                  ))}
                </p>
              </div>
            ))
          }
        </KitBlock>
      </section>

      <section id="report" class="kit-section" data-analytics-section="swe_kit_report">
        <h2 class="kit-h2">Event report</h2>
        <p class="kit-lede">For IQAC, NAAC and NBA documentation, usually written after the workshop.</p>
        <ul class="kit-lines">
          {
            reportParts.map((part) => (
              <li class="kit-line">
                <div>
                  <p class="kit-line__label">{part.label}</p>
                  <p class="kit-line__text">{part.text}</p>
                </div>
                <KitAction copy={part.text} />
              </li>
            ))
          }
        </ul>
      </section>

      <section id="facts" class="kit-section" data-analytics-section="swe_kit_facts">
        <h2 class="kit-h2">Workshop facts</h2>
        <div class="kit-lede-row">
          <p class="kit-lede">The raw details, for writing your own announcement or report.</p>
          <KitAction copy={facts.map((fact) => `${fact.label}: ${fact.value}`).join("\n")} label="Copy all facts" />
        </div>
        <ul class="kit-lines">
          {
            facts.map((fact) => (
              <li class="kit-line">
                <div>
                  <p class="kit-line__label">{fact.label}</p>
                  <p class="kit-line__text">{fact.value}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </main>
</Landing>

<style>
  /* === Header === */
  .kit-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--surface-sticky);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 1px 0 var(--border-weak);
  }

  .kit-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    height: 64px;
  }

  .kit-header__title {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--fg-strong);
  }

  .kit-header__title span {
    font-weight: 400;
    color: var(--fg-weaker);
  }

  /* One readable column for the whole page. */
  .kit-column {
    max-width: 860px;
    margin-inline: auto;
  }

  /* === Intro === */
  .kit-intro {
    padding-block: clamp(2.5rem, 6vw, 4rem) 0;
  }

  .kit-intro__title {
    font-size: clamp(1.875rem, 1.4rem + 2vw, 2.75rem);
    font-weight: 560;
    line-height: 1.08;
    letter-spacing: -0.028em;
    color: var(--fg-strong);
    text-wrap: balance;
    margin-bottom: var(--space-4);
  }

  .kit-intro__lede {
    max-width: 58ch;
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--fg-weak);
    text-wrap: pretty;
  }

  /* === Jump nav ===
     Wide screens: a floating pill under the header that marks the section in
     view. Narrow screens: a "Jump to" bar showing the current section, which
     opens the full list as a dropdown. */
  .kit-toc {
    position: sticky;
    top: 76px;
    z-index: 50;
    margin-block: var(--space-8) var(--space-4);
  }

  .kit-toc__toggle {
    display: none;
  }

  .kit-toc ol {
    display: flex;
    gap: 2px;
    width: fit-content;
    margin: 0;
    padding: 4px;
    list-style: none;
    border: 1px solid var(--border-base);
    border-radius: 999px;
    background-color: var(--surface-sticky);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: var(--shadow-raised);
  }

  .kit-toc a {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 999px;
    white-space: nowrap;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--fg-weak);
    text-decoration: none;
