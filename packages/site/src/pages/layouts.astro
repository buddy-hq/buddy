</style>

<script>
  // ==========================================
  // TOP BAR LAYOUT SWITCHING
  // ==========================================
  const layoutGridBtns = document.querySelectorAll(".layout-grid-btn");
  const layoutSections = document.querySelectorAll(".layout-section");

  layoutGridBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const layoutId = btn.getAttribute("data-layout");
      if (!layoutId) return;

      // Update switcher buttons
      layoutGridBtns.forEach((b) => {
        b.classList.remove("active");
        b.setAttribute("aria-selected", "false");
      });
      btn.classList.add("active");
      btn.setAttribute("aria-selected", "true");

      // Show/hide sections
      layoutSections.forEach((sec) => {
        sec.classList.remove("active");
      });
      
      const activeSec = document.getElementById(`layout-${layoutId}`);
      if (activeSec) {
        activeSec.classList.add("active");
        window.scrollTo({ top: 0, behavior: "smooth" });
      }
    });
  });

  // ==========================================
  // INTERACTIVE SCRIPTS FOR LAYOUT 1: SPLIT STAGE
  // ==========================================
  const l1Btns = document.querySelectorAll(".l1-tab-btn");
  const l1Panels = document.querySelectorAll(".l1-panel");
  const l1Cards = document.querySelectorAll(".l1-stack-card");

  l1Btns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const target = btn.getAttribute("data-target");
      if (!target || btn.classList.contains("active")) return;

      l1Btns.forEach((b) => {
        b.classList.remove("active");
        b.setAttribute("aria-selected", "false");
      });
      btn.classList.add("active");
      btn.setAttribute("aria-selected", "true");

      l1Panels.forEach((panel) => {
        panel.classList.remove("active");
      });
      const activePanel = document.getElementById(`l1-panel-${target}`);
      if (activePanel) activePanel.classList.add("active");

      const targetIdx = Array.from(l1Btns).indexOf(btn);
      
      l1Cards.forEach((card, idx) => {
        card.classList.remove("active", "next", "back");
        if (idx === targetIdx) {
          card.classList.add("active");
        } else if ((idx === targetIdx + 1) || (targetIdx === l1Btns.length - 1 && idx === 0)) {
          card.classList.add("next");
        } else {
          card.classList.add("back");
        }
      });
    });
  });

  // ==========================================
  // INTERACTIVE SCRIPTS FOR LAYOUT 2: DEV WORKSPACE
  // ==========================================
  const fileRows = document.querySelectorAll(".l5-file-row");
  const editorTabs = document.querySelectorAll(".l5-editor-tab");
  const editorContents = document.querySelectorAll(".l5-editor-content");
  const consoleOutputs = document.querySelectorAll(".l5-console-output");

  function switchIDEFile(cohortId: string) {
    fileRows.forEach((row) => {
      if (row.getAttribute("data-file") === cohortId) {
        row.classList.add("active");
      } else {
        row.classList.remove("active");
      }
    });

    editorTabs.forEach((tab) => {
      if (tab.getAttribute("data-target") === cohortId) {
        tab.classList.add("active");
      } else {
        tab.classList.remove("active");
      }
    });

    editorContents.forEach((content) => {
      if (content.getAttribute("id") === `l5-editor-${cohortId}`) {
        content.classList.add("active");
      } else {
        content.classList.remove("active");
      }
    });

    consoleOutputs.forEach((output) => {
      if (output.getAttribute("id") === `l5-console-${cohortId}`) {
        output.classList.add("active");
      } else {
        output.classList.remove("active");
      }
    });
  }

  fileRows.forEach((row) => {
    row.addEventListener("click", () => {
      const fileId = row.getAttribute("data-file");
      if (fileId) switchIDEFile(fileId);
    });
  });

  editorTabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const targetId = tab.getAttribute("data-target");
      if (targetId) switchIDEFile(targetId);
    });
  });

  // ==========================================
  // INTERACTIVE SCRIPTS FOR LAYOUT 3: ACCORDION
  // ==========================================
  const l6Drawers = document.querySelectorAll(".l6-drawer");

  l6Drawers.forEach((drawer) => {
    drawer.addEventListener("click", () => {
      l6Drawers.forEach((d) => d.classList.remove("active"));
      drawer.classList.add("active");
    });
  });

  // ==========================================
  // INTERACTIVE SCRIPTS FOR LAYOUT 4: OS WINDOWS DRAG
  // ==========================================
  const windows = document.querySelectorAll(".l11-window");
  const shortcuts = document.querySelectorAll(".l11-file-shortcut");

  function focusWindow(win: HTMLElement) {
    windows.forEach((w) => {
      w.classList.remove("focus-window");
    });
    
    win.classList.add("focus-window");
    
    let maxZ = 10;
    windows.forEach((w) => {
      const zVal = parseInt(window.getComputedStyle(w).zIndex);
      if (!isNaN(zVal) && zVal > maxZ) {
        maxZ = zVal;
      }
    });
    
    win.style.zIndex = (maxZ + 1).toString();
  }

  shortcuts.forEach((sc) => {
    sc.addEventListener("click", () => {
      const targetId = sc.getAttribute("data-open");
      if (!targetId) return;

      const targetWin = document.getElementById(`l11-win-${targetId}`);
      if (targetWin) {
        focusWindow(targetWin);
      }
    });
  });

  windows.forEach((win) => {
    const htmlWin = win as HTMLElement;
    
    htmlWin.addEventListener("mousedown", () => {
      focusWindow(htmlWin);
    });

    const titleBar = htmlWin.querySelector(".l11-title-bar") as HTMLElement;
    if (!titleBar) return;
    
    let isDragging = false;
    let startX = 0;
    let startY = 0;
    
    titleBar.addEventListener("mousedown", (e: MouseEvent) => {
      isDragging = true;
      startX = e.clientX - htmlWin.offsetLeft;
      startY = e.clientY - htmlWin.offsetTop;
      focusWindow(htmlWin);
      e.preventDefault();
    });
    
    document.addEventListener("mousemove", (e: MouseEvent) => {
      if (!isDragging) return;
      
      const newLeft = e.clientX - startX;
      const newTop = e.clientY - startY;
      
      const workspace = htmlWin.parentElement as HTMLElement;
      if (workspace) {
        const rect = workspace.getBoundingClientRect();
        if (newLeft >= 0 && newLeft <= rect.width - 200) {
          htmlWin.style.left = `${newLeft}px`;
        }
        if (newTop >= 0 && newTop <= rect.height - 100) {
          htmlWin.style.top = `${newTop}px`;
        }
      }
    });
    
    document.addEventListener("mouseup", () => {
      isDragging = false;
    });
  });

  // ==========================================
  // INTERACTIVE SCRIPTS FOR LAYOUT 5: AUDIO MIXER
  // ==========================================
  const mixerStrips = document.querySelectorAll(".l12-strip");
  const mixerMonitors = document.querySelectorAll(".l12-monitor-screen");

  mixerStrips.forEach((strip) => {
    strip.addEventListener("click", () => {
      const target = strip.getAttribute("data-target");
      const indexStr = strip.getAttribute("data-index");
      if (!target || !indexStr) return;
      const targetIdx = parseInt(indexStr);

      mixerStrips.forEach((s) => s.classList.remove("active"));
      strip.classList.add("active");

      mixerStrips.forEach((s, idx) => {
        const knob = s.querySelector(".l12-fader-knob") as HTMLElement;
        if (knob) {
          if (idx === targetIdx) {
            knob.style.bottom = "80%";
          } else {
            knob.style.bottom = "10%";
          }
        }
      });

      mixerMonitors.forEach((m) => m.classList.remove("active"));
      const activeMon = document.getElementById(`l12-monitor-${target}`);
      if (activeMon) activeMon.classList.add("active");
    });
  });

  // ==========================================
  // INTERACTIVE SCRIPTS FOR LAYOUT 6: RETRO ROTARY
  // ==========================================
  const rotaryHoles = document.querySelectorAll(".rotary-hole");
  const rotaryDialer = document.getElementById("rotary-dialer");
  const crtPanels = document.querySelectorAll(".l6-crt-panel");

  rotaryHoles.forEach((hole) => {
    hole.addEventListener("click", () => {
      const target = hole.getAttribute("data-target");
      const angleStr = hole.getAttribute("data-angle");
      if (!target || !angleStr || !rotaryDialer) return;
      
      const angle = parseInt(angleStr);

      // Animation: spin the rotary wheel, then back
      rotaryHoles.forEach(h => h.classList.remove("active"));
      hole.classList.add("active");

      rotaryDialer.style.transform = `rotate(${360 - angle}deg)`;
      
      setTimeout(() => {
        if (rotaryDialer) rotaryDialer.style.transform = `rotate(0deg)`;
      }, 500);

      // Update screen
      crtPanels.forEach(p => p.classList.remove("active"));
      const activeCrt = document.getElementById(`l6-crt-${target}`);
      if (activeCrt) activeCrt.classList.add("active");
    });
  });

  // ==========================================
  // INTERACTIVE SCRIPTS FOR LAYOUT 7: CHAT SHELL
  // ==========================================
  const promptBtns = document.querySelectorAll(".prompt-btn");
  const consoleScreen = document.getElementById("l7-console-screen");
  const consoleInput = document.getElementById("l7-console-input") as HTMLInputElement;
  const shellPreviewBox = document.querySelectorAll(".l7-shell-img-card");

  promptBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const target = btn.getAttribute("data-target");
      const promptText = btn.getAttribute("data-prompt");
      if (!target || !promptText || !consoleScreen || !consoleInput) return;

      // Simulate user typing
      consoleInput.value = promptText;

      // Create log lines
      const userLine = document.createElement("p");
      userLine.className = "user-line";
      userLine.innerHTML = `buddy@local:~$ <span class="bold-text">${promptText}</span>`;
      consoleScreen.appendChild(userLine);

      const loaderLine = document.createElement("p");
      loaderLine.className = "system-line";
      loaderLine.innerText = `[system] Fetching sandbox metadata for '${target}'...`;
      consoleScreen.appendChild(loaderLine);

      setTimeout(() => {
        const replyLine = document.createElement("p");
        replyLine.className = "reply-line";
        replyLine.innerText = `[system] Sandboxed instance for ${target} loaded successfully. Display channel opened.`;
        consoleScreen.appendChild(replyLine);
        
        // Scroll screen
        consoleScreen.scrollTop = consoleScreen.scrollHeight;

        // Toggle preview image
        shellPreviewBox.forEach(card => card.classList.remove("active"));
        const activeCard = document.getElementById(`l7-shell-img-${target}`);
        if (activeCard) activeCard.classList.add("active");
      }, 600);
    });
  });

  // ==========================================
  // INTERACTIVE SCRIPTS FOR LAYOUT 8: VENN DIAGRAM
  // ==========================================
  const vennCircles = document.querySelectorAll(".venn-circle");
  const vennPanels = document.querySelectorAll(".l8-venn-panel");

  vennCircles.forEach((circle) => {
    circle.addEventListener("mouseenter", () => {
      const id = circle.getAttribute("id");
      if (!id) return;
      
      const cohort = id.replace("venn-c-", "");
      
      // Update circle visual
      vennCircles.forEach(c => c.classList.remove("active"));
      circle.classList.add("active");

      // Update detail panel
      vennPanels.forEach(p => p.classList.remove("active"));
      const activePanel = document.getElementById(`l8-venn-${cohort}`);
      if (activePanel) activePanel.classList.add("active");
    });
  });

  // ==========================================
  // INTERACTIVE SCRIPTS FOR LAYOUT 9: WAVEFORM VISUALIZER
  // ==========================================
  const waveTracks = document.querySelectorAll(".l9-wave-track");
  const wavePanels = document.querySelectorAll(".l9-wave-panel");

  waveTracks.forEach((track) => {
    track.addEventListener("click", () => {
      const target = track.getAttribute("data-target");
      if (!target) return;

      waveTracks.forEach(t => t.classList.remove("active"));
      track.classList.add("active");

      // Animate active waveform heights slightly
      const bars = track.querySelectorAll(".wave-bar");
      bars.forEach((bar) => {
        const hBar = bar as HTMLElement;
        const targetHeight = Math.floor(Math.random() * 32) + 8;
        hBar.style.height = `${targetHeight}px`;
      });

      wavePanels.forEach(p => p.classList.remove("active"));
      const activePanel = document.getElementById(`l9-wave-panel-${target}`);
      if (activePanel) activePanel.classList.add("active");
    });
  });

  // ==========================================
  // INTERACTIVE SCRIPTS FOR LAYOUT 10: NODE GRAPH NAVIGATOR
  // ==========================================
  const graphNodes = document.querySelectorAll(".graph-node");
  const graphPanels = document.querySelectorAll(".l10-graph-panel");

  graphNodes.forEach((node) => {
    node.addEventListener("click", () => {
      const target = node.getAttribute("data-target");
      if (!target) return;

      graphNodes.forEach(n => n.classList.remove("active"));
      node.classList.add("active");

      graphPanels.forEach(p => p.classList.remove("active"));
      const activePanel = document.getElementById(`l10-graph-panel-${target}`);
      if (activePanel) activePanel.classList.add("active");
    });
  });
</script>
