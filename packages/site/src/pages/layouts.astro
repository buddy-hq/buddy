                <div class="wave-panel-grid">
                  <div class="wave-p-info">
                    <span class="wave-tag" style={`border-color: ${aud.accent}; color: ${aud.accent};`}>{aud.label}</span>
                    <h3 class="wave-title">{aud.title}</h3>
                    <p class="wave-desc">{aud.description}</p>
                    <ul class="wave-list">
                      {aud.features.map(f => (
                        <li>{f}</li>
                      ))}
                    </ul>
                  </div>
                  <div class="wave-p-media">
                    <div class="wave-media-box">
                      <Image src={aud.bg} alt="" class="wave-bg" />
                      <Image src={aud.mascot} alt="" class="wave-mascot" />
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ==========================================
         LAYOUT 10: NODE GRAPH NAVIGATOR (NEW)
         ========================================== -->
    <section id="layout-10" class="layout-section">
      <div class="container">
        <div class="layout-intro text-center">
          <span class="badge">Layout 10: Node Graph Navigator</span>
          <h2 class="prototype-heading">Built for how you learn</h2>
          <p class="prototype-subheading">An interactive graph mapping relational workspaces to Buddy's core core module.</p>
        </div>

        <div class="l10-graph-workspace">
          <div class="l10-graph-left">
            <div class="node-graph-area">
              <div class="center-node">
                <span class="core-bullet">BUDDY</span>
              </div>
              
              <!-- Draw SVG linking lines -->
              <svg class="graph-svg" viewBox="0 0 300 300">
                <line x1="150" y1="150" x2="60" y2="70" stroke="rgba(255,107,0,0.4)" stroke-width="1.5" />
                <line x1="150" y1="150" x2="240" y2="70" stroke="rgba(45,212,191,0.4)" stroke-width="1.5" />
                <line x1="150" y1="150" x2="150" y2="240" stroke="rgba(245,158,11,0.4)" stroke-width="1.5" />
              </svg>

              {audiences.map((aud, index) => {
                const positions = [
                  { left: "60px", top: "70px" },
                  { left: "240px", top: "70px" },
                  { left: "150px", top: "240px" }
                ]
                const pos = positions[index]
                return (
                  <button 
                    class={`graph-node ${index === 0 ? 'active' : ''}`} 
                    data-target={aud.id} 
                    style={`left: ${pos.left}; top: ${pos.top}; --node-accent: ${aud.accent}; --node-glow: ${aud.glow};`}
                  >
                    <span class="node-bullet">•</span>
                    <span class="node-label">{aud.label.replace('For ', '')}</span>
                  </button>
                )
              })}
            </div>
          </div>

          <div class="l10-graph-right">
            <div class="l10-graph-viewer">
              {audiences.map((aud, index) => (
                <div class={`l10-graph-panel ${index === 0 ? 'active' : ''}`} id={`l10-graph-panel-${aud.id}`} style={`--g-accent: ${aud.accent};`}>
                  <div class="graph-panel-header">NODE OBJECT: {aud.id.toUpperCase()}</div>
                  <h3 class="graph-panel-title">{aud.title}</h3>
                  <p class="graph-panel-desc">{aud.description}</p>
                  <ul class="graph-panel-features">
                    {aud.features.map(f => (
                      <li>
                        <span class="arrow">-</span>
                        <span>{f}</span>
                      </li>
                    ))}
                  </ul>
                  <div class="graph-panel-media">
                    <Image src={aud.bg} alt="" class="g-bg" />
                    <Image src={aud.mascot} alt="" class="g-mascot" />
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>
</Landing>

