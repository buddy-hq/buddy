    display: flex;
    align-items: center;
    transition: opacity 300ms var(--ease-out) 150ms, visibility 300ms var(--ease-out) 150ms;
    overflow: hidden;
  }

  .l6-drawer:hover .l6-expanded-content, .l6-drawer.active .l6-expanded-content {
    opacity: 1;
    visibility: visible;
  }

  .l6-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
    width: 100%;
    align-items: center;
  }

  .l6-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 4px;
    margin-bottom: var(--space-4);
  }

  .l6-title {
    font-size: var(--text-xl);
    font-weight: 800;
    color: #ffffff;
    margin-bottom: var(--space-3);
  }

  .l6-desc {
    color: var(--color-text-tertiary);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-4);
  }

  .l6-features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .l6-features li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .l6-features li .bullet {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .l6-img-frame {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 16/10;
    border: 1px solid rgba(255, 255, 255, 0.05);
    background: rgba(0, 0, 0, 0.25);
  }

  .l6-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .l6-mascot {
    position: absolute;
    bottom: 8px;
    right: 8px;
    width: 25%;
    filter: drop-shadow(0 4px 8px rgba(0,0,0,0.3));
  }

  @media (max-width: 768px) {
    .l6-accordion-container {
      flex-direction: column;
      height: auto;
    }
    .l6-drawer {
      height: 100px;
    }
    .l6-drawer:hover, .l6-drawer.active {
      height: 380px;
    }
  }

  /* ============================================================
     LAYOUT 4: RETRO WINDOW CASCADES SPECIFIC STYLE
     ============================================================ */
  .l11-desktop-workspace {
    position: relative;
    width: 100%;
    height: 600px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    background-color: #0b0908;
    background-image: radial-gradient(rgba(255, 255, 255, 0.015) 1px, transparent 1px);
    background-size: 16px 16px;
    overflow: hidden;
    margin-top: var(--space-8);
  }

  .l11-icon-sidebar {
    position: absolute;
    top: 20px;
    left: 20px;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    z-index: 5;
  }

  .l11-file-shortcut {
    display: flex;
    flex-direction: column;
    align-items: center;
    cursor: pointer;
    width: 72px;
  }

  .shortcut-icon {
    width: 44px;
    height: 44px;
    border-radius: 8px;
    border: 1px solid;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.2);
    transition: transform 150ms var(--ease-out);
  }

  .l11-file-shortcut:hover .shortcut-icon {
    transform: scale(1.06);
  }

  .shortcut-name {
    font-family: var(--font-mono);
    font-size: 9px;
    color: var(--color-text-tertiary);
    margin-top: 4px;
    text-align: center;
  }

  .l11-windows-container {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .l11-window {
    position: absolute;
    width: 580px;
    background-color: #161312;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
    overflow: hidden;
  }

  .l11-window.focus-window {
    border-color: var(--win-accent);
    box-shadow: 0 25px 50px rgba(0, 0, 0, 0.45), 0 0 15px rgba(255,107,0,0.05);
  }

  .l11-title-bar {
    height: 34px;
    background-color: #0e0c0b;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: var(--space-4);
    cursor: move;
    user-select: none;
  }

  .l11-win-ctrls {
    display: flex;
    gap: 6px;
  }

  .l11-win-title {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-text-muted);
    font-weight: 700;
  }

  .l11-window.focus-window .l11-win-title {
    color: #ffffff;
  }

  .l11-win-status {
    font-family: var(--font-mono);
    font-size: 8px;
    background-color: rgba(45, 212, 191, 0.1);
    color: #2dd4bf;
    padding: 1px 4px;
    border-radius: 3px;
  }

  .l11-win-body {
    padding: var(--space-5);
  }

  .l11-win-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-5);
    align-items: center;
  }

  .l11-win-text .l11-tag {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 700;
    border: 1px solid;
    padding: 2px 6px;
    border-radius: 4px;
    display: inline-block;
    margin-bottom: var(--space-3);
  }

  .l11-win-text .l11-title {
    font-size: var(--text-base);
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 6px;
  }

  .l11-win-text .l11-desc {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-4);
  }

  .l11-bullets {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .l11-bullet-row {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
  }

  .l11-bullet-row .bullet {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .l11-win-media {
    display: flex;
    justify-content: center;
  }

  .l11-card-mockup {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.05);
    aspect-ratio: 16/10;
    background: rgba(0,0,0,0.25);
    width: 100%;
  }

  .l11-m-bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .l11-m-mascot {
    position: absolute;
    bottom: 4px;
    right: 4px;
    width: 25%;
  }

  @media (max-width: 768px) {
    .l11-window {
      width: 100%;
    }
  }

  /* ============================================================
     LAYOUT 5: STUDIO MIXER SPECIFIC STYLE
     ============================================================ */
  .l12-mixer-deck {
    display: grid;
    grid-template-columns: 320px 1fr;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    background-color: #0d0b0a;
    overflow: hidden;
    margin-top: var(--space-8);
  }

  .l12-channel-strips {
    display: flex;
    background-color: #080706;
    border-right: 1px solid rgba(255, 255, 255, 0.06);
  }

  .l12-strip {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: var(--space-5);
    border-right: 1px solid rgba(255, 255, 255, 0.03);
    cursor: pointer;
    transition: background-color 200ms var(--ease-out);
  }

  .l12-strip:hover, .l12-strip.active {
    background-color: rgba(255, 255, 255, 0.015);
  }

  .l12-strip-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    margin-bottom: var(--space-6);
  }

  .l12-strip-header .ch-num {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-text-muted);
  }

  .l12-strip-header .ch-name {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 700;
    color: var(--color-text-tertiary);
  }

  .l12-strip.active .ch-name {
    color: var(--ch-accent);
  }

  .l12-fader-track {
    position: relative;
    width: 40px;
    height: 220px;
    background-color: #030202;
    border-radius: 4px;
    margin-bottom: var(--space-6);
    border-left: 1px solid rgba(255,255,255,0.03);
  }

  .fader-db-ticks {
    position: absolute;
    left: -24px;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 7px;
    color: var(--color-text-muted);
    text-align: right;
  }

  .l12-fader-knob {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    width: 24px;
    height: 38px;
    border-radius: 3px;
    background-color: #26211e;
    border: 1px solid #3c3430;
    box-shadow: 0 4px 10px rgba(0,0,0,0.5);
    cursor: ns-resize;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: bottom 300ms cubic-bezier(0.25, 1, 0.3, 1);
  }

  .l12-strip.active .l12-fader-knob {
    background-color: var(--ch-accent);
    border-color: #ffffff;
  }

  .knob-line {
    width: 100%;
    height: 2px;
    background-color: #ffffff;
  }

  .l12-mute-solo {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 80%;
  }

  .l12-mute-solo button {
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 8px;
    font-weight: 700;
    padding-block: 4px;
    background-color: #161312;
    color: var(--color-text-muted);
    cursor: pointer;
  }

  .l12-strip.active .btn-select {
    background-color: var(--ch-accent);
    color: #ffffff;
  }

  .l12-mixer-monitor {
    padding: var(--space-8);
    display: flex;
    align-items: center;
  }

  .l12-monitor-screen {
    display: none;
    width: 100%;
    animation: fadeInUp 0.4s var(--ease-out) forwards;
  }

  .l12-monitor-screen.active {
    display: block;
  }

  .l12-mon-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
    align-items: center;
  }

  .l12-mon-badge {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    border: 1px solid;
    padding: 3px 8px;
    border-radius: 4px;
    display: inline-block;
    margin-bottom: var(--space-4);
  }

  .l12-mon-title {
    font-size: var(--text-xl);
    font-weight: 800;
    color: #ffffff;
    margin-bottom: var(--space-3);
  }

  .l12-mon-desc {
    color: var(--color-text-tertiary);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-6);
  }

  .l12-mon-features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .l12-mon-features li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .l12-mon-features li .bullet {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .l12-mon-frame {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 16/10;
    border: 1px solid rgba(255, 255, 255, 0.05);
    background: rgba(0,0,0,0.25);
  }

  .l12-mon-frame .l12-bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .l12-mon-frame .l12-mascot {
    position: absolute;
    bottom: 8px;
    right: 8px;
    width: 25%;
  }

  @media (max-width: 992px) {
    .l12-mon-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ============================================================
     LAYOUT 6: RETRO ROTARY DIAL SPECIFIC STYLE
     ============================================================ */
  .l6-rotary-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    align-items: center;
    margin-top: var(--space-8);
  }

  .l6-rotary-left {
    display: flex;
    justify-content: center;
  }

  .l6-rotary-phone {
    width: 320px;
    height: 320px;
    background-color: #12100f;
    border: 3px solid #282421;
    border-radius: 50%;
    box-shadow: 0 20px 50px rgba(0,0,0,0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .rotary-face {
    width: 260px;
    height: 260px;
    background-color: #1a1816;
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 50%;
    position: relative;
    transition: transform 600ms cubic-bezier(0.25, 0.8, 0.25, 1);
  }

  .rotary-center {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 90px;
    height: 90px;
    background-color: #0b0908;
    border: 2px solid #ff6b00;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: inset 0 4px 10px rgba(0,0,0,0.8);
    z-index: 10;
  }

  .center-brand {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 900;
    color: #ff6b00;
    letter-spacing: var(--tracking-wider);
  }

  .rotary-hole {
    position: absolute;
    top: calc(50% - 25px);
    left: calc(50% - 25px);
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background-color: rgba(0,0,0,0.4);
    border: 1.5px solid rgba(255,255,255,0.06);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-weight: 800;
    font-size: 14px;
    box-shadow: inset 0 2px 5px rgba(0,0,0,0.6);
    transition: all 180ms var(--ease-out);
  }

  .rotary-hole:hover {
    border-color: var(--hole-accent);
    color: var(--hole-accent);
    box-shadow: inset 0 2px 5px rgba(0,0,0,0.6), 0 0 10px var(--hole-accent);
  }

  .rotary-hole.active {
    background-color: var(--hole-accent);
    color: #000;
    border-color: #fff;
    box-shadow: 0 0 12px var(--hole-accent);
  }

  .l6-rotary-right {
    display: flex;
    justify-content: center;
  }

  /* CRT Terminal display */
  .l6-retro-crt {
    width: 100%;
    max-width: 480px;
    background-color: #12100f;
    border: 6px solid #2c2724;
    border-radius: 20px;
    aspect-ratio: 4/3;
    position: relative;
    overflow: hidden;
    box-shadow: inset 0 0 40px rgba(0,0,0,1), 0 15px 30px rgba(0,0,0,0.5);
  }

  .crt-glare {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(255,255,255,0.03) 0%, transparent 50%, rgba(0,0,0,0.15) 100%);
    pointer-events: none;
    z-index: 10;
  }

  .crt-content {
    height: 100%;
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    justify-content: center;
    background-color: #060505;
  }

  .l6-crt-panel {
    display: none;
    opacity: 0;
    animation: fadeInUp 0.4s var(--ease-out) forwards;
  }

  .l6-crt-panel.active {
    display: block;
    opacity: 1;
  }

  .crt-header {
    font-family: var(--font-mono);
    font-size: 9px;
    color: var(--crt-accent);
    letter-spacing: 2px;
    margin-bottom: var(--space-2);
  }

  .crt-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 800;
    color: #ffffff;
    margin-bottom: var(--space-2);
    text-shadow: 0 0 4px rgba(255,255,255,0.3);
  }

  .crt-desc {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-4);
  }

  .crt-screen-mockup {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.05);
    background: rgba(0, 0, 0, 0.3);
    aspect-ratio: 16/10;
    width: 80%;
  }

  .crt-mock-bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.8;
  }

  .crt-mock-mascot {
    position: absolute;
    bottom: 4px;
    right: 4px;
    width: 25%;
  }

  @media (max-width: 992px) {
    .l6-rotary-grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }

  /* ============================================================
     LAYOUT 7: INTERACTIVE CHAT SHELL SPECIFIC STYLE
     ============================================================ */
  .l7-shell-frame {
    display: grid;
    grid-template-columns: 200px 1fr 280px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    background-color: #0b0908;
    overflow: hidden;
    margin-top: var(--space-8);
    min-height: 400px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.4);
  }

  .l7-shell-sidebar {
    background-color: #060505;
    border-right: 1px solid rgba(255, 255, 255, 0.05);
    padding: var(--space-4);
  }

  .l7-shell-sidebar .sb-title {
    display: block;
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 700;
    color: var(--color-text-muted);
    letter-spacing: 1px;
    margin-bottom: var(--space-4);
  }

  .prompt-suggestions {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .prompt-btn {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 6px;
    padding: 8px 10px;
    text-align: left;
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: 11px;
    cursor: pointer;
    transition: all 180ms var(--ease-out);
  }

  .prompt-btn:hover {
    background-color: rgba(255,255,255,0.03);
    border-color: var(--color-accent-primary);
    color: #ffffff;
  }

  .prompt-btn .arrow {
    color: var(--color-accent-primary);
    margin-right: 2px;
  }

  .l7-shell-console {
    background-color: #090807;
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    border-right: 1px solid rgba(255, 255, 255, 0.05);
  }

  .console-screen {
    flex-grow: 1;
    font-family: var(--font-mono);
    font-size: 11px;
    color: #a8a29e;
    line-height: 1.6;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-height: 250px;
  }

  .system-line { color: #78716c; }
  .user-line { color: #ff6b00; }
  .reply-line { color: #2dd4bf; }
  .bold-text { color: #ffffff; font-weight: 700; }

  .console-input-bar {
    display: flex;
    align-items: center;
    border-top: 1px solid rgba(255,255,255,0.04);
    padding-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .prompt-prefix {
    color: var(--color-accent-cool);
    margin-right: 8px;
  }

  .console-input {
    background: transparent;
    border: none;
    outline: none;
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 11px;
    flex-grow: 1;
  }

  .cursor-blink {
    color: var(--color-accent-cool);
    animation: cursor-flicker 1s steps(2, start) infinite;
  }

  @keyframes cursor-flicker {
    to { visibility: hidden; }
  }

  /* Render screen right panel */
  .l7-shell-output-preview {
    background-color: #060505;
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
  }

  .preview-header {
    font-family: var(--font-mono);
    font-size: 9px;
    color: var(--color-text-muted);
    letter-spacing: 1px;
    margin-bottom: var(--space-4);
  }

  .preview-stage {
    flex-grow: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.03);
    border-radius: 8px;
    background-color: rgba(0,0,0,0.25);
    overflow: hidden;
  }

  .l7-shell-img-card {
    display: none;
    position: relative;
    width: 100%;
    height: 100%;
    aspect-ratio: 16/10;
  }

  .l7-shell-img-card.active {
    display: block;
    animation: fadeInUp 0.4s var(--ease-out) forwards;
  }

