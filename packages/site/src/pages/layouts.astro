---
import Landing from "../layouts/Landing.astro"
import { Image } from "astro:assets"

// Import existing assets
import stateFlashcards from "../assets/mascot/buddy-state-empty-flashcards.png"
import stateBooks from "../assets/mascot/buddy-state-empty-books.png"
import stateExercises from "../assets/mascot/buddy-state-empty-exercises.png"
import mascotIdea from "../assets/mascot/buddy-mascot-idea.png"
import mascotRead from "../assets/mascot/buddy-mascot-read.png"
import mascotThink from "../assets/mascot/buddy-mascot-think.png"

const audiences = [
  {
    id: "students",
    num: "01",
    label: "For Students",
    tag: "STUDENT",
    title: "Ace your exams with active study tools",
    description: "Import textbooks or syllabus material, then generate flashcards, practice quizzes, and visual summaries that target exactly what you need to review.",
    features: [
      "Generate active recall flashcards from core textbook chapters",
      "Solve equations and plot charts inside a sandboxed Python runtime",
      "Track memory retention using spaced repetition algorithms"
    ],
    bg: stateFlashcards,
    mascot: mascotIdea,
    accent: "#ff6b00",
    glow: "rgba(255, 107, 0, 0.15)",
    file: "students.py",
    lang: "python",
    osWindow: "students_workspace.exe",
    icon: "🐍"
  },
  {
    id: "learners",
    num: "02",
    label: "For Lifelong Learners",
    tag: "LEARNER",
    title: "Explore new subjects at your own pace",
    description: "Dive into any discipline — from history to programming. Buddy acts as a knowledgeable co-reader, helping you break down dense texts and organize your research.",
    features: [
      "Highlight, search, and annotate text inline as you read",
      "Sketch mental models on the integrated Excalidraw whiteboard",
      "Author Markdown notes with live LaTeX math and Mermaid diagrams"
    ],
    bg: stateBooks,
    mascot: mascotRead,
    accent: "#2dd4bf",
    glow: "rgba(45, 212, 191, 0.15)",
    file: "learners.md",
    lang: "markdown",
    osWindow: "read_annotate.app",
    icon: "📝"
  },
  {
    id: "educators",
    num: "03",
    label: "For Educators",
    tag: "EDUCATOR",
    title: "Create structured materials in minutes",
    description: "Generate standards-aligned worksheets, map lessons to learning objectives, and export polished resources — without starting from scratch.",
    features: [
      "Export lesson plans and worksheets to print-ready PDF layouts",
      "Align lesson objectives to Bloom's Taxonomy & grade-level targets",
      "Map exercises to CCSS, NGSS, and state guidelines"
    ],
    bg: stateExercises,
    mascot: mascotThink,
    accent: "#f59e0b",
    glow: "rgba(245, 158, 11, 0.15)",
    file: "educators.yaml",
    lang: "yaml",
    osWindow: "worksheet_builder.dmg",
    icon: "⚙️"
  }
]

const layoutNames = [
  { id: "1", name: "01. Split Stage Deck" },
  { id: "2", name: "02. Code Sandbox Workspace" },
  { id: "3", name: "03. Hover Drawer Accordion" },
  { id: "4", name: "04. Retro Window Cascades" },
  { id: "5", name: "05. Studio Mixer Console" },
  { id: "6", name: "06. Retro Rotary Dial" },
  { id: "7", name: "07. Interactive Chat Shell" },
  { id: "8", name: "08. Venn Intersection diagram" },
  { id: "9", name: "09. Waveform Track Visualizer" },
  { id: "10", name: "10. Node Graph Navigator" }
]
---

<Landing title="10 Audience Layout Prototypes — Buddy" robots="noindex, follow">
  <!-- Top bar to switch layouts -->
  <header class="layouts-nav">
    <div class="nav-container">
      <div class="nav-brand">
        <a href="/" class="back-link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          Back
        </a>
        <span class="divider">/</span>
        <span class="nav-title">Buddy Design Prototypes</span>
      </div>

      <div class="layout-grid-selector" role="tablist">
        {layoutNames.map((l) => (
          <button class={`layout-grid-btn ${l.id === '1' ? 'active' : ''}`} data-layout={l.id} role="tab" aria-selected={l.id === '1' ? 'true' : 'false'}>
            {l.name}
          </button>
        ))}
      </div>
    </div>
  </header>

  <main class="prototypes-container">
    
    <!-- ==========================================
         LAYOUT 1: SPLIT STAGE
         ========================================== -->
    <section id="layout-1" class="layout-section active">
      <div class="container">
        <div class="layout-intro text-center">
          <span class="badge">Layout 01: Split Stage Deck</span>
          <h2 class="prototype-heading">Built for how you learn</h2>
          <p class="prototype-subheading">An interactive deck that layers screen mockups and mascot states in a physical stack layout.</p>
        </div>

        <div class="l1-split-grid">
          <div class="l1-left">
            <div class="l1-tabs" role="tablist">
              {audiences.map((aud, index) => (
                <button class={`l1-tab-btn ${index === 0 ? 'active' : ''}`} data-target={aud.id} style={`--accent: ${aud.accent}; --glow: ${aud.glow};`}>
                  <span class="l1-tab-num">{aud.num}</span>
                  <span class="l1-tab-lbl">{aud.label}</span>
                </button>
              ))}
            </div>

            <div class="l1-content-box">
              {audiences.map((aud, index) => (
                <div class={`l1-panel ${index === 0 ? 'active' : ''}`} id={`l1-panel-${aud.id}`}>
                  <h3 class="l1-panel-title">{aud.title}</h3>
                  <p class="l1-panel-desc">{aud.description}</p>
                  <ul class="l1-panel-list">
                    {aud.features.map(feat => (
                      <li>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke={aud.accent} stroke-width="3">
                          <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        <span>{feat}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>

          <div class="l1-right">
            <div class="l1-stack-container">
              {audiences.map((aud, index) => (
                <div class={`l1-stack-card ${index === 0 ? 'active' : index === 1 ? 'next' : 'back'}`} id={`l1-card-${aud.id}`} style={`--card-accent: ${aud.accent};`}>
                  <div class="l1-card-inner">
                    <Image src={aud.bg} alt={aud.label} class="l1-card-bg" />
                    <div class="l1-mascot-wrapper">
                      <Image src={aud.mascot} alt="" class="l1-mascot-img" />
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ==========================================
         LAYOUT 2: CODE SANDBOX WORKSPACE (formerly 5)
         ========================================== -->
    <section id="layout-2" class="layout-section">
      <div class="container">
        <div class="layout-intro text-center">
          <span class="badge">Layout 02: Code Sandbox Workspace</span>
          <h2 class="prototype-heading">Built for how you learn</h2>
          <p class="prototype-subheading">A terminal & IDE styled interface mirroring Buddy's sandboxed environment.</p>
        </div>

        <div class="l5-workspace-frame">
          <div class="l5-sidebar">
            <div class="l5-sb-section">
              <span class="l5-sb-header">EXPLORER: BUDDY</span>
              <div class="l5-files">
                {audiences.map((aud, index) => (
                  <button class={`l5-file-row ${index === 0 ? 'active' : ''}`} data-file={aud.id}>
                    <span class="l5-file-icon" style={`color: ${aud.accent};`}>{aud.icon}</span>
                    <span class="l5-file-name">{aud.file}</span>
                  </button>
                ))}
              </div>
            </div>
          </div>

          <div class="l5-main-editor">
            <div class="l5-editor-tabs">
              {audiences.map((aud, index) => (
                <div class={`l5-editor-tab ${index === 0 ? 'active' : ''}`} id={`l5-tab-header-${aud.id}`} data-target={aud.id}>
                  <span>{aud.file}</span>
                  <span class="close-btn">×</span>
                </div>
              ))}
            </div>

            <div class="l5-editor-body">
              {audiences.map((aud, index) => (
                <div class={`l5-editor-content ${index === 0 ? 'active' : ''}`} id={`l5-editor-${aud.id}`}>
                  <div class="line-numbers">
                    {Array.from({ length: 14 }).map((_, i) => (
                      <span>{i + 1}</span>
                    ))}
                  </div>
                  <pre class="code-highlight"><code>
{aud.lang === 'python' ? (
`# ${aud.label} Configuration
import buddy_runtime as buddy

class ${aud.label.replace(/\s+/g, '')}Workspace:
    def __init__(self):
        self.objective = "${aud.title}"
        self.description = "${aud.description}"
        self.features = [
            "${aud.features[0]}",
            "${aud.features[1]}",
            "${aud.features[2]}"
        ]

    def load_environment(self):
        return buddy.Sandbox(self.features)`
) : aud.lang === 'markdown' ? (
`# ${aud.label} Mode

## ${aud.title}

${aud.description}

### Core Tooling
* **Reader**: ${aud.features[0]}
* **Excalidraw**: ${aud.features[1]}
* **Notes**: ${aud.features[2]}`
) : (
`# yaml-language-server: $schema=buddy-schema
cohort: "${aud.label}"
action: "${aud.title}"
details: "${aud.description}"
deliverables:
  - "${aud.features[0]}"
  - "${aud.features[1]}"
  - "${aud.features[2]}"`
)}
                  </code></pre>
                </div>
              ))}
            </div>

            <div class="l5-console-pane">
              <div class="l5-console-header">
                <span class="console-title">🖥️ LIVE COMPILER RUNTIME</span>
                <span class="console-status">CONNECTED</span>
              </div>
              <div class="l5-console-body">
                {audiences.map((aud, index) => (
                  <div class={`l5-console-output ${index === 0 ? 'active' : ''}`} id={`l5-console-${aud.id}`}>
                    <div class="console-logs">
                      <p class="log-info">[system] Initializing {aud.file}...</p>
                      <p class="log-success">[system] Workspace ready!</p>
                    </div>
                    <div class="l5-console-visual">
                      <div class="l5-c-frame">
                        <Image src={aud.bg} alt={aud.label} class="l5-c-bg" />
                        <Image src={aud.mascot} alt="" class="l5-c-mascot" />
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ==========================================
         LAYOUT 3: HOVER DRAWER ACCORDION (formerly 6)
         ========================================== -->
    <section id="layout-3" class="layout-section">
      <div class="container">
        <div class="layout-intro text-center">
          <span class="badge">Layout 03: Hover Drawer Accordion</span>
          <h2 class="prototype-heading">Built for how you learn</h2>
          <p class="prototype-subheading">Vertical panels that expand horizontally on hover, giving a highly dynamic spatial focus.</p>
        </div>

        <div class="l6-accordion-container">
          {audiences.map((aud, index) => (
            <div class={`l6-drawer ${index === 0 ? 'active' : ''}`} style={`--drawer-accent: ${aud.accent}; --drawer-glow: ${aud.glow};`}>
              <div class="l6-collapsed-header">
                <span class="l6-vertical-num">{aud.num}</span>
                <h3 class="l6-vertical-title">{aud.label}</h3>
              </div>
              <div class="l6-expanded-content">
                <div class="l6-grid">
                  <div class="l6-info">
                    <span class="l6-tag" style={`color: ${aud.accent}; background-color: ${aud.glow};`}>{aud.label}</span>
                    <h4 class="l6-title">{aud.title}</h4>
                    <p class="l6-desc">{aud.description}</p>
                    <ul class="l6-features">
                      {aud.features.map(feat => (
                        <li>
                          <span class="bullet" style={`background-color: ${aud.accent};`}></span>
                          <span>{feat}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                  <div class="l6-visual">
                    <div class="l6-img-frame">
                      <Image src={aud.bg} alt={aud.label} class="l6-bg-img" />
                      <Image src={aud.mascot} alt="" class="l6-mascot" />
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ==========================================
         LAYOUT 4: RETRO WINDOW CASCADES (formerly 11)
         ========================================== -->
    <section id="layout-4" class="layout-section">
      <div class="container">
        <div class="layout-intro text-center">
          <span class="badge">Layout 04: Retro Window Cascades</span>
          <h2 class="prototype-heading">Built for how you learn</h2>
          <p class="prototype-subheading">A nostalgic operating system layout. Click desktop window header bars to pull workspaces to front.</p>
        </div>

        <div class="l11-desktop-workspace">
          <div class="l11-icon-sidebar">
            {audiences.map((aud) => (
              <div class="l11-file-shortcut" data-open={aud.id}>
                <div class="shortcut-icon" style={`background-color: ${aud.accent}1c; border-color: ${aud.accent}55;`}>
                  {aud.icon}
                </div>
                <span class="shortcut-name">{aud.file}</span>
              </div>
            ))}
          </div>

          <div class="l11-windows-container">
            {audiences.map((aud, index) => (
              <div 
                class="l11-window" 
                id={`l11-win-${aud.id}`} 
                style={`--win-accent: ${aud.accent}; --index: ${index}; z-index: ${10 + index}; top: ${40 + index*35}px; left: ${40 + index*40}px;`}
              >
                <div class="l11-title-bar">
                  <div class="l11-win-ctrls">
                    <span class="ctrl-dot red"></span>
                    <span class="ctrl-dot yellow"></span>
                    <span class="ctrl-dot green"></span>
                  </div>
                  <span class="l11-win-title">{aud.osWindow}</span>
                  <div class="l11-win-status">ACTIVE</div>
                </div>
                
                <div class="l11-win-body">
                  <div class="l11-win-grid">
                    <div class="l11-win-text">
                      <span class="l11-tag" style={`border-color: ${aud.accent}; color: ${aud.accent};`}>{aud.label}</span>
                      <h3 class="l11-title">{aud.title}</h3>
                      <p class="l11-desc">{aud.description}</p>
                      
                      <div class="l11-bullets">
                        {aud.features.map(f => (
                          <div class="l11-bullet-row">
                            <span class="bullet" style={`background-color: ${aud.accent};`}></span>
                            <span>{f}</span>
                          </div>
                        ))}
                      </div>
                    </div>
                    <div class="l11-win-media">
                      <div class="l11-card-mockup">
                        <Image src={aud.bg} alt={aud.label} class="l11-m-bg" />
                        <Image src={aud.mascot} alt="" class="l11-m-mascot" />
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ==========================================
         LAYOUT 5: STUDIO MIXER CONSOLE (formerly 12)
         ========================================== -->
    <section id="layout-5" class="layout-section">
      <div class="container">
        <div class="layout-intro text-center">
          <span class="badge">Layout 05: Studio Mixer Interface</span>
          <h2 class="prototype-heading">Built for how you learn</h2>
          <p class="prototype-subheading">Adjust faders or click channels to crossfade details and active visual layouts on the mixing console.</p>
        </div>

        <div class="l12-mixer-deck">
          <div class="l12-channel-strips">
            {audiences.map((aud, index) => (
              <div class={`l12-strip ${index === 0 ? 'active' : ''}`} data-index={index} data-target={aud.id} style={`--ch-accent: ${aud.accent};`}>
                <div class="l12-strip-header">
                  <span class="ch-num">{aud.num}</span>
                  <span class="ch-name">{aud.label.replace('For ', '')}</span>
                </div>
                
                <div class="l12-fader-track">
                  <div class="fader-db-ticks">
                    <span>+10</span><span>+5</span><span>0</span><span>-5</span><span>-10</span><span>-20</span><span>-∞</span>
                  </div>
                  <div class="l12-fader-knob" style={`bottom: ${index === 0 ? '80%' : '10%'};`}>
                    <span class="knob-line"></span>
                  </div>
                </div>

                <div class="l12-mute-solo">
                  <button class="btn-solo active">MUTE</button>
                  <button class="btn-select">SEL</button>
                </div>
              </div>
            ))}
          </div>

          <div class="l12-mixer-monitor">
            {audiences.map((aud, index) => (
              <div class={`l12-monitor-screen ${index === 0 ? 'active' : ''}`} id={`l12-monitor-${aud.id}`} style={`--m-accent: ${aud.accent};`}>
                <div class="l12-mon-grid">
                  <div class="l12-mon-info">
                    <span class="l12-mon-badge" style={`background-color: ${aud.accent}12; border-color: ${aud.accent}33; color: ${aud.accent};`}>{aud.label}</span>
                    <h3 class="l12-mon-title">{aud.title}</h3>
                    <p class="l12-mon-desc">{aud.description}</p>
                    <ul class="l12-mon-features">
                      {aud.features.map(f => (
                        <li>
                          <span class="bullet" style={`background-color: ${aud.accent};`}></span>
                          <span>{f}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                  <div class="l12-mon-visual">
                    <div class="l12-mon-frame">
                      <Image src={aud.bg} alt={aud.label} class="l12-bg" />
                      <Image src={aud.mascot} alt="" class="l12-mascot" />
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ==========================================
         LAYOUT 6: RETRO ROTARY DIAL (NEW)
         ========================================== -->
    <section id="layout-6" class="layout-section">
      <div class="container">
        <div class="layout-intro text-center">
          <span class="badge">Layout 06: Retro Rotary Phone Dial</span>
          <h2 class="prototype-heading">Built for how you learn</h2>
          <p class="prototype-subheading">A playful rotary phone interface. Spin the dial to pull a cohort stream onto the vintage display.</p>
        </div>

        <div class="l6-rotary-grid">
          <div class="l6-rotary-left">
            <div class="l6-rotary-phone">
              <div class="rotary-face" id="rotary-dialer">
                <div class="rotary-center">
                  <span class="center-brand">BUDDY</span>
                </div>
                {audiences.map((aud, index) => {
                  const angles = [45, 135, 225]
                  const angle = angles[index]
                  return (
                    <button 
                      class={`rotary-hole ${index === 0 ? 'active' : ''}`} 
                      data-target={aud.id} 
                      data-angle={angle}
                      style={`transform: rotate(${angle}deg) translate(95px) rotate(-${angle}deg); --hole-accent: ${aud.accent};`}
                    >
                      <span class="num">{index + 1}</span>
                    </button>
                  )
                })}
              </div>
            </div>
          </div>

          <div class="l6-rotary-right">
            <div class="l6-retro-crt">
              <div class="crt-glare"></div>
              <div class="crt-content">
                {audiences.map((aud, index) => (
                  <div class={`l6-crt-panel ${index === 0 ? 'active' : ''}`} id={`l6-crt-${aud.id}`} style={`--crt-accent: ${aud.accent};`}>
                    <div class="crt-header">COHORT_MODE: {aud.label.toUpperCase()}</div>
                    <h3 class="crt-title">{aud.title}</h3>
                    <p class="crt-desc">{aud.description}</p>
                    <div class="crt-screen-mockup">
                      <Image src={aud.bg} alt="" class="crt-mock-bg" />
                      <Image src={aud.mascot} alt="" class="crt-mock-mascot" />
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ==========================================
         LAYOUT 7: INTERACTIVE CHAT SHELL (NEW)
         ========================================== -->
    <section id="layout-7" class="layout-section">
      <div class="container">
        <div class="layout-intro text-center">
          <span class="badge">Layout 07: Command Shell Terminal</span>
          <h2 class="prototype-heading">Built for how you learn</h2>
          <p class="prototype-subheading">A mock chat console where entering queries activates specialized workspaces.</p>
        </div>

        <div class="l7-shell-frame">
          <div class="l7-shell-sidebar">
            <span class="sb-title">SELECT PROMPT</span>
            <div class="prompt-suggestions">
              {audiences.map((aud) => (
                <button class="prompt-btn" data-target={aud.id} data-prompt={`/workspace load ${aud.id}`}>
                  <span class="arrow">&gt;</span> /load {aud.id}
                </button>
              ))}
            </div>
          </div>

          <div class="l7-shell-console">
            <div class="console-screen" id="l7-console-screen">
              <p class="system-line">[system] Initializing Buddy shell agent v1.0.4...</p>
              <p class="system-line">[system] Ready. Click prompt buttons on the left to execute commands.</p>
              
              <!-- Logs appended dynamically by JS -->
            </div>
            
            <div class="console-input-bar">
              <span class="prompt-prefix">buddy@local:~$</span>
              <input type="text" id="l7-console-input" class="console-input" readonly placeholder="Click a suggestions button to type..." />
              <span class="cursor-blink">_</span>
            </div>
          </div>

          <div class="l7-shell-output-preview">
            <div class="preview-header">RENDER SCREEN</div>
            <div class="preview-stage" id="l7-shell-preview-box">
              {audiences.map((aud, index) => (
                <div class={`l7-shell-img-card ${index === 0 ? 'active' : ''}`} id={`l7-shell-img-${aud.id}`}>
                  <Image src={aud.bg} alt="" class="l7-sh-bg" />
                  <Image src={aud.mascot} alt="" class="l7-sh-mascot" />
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ==========================================
         LAYOUT 8: VENN INTERSECTION DIAGRAM (NEW)
         ========================================== -->
    <section id="layout-8" class="layout-section">
      <div class="container">
        <div class="layout-intro text-center">
          <span class="badge">Layout 08: Venn Intersection Graph</span>
          <h2 class="prototype-heading">Built for how you learn</h2>
          <p class="prototype-subheading">Hover intersection circles or nodes to reveal corresponding cohort modules.</p>
        </div>

        <div class="l8-venn-layout">
          <div class="l8-venn-graphics">
            <div class="venn-diagram-wrapper">
              <div class="venn-circle c1" id="venn-c-students" style="--v-accent: #ff6b00; --v-glow: rgba(255,107,0,0.12)">
                <span class="v-label">ACADEMIC</span>
              </div>
              <div class="venn-circle c2" id="venn-c-learners" style="--v-accent: #2dd4bf; --v-glow: rgba(45,212,191,0.12)">
                <span class="v-label">RESEARCH</span>
              </div>
              <div class="venn-circle c3" id="venn-c-educators" style="--v-accent: #f59e0b; --v-glow: rgba(245,158,11,0.12)">
