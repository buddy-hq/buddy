                      <span>{f}</span>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ==========================================
         LAYOUT 9: WAVEFORM TRACK VISUALIZER (NEW)
         ========================================== -->
    <section id="layout-9" class="layout-section">
      <div class="container">
        <div class="layout-intro text-center">
          <span class="badge">Layout 09: Audio Waveform Tracks</span>
          <h2 class="prototype-heading">Built for how you learn</h2>
