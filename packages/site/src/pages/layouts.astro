                <div class="track-header">
                  <span class="track-play-btn">▶</span>
                  <span class="track-title">{aud.label}</span>
                </div>
                
                <div class="track-visualizer">
                  {Array.from({ length: 48 }).map(() => {
                    const h = Math.floor(Math.random() * 28) + 6
                    return <span class="wave-bar" style={`height: ${h}px;`}></span>
                  })}
                </div>
              </div>
            ))}
          </div>

          <div class="l9-wave-output">
