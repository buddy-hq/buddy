---
/**
 * Easel prototype — Free section: round 5, designed against its neighbours.
 *
 * Two facts, nothing else:
 *   1. Buddy costs nothing.
 *   2. Because you bring your own keys, logins, or local models.
 *
 * What actually made the Billboard feel off — it isn't the zero. On the page
 * this section sits here:
 *
 *   LearnerCapabilities  →  [this section]  →  InstallSection
 *   centred header,          ???                centred, 4.5rem title,
 *   scrolling marquee                          download buttons
 *
 * The Billboard is a third centred slab in a row, and its display type competes
 * with the 4.5rem install title sitting directly beneath it. Two hero-scale
 * centred moments back to back — the page has nowhere to breathe between them.
 *
 * So every direction here is left-set or asymmetric, and none exceeds the
 * answers-headline scale (~3rem). They also differ in height, because that's
 * the other half of the rhythm question.
 *
 * A marquee is deliberately absent: it would duplicate the section above.
 *
 * N — Split      · medium height · statement left, app screen right
 * O — The bill   · medium height · left-set ledger, keeps the zero
 * P — Lockup     · low height    · one line, provider marks set inline
 *
 * Each is rendered between stubs of its real neighbours so the rhythm is
 * judgeable in place.
 */

import ollamaIcon from "../../assets/ollama-icon.svg?raw"

const OPENAI_PATH =
  "M22.2819 9.8211a5.9847 5.9847 0 0 0-.5157-4.9108 6.0462 6.0462 0 0 0-6.5098-2.9A6.0651 6.0651 0 0 0 4.9807 4.1818a5.9847 5.9847 0 0 0-3.9977 2.9 6.0462 6.0462 0 0 0 .7427 7.0966 5.98 5.98 0 0 0 .511 4.9107 6.051 6.051 0 0 0 6.5146 2.9001A5.9847 5.9847 0 0 0 13.2599 24a6.0557 6.0557 0 0 0 5.7718-4.2058 5.9894 5.9894 0 0 0 3.9977-2.9001 6.0557 6.0557 0 0 0-.7475-7.0729zm-9.022 12.6081a4.4755 4.4755 0 0 1-2.8764-1.0408l.1419-.0804 4.7783-2.7582a.7948.7948 0 0 0 .3927-.6813v-6.7369l2.02 1.1686a.071.071 0 0 1 .038.052v5.5826a4.504 4.504 0 0 1-4.4945 4.4944zm-9.6607-4.1254a4.4708 4.4708 0 0 1-.5346-3.0137l.142.0852 4.783 2.7582a.7712.7712 0 0 0 .7806 0l5.8428-3.3685v2.3324a.0804.0804 0 0 1-.0332.0615L9.74 19.9502a4.4992 4.4992 0 0 1-6.1408-1.6464zM2.3408 7.8956a4.485 4.485 0 0 1 2.3655-1.9728V11.6a.7664.7664 0 0 0 .3879.6765l5.8144 3.3543-2.0201 1.1685a.0757.0757 0 0 1-.071 0l-4.8303-2.7865A4.504 4.504 0 0 1 2.3408 7.8956zm16.5963 3.8558L13.1038 8.364l2.0201-1.1638a.0757.0757 0 0 1 .071 0l4.8303 2.7913a4.4944 4.4944 0 0 1-.6765 8.1042v-5.6772a.79.79 0 0 0-.407-.667zm2.0107-3.0231l-.142-.0852-4.7735-2.7818a.7759.7759 0 0 0-.7854 0L9.409 9.2297V6.8974a.0662.0662 0 0 1 .0284-.0615l4.8303-2.7866a4.4992 4.4992 0 0 1 6.6802 4.66zM8.3065 12.863l-2.02-1.1638a.0804.0804 0 0 1-.038-.0567V6.0742a4.4992 4.4992 0 0 1 7.3757-3.4537l-.142.0805L8.704 5.459a.7948.7948 0 0 0-.3927.6813zm1.0976-2.3654l2.602-1.4998 2.6069 1.4998v2.9994l-2.5974 1.4997-2.6067-1.4997z"

/** Stand-in for the marquee above — static, just enough to read the rhythm. */
const ABOVE_CHIPS = ["Ebook reader", "Whiteboards", "Research", "Simulations", "Flashcards"] as const
---

<div class="easel">
  <p class="legend">
    Round 5 — designed against the neighbours. Above is Capabilities (centred header + scrolling
    marquee); below is Install (centred, 4.5rem title). So each direction here is
    <b>left-set</b>, stays <b>under 3rem</b>, and differs in <b>height</b>. Neighbour stubs are
    rendered around each one so the rhythm is judgeable in place.
  </p>

  <!-- ═══ N — Split ═════════════════════════════════════════════════════
       Text left, app screen right. The picture carries fact 2, so there is
       no list to read. Asymmetric, which is the strongest possible contrast
       against the two centred sections it sits between.
       ═════════════════════════════════════════════════════════════════ -->
  <section class="direction">
    <header class="direction-head">
      <h2 class="direction-label">N</h2>
      <div>
        <h3 class="direction-name">Split · medium height</h3>
        <p class="direction-desc">
          Statement left, the real provider screen right. Fact 2 is shown, not described — 5 words
          of prose in the whole section.
        </p>
      </div>
    </header>

    <div class="page-mock">
      <section class="stub stub-above">
        <div class="mock-container">
          <h3 class="stub-head">There's more in the box.</h3>
          <div class="stub-chips">
            {ABOVE_CHIPS.map((chip) => <span class="stub-chip">{chip}</span>)}
          </div>
        </div>
      </section>
      <hr class="mock-hr" />

      <section class="mock-section">
        <div class="mock-container">
          <div class="n-layout">
            <div class="n-text">
              <span class="site-eyebrow">No catch</span>
              <h2 class="n-head">Free. You bring the AI.</h2>
            </div>

            <div class="n-window">
              <div class="win-bar">
                <span class="win-dots"><i></i><i></i><i></i></span>
                <span class="win-title">Connect your AI</span>
              </div>
              <ul class="win-list">
                <li class="win-item">
                  <span class="win-icon">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d={OPENAI_PATH}></path></svg>
                  </span>
                  <span class="win-name">ChatGPT</span>
                  <span class="win-state">Log in</span>
                </li>
                <li class="win-item">
                  <span class="win-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M19 11v6"></path>
                      <path d="M19 13h2"></path>
                      <path d="M2 21a8 8 0 0 1 12.868-6.349"></path>
                      <circle cx="10" cy="8" r="5"></circle>
                      <circle cx="19" cy="19" r="2"></circle>
                    </svg>
                  </span>
                  <span class="win-name">API key</span>
                  <span class="win-state">Paste</span>
                </li>
                <li class="win-item">
                  <span class="win-icon win-icon-raw" set:html={ollamaIcon} />
                  <span class="win-name">Ollama</span>
                  <span class="win-state">On your machine</span>
                </li>
                <li class="win-item">
                  <span class="win-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 7v14"></path>
                      <path d="M20 11v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-8"></path>
                      <path d="M7.5 7a1 1 0 0 1 0-5A4.8 8 0 0 1 12 7a4.8 8 0 0 1 4.5-5 1 1 0 0 1 0 5"></path>
                      <rect x="3" y="7" width="18" height="4" rx="1"></rect>
                    </svg>
                  </span>
                  <span class="win-name">Free models</span>
                  <span class="win-state win-state-on">Ready</span>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <hr class="mock-hr" />
      <section class="stub stub-below">
        <div class="mock-container">
          <h3 class="stub-install">Whatever you're learning,<br />bring it home.</h3>
          <div class="stub-buttons"><span></span><span></span></div>
        </div>
      </section>
    </div>
  </section>

  <!-- ═══ O — The bill ══════════════════════════════════════════════════
       Both facts in one depicted object, the way LearnerLives depicts a quiz
       or a flashcard. The zero stays the anchor but sits left, so it reads as
       a ledger entry rather than a second install headline.
       ═════════════════════════════════════════════════════════════════ -->
  <section class="direction">
    <header class="direction-head">
      <h2 class="direction-label">O</h2>
      <div>
        <h3 class="direction-name">The bill · medium height</h3>
        <p class="direction-desc">
          Both facts in one object. The zero is still the anchor — just left-set, so it stops
          fighting the install title below it.
        </p>
      </div>
    </header>

    <div class="page-mock">
      <section class="stub stub-above">
        <div class="mock-container">
          <h3 class="stub-head">There's more in the box.</h3>
          <div class="stub-chips">
            {ABOVE_CHIPS.map((chip) => <span class="stub-chip">{chip}</span>)}
          </div>
        </div>
      </section>
      <hr class="mock-hr" />

      <section class="mock-section">
        <div class="mock-container">
          <div class="o-layout">
            <dl class="o-bill">
              <div class="o-line">
                <dt>The app</dt>
                <dd>$0</dd>
              </div>
              <div class="o-line">
                <dt>The AI</dt>
                <dd class="o-yours">yours</dd>
              </div>
            </dl>
            <p class="o-note">Your login, your key, or your own machine.</p>
          </div>
        </div>
      </section>

      <hr class="mock-hr" />
      <section class="stub stub-below">
        <div class="mock-container">
          <h3 class="stub-install">Whatever you're learning,<br />bring it home.</h3>
          <div class="stub-buttons"><span></span><span></span></div>
        </div>
      </section>
    </div>
  </section>

  <!-- ═══ P — Lockup ════════════════════════════════════════════════════
       One left-set line, provider marks set inline as part of the sentence.
       Almost no height — which is the point. It gives the page a breath
       between the marquee above and the install title below instead of
       adding a third full-weight section.
       ═════════════════════════════════════════════════════════════════ -->
  <section class="direction">
    <header class="direction-head">
      <h2 class="direction-label">P</h2>
      <div>
        <h3 class="direction-name">Lockup · low height</h3>
        <p class="direction-desc">
          One line. The marks are the sentence's object. Adds a breath between two big centred
          sections instead of a third heavy one — 6 words total.
        </p>
      </div>
    </header>

    <div class="page-mock">
      <section class="stub stub-above">
        <div class="mock-container">
          <h3 class="stub-head">There's more in the box.</h3>
          <div class="stub-chips">
            {ABOVE_CHIPS.map((chip) => <span class="stub-chip">{chip}</span>)}
          </div>
        </div>
      </section>
      <hr class="mock-hr" />

      <section class="mock-section mock-section-tight">
        <div class="mock-container">
          <p class="p-lockup">
            <span class="p-free">Free.</span>
            <span class="p-rest">You bring the AI</span>
            <span class="p-marks" aria-hidden="true">
              <span class="p-mark">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d={OPENAI_PATH}></path></svg>
              </span>
              <span class="p-mark">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M19 11v6"></path>
                  <path d="M19 13h2"></path>
                  <path d="M2 21a8 8 0 0 1 12.868-6.349"></path>
                  <circle cx="10" cy="8" r="5"></circle>
                  <circle cx="19" cy="19" r="2"></circle>
                </svg>
              </span>
              <span class="p-mark p-mark-raw" set:html={ollamaIcon} />
            </span>
            <span class="p-sr">— your ChatGPT login, an API key, or local models.</span>
          </p>
        </div>
      </section>

      <hr class="mock-hr" />
      <section class="stub stub-below">
        <div class="mock-container">
          <h3 class="stub-install">Whatever you're learning,<br />bring it home.</h3>
          <div class="stub-buttons"><span></span><span></span></div>
        </div>
      </section>
    </div>
  </section>
</div>

<style>
  /* ═══ Easel shell ═══ */
  .easel {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .legend {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.55;
    color: oklch(0.62 0 0);
    max-width: 88ch;
  }

  .legend b {
    color: oklch(0.88 0 0);
    font-weight: 600;
  }

  .direction {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .direction + .direction {
    margin-top: 0.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid oklch(1 0 0 / 8%);
  }

  .direction-head {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .direction-label {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    display: grid;
    place-items: center;
    border-radius: 6px;
    background: oklch(1 0 0 / 8%);
    color: oklch(0.92 0 0);
    font-size: 0.8125rem;
    font-weight: 650;
    margin: 0;
  }

  .direction-name {
    font-size: 0.875rem;
    font-weight: 600;
    color: oklch(0.95 0 0);
    margin: 0;
  }

  .direction-desc {
    margin: 2px 0 0;
    font-size: 0.75rem;
    line-height: 1.45;
    color: oklch(0.6 0 0);
    max-width: 84ch;
  }

  /* ═══ Page mock ═══ */
  .page-mock {
    background: var(--surface-page, oklch(0.16 0 0));
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid oklch(1 0 0 / 6%);
  }

  .mock-section {
    padding: var(--space-24, 6rem) 0;
  }

  .mock-section-tight {
    padding: var(--space-12, 3rem) 0;
  }

  .mock-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-6, 1.5rem);
  }

  .mock-hr {
    border: none;
    border-top: 1px solid var(--border, var(--border-base));
    margin: 0 auto;
    max-width: 1200px;
  }

  .site-eyebrow {
    display: block;
    font-family: var(--font-mono, "Geist Mono", monospace);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent-primary, var(--accent-fill));
    margin-bottom: var(--space-5, 1.25rem);
  }

  /* ═══ Neighbour stubs — the sections above and below, in miniature ═══ */
  .stub {
    padding: var(--space-12, 3rem) 0;
    opacity: 0.72;
  }

  .stub-head,
  .stub-install {
    font-family: var(--font-display, "Geist", sans-serif);
    font-weight: 510;
    letter-spacing: -0.022em;
    color: var(--color-text-primary, var(--fg-strong));
    text-align: center;
    margin: 0;
  }

  .stub-head {
    font-size: 1.5rem;
    line-height: 1.2;
  }

  /* The install title is the thing this section must not compete with —
     rendered at its real relative weight, just scaled for the mock. */
  .stub-install {
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    line-height: 1;
  }

  .stub-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3, 0.75rem);
    margin-top: var(--space-6, 1.5rem);
  }

  .stub-chip {
    font-family: var(--font-display, "Geist", sans-serif);
    font-size: 0.9375rem;
    font-weight: 510;
    color: var(--color-text-primary, var(--fg-strong));
    background-color: var(--accent-weak);
    border: 1px solid var(--accent-border);
    border-radius: 999px;
    padding: 8px 18px;
    white-space: nowrap;
  }

  .stub-buttons {
    display: flex;
    justify-content: center;
    gap: var(--space-4, 1rem);
    margin-top: var(--space-8, 2rem);
  }

  .stub-buttons span {
    width: 132px;
    height: 38px;
    border-radius: var(--radius, 0.625rem);
    background-color: var(--invert-fill);
    opacity: 0.9;
  }

  /* ═══════════════════════════════════════════
     N — Split
     ═══════════════════════════════════════════ */
  .n-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 460px);
    gap: var(--space-16, 4rem);
    align-items: center;
  }

  .n-head {
    font-family: var(--font-display, "Geist", sans-serif);
    font-size: clamp(1.875rem, 3.5vw, 3rem);
    font-weight: 510;
    line-height: 1.1;
    letter-spacing: -0.024em;
    color: var(--color-text-primary, var(--fg-strong));
    max-width: 14ch;
    text-wrap: balance;
    margin: 0;
  }

  @media (max-width: 900px) {
    .n-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-8, 2rem);
    }
  }

  /* Shared app-window chrome */
  .n-window {
    width: 100%;
    background-color: var(--chrome-panel);
    border: 1px solid var(--border, var(--border-base));
    border-radius: calc(var(--radius, 0.625rem) + 2px);
    overflow: hidden;
    box-shadow: var(--shadow-raised);
  }

  .win-bar {
    display: flex;
    align-items: center;
    gap: var(--space-3, 0.75rem);
    height: 34px;
    padding-inline: 14px;
    background-color: var(--chrome-bar);
    border-bottom: 1px solid var(--border, var(--border-base));
  }

  .win-dots {
    display: flex;
    gap: 6px;
  }

  .win-dots i {
    width: 6.5px;
    height: 6.5px;
    border-radius: 50%;
    background-color: var(--border-base);
  }

  .win-title {
    font-family: var(--font-mono, "Geist Mono", monospace);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted, var(--fg-weaker));
  }

  .win-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .win-item {
    display: flex;
    align-items: center;
    gap: var(--space-3, 0.75rem);
    padding: var(--space-4, 1rem) var(--space-5, 1.25rem);
  }

  .win-item + .win-item {
    border-top: 1px solid var(--border, var(--border-base));
  }

  .win-icon {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    color: var(--color-text-secondary, var(--fg-base));
  }

  .win-icon svg {
    width: 20px;
    height: 20px;
  }

  .win-icon-raw :global(svg) {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  .win-name {
    flex: 1;
    min-width: 0;
    font-family: var(--font-display, "Geist", sans-serif);
    font-size: 0.9375rem;
    font-weight: 550;
    color: var(--color-text-primary, var(--fg-strong));
  }

  .win-state {
    flex: 0 0 auto;
    font-family: var(--font-mono, "Geist Mono", monospace);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted, var(--fg-weaker));
  }

  .win-state-on {
    color: var(--accent-base);
  }

  @media (max-width: 576px) {
    .win-item {
      padding: var(--space-3, 0.75rem) var(--space-4, 1rem);
    }
  }

  /* ═══════════════════════════════════════════
     O — The bill
     ═══════════════════════════════════════════ */
  .o-bill {
    width: 100%;
    max-width: 620px;
    margin: 0;
  }

  .o-line {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-6, 1.5rem);
    padding-block: var(--space-4, 1rem);
  }

  .o-line + .o-line {
    border-top: 1px solid var(--border, var(--border-base));
  }

  .o-line dt {
    font-family: var(--font-mono, "Geist Mono", monospace);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted, var(--fg-weaker));
  }

  .o-line dd {
    margin: 0;
    font-family: var(--font-display, "Geist", sans-serif);
    font-size: clamp(2.75rem, 7vw, 4.5rem);
    font-weight: 510;
    line-height: 0.95;
    letter-spacing: -0.036em;
    color: var(--color-text-primary, var(--fg-strong));
    font-variant-numeric: tabular-nums;
  }

  .o-yours {
    color: var(--accent-base);
  }

  .o-note {
    font-family: var(--font-body, "Geist", sans-serif);
    font-size: 1.0625rem;
    font-weight: 300;
    letter-spacing: -0.011em;
    color: var(--color-text-secondary, var(--fg-base));
    margin: var(--space-6, 1.5rem) 0 0;
  }

  @media (max-width: 576px) {
    .o-note {
      font-size: 0.9375rem;
    }
  }

  /* ═══════════════════════════════════════════
     P — Lockup
     ═══════════════════════════════════════════ */
  .p-lockup {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3, 0.75rem);
    font-family: var(--font-display, "Geist", sans-serif);
    font-size: clamp(1.375rem, 3vw, 2.25rem);
    font-weight: 510;
    line-height: 1.2;
    letter-spacing: -0.022em;
    color: var(--color-text-primary, var(--fg-strong));
    margin: 0;
  }

  .p-rest {
    color: var(--color-text-secondary, var(--fg-base));
  }

  .p-marks {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3, 0.75rem);
    margin-left: var(--space-1, 0.25rem);
  }

  .p-mark {
    display: grid;
    place-items: center;
    width: 1em;
    height: 1em;
    color: var(--color-text-primary, var(--fg-strong));
  }

  .p-mark svg {
    width: 100%;
    height: 100%;
  }

  .p-mark-raw :global(svg) {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  /* The marks carry meaning visually; keep the words for screen readers. */
  .p-sr {
