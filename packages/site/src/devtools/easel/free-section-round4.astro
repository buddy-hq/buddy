---
/**
 * Easel prototype — Free section: round 4, three fixes for the Billboard.
 *
 * The Billboard (round 3, direction D) had the right energy and the wrong
 * hierarchy. Diagnosis:
 *
 *   1. The biggest element carried the least information. "$0" is a glyph,
 *      not a statement — the eye lands on the loudest thing and learns
 *      nothing it didn't already suspect.
 *   2. Four tiers (eyebrow / number / subtext / mono chips) for two ideas.
 *      Every tier is a stop for the eye, so it reads as a list of four
 *      things instead of one claim.
 *   3. The chips are the actual proof, and they sit last at 11px uppercase
 *      mono — the least readable treatment on the page.
 *   4. "$0" sets a pricing frame, which makes the reader look for the tier
 *      above. Buddy's story is that there is no pricing model at all.
 *
 * Each direction below answers the same question differently: which of the
 * two ideas — "it's free" or "because you bring the AI" — gets the scale?
 *
 * H — "One Sentence": the claim gets the scale. Billboard geometry, words
 *     instead of a number, two tiers total.
 * I — "Hanging Reason": claim and reason share the frame. Asymmetric,
 *     left-set, options folded into prose so there is no chip tier at all.
 * J — "Marquee": the proof gets the scale. The ways you bring AI are the
 *     display type; "free" shrinks to a label.
 *
 * Copy alternates are listed under each direction — the wording is as much
 * of the fix as the layout is.
 */

const DIRECTIONS = [
  {
    key: "H",
    name: "One Sentence",
    thesis: "The claim gets the scale.",
    desc: "Billboard geometry — centred, breathing, one big thing. But the big thing is a sentence, so the loudest element is also the most informative. Two tiers, and the second tier is sentence-case body text instead of uppercase mono, so the proof is actually readable.",
    alts: [
      "Buddy is free. You bring the AI.",
      "Free forever. You bring the AI.",
      "It's free. The AI is yours.",
    ],
  },
  {
    key: "I",
    name: "Hanging Reason",
    thesis: "Claim and reason share the frame.",
    desc: "Left-set and asymmetric, which gives this section its own rhythm against the centred sections around it. The word carries the claim, the paragraph carries the reason, and the four options are folded into the prose — so the chip tier disappears entirely.",
    alts: [
      "Free. / No pricing page, no subscription…",
      "$0. / Not a trial, not a tier…",
      "Nothing. / There is no pricing page…",
    ],
  },
  {
    key: "J",
    name: "Marquee",
    thesis: "The proof gets the scale.",
    desc: "Inverts the Billboard. \"Free\" is the label; the ways you bring AI are the display type. This is the honest hierarchy if the differentiator is really the range of options rather than the price — and the lines are lifted from copy already in site.ts.",
    alts: [
      "Your ChatGPT. Your keys. Your local models.",
      "Your ChatGPT. Your keys. Your machine.",
      "Log in. Paste a key. Or run it local.",
    ],
  },
] as const
---

<div class="easel">
  <div class="easel-controls">
    <div class="legend">
      <span>Round 4 — three fixes for the Billboard's hierarchy</span>
      <span class="legend-dim">
        Same page-native tokens and type scale as round 3. Each direction answers the same
        question differently: which of the two ideas gets the scale?
      </span>
    </div>
  </div>

  <section class="diagnosis">
    <h2 class="diagnosis-title">Why the Billboard felt off</h2>
    <ol class="diagnosis-list">
      <li>
        <b>The biggest element carried the least information.</b> "$0" is a glyph, not a statement.
        The eye lands on the loudest thing and learns nothing new.
      </li>
      <li>
        <b>Four tiers for two ideas.</b> Eyebrow, number, subtext, chips. Every tier is a stop, so
        it reads as a list of four things rather than one claim.
      </li>
      <li>
        <b>The proof was buried.</b> The four options <em>are</em> the argument, and they sat last
        at 11px uppercase mono — the least readable treatment on the page.
      </li>
      <li>
        <b>"$0" sets a pricing frame.</b> The moment the reader thinks "price" they start hunting
        for the tier above. The story is that there is no pricing model at all.
      </li>
    </ol>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       DIRECTION H — "One Sentence"
       The Billboard, fixed. Same centred geometry and generous scale, but
       the display type is a sentence and the second tier is readable body
       copy rather than uppercase mono chips. Two tiers, full stop.
       ═══════════════════════════════════════════════════════════════════ -->
  <section class="direction">
    <header class="direction-head">
      <h2 class="direction-label">{DIRECTIONS[0].key}</h2>
      <div class="direction-meta">
        <h3 class="direction-name">
          {DIRECTIONS[0].name}
          <span class="direction-thesis">{DIRECTIONS[0].thesis}</span>
        </h3>
        <p class="direction-desc">{DIRECTIONS[0].desc}</p>
      </div>
    </header>

    <div class="page-mock">
      <section class="mock-section">
        <div class="mock-container">
          <div class="h-layout">
            <h2 class="h-head">
              <span class="h-line">Buddy is <span class="h-accent">free</span>.</span>
              <span class="h-line">You bring the AI.</span>
            </h2>
            <p class="h-sub">
              Your ChatGPT login, an API key, or local models — a few free ones included.
            </p>
          </div>
        </div>
      </section>
    </div>

    <ul class="copy-alts">
      {DIRECTIONS[0].alts.map((alt) => <li>{alt}</li>)}
    </ul>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       DIRECTION I — "Hanging Reason"
       Asymmetric and left-set. The big word hangs on the left, the reason
       sits beside it at body scale with the options folded into the
       sentence — no chips, no third tier. Bottom-aligned on desktop so the
       two blocks read as one composition rather than two stacked items.
       ═══════════════════════════════════════════════════════════════════ -->
  <section class="direction">
    <header class="direction-head">
      <h2 class="direction-label">{DIRECTIONS[1].key}</h2>
      <div class="direction-meta">
        <h3 class="direction-name">
          {DIRECTIONS[1].name}
          <span class="direction-thesis">{DIRECTIONS[1].thesis}</span>
        </h3>
        <p class="direction-desc">{DIRECTIONS[1].desc}</p>
      </div>
    </header>

    <div class="page-mock">
      <section class="mock-section">
        <div class="mock-container">
          <div class="i-layout">
            <h2 class="i-word">Free.</h2>
            <p class="i-reason">
              No pricing page, no subscription. You bring the AI you already have — your ChatGPT
              login, an API key, or models running on your own machine. A few are free out of the
              box, so you can start right now.
            </p>
          </div>
        </div>
      </section>
    </div>

    <ul class="copy-alts">
      {DIRECTIONS[1].alts.map((alt) => <li>{alt}</li>)}
    </ul>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       DIRECTION J — "Marquee"
       The inverse of the Billboard: the options are the display type and
       "free" is the label. Uses bringYourOwn.subtext and bringYourOwn.promo
       nearly verbatim — copy that already exists in site.ts and has never
       been rendered on the page.
       ═══════════════════════════════════════════════════════════════════ -->
  <section class="direction">
    <header class="direction-head">
      <h2 class="direction-label">{DIRECTIONS[2].key}</h2>
      <div class="direction-meta">
        <h3 class="direction-name">
          {DIRECTIONS[2].name}
          <span class="direction-thesis">{DIRECTIONS[2].thesis}</span>
        </h3>
        <p class="direction-desc">{DIRECTIONS[2].desc}</p>
      </div>
    </header>

    <div class="page-mock">
      <section class="mock-section">
        <div class="mock-container">
          <div class="j-layout">
            <span class="site-eyebrow">It's free</span>
            <h2 class="j-head">
              Your ChatGPT. Your keys. Your <span class="j-accent">local models</span>.
            </h2>
            <p class="j-sub">A few models are free out of the box.</p>
          </div>
        </div>
      </section>
    </div>

    <ul class="copy-alts">
      {DIRECTIONS[2].alts.map((alt) => <li>{alt}</li>)}
    </ul>
  </section>
</div>

<style>
  /* ═══ Easel shell ═══ */
  .easel {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .easel-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .legend {
    display: flex;
    flex-direction: column;
    font-size: 0.8125rem;
    color: oklch(0.85 0 0);
  }

  .legend-dim {
    color: oklch(0.6 0 0);
    max-width: 76ch;
  }

  /* ═══ Diagnosis note ═══ */
  .diagnosis {
    border: 1px solid oklch(1 0 0 / 8%);
    border-radius: 10px;
    padding: 1rem 1.25rem;
    background: oklch(1 0 0 / 2%);
  }

  .diagnosis-title {
    margin: 0 0 0.5rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: oklch(0.95 0 0);
  }

  .diagnosis-list {
    margin: 0;
    padding-left: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    font-size: 0.75rem;
    line-height: 1.5;
    color: oklch(0.66 0 0);
    max-width: 96ch;
  }

  .diagnosis-list b {
    color: oklch(0.86 0 0);
    font-weight: 600;
  }

  /* ═══ Direction wrappers ═══ */
  .direction {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .direction + .direction {
    margin-top: 0.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid oklch(1 0 0 / 8%);
  }

  .direction-head {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .direction-label {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    display: grid;
    place-items: center;
    border-radius: 6px;
    background: oklch(1 0 0 / 8%);
    color: oklch(0.92 0 0);
    font-size: 0.8125rem;
    font-weight: 650;
    margin: 0;
  }

  .direction-meta {
    min-width: 0;
  }

  .direction-name {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: oklch(0.95 0 0);
    margin: 0;
  }

  .direction-thesis {
    font-size: 0.75rem;
    font-weight: 400;
    color: oklch(0.7 0.19 41);
  }

  .direction-desc {
    margin: 2px 0 0;
    font-size: 0.75rem;
    line-height: 1.45;
    color: oklch(0.6 0 0);
    max-width: 82ch;
  }

  /* ═══ Copy alternates ═══ */
  .copy-alts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .copy-alts::before {
    content: "Copy";
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: oklch(0.5 0 0);
    align-self: center;
    margin-right: 0.25rem;
  }

  .copy-alts li {
    font-size: 0.6875rem;
    line-height: 1.3;
    color: oklch(0.72 0 0);
    border: 1px solid oklch(1 0 0 / 10%);
    border-radius: 999px;
    padding: 4px 10px;
  }

  /* ═══ Page mock — renders at the same width/padding as the real site ═══ */
  .page-mock {
    background: var(--surface-page, oklch(0.16 0 0));
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid oklch(1 0 0 / 6%);
  }

  .mock-section {
    padding: var(--space-24, 6rem) 0;
  }

  .mock-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-6, 1.5rem);
  }

  /* ═══ Shared: the mono eyebrow used across the real site ═══ */
  .site-eyebrow {
    font-family: var(--font-mono, "Geist Mono", monospace);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent-primary, var(--accent-fill));
  }

  /* ═══════════════════════════════════════════
     H — One Sentence
     Billboard geometry at install-title scale.
     Two tiers: the sentence, and one readable
     line of proof. Nothing else.
     ═══════════════════════════════════════════ */
  .h-layout {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .h-head {
    font-family: var(--font-display, "Geist", sans-serif);
    font-size: clamp(2rem, 7.5vw, 4.5rem);
    font-weight: 510;
    line-height: 1.03;
    letter-spacing: -0.028em;
    color: var(--color-text-primary, var(--fg-strong));
    margin: 0;
    text-wrap: balance;
  }

  .h-line {
    display: block;
  }

  .h-accent {
    color: var(--accent-base, var(--color-accent-secondary));
  }

  .h-sub {
    font-family: var(--font-body, "Geist", sans-serif);
    font-size: clamp(1.0625rem, 1.6vw, 1.3125rem);
    font-weight: 300;
    line-height: 1.55;
    letter-spacing: -0.011em;
    color: var(--color-text-secondary, var(--fg-base));
    max-width: 48ch;
    text-wrap: pretty;
    margin: var(--space-6, 1.5rem) 0 0;
  }

  @media (max-width: 576px) {
    .h-sub {
      font-size: 1rem;
      margin-top: var(--space-5, 1.25rem);
    }
  }

  /* ═══════════════════════════════════════════
     I — Hanging Reason
     Asymmetric, left-set, bottom-aligned so the
     two blocks read as one composition.
     ═══════════════════════════════════════════ */
  .i-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: var(--space-16, 4rem);
    align-items: end;
  }

  .i-word {
    font-family: var(--font-display, "Geist", sans-serif);
    font-size: clamp(3.5rem, 9vw, 7rem);
    font-weight: 510;
    line-height: 0.88;
    letter-spacing: -0.04em;
    color: var(--color-text-primary, var(--fg-strong));
    margin: 0;
  }

  .i-reason {
    font-family: var(--font-body, "Geist", sans-serif);
    font-size: clamp(1rem, 1.3vw, 1.125rem);
    font-weight: 300;
    line-height: 1.7;
    letter-spacing: -0.011em;
    color: var(--color-text-secondary, var(--fg-base));
    max-width: 52ch;
    text-wrap: pretty;
    margin: 0;
  }

  @media (max-width: 768px) {
    .i-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5, 1.25rem);
      align-items: start;
    }

    .i-word {
      font-size: clamp(3rem, 16vw, 4.5rem);
    }
  }

  /* ═══════════════════════════════════════════
     J — Marquee
     The options are the display type. The claim
     shrinks to an eyebrow. Narrow measure forces
     roughly one phrase per line — poster rhythm.
     ═══════════════════════════════════════════ */
  .j-layout {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .j-head {
    font-family: var(--font-display, "Geist", sans-serif);
    font-size: clamp(1.875rem, 5vw, 3.5rem);
    font-weight: 510;
    line-height: 1.15;
    letter-spacing: -0.026em;
    color: var(--color-text-primary, var(--fg-strong));
    max-width: 22ch;
    text-wrap: balance;
    margin: var(--space-5, 1.25rem) 0 0;
  }

  .j-accent {
    color: var(--accent-base, var(--color-accent-secondary));
  }

  .j-sub {
    font-family: var(--font-body, "Geist", sans-serif);
    font-size: 1.0625rem;
    font-weight: 300;
    line-height: 1.6;
    letter-spacing: -0.011em;
    color: var(--color-text-muted, var(--fg-weaker));
    margin: var(--space-6, 1.5rem) 0 0;
  }

  @media (max-width: 576px) {
    .j-head {
      max-width: 16ch;
    }

    .j-sub {
      font-size: 0.9375rem;
      margin-top: var(--space-5, 1.25rem);
    }
  }
</style>
