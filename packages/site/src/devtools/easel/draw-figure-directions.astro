  .direction-desc {
    margin: 2px 0 0;
    font-size: 0.75rem;
    line-height: 1.45;
    color: oklch(0.6 0 0);
    max-width: 84ch;
  }

  /* The draw order, as a numbered run of chips — reads as a sequence without a bullet list's
     vertical cost. */
  .draw-order {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 6px;
    counter-reset: draw;
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
    max-width: 84ch;
  }

  .draw-step {
    counter-increment: draw;
    font-size: 0.6875rem;
    line-height: 1.3;
    color: oklch(0.68 0 0);
    background: oklch(1 0 0 / 5%);
    border: 1px solid oklch(1 0 0 / 8%);
    border-radius: 999px;
    padding: 2px 9px 2px 6px;
  }

  .draw-step::before {
    content: counter(draw);
    display: inline-block;
    min-width: 12px;
    margin-right: 5px;
    text-align: center;
    color: oklch(0.7 0.19 41);
    font-weight: 650;
  }

  .replay {
    flex-shrink: 0;
    margin-left: auto;
    font: inherit;
    font-size: 0.6875rem;
    color: oklch(0.8 0 0);
    background: oklch(1 0 0 / 6%);
    border: 1px solid oklch(1 0 0 / 14%);
    border-radius: 6px;
    padding: 4px 10px;
    cursor: pointer;
  }

  .replay:hover {
    background: oklch(1 0 0 / 12%);
    color: oklch(0.98 0 0);
  }

  .renders {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* Both frames are the real board: same ground, same grid, same 30px pitch. */
  .frame {
    position: relative;
    display: flex;
    align-items: center;
    border-radius: 10px;
    border: 1px solid var(--border-weak);
    background-color: var(--board-base);
    background-image: radial-gradient(var(--board-grid) 1px, transparent 1px);
    background-size: 30px 30px;
    overflow: hidden;
    cursor: pointer;
  }

  /* Desktop: 16/10 bezel, chat popup parked on the right taking ~26% of it. */
  .frame--wide {
    flex: 1 1 640px;
    min-width: 520px;
    max-width: 900px;
    aspect-ratio: 16 / 10;
    padding: 1rem 1.5rem;
    gap: 1rem;
  }

  /* Phone: chat hidden, board 360px tall, figure capped at 310. */
  .frame--phone {
    flex: 0 0 auto;
    width: 340px;
    height: 360px;
    padding: 0.75rem;
    justify-content: center;
  }

  .art {
    flex: 1;
    min-width: 0;
    height: 100%;
    display: flex;
    align-items: center;
  }

  .frame--phone .art {
    max-height: 310px;
  }

  .rail {
    flex: 0 0 26%;
    align-self: flex-end;
    height: 62%;
    border: 1px dashed oklch(1 0 0 / 18%);
    border-bottom: none;
    border-radius: 12px 12px 0 0;
    display: grid;
    place-items: start center;
    padding-top: 0.5rem;
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: oklch(0.5 0 0);
  }
</style>

<style is:global>
  /* set:html content sits outside Astro's scoping, so the figure styles are global and
     namespaced by hand. */
  .dfg .art svg {
    width: 100%;
    height: 100%;
    max-height: 100%;
  }

  .dfg .hand {
    font-family: "Architects Daughter", cursive, sans-serif;
    user-select: none;
  }

  .dfg .ink {
    fill: var(--board-ink);
  }

  .dfg .dim {
    fill: var(--board-ink-weak);
  }

  .dfg .agent {
    fill: var(--agent-base);
  }

  .dfg .aurora {
    fill: var(--aurora-base);
  }

  .dfg .red {
    fill: #f87171;
  }

  .dfg .s-chalk {
    stroke: var(--board-ink-weak);
    fill: none;
  }

  .dfg .s-agent {
    stroke: var(--agent-base);
    fill: none;
  }

  .dfg .s-aurora {
    stroke: var(--aurora-base);
    fill: none;
  }

  .dfg .s-red {
    stroke: #f87171;
    fill: none;
  }

  .dfg .s-green {
    stroke: #4ade80;
    fill: none;
  }

  .dfg .fade {
    opacity: 0.45;
  }

  /* ═══ The draw ═══
     Strokes are normalised with pathLength="1", so every stroke takes one beat whatever its
     length. Text and grouped doodles can't be drawn that way, so they fade in on the same
     beat instead — which is also how a word appears when someone writes it fast. */
  .dfg .art path[data-step] {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .dfg .art path[data-step].is-drawn {
    stroke-dashoffset: 0;
  }

  /* A dashed stroke can't also be a dash-drawn stroke: the offset animation would fight the
     pattern. Those fade instead. */
  .dfg .art path[data-step][stroke-dasharray] {
    stroke-dasharray: inherit;
    stroke-dashoffset: 0;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .dfg .art path[data-step][stroke-dasharray].is-drawn {
    opacity: 1;
  }

  .dfg .art path[data-step][stroke-dasharray].fade.is-drawn {
    opacity: 0.45;
  }

  .dfg .art text[data-step],
  .dfg .art g[data-step] {
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .dfg .art text[data-step].is-shown,
  .dfg .art g[data-step].is-shown {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .dfg .art path[data-step],
    .dfg .art text[data-step],
    .dfg .art g[data-step] {
      stroke-dashoffset: 0;
      opacity: 1;
      transition: none;
    }

    .dfg .art path[data-step].fade {
      opacity: 0.45;
    }
  }
</style>

<script>
  /** One beat per step. Long enough to read as drawing, short enough that F's eight steps
   *  still land inside the time someone spends looking at a section. */
  const STEP_MS = 420

  const timers = new WeakMap<Element, number[]>()

  const clearTimers = (art: Element) => {
    for (const id of timers.get(art) ?? []) window.clearTimeout(id)
    timers.set(art, [])
  }

  const draw = (art: Element) => {
    clearTimers(art)

    const marks = [...art.querySelectorAll<SVGElement>("[data-step]")]
    for (const mark of marks) mark.classList.remove("is-drawn", "is-shown")

    const beats = new Map<number, SVGElement[]>()
    for (const mark of marks) {
      const step = Number(mark.dataset.step)
      beats.set(step, [...(beats.get(step) ?? []), mark])
    }

    const ids: number[] = []
    for (const [index, step] of [...beats.keys()].sort((a, b) => a - b).entries()) {
      ids.push(
        window.setTimeout(() => {
          for (const mark of beats.get(step) ?? []) {
            mark.classList.add(mark.tagName === "path" ? "is-drawn" : "is-shown")
          }
        }, index * STEP_MS),
      )
    }
    timers.set(art, ids)
  }

  const gallery = document.querySelector(".dfg")
  if (gallery) {
    const arts = [...gallery.querySelectorAll<HTMLElement>(".art")]

    // Draw when the board comes into view, once — the same trigger the live mock uses.
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue
          observer.unobserve(entry.target)
          draw(entry.target)
        }
      },
      { rootMargin: "0px 0px -15% 0px", threshold: 0.25 },
    )
    for (const art of arts) observer.observe(art)

    // Click a board to watch it again.
    for (const frame of gallery.querySelectorAll<HTMLElement>(".frame")) {
      frame.addEventListener("click", () => {
        const art = frame.querySelector(".art")
        if (art) draw(art)
      })
    }

    // Replay redraws both renders of one direction, in step.
    for (const button of gallery.querySelectorAll<HTMLButtonElement>("[data-replay]")) {
      button.addEventListener("click", () => {
        const section = button.closest(".direction")
        if (!section) return
        for (const art of section.querySelectorAll(".art")) draw(art)
      })
    }
  }
</script>
