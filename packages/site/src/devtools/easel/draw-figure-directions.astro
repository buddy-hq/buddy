    background: oklch(1 0 0 / 8%);
    color: oklch(0.92 0 0);
    font-size: 0.8125rem;
    font-weight: 650;
    margin: 0;
  }

  .direction-name {
    font-size: 0.875rem;
    font-weight: 600;
    color: oklch(0.95 0 0);
