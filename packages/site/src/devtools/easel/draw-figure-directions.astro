<div class="dfg">
  <p class="legend">
    The board draws a concept map; CONNECT draws a note graph; REMEMBER stacks rounded
    rectangles of short text. In silhouette they are the same picture three times. Six figures
    below, all Self-Reliance, none of them a hub with labelled boxes around it. Each one draws
    itself on scroll — click a board (or hit Replay) to watch it again. The draw order is
    written beside it, because the order is half the proposal.
  </p>

  {
    FIGURES.map((figure) => (
      <section class="direction" data-figure={figure.key}>
        <header class="direction-head">
          <h2 class="direction-label">{figure.key}</h2>
          <div class="direction-copy">
            <h3 class="direction-name">{figure.name}</h3>
            <p class="direction-desc">{figure.desc}</p>
            <ol class="draw-order">
              {figure.steps.map((step) => (
                <li class="draw-step">{step}</li>
              ))}
            </ol>
          </div>
          <button class="replay" type="button" data-replay={figure.key}>
            Replay
          </button>
        </header>

        <div class="renders">
          <div class="frame frame--wide">
            <div class="art" set:html={figure.svg} />
            <div class="rail">chat</div>
          </div>
          <div class="frame frame--phone">
            <div class="art" set:html={figure.svg} />
          </div>
        </div>
      </section>
    ))
  }
</div>

<style>
  .dfg {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

