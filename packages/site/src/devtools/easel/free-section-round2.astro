---
/**
 * Easel prototype — Free section: four minimal-text directions (round 2).
 *
 * Constraints from the user:
 *   - As few words as possible
 *   - Must work on both mobile and desktop
 *   - Two messages only: (1) it's free, (2) because you bring the AI
 *
 * D — "The Price Tag": Giant $0, four icons below. Poster energy.
 * E — "The Stack": provider cards stacked/fanned with one line above.
 * F — "The Scoreboard": side-by-side: them (costs) vs you ($0). Visual proof.
 * G — "The Pill Bar": a single horizontal bar with icon-pills. Fits anywhere.
 */
---

<div class="easel">
  <div class="easel-controls">
    <div class="legend">
      <span>Round 2 — four minimal-text directions · learner and educator</span>
      <span class="legend-dim">
        Minimum words. Mobile-first. Two messages: free + bring your own AI.
      </span>
    </div>
    <div class="layout-toggle" role="group" aria-label="Stage layout">
      <button type="button" data-layout="grid" class="layout-btn is-active">Side by side</button>
      <button type="button" data-layout="stack" class="layout-btn">Stacked</button>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════════
       DIRECTION D — "The Price Tag"
       Giant $0 dominates. Four icon-only tiles below. Almost a poster.
       ═══════════════════════════════════════════════════════════════════ -->
  <section class="direction">
    <header class="direction-head">
      <h2 class="direction-label">D</h2>
      <div class="direction-meta">
        <h3 class="direction-name">The Price Tag</h3>
        <p class="direction-desc">
          Giant $0 as the visual anchor. One short line. Four icon tiles.
          The number does the talking.
        </p>
      </div>
    </header>

    <div class="stage" data-layout="grid">
      <!-- Learner -->
      <article class="slice">
        <div class="slice-label">Learner</div>
        <div class="canvas canvas-center">
          <div class="canvas-inner d-layout">
            <div class="d-price">$0</div>
            <p class="d-line">You bring the AI. We built the app.</p>
            <div class="d-tiles">
              <div class="d-tile">
                <svg class="d-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
                <span class="d-tile-label">Free models</span>
              </div>
              <div class="d-tile">
                <svg class="d-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
                <span class="d-tile-label">ChatGPT</span>
              </div>
              <div class="d-tile">
                <svg class="d-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                <span class="d-tile-label">API keys</span>
              </div>
              <div class="d-tile">
                <svg class="d-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"/><rect x="2" y="14" width="20" height="8" rx="2" ry="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>
                <span class="d-tile-label">Local models</span>
              </div>
            </div>
          </div>
        </div>
      </article>

      <!-- Educator -->
      <article class="slice">
        <div class="slice-label">Educator</div>
        <div class="canvas canvas-center">
          <div class="canvas-inner d-layout">
            <div class="d-price">$0</div>
            <p class="d-line">You bring the AI. We built the app.</p>
            <div class="d-tiles">
              <div class="d-tile">
                <svg class="d-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
                <span class="d-tile-label">Free models</span>
              </div>
              <div class="d-tile">
                <svg class="d-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
                <span class="d-tile-label">ChatGPT</span>
              </div>
              <div class="d-tile">
                <svg class="d-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                <span class="d-tile-label">API keys</span>
              </div>
              <div class="d-tile">
                <svg class="d-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"/><rect x="2" y="14" width="20" height="8" rx="2" ry="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>
                <span class="d-tile-label">Local models</span>
              </div>
            </div>
          </div>
        </div>
      </article>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       DIRECTION E — "The Stack"
       Fanned cards representing each AI source, stacked visually.
       One line at top. The cards ARE the content.
       ═══════════════════════════════════════════════════════════════════ -->
  <section class="direction">
    <header class="direction-head">
      <h2 class="direction-label">E</h2>
      <div class="direction-meta">
        <h3 class="direction-name">The Stack</h3>
        <p class="direction-desc">
          Fanned cards representing each AI source. The visual IS the list.
          One line anchors the meaning. Works as a narrow interstitial.
        </p>
      </div>
    </header>

    <div class="stage" data-layout="grid">
      <!-- Learner -->
      <article class="slice">
        <div class="slice-label">Learner</div>
        <div class="canvas canvas-center">
          <div class="canvas-inner e-layout">
            <p class="e-above">Buddy is free. Bring any AI.</p>
            <div class="e-stack">
              <div class="e-card e-card-1">
                <span class="e-card-icon">✦</span>
                <span class="e-card-name">Free models</span>
                <span class="e-card-aside">included</span>
              </div>
              <div class="e-card e-card-2">
                <span class="e-card-icon">⬡</span>
                <span class="e-card-name">ChatGPT</span>
                <span class="e-card-aside">your login</span>
              </div>
              <div class="e-card e-card-3">
                <span class="e-card-icon">⚿</span>
                <span class="e-card-name">API keys</span>
                <span class="e-card-aside">50+ providers</span>
              </div>
              <div class="e-card e-card-4">
                <span class="e-card-icon">⬢</span>
                <span class="e-card-name">Ollama</span>
                <span class="e-card-aside">local</span>
              </div>
            </div>
          </div>
        </div>
      </article>

      <!-- Educator -->
      <article class="slice">
        <div class="slice-label">Educator</div>
        <div class="canvas canvas-center">
          <div class="canvas-inner e-layout">
            <p class="e-above">Buddy is free. Bring any AI.</p>
            <div class="e-stack">
              <div class="e-card e-card-1">
                <span class="e-card-icon">✦</span>
                <span class="e-card-name">Free models</span>
                <span class="e-card-aside">included</span>
              </div>
              <div class="e-card e-card-2">
                <span class="e-card-icon">⬡</span>
                <span class="e-card-name">ChatGPT</span>
                <span class="e-card-aside">your login</span>
              </div>
              <div class="e-card e-card-3">
                <span class="e-card-icon">⚿</span>
                <span class="e-card-name">API keys</span>
                <span class="e-card-aside">50+ providers</span>
              </div>
              <div class="e-card e-card-4">
                <span class="e-card-icon">⬢</span>
                <span class="e-card-name">Ollama</span>
                <span class="e-card-aside">local</span>
              </div>
            </div>
          </div>
        </div>
      </article>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       DIRECTION F — "The Scoreboard"
       Left: what others charge (crossed out prices). Right: $0.
       Purely visual contrast. No paragraphs.
       ═══════════════════════════════════════════════════════════════════ -->
  <section class="direction">
    <header class="direction-head">
      <h2 class="direction-label">F</h2>
      <div class="direction-meta">
        <h3 class="direction-name">The Scoreboard</h3>
        <p class="direction-desc">
          Visual contrast: crossed-out subscription prices on the left,
          $0 on the right. The comparison does the arguing.
        </p>
      </div>
    </header>

    <div class="stage" data-layout="grid">
      <!-- Learner -->
      <article class="slice">
        <div class="slice-label">Learner</div>
        <div class="canvas canvas-center">
          <div class="canvas-inner f-layout">
            <div class="f-board">
              <div class="f-col f-others">
                <p class="f-col-label">Others</p>
                <div class="f-prices">
                  <span class="f-struck">$20<small>/mo</small></span>
                  <span class="f-struck">$10<small>/mo</small></span>
                  <span class="f-struck">$30<small>/mo</small></span>
                </div>
              </div>
              <div class="f-vs">vs</div>
              <div class="f-col f-buddy-col">
                <p class="f-col-label">Buddy</p>
                <div class="f-free">$0</div>
                <p class="f-reason">You bring the AI</p>
              </div>
            </div>
            <div class="f-how">
              <span class="f-how-chip">Free models</span>
              <span class="f-how-chip">ChatGPT</span>
              <span class="f-how-chip">API keys</span>
              <span class="f-how-chip">Ollama</span>
            </div>
          </div>
        </div>
      </article>

      <!-- Educator -->
      <article class="slice">
        <div class="slice-label">Educator</div>
        <div class="canvas canvas-center">
          <div class="canvas-inner f-layout">
            <div class="f-board">
              <div class="f-col f-others">
                <p class="f-col-label">Others</p>
                <div class="f-prices">
                  <span class="f-struck">$20<small>/mo</small></span>
                  <span class="f-struck">$10<small>/mo</small></span>
                  <span class="f-struck">$30<small>/mo</small></span>
                </div>
              </div>
              <div class="f-vs">vs</div>
              <div class="f-col f-buddy-col">
                <p class="f-col-label">Buddy</p>
                <div class="f-free">$0</div>
                <p class="f-reason">You bring the AI</p>
              </div>
            </div>
            <div class="f-how">
              <span class="f-how-chip">Free models</span>
              <span class="f-how-chip">ChatGPT</span>
              <span class="f-how-chip">API keys</span>
              <span class="f-how-chip">Ollama</span>
            </div>
          </div>
        </div>
      </article>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       DIRECTION G — "The Pill Bar"
       A single horizontal strip. Could be an interstitial between sections.
       Icon-pills showing each option, anchored by a short phrase.
       Ultra-compact. Almost a banner.
       ═══════════════════════════════════════════════════════════════════ -->
  <section class="direction">
    <header class="direction-head">
      <h2 class="direction-label">G</h2>
      <div class="direction-meta">
        <h3 class="direction-name">The Pill Bar</h3>
        <p class="direction-desc">
          Banner-weight strip. Icon-pills in a row. Could live between any two sections.
          Almost zero vertical space.
        </p>
      </div>
    </header>

    <div class="stage" data-layout="grid">
      <!-- Learner -->
      <article class="slice">
        <div class="slice-label">Learner</div>
        <div class="canvas canvas-center">
          <div class="canvas-inner g-layout">
            <div class="g-bar">
              <div class="g-statement">
                <span class="g-free">Free</span>
                <span class="g-sep">—</span>
                <span class="g-why">bring your own AI</span>
              </div>
              <div class="g-pills">
                <span class="g-pill">
                  <svg class="g-pill-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
                  Free models
                </span>
                <span class="g-pill">
                  <svg class="g-pill-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
                  ChatGPT
                </span>
                <span class="g-pill">
                  <svg class="g-pill-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                  API keys
                </span>
                <span class="g-pill">
                  <svg class="g-pill-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"/><rect x="2" y="14" width="20" height="8" rx="2" ry="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>
                  Ollama
                </span>
              </div>
            </div>
          </div>
        </div>
      </article>

      <!-- Educator -->
      <article class="slice">
        <div class="slice-label">Educator</div>
        <div class="canvas canvas-center">
          <div class="canvas-inner g-layout">
            <div class="g-bar">
              <div class="g-statement">
                <span class="g-free">Free</span>
                <span class="g-sep">—</span>
                <span class="g-why">bring your own AI</span>
              </div>
              <div class="g-pills">
                <span class="g-pill">
                  <svg class="g-pill-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
                  Free models
                </span>
                <span class="g-pill">
                  <svg class="g-pill-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
                  ChatGPT
                </span>
                <span class="g-pill">
                  <svg class="g-pill-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                  API keys
                </span>
                <span class="g-pill">
                  <svg class="g-pill-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"/><rect x="2" y="14" width="20" height="8" rx="2" ry="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>
                  Ollama
                </span>
              </div>
            </div>
          </div>
        </div>
      </article>
    </div>
  </section>
</div>

<style>
  /* ═══ Easel shell (shared) ═══ */
  .easel {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    min-height: 0;
  }

  .easel-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .legend {
    display: flex;
    flex-direction: column;
    font-size: 0.8125rem;
    color: oklch(0.85 0 0);
  }

  .legend-dim {
    color: oklch(0.6 0 0);
    max-width: 76ch;
  }

  .layout-toggle {
    display: inline-flex;
    gap: 2px;
    padding: 2px;
    border: 1px solid oklch(1 0 0 / 12%);
    border-radius: 8px;
  }

  .layout-btn {
    appearance: none;
    border: none;
    background: transparent;
    color: oklch(0.7 0 0);
    font: inherit;
    font-size: 0.75rem;
    padding: 4px 10px;
    border-radius: 6px;
    cursor: pointer;
  }

  .layout-btn.is-active {
    background: oklch(1 0 0 / 10%);
    color: oklch(0.98 0 0);
  }

  /* ═══ Direction wrappers ═══ */
  .direction {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .direction + .direction {
    margin-top: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid oklch(1 0 0 / 8%);
  }

  .direction-head {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .direction-label {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    display: grid;
    place-items: center;
    border-radius: 6px;
    background: oklch(1 0 0 / 8%);
    color: oklch(0.92 0 0);
    font-size: 0.8125rem;
    font-weight: 650;
    margin: 0;
  }

  .direction-meta { min-width: 0; }

  .direction-name {
    font-size: 0.875rem;
    font-weight: 600;
    color: oklch(0.95 0 0);
    margin: 0;
  }

  .direction-desc {
    margin: 2px 0 0;
    font-size: 0.75rem;
    line-height: 1.45;
    color: oklch(0.6 0 0);
    max-width: 72ch;
  }

  /* ═══ Stage ═══ */
  .stage {
    display: grid;
    gap: 1rem;
  }

  .stage[data-layout="grid"] {
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
  }

  .stage[data-layout="stack"] {
    grid-template-columns: 1fr;
  }

  .slice {
    display: flex;
    flex-direction: column;
    border: 1px solid oklch(1 0 0 / 10%);
    border-radius: 12px;
    overflow: hidden;
  }

  .slice-label {
    padding: 0.5rem 1rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: oklch(0.65 0 0);
    background: oklch(0.16 0 0);
    border-bottom: 1px solid oklch(1 0 0 / 8%);
  }

  .canvas {
    position: relative;
    background: var(--surface-page, oklch(0.16 0 0));
    padding: 2.5rem 1.5rem;
    flex: 1;
  }

  .canvas-center {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .canvas-inner {
    position: relative;
    z-index: 1;
    width: 100%;
  }

  /* ═══════════════════════════════════════════
     D — The Price Tag
     ═══════════════════════════════════════════ */
  .d-layout {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  .d-price {
    font-size: clamp(5rem, 12vw, 8rem);
    font-weight: 750;
    letter-spacing: -0.06em;
    line-height: 1;
    color: var(--fg-strong, oklch(0.985 0 0));
    font-variant-numeric: tabular-nums;
  }

  .d-line {
    margin: 0.25rem 0 0;
    font-size: clamp(0.875rem, 1.5vw, 1.0625rem);
    font-weight: 400;
    color: var(--fg-weak, oklch(0.708 0 0));
    letter-spacing: -0.01em;
  }

  .d-tiles {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.625rem;
    margin-top: 1.75rem;
    width: 100%;
    max-width: 420px;
  }

  .d-tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.375rem;
    padding: 0.875rem 0.5rem;
    border-radius: 10px;
    border: 1px solid var(--border-base, oklch(1 0 0 / 10%));
    background: var(--surface-base, oklch(0.205 0 0 / 45%));
  }

  .d-icon {
    color: var(--fg-weaker, oklch(0.556 0 0));
  }

  .d-tile-label {
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--fg-base, oklch(0.85 0 0));
    white-space: nowrap;
  }

  @media (max-width: 480px) {
    .d-tiles {
      grid-template-columns: repeat(2, 1fr);
      max-width: 240px;
    }
  }

  /* ═══════════════════════════════════════════
     E — The Stack
     ═══════════════════════════════════════════ */
  .e-layout {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .e-above {
    margin: 0;
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    font-weight: 560;
    letter-spacing: -0.025em;
    line-height: 1.2;
    color: var(--fg-strong, oklch(0.985 0 0));
  }

  .e-stack {
    display: flex;
    flex-direction: column;
    gap: 0;
    width: 100%;
    max-width: 340px;
  }

  .e-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
