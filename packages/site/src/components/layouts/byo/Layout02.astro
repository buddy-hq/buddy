---
import { content } from "../../../content/site"
const { bringYourOwn } = content

const logins = [
  { ...bringYourOwn.primary, subtext: bringYourOwn.primary.description },
  { name: bringYourOwn.secondary.options[0], icon: "github", subtext: "Log in with GitHub. No new bill." }
]
---

<div class="byo-layout-02">
  <div class="container">
    <div class="editorial-split">
      
      <!-- Left side: Logins -->
      <div class="split-left">
        <h2 class="section-title">{bringYourOwn.headline}</h2>
        <div class="logins-list">
          {logins.map((login) => (
            <div class="login-row">
              <div class="login-meta">
                <span class="icon-holder">
                  {login.icon === "openai" ? (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width: 18px; height: 18px;"><path d="M4.5 16.5c-1.5-2.5-1-6 1.5-7.5s6-1 7.5 1.5m0 0c1.5 2.5 1 6-1.5 7.5s-6 1-7.5-1.5M12 9V3m0 6c2-1 4.5-.5 5.5 1.5s-.5 4.5-2.5 5.5m0 0l5 3m-5-3c.5 2-.5 4.5-2.5 5.5S10 20 9 18" stroke-linecap="round"/></svg>
                  ) : (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width: 18px; height: 18px;"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  )}
                </span>
                <span class="login-name">{login.name}</span>
              </div>
              <p class="login-subtext">{login.subtext}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Right side: Providers -->
      <div class="split-right">
        <h3 class="trailing-title">{bringYourOwn.secondary.label}</h3>
        <div class="providers-list">
          {bringYourOwn.secondary.providers.map((provider) => (
            <div class="provider-row">
              <span class="bullet-dot"></span>
              <span class="provider-name">{provider}</span>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</div>

<style is:global>
  .byo-layout-02 {
    padding: var(--space-12) 0;
    width: 100%;
  }

  .byo-layout-02 .container {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  .byo-layout-02 .editorial-split {
    display: flex;
    justify-content: space-between;
    gap: var(--space-10);
    align-items: flex-start;
  }

  .byo-layout-02 .split-left {
    width: 50%;
  }

  .byo-layout-02 .split-right {
    width: 40%;
    background-color: #0b0908;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 16px;
    padding: var(--space-6) var(--space-5);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
  }

  .byo-layout-02 .section-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 2.75rem);
    font-weight: 800;
    line-height: 1.1;
    color: var(--color-text-primary);
    margin-bottom: var(--space-8);
    letter-spacing: var(--tracking-tight);
  }

  .byo-layout-02 .logins-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .byo-layout-02 .login-row {
    border-left: 2px solid rgba(255, 107, 0, 0.15);
    padding-left: var(--space-4);
  }

  .byo-layout-02 .login-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-1);
  }

  .byo-layout-02 .icon-holder {
    color: var(--color-accent-primary);
    display: flex;
    align-items: center;
  }

  .byo-layout-02 .login-name {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 750;
    color: var(--color-text-primary);
  }

  .byo-layout-02 .login-subtext {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  /* Right column providers list */
  .byo-layout-02 .trailing-title {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 750;
    color: var(--color-text-primary);
    margin-bottom: var(--space-4);
    border-bottom: 1px dashed rgba(255, 255, 255, 0.08);
    padding-bottom: var(--space-2);
  }

  .byo-layout-02 .providers-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .byo-layout-02 .provider-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .byo-layout-02 .bullet-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-accent-primary);
    box-shadow: 0 0 6px var(--color-accent-primary);
  }

  .byo-layout-02 .provider-name {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
  }

  @media (max-width: 860px) {
    .byo-layout-02 .editorial-split {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-8);
    }
    .byo-layout-02 .split-left, .byo-layout-02 .split-right {
      width: 100%;
    }
  }
</style>
