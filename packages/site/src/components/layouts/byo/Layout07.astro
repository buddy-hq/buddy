---
import { content } from "../../../content/site"
const { bringYourOwn } = content

const logins = [
  { ...bringYourOwn.primary, subtext: bringYourOwn.primary.description },
  { name: bringYourOwn.secondary.options[0], icon: "github", subtext: "Log in with GitHub. No new bill." }
]

// Duplicate providers list to ensure smooth infinite loop scroll
const doubleProviders = [...bringYourOwn.secondary.providers, ...bringYourOwn.secondary.providers]
---

<div class="byo-layout-07">
  <div class="container-full">
    <!-- Header -->
    <div class="header-box">
      <h2 class="section-title">{bringYourOwn.headline}</h2>
    </div>

    <!-- Logins: Wide side-by-side cards -->
    <div class="logins-horizontal-deck">
      {logins.map((login) => (
        <div class="deck-card">
          <div class="card-inner-flex">
            <div class="login-brand">
              <span class="icon-holder">
                {login.icon === "openai" ? (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width: 20px; height: 20px;"><path d="M4.5 16.5c-1.5-2.5-1-6 1.5-7.5s6-1 7.5 1.5m0 0c1.5 2.5 1 6-1.5 7.5s-6 1-7.5-1.5M12 9V3m0 6c2-1 4.5-.5 5.5 1.5s-.5 4.5-2.5 5.5m0 0l5 3m-5-3c.5 2-.5 4.5-2.5 5.5S10 20 9 18" stroke-linecap="round"/></svg>
                ) : (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width: 20px; height: 20px;"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" stroke-linecap="round" stroke-linejoin="round"/></svg>
                )}
              </span>
              <h3 class="login-name">{login.name}</h3>
            </div>
            <p class="login-subtext">{login.subtext}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Marquee Banner Zone -->
    <div class="marquee-zone">
      <div class="marquee-header">
        <h4 class="trailing-title">{bringYourOwn.secondary.label}</h4>
      </div>
      
      <div class="marquee-container">
        <div class="marquee-track">
          {doubleProviders.map((provider) => (
            <div class="marquee-item">
              <span class="provider-dot"></span>
              <span class="provider-text">{provider}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

  </div>
</div>

<style is:global>
  .byo-layout-07 {
    padding: var(--space-12) 0;
    width: 100%;
    overflow-x: hidden;
  }

  .byo-layout-07 .container-full {
    width: 100%;
    max-width: 100vw;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .byo-layout-07 .header-box {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 var(--space-6);
    width: 100%;
    text-align: center;
  }

  .byo-layout-07 .section-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 800;
    color: var(--color-text-primary);
    line-height: 1.1;
    letter-spacing: var(--tracking-tight);
    margin: 0;
  }

  /* Logins Deck */
  .byo-layout-07 .logins-horizontal-deck {
    display: flex;
    gap: var(--space-4);
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 var(--space-6);
    width: 100%;
  }

  .byo-layout-07 .deck-card {
    flex: 1;
    background-color: #0b0908;
    border: 1px solid rgba(255, 255, 255, 0.04);
    border-radius: 16px;
    padding: var(--space-6) var(--space-8);
    transition: all 0.3s var(--ease-out);
  }

  .byo-layout-07 .deck-card:hover {
    border-color: rgba(255, 107, 0, 0.2);
    transform: translateY(-2px);
  }

  .byo-layout-07 .card-inner-flex {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .byo-layout-07 .login-brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .byo-layout-07 .icon-holder {
    width: 32px;
    height: 32px;
    background-color: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-secondary);
  }

  .byo-layout-07 .deck-card:hover .icon-holder {
    color: var(--color-accent-primary);
    border-color: rgba(255, 107, 0, 0.15);
  }

  .byo-layout-07 .login-name {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 750;
    color: var(--color-text-primary);
    margin: 0;
  }

  .byo-layout-07 .login-subtext {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    margin: 0;
    text-align: right;
  }

  /* Marquee Styling */
  .byo-layout-07 .marquee-zone {
    width: 100%;
    margin-top: var(--space-4);
  }

  .byo-layout-07 .marquee-header {
    max-width: 1000px;
    margin: 0 auto var(--space-4);
    padding: 0 var(--space-6);
    width: 100%;
  }

  .byo-layout-07 .trailing-title {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 750;
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin: 0;
  }

  .byo-layout-07 .marquee-container {
    width: 100%;
    background-color: rgba(255, 255, 255, 0.01);
    border-block: 1px solid rgba(255, 255, 255, 0.04);
    padding: var(--space-4) 0;
    overflow: hidden;
    position: relative;
  }

  .byo-layout-07 .marquee-track {
    display: flex;
    gap: var(--space-8);
    width: max-content;
    animation: marquee 30s linear infinite;
  }

  .byo-layout-07 .marquee-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .byo-layout-07 .provider-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-accent-primary);
  }

  .byo-layout-07 .provider-text {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-secondary);
    white-space: nowrap;
  }

  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 768px) {
    .byo-layout-07 .logins-horizontal-deck {
      flex-direction: column;
    }
    .byo-layout-07 .card-inner-flex {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }
    .byo-layout-07 .login-subtext {
      text-align: left;
    }
  }
</style>
