---
import { content } from "../../../content/site"
const { capabilities } = content
---

<div class="cap-layout-02">
  <div class="container">
    <div class="workflow-header text-center">
      <span class="editorial-tag">WORKFLOW PIPELINE</span>
      <h2 class="section-title">{capabilities.headline}</h2>
      <p class="section-subtext">{capabilities.subtext}</p>
    </div>

    <!-- Vertical Timeline -->
    <div class="vertical-timeline">
      <div class="timeline-line"></div>
      
      {capabilities.items.map((item, idx) => (
        <div class="timeline-step">
          <!-- Left side connector circle -->
          <div class="timeline-connector">
            <div class="connector-circle">
              <span class="connector-num">{idx + 1}</span>
            </div>
          </div>
          
          <!-- Right side content panel -->
          <div class="timeline-content">
            <h3 class="step-title">{item.name}</h3>
            <p class="step-desc">{item.detail}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .cap-layout-02 {
    padding: var(--space-12) 0;
  }

  .container {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  .text-center {
    text-align: center;
  }

  .workflow-header {
    margin-bottom: var(--space-12);
  }

  .editorial-tag {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 750;
    letter-spacing: 0.1em;
    color: var(--color-accent-primary);
    text-transform: uppercase;
    margin-bottom: var(--space-3);
    display: inline-block;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    color: var(--color-text-primary);
    margin-bottom: var(--space-2);
    letter-spacing: var(--tracking-tight);
  }

  .section-subtext {
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
    line-height: var(--leading-relaxed);
  }

  /* Vertical Timeline */
  .vertical-timeline {
    position: relative;
    padding-left: var(--space-10);
  }

  .timeline-line {
    position: absolute;
    left: 21px; /* Centers with the connector circles */
    top: 20px;
    bottom: 20px;
    width: 2px;
    background-color: rgba(255, 255, 255, 0.04);
    pointer-events: none;
    transition: background-color 0.3s var(--ease-out);
  }

  .timeline-step {
    position: relative;
    display: flex;
    gap: var(--space-6);
    padding-bottom: var(--space-10);
    cursor: pointer;
  }

  .timeline-step:last-child {
    padding-bottom: 0;
  }

  /* Timeline Connector Circle left side */
  .timeline-connector {
    position: relative;
    z-index: 2;
  }

  .connector-circle {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: #0b0908;
    border: 2px solid rgba(255, 255, 255, 0.06);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s var(--ease-out);
  }

  .connector-num {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-text-muted);
    transition: color 0.3s var(--ease-out);
  }

  /* Right content block */
  .timeline-content {
    flex: 1;
    padding-top: var(--space-2);
    transition: transform 0.3s var(--ease-out);
  }

  .step-title {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 750;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-2);
    transition: color 0.3s var(--ease-out);
  }

  .step-desc {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    line-height: var(--leading-relaxed);
  }

  /* Hover timeline item */
  .timeline-step:hover .connector-circle {
    border-color: var(--color-accent-primary);
    background-color: rgba(255, 107, 0, 0.03);
    box-shadow: 0 0 12px rgba(255, 107, 0, 0.2);
    transform: scale(1.1);
  }

  .timeline-step:hover .connector-num {
    color: var(--color-accent-primary);
  }

  .timeline-step:hover .step-title {
    color: var(--color-text-primary);
  }

  .timeline-step:hover .timeline-content {
    transform: translateX(4px);
  }
</style>
