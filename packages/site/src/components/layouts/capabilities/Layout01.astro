---
import { content } from "../../../content/site"
const { capabilities } = content
---

<div class="cap-layout-01">
  <div class="container">
    <div class="dashboard-header text-center">
      <span class="editorial-tag">SYSTEM FEATURES</span>
      <h2 class="section-title">{capabilities.headline}</h2>
      <p class="section-subtext">{capabilities.subtext}</p>
    </div>

    <!-- Diagnostic Grid -->
    <div class="diagnostic-grid">
      {capabilities.items.map((item, idx) => {
        // Custom mock logs for each item type to make it feel extremely authentic
        const mockLogs = [
          ["subagent-manager initialized", "spawning: task-decomposer", "subagent status: active"],
          ["mcp-client handshaking...", "connected: sqlite-tool v1.2", "mcp schema synchronized"],
          ["indexing skills directory...", "loaded: spaced-repetition.db", "24 skills compile-checked"],
          ["registering system tools...", "34 local tools online", "permissions: secure-sandbox"],
          ["reading instruction rules...", "AGENTS.md parsed successfully", "rules applied: strict-sound"]
        ][idx]

        return (
          <div class="diagnostic-panel">
            <div class="panel-header-line">
              <div class="panel-tag-group">
                <span class="status-marker green"></span>
                <span class="panel-sysname">{item.name}</span>
              </div>
              <span class="panel-num-id">0{idx + 1}</span>
            </div>
            
            <div class="panel-body-content">
              <p class="panel-desc">{item.detail}</p>
            </div>

            <!-- Terminal log readout at the bottom of the card -->
            <div class="panel-log-box">
              {mockLogs.map((log) => (
                <div class="log-line">
                  <span class="log-timestamp">[14:32:01]</span> {log}
                </div>
              ))}
            </div>
          </div>
        )
      })}
    </div>
  </div>
</div>

<style>
  .cap-layout-01 {
    padding: var(--space-12) 0;
  }

  .container {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  .text-center {
    text-align: center;
  }

  .dashboard-header {
    margin-bottom: var(--space-10);
  }

  .editorial-tag {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 750;
    letter-spacing: 0.1em;
    color: var(--color-accent-primary);
    text-transform: uppercase;
    margin-bottom: var(--space-3);
    display: inline-block;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    color: var(--color-text-primary);
    margin-bottom: var(--space-2);
    letter-spacing: var(--tracking-tight);
  }

  .section-subtext {
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
    line-height: var(--leading-relaxed);
  }

  /* Diagnostic Dashboard Grid */
  .diagnostic-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: var(--space-5);
  }

  .diagnostic-panel {
    background-color: #0b0908;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 250px;
    position: relative;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    transition: all 0.3s var(--ease-out);
  }

  .diagnostic-panel:hover {
    border-color: rgba(255, 107, 0, 0.2);
    background-color: rgba(255, 255, 255, 0.01);
  }

  .panel-header-line {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px dashed rgba(255, 255, 255, 0.05);
    padding-bottom: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .panel-tag-group {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .status-marker {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .status-marker.green {
    background-color: #10b981;
    box-shadow: 0 0 6px #10b981;
  }

  .panel-sysname {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 750;
    color: var(--color-text-secondary);
    letter-spacing: var(--tracking-wide);
  }

  .panel-num-id {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-text-muted);
  }

  .panel-body-content {
    flex: 1;
    margin-bottom: var(--space-4);
  }

  .panel-desc {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  /* Log Box in Footer of Card */
  .panel-log-box {
    background-color: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.03);
    border-radius: 6px;
    padding: var(--space-3);
    font-family: var(--font-mono);
    font-size: 9px;
    color: var(--color-text-muted);
    display: flex;
    flex-direction: column;
    gap: 4px;
    height: 64px;
    overflow: hidden;
  }

  .log-line {
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
  }

  .log-timestamp {
    color: var(--color-accent-primary);
  }
</style>
