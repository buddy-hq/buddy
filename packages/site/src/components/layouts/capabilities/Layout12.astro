---
import { content } from "../../../content/site"
const { capabilities } = content
---

<div class="capabilities-layout-12" id="p12-cap-container">
  <div class="container">
    <div class="scroll-split-wrapper">
      
      <!-- Left side: Assembly Slots with schema inspection toggles -->
      <div class="scroll-content-side">
        <div class="constructor-intro">
          <h2 class="section-headline">{capabilities.headline}</h2>
          <p class="section-subtext">{capabilities.subtext}</p>
        </div>

        <div class="slots-stack" id="p12-cap-slots">
          {capabilities.items.map((item, idx) => (
            <div class="slot-card" data-index={idx} id={`p12-cap-card-${idx}`}>
              <div class="card-meta">
                <span class="slot-idx">LAYER 0{idx + 1}</span>
                <button class="schema-inspect-btn" data-index={idx} aria-label="Toggle JSON schema info">SCHEMA</button>
              </div>
              <h3 class="name">{item.name}</h3>
              <p class="detail">{item.detail}</p>
              
              <!-- Slide-down code schema -->
              <div class="schema-drawer-panel hidden" id={`p12-schema-drawer-${idx}`}>
                <pre class="schema-pre-code"><code>{`{
  "type": "${item.name.toLowerCase()}",
  "active": true,
  "sandbox": "isolated"
}`}</code></pre>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right side: Sticky Chassis Constructor Assembly -->
      <div class="sticky-visual-side">
        <div class="sticky-viewport-panel" id="p12-cap-sticky-panel">
          
          <div class="chassis-rack-inner">
            <svg class="chassis-core-svg" viewBox="0 0 120 120">
              <!-- Grid pattern details -->
              <circle cx="60" cy="60" r="50" fill="none" stroke="rgba(255,255,255,0.015)" stroke-width="1.5" />
              <circle cx="60" cy="60" r="35" fill="none" stroke="rgba(255,255,255,0.02)" stroke-width="1" />
              
              <!-- Center motherboard chassis -->
              <rect x="35" y="35" width="50" height="50" rx="6" fill="#090909" stroke="rgba(255,255,255,0.04)" stroke-width="1.5" />
              <rect x="42" y="42" width="36" height="36" rx="4" fill="#020202" stroke="rgba(255,255,255,0.06)" stroke-width="1.2" />

              <!-- Visual routes matching layers (glows dynamically) -->
              <!-- 0: Subagents (Top routes) -->
              <g class="chassis-route route-0">
                <path d="M 60,35 V 20 M 60,20 H 45" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="1.5" />
                <circle cx="45" cy="20" r="3.5" fill="#090909" stroke="rgba(255,255,255,0.2)" stroke-width="1.2" class="interactive-pin pin-0" style="cursor: pointer; pointer-events: auto;" />
              </g>
              <!-- 1: MCPs (Right routes) -->
              <g class="chassis-route route-1">
                <path d="M 85,60 H 100 M 100,60 V 45" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="1.5" />
                <circle cx="100" cy="45" r="3.5" fill="#090909" stroke="rgba(255,255,255,0.2)" stroke-width="1.2" class="interactive-pin pin-1" style="cursor: pointer; pointer-events: auto;" />
              </g>
              <!-- 2: Skills (Bottom routes) -->
              <g class="chassis-route route-2">
                <path d="M 60,85 V 100 M 60,100 H 75" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="1.5" />
                <circle cx="75" cy="100" r="3.5" fill="#090909" stroke="rgba(255,255,255,0.2)" stroke-width="1.2" class="interactive-pin pin-2" style="cursor: pointer; pointer-events: auto;" />
              </g>
              <!-- 3: Tools (Left routes) -->
              <g class="chassis-route route-3">
                <path d="M 35,60 H 20 M 20,60 V 75" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="1.5" />
                <circle cx="20" cy="75" r="3.5" fill="#090909" stroke="rgba(255,255,255,0.2)" stroke-width="1.2" class="interactive-pin pin-3" style="cursor: pointer; pointer-events: auto;" />
              </g>
              <!-- 4: AGENTS.md (Steering processor bounds) -->
              <g class="chassis-route route-4">
                <rect x="47" y="47" width="26" height="26" rx="2" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="1" stroke-dasharray="2,2" />
                <circle cx="60" cy="60" r="4.5" fill="rgba(255,255,255,0.1)" stroke="rgba(255,255,255,0.2)" stroke-width="1.2" class="interactive-pin pin-4" style="cursor: pointer; pointer-events: auto;" />
              </g>
            </svg>
            
            <div class="chassis-status-display" id="p12-chassis-status">STANDBY</div>
          </div>

        </div>
      </div>

    </div>
  </div>
</div>

<style is:global>
  .capabilities-layout-12 {
    width: 100%;
    background-color: #050505;
    position: relative;
    padding-bottom: var(--space-20);
    border-bottom: 1px solid rgba(255, 255, 255, 0.02);
  }

  .capabilities-layout-12 .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 var(--space-6);
    width: 100%;
  }

  .capabilities-layout-12 .scroll-split-wrapper {
    display: flex;
    gap: var(--space-10);
    width: 100%;
    position: relative;
  }

  /* Left Slots column */
  .capabilities-layout-12 .scroll-content-side {
    width: 45%;
    display: flex;
    flex-direction: column;
  }

  .capabilities-layout-12 .section-headline {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: 850;
    color: var(--color-text-primary);
    line-height: 1.15;
    letter-spacing: var(--tracking-tighter);
    margin: 0;
    padding-top: var(--space-12);
  }

  .capabilities-layout-12 .section-subtext {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    margin-top: 4px;
    margin-bottom: 24px;
  }

  .capabilities-layout-12 .slots-stack {
    display: flex;
    flex-direction: column;
  }

  .capabilities-layout-12 .slot-card {
    min-height: 60vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-2);
    opacity: 0.15;
    transition: opacity 350ms cubic-bezier(0.16, 1, 0.3, 1), transform 350ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .capabilities-layout-12 .slot-card.active {
    opacity: 1;
    transform: translateX(4px);
  }

  .capabilities-layout-12 .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .capabilities-layout-12 .slot-idx {
    font-family: var(--font-mono);
    font-size: 9px;
    color: var(--color-accent-primary);
    font-weight: 700;
  }

  .capabilities-layout-12 .schema-inspect-btn {
    background-color: transparent;
    border: 1px dashed rgba(255, 255, 255, 0.15);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 7px;
    padding: 2px 6px;
    border-radius: 4px;
    cursor: pointer;
    font-weight: 700;
    transition: all 150ms ease;
  }

  .capabilities-layout-12 .schema-inspect-btn:hover {
    border-style: solid;
    color: var(--color-text-primary);
  }

  .capabilities-layout-12 .schema-inspect-btn.active {
    border-color: var(--color-accent-primary);
    color: var(--color-accent-primary);
    border-style: solid;
  }

  .capabilities-layout-12 .name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 800;
    color: var(--color-text-primary);
    margin: 0;
  }

  .capabilities-layout-12 .detail {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  /* Schema slide drawer */
  .capabilities-layout-12 .schema-drawer-panel {
    background-color: #020202;
    border: 1.5px solid rgba(255, 255, 255, 0.03);
    border-radius: 8px;
    padding: 8px;
    margin-top: 8px;
    animation: drawerSlide 250ms ease-out;
  }

  .capabilities-layout-12 .schema-drawer-panel.hidden {
    display: none !important;
  }

  @keyframes drawerSlide {
    from { opacity: 0; transform: translateY(-5px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .capabilities-layout-12 .schema-pre-code {
    font-family: var(--font-mono);
    font-size: 8px;
    color: #888;
    margin: 0;
  }

  /* Right Side sticky chassis */
  .capabilities-layout-12 .sticky-visual-side {
    width: 55%;
    position: relative;
  }

  .capabilities-layout-12 .sticky-viewport-panel {
    position: sticky;
    top: 150px;
    height: 320px;
    background-color: #090909;
    border: 1px solid rgba(255, 255, 255, 0.03);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
  }

  .capabilities-layout-12 .chassis-rack-inner {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-6);
  }

  .capabilities-layout-12 .chassis-core-svg {
    width: auto;
    height: 180px;
  }

  .capabilities-layout-12 .chassis-route path {
    stroke: rgba(255,255,255,0.06);
    transition: stroke 350ms ease, stroke-width 350ms ease;
  }

  .capabilities-layout-12 .chassis-route rect {
    stroke: rgba(255,255,255,0.06);
    transition: stroke 350ms ease, stroke-width 350ms ease;
  }

  .capabilities-layout-12 .interactive-pin {
    transition: all 250ms ease;
  }

  .capabilities-layout-12 .interactive-pin:hover {
    stroke: var(--color-text-primary);
  }

  /* Active compilation state highlighting */
  .capabilities-layout-12 .sticky-viewport-panel.compile-0 .route-0 path { stroke: var(--color-accent-primary); stroke-width: 1.8px; }
  .capabilities-layout-12 .sticky-viewport-panel.compile-0 .pin-0 { stroke: var(--color-accent-primary); fill: rgba(255,107,0,0.3); }

  .capabilities-layout-12 .sticky-viewport-panel.compile-1 .route-1 path { stroke: var(--color-accent-primary); stroke-width: 1.8px; }
  .capabilities-layout-12 .sticky-viewport-panel.compile-1 .pin-1 { stroke: var(--color-accent-primary); fill: rgba(255,107,0,0.3); }

  .capabilities-layout-12 .sticky-viewport-panel.compile-2 .route-2 path { stroke: var(--color-accent-primary); stroke-width: 1.8px; }
  .capabilities-layout-12 .sticky-viewport-panel.compile-2 .pin-2 { stroke: var(--color-accent-primary); fill: rgba(255,107,0,0.3); }

  .capabilities-layout-12 .sticky-viewport-panel.compile-3 .route-3 path { stroke: var(--color-accent-primary); stroke-width: 1.8px; }
  .capabilities-layout-12 .sticky-viewport-panel.compile-3 .pin-3 { stroke: var(--color-accent-primary); fill: rgba(255,107,0,0.3); }

  .capabilities-layout-12 .sticky-viewport-panel.compile-4 .route-4 rect { stroke: var(--color-accent-primary); stroke-width: 1.5px; }
  .capabilities-layout-12 .sticky-viewport-panel.compile-4 .pin-4 { stroke: var(--color-accent-primary); fill: rgba(255,107,0,0.3); }

  .capabilities-layout-12 .chassis-status-display {
    font-family: var(--font-mono);
    font-size: 8px;
    font-weight: 700;
    color: var(--color-accent-primary);
    background-color: rgba(255, 107, 0, 0.05);
    border: 1px solid rgba(255, 107, 0, 0.15);
    border-radius: 4px;
    padding: 3px 8px;
  }

  @media (max-width: 900px) {
    .capabilities-layout-12 .scroll-split-wrapper {
      flex-direction: column;
    }
    .capabilities-layout-12 .scroll-content-side,
    .capabilities-layout-12 .sticky-visual-side {
      width: 100%;
    }
    .capabilities-layout-12 .sticky-viewport-panel {
      position: relative;
      top: 0;
    }
    .capabilities-layout-12 .slot-card {
      min-height: auto;
      padding-block: var(--space-6);
    }
  }
</style>

<script>
  const setupCapabilitiesLayout12 = () => {
    const slots = document.querySelectorAll(".capabilities-layout-12 .slot-card")
    const viewport = document.getElementById("p12-cap-sticky-panel")
    const statusText = document.getElementById("p12-chassis-status")

    const updateChassisState = (idx: number) => {
      if (!viewport || !statusText) return
      // Clear compile classes
      for (let i = 0; i < 5; i++) {
        viewport.classList.remove(`compile-${i}`)
      }
      viewport.classList.add(`compile-${idx}`)
      
      const layerNames = ["SUBAGENTS", "MCPS", "SKILLS", "TOOLS", "AGENTS.MD"]
      statusText.textContent = `ASSEMBLED LAYER: ${layerNames[idx]}`
    }

    // Scroll observing
    const observerOptions = {
      root: null,
      rootMargin: "0px 0px -50% 0px",
      threshold: 0.2
    }

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const idx = parseInt(entry.target.getAttribute("data-index") || "0")
          slots.forEach((s) => s.classList.remove("active"))
          entry.target.classList.add("active")
          updateChassisState(idx)
        }
      })
    }, observerOptions)

    slots.forEach((slot) => observer.observe(slot))

    // Interactive Schema togglers
    const schemaBtns = document.querySelectorAll(".schema-inspect-btn")
    schemaBtns.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation()
        const idx = btn.getAttribute("data-index")
        const drawer = document.getElementById(`p12-schema-drawer-${idx}`)
        if (drawer) {
          const isCollapsed = drawer.classList.toggle("hidden")
          btn.classList.toggle("active", !isCollapsed)
        }
      })
    })

    // Interactive right side pins
    const pins = document.querySelectorAll(".interactive-pin")
    const labels = ["Subagents connected", "MCP bridge alive", "Skills path staged", "Tools active", "AGENTS.md steering locked"]
    pins.forEach((pin, pIdx) => {
      pin.addEventListener("click", () => {
        if (statusText) {
          statusText.textContent = `PIN_0${pIdx + 1}: ${labels[pIdx].toUpperCase()}`
        }
      })
    })
  }

  setupCapabilitiesLayout12()
</script>
