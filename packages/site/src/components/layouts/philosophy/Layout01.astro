---
import { content } from "../../../content/site"
const { philosophy } = content
---

<div class="philosophy-layout-01">
  <div class="container text-center">
    
    <!-- Editorial Category Label -->
    <span class="editorial-label animate-fade-in">POSITIONING / PHILOSOPHY</span>
    
    <!-- Central Main Statement -->
    <h2 class="main-statement animate-fade-in-delayed">{philosophy.headline}</h2>
    
    <!-- Three Columns Stack -->
    <div class="philosophy-columns animate-fade-in-delayed-more">
      {philosophy.items.map((item, idx) => (
        <div class="philosophy-col">
          <div class="col-num">0{idx + 1}</div>
          <h3 class="col-title">{item.label}</h3>
          <p class="col-detail">{item.detail}</p>
        </div>
      ))}
    </div>
    
  </div>
</div>

<style>
  .philosophy-layout-01 {
    padding: var(--space-16) 0;
    display: flex;
    align-items: center;
    min-height: 80vh;
    background-color: #0a0807;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  .text-center {
    text-align: center;
  }

  .editorial-label {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 750;
    letter-spacing: 0.15em;
    color: var(--color-accent-primary);
    text-transform: uppercase;
    display: inline-block;
    margin-bottom: var(--space-6);
  }

  .main-statement {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6.5vw, 4.5rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: var(--color-text-primary);
    margin-bottom: var(--space-12);
    max-width: 18ch;
    margin-inline: auto;
  }

  /* Column layouts */
  .philosophy-columns {
    display: flex;
    justify-content: space-between;
    gap: var(--space-8);
    text-align: left;
    margin-top: var(--space-4);
  }

  .philosophy-col {
    flex: 1;
    position: relative;
    padding-top: var(--space-4);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .col-num {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: bold;
    color: var(--color-accent-primary);
    margin-bottom: var(--space-3);
  }

  .col-title {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: var(--space-2);
    letter-spacing: var(--tracking-tight);
  }

  .col-detail {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    line-height: var(--leading-relaxed);
  }

  /* Responsive styling */
  @media (max-width: 768px) {
    .philosophy-columns {
      flex-direction: column;
      gap: var(--space-8);
    }
  }

  /* Animations */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fadeInUp 0.4s var(--ease-out) forwards;
  }

  .animate-fade-in-delayed {
    opacity: 0;
    animation: fadeInUp 0.4s var(--ease-out) 0.15s forwards;
  }

  .animate-fade-in-delayed-more {
    opacity: 0;
    animation: fadeInUp 0.4s var(--ease-out) 0.3s forwards;
  }
</style>
