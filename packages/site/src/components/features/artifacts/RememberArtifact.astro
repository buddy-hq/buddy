---
// REMEMBER artifact — not an app mock. The pitch is the loop itself:
// a self-check with one miss, and that miss reborn as a flashcard
// with a review schedule. Wrong answers become memory.
---

<div class="ra-stage" aria-label="A quiz with one missed question, turned into a flashcard scheduled for review">

  <!-- The self-check -->
  <article class="ra-quiz">
    <header class="ra-quiz-head">
      <span class="ra-quiz-title">Self-Reliance · self-check</span>
      <span class="ra-score">7/10</span>
    </header>

    <div class="ra-q ra-q--right">
      <span class="ra-q-num" aria-hidden="true">06</span>
      <p class="ra-q-text">Why is “envy ignorance”?</p>
      <span class="ra-mark ra-mark--right" aria-label="answered correctly">✓</span>
    </div>

    <div class="ra-q ra-q--missed">
      <span class="ra-q-num" aria-hidden="true">07</span>
      <p class="ra-q-text">What is “the hobgoblin of little minds”?</p>
      <span class="ra-mark ra-mark--wrong" aria-label="answered incorrectly">✗</span>
    </div>

    <p class="ra-quiz-note">missed → becomes a card</p>
  </article>

  <!-- What the deck actually looks like once a few cards exist. Without this the whole
       lower-left of the frame was empty and the two cards read as floating. The rows are
       cards, not table rows: same material as the deck, receding as their due date does. -->
  <article class="ra-queue">
    <span class="ra-queue-label">Practice · your queue</span>
    <div class="ra-queue-row">
      <span class="ra-queue-q">“Imitation is suicide” — the argument in four words</span>
      <span class="ra-queue-tag ra-queue-tag--now">new</span>
    </div>
    <div class="ra-queue-row">
      <span class="ra-queue-q">Transcendentalism, in one line</span>
      <span class="ra-queue-tag">+4d</span>
    </div>
    <div class="ra-queue-row">
      <span class="ra-queue-q">What is the “iron string”?</span>
      <span class="ra-queue-tag">+12d</span>
    </div>
  </article>

  <!-- The thread from the miss to the deck -->
  <svg class="ra-thread" viewBox="0 0 220 130" fill="none" aria-hidden="true">
    <path d="M8 32 C 90 40, 120 96, 208 88" stroke="var(--accent-border)" stroke-width="1.6" stroke-dasharray="5 6" stroke-linecap="round" />
    <circle cx="8" cy="32" r="3" fill="var(--color-accent-primary)" />
    <path d="M200 82 L 210 88 L 199 93" stroke="var(--accent-border)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
  </svg>

  <!-- The deck it lands in. The card face carries the question and its answer and nothing
       else; the schedule sits under the stack, the way a review queue sits under a deck. -->
  <div class="ra-deck">
    <div class="ra-stack">
      <div class="ra-card ra-card--back-2" aria-hidden="true"></div>
      <div class="ra-card ra-card--back-1" aria-hidden="true"></div>
      <article class="ra-card ra-card--face">
        <span class="ra-card-label">Flashcard · from your misses</span>
        <p class="ra-card-q">What is “the hobgoblin of little minds”?</p>
        <span class="ra-card-rule" aria-hidden="true"></span>
        <p class="ra-card-a">A foolish consistency.</p>
      </article>
    </div>

    <div class="ra-sched" aria-label="Spaced review schedule">
      <span class="ra-sched-pill ra-sched-pill--now">today</span>
      <span class="ra-sched-sep"></span>
      <span class="ra-sched-pill">+4 days</span>
      <span class="ra-sched-sep"></span>
      <span class="ra-sched-pill">+12 days</span>
    </div>
  </div>
</div>

<style>
  .ra-stage {
    position: relative;
    width: 100%;
    height: 100%;
    container-type: size;
  }


  /* ---------- the self-check ---------- */
  .ra-quiz {
    position: absolute;
    left: 6%;
    top: 8%;
    width: 41%;
    transform: rotate(-1.6deg);
    font-size: clamp(10px, 1.35cqw, 16px);
    background: linear-gradient(180deg, var(--chrome-panel), var(--chrome-sunken));
    border: 1px solid var(--border-weak);
    border-radius: 0.8em;
    padding: 1.5em 1.7em;
    box-shadow: var(--shadow-overlay);
  }

  /* ---------- the practice queue, under the self-check ----------
     No panel around it. A tray with ruled rows was a third dark rounded rectangle on a stage
     that already had two, and it made the queue read as another screen when what it holds is
     three more of the same object the deck is made of. So the rows carry the chrome instead,
     and the panel goes away. */
  .ra-queue {
    position: absolute;
    left: 9%;
    top: 58%;
    width: 41%;
    transform: rotate(-1.1deg);
    font-size: clamp(9px, 1.2cqw, 14px);
    display: flex;
    flex-direction: column;
    gap: 0.5em;
  }

  .ra-queue-label {
    font-family: var(--font-mono);
    font-size: 0.78em;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-base);
    margin-bottom: 0.35em;
  }

  /* Each row is a card lying flat. They step down the same ladder the deck's back cards use,
     so the queue recedes into the future rather than sitting flat as a list. */
  .ra-queue-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8em;
    background-color: var(--chrome-doc);
    border: 1px solid var(--border-base);
    border-radius: 0.65em;
    padding: 0.85em 1em;
    box-shadow: var(--shadow-raised);
  }

  .ra-queue-row:nth-of-type(2) {
    background-color: var(--chrome-base);
  }

  .ra-queue-row:nth-of-type(3) {
    background-color: var(--chrome-bar);
  }

  .ra-queue-q {
    color: var(--fg-weak);
    line-height: 1.35;
  }

  .ra-queue-row:nth-of-type(3) .ra-queue-q {
    color: var(--fg-weaker);
  }

  .ra-queue-tag {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.8em;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--fg-weaker);
    /* Transparent, not a fill: the three rows now sit on three different rungs, and any fixed
       pill colour is recessed on one of them and raised on another. */
    background-color: transparent;
    border: 1px solid var(--border-base);
    border-radius: 999px;
    padding: 0.25em 0.7em;
  }

  .ra-queue-tag--now {
    color: var(--accent-base);
    background-color: var(--accent-weak);
    border-color: var(--accent-border);
  }

  .ra-quiz-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1em;
    padding-bottom: 1em;
    border-bottom: 1px solid var(--border-weak);
  }

  .ra-quiz-title {
    font-family: var(--font-mono);
    font-size: 0.68em;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .ra-score {
    font-family: var(--font-mono);
    font-size: 0.68em;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--color-accent-primary);
    background-color: var(--accent-weak);
    border: 1px solid var(--accent-border);
    border-radius: 999px;
    padding: 0.3em 0.85em;
  }

  .ra-q {
    display: flex;
    align-items: baseline;
    gap: 0.9em;
    padding: 1em 0.2em;
  }

  /* A numbered row is what separates a quiz from a list of sentences. */
  .ra-q-num {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 0.72em;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--fg-weaker);
  }

  .ra-q + .ra-q {
    border-top: 1px solid var(--border-weak);
  }

  .ra-q-text {
    flex: 1 1 auto;
    font-size: 0.92em;
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .ra-q--missed {
    margin: 0 -0.6em;
    padding-inline: 0.8em;
    border-radius: 0.5em;
    background-color: var(--accent-weak);
    border-top: none !important;
  }

  .ra-q--missed .ra-q-text {
    color: var(--color-text-primary);
  }

  .ra-q--missed .ra-q-num {
    color: var(--color-accent-primary);
  }

  .ra-mark {
    flex: 0 0 auto;
    font-size: 0.85em;
    font-weight: 700;
  }

  .ra-mark--right {
    color: #4ade80;
  }

  .ra-mark--wrong {
    color: #f87171;
  }

  .ra-quiz-note {
    font-family: var(--font-mono);
    font-size: 0.62em;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent-primary);
    margin: 1.1em 0 0 0;
  }

  /* ---------- the thread ---------- */
  .ra-thread {
    position: absolute;
    left: 42%;
    top: 30%;
    width: 24%;
    height: auto;
    overflow: visible;
  }

  /* ---------- the deck ---------- */
  .ra-deck {
    position: absolute;
    right: 6%;
    top: 34%;
    width: 33%;
    font-size: clamp(10px, 1.3cqw, 15px);
  }

  /* An index-card footprint, not a text block. The self-check above is a screen — it sits
     below the page on the chrome ladder — so the card climbs above it instead: lighter than
     the page, squat, centred, with the two cards behind it far enough out to read as a pile.
     The old 0.7em nudge vanished the moment the card narrowed to phone width, which left two
     identical dark rectangles stacked down the stage. */
  .ra-stack {
    position: relative;
    aspect-ratio: 1.62;
  }

  .ra-card {
    position: absolute;
    inset: 0;
    background-color: var(--chrome-doc);
    border: 1px solid var(--border-base);
    border-radius: 1.1em;
  }

  .ra-card--face {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.8em;
    text-align: center;
    padding: 2.6em 1.6em 1.6em;
    box-shadow: var(--shadow-overlay);
  }

  .ra-card--back-1 {
    background-color: var(--chrome-base);
    transform: rotate(4.5deg) translate(4%, -4%);
  }

  .ra-card--back-2 {
    background-color: var(--chrome-bar);
    transform: rotate(-5deg) translate(-5%, 3%);
  }

  .ra-card-label {
    position: absolute;
    top: 1.3em;
    left: 1.4em;
    right: 1.4em;
    font-family: var(--font-mono);
    font-size: 0.62em;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--color-accent-primary);
  }

  .ra-card-q {
    font-family: var(--font-display);
    font-size: 1.08em;
    font-weight: 550;
    line-height: 1.35;
    letter-spacing: -0.014em;
    color: var(--color-text-primary);
    margin: 0;
  }

  /* The fold between the two faces of the card. */
  .ra-card-rule {
    width: 2.6em;
    height: 1px;
    background-color: var(--border-base);
  }

  .ra-card-a {
    font-size: 0.9em;
    line-height: 1.4;
    color: #4ade80;
    margin: 0;
  }

  /* Under the deck, where a review queue belongs — the card face stays a card face. */
  .ra-sched {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.55em;
    margin-top: 1.2em;
  }

  .ra-sched-pill {
    font-family: var(--font-mono);
    font-size: 0.6em;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
    background-color: var(--chrome-raised);
    border-radius: 999px;
    padding: 0.4em 1em;
    white-space: nowrap;
  }

  .ra-sched-pill--now {
    color: var(--color-accent-primary);
    background-color: var(--accent-weak);
  }

  .ra-sched-sep {
    flex: 0 0 auto;
    width: 0.9em;
    height: 1px;
    background-color: var(--chrome-high);
  }

  /* ---------- compact stage ----------
     700px, not 640px, and a container query rather than a viewport one: below 960px the
     staged wrapper is pinned to a 680px canvas and shown through a clip window narrower than
     itself — down to ~81% of it at 800px of viewport and ~52% on a phone. A viewport query
     that lets the wide layout survive into that band does not save the composition, it just
     moves the damage: the deck sits at the canvas's right edge, so the flashcard — the whole
     point of the beat — gets sliced mid-question by the clip.

     What fits in that window is two beats, not four. The practice queue and the thread are
     what turned this into a pile — the deck landed on top of the queue, and the thread
     pointed across a column that had been stacked underneath it. Both drop out; "missed →
     becomes a card" still carries the link. */
  @container (max-width: 700px) {
    .ra-queue,
    .ra-thread {
      display: none;
    }

    .ra-quiz {
      left: 4%;
      top: 2.5%;
      width: 47%;
      font-size: clamp(12px, 1.35cqw, 16px);
    }

    .ra-deck {
      right: auto;
      left: 4%;
      top: 44%;
      width: 47%;
      font-size: clamp(13px, 1.3cqw, 15px);
    }

    /* A shallower card than the desktop 5×3. At phone width the deck is only ~320px across,
       and a full index-card ratio pushes the schedule pills into the stage's bottom feather. */
    .ra-stack {
      aspect-ratio: 1.8;
    }
  }
</style>
