---
// REMEMBER artifact — not an app mock. The pitch is the loop itself:
// a self-check with one miss, and that miss reborn as a flashcard
// with a review schedule. Wrong answers become memory.
---

<div class="ra-stage" aria-label="A quiz with one missed question, turned into a flashcard scheduled for review">
  <div class="ra-dots" aria-hidden="true"></div>

  <!-- The self-check -->
  <article class="ra-quiz">
    <header class="ra-quiz-head">
      <span class="ra-quiz-title">Self-Reliance · self-check</span>
      <span class="ra-score">7/10</span>
    </header>

    <div class="ra-q ra-q--right">
      <p class="ra-q-text">Why is “envy ignorance”?</p>
      <span class="ra-mark ra-mark--right" aria-label="answered correctly">✓</span>
    </div>

    <div class="ra-q ra-q--missed">
      <p class="ra-q-text">What is “the hobgoblin of little minds”?</p>
      <span class="ra-mark ra-mark--wrong" aria-label="answered incorrectly">✗</span>
    </div>

    <p class="ra-quiz-note">missed → becomes a card</p>
  </article>

  <!-- The thread from the miss to the deck -->
  <svg class="ra-thread" viewBox="0 0 220 130" fill="none" aria-hidden="true">
    <path d="M8 32 C 90 40, 120 96, 208 88" stroke="rgba(255, 107, 0, 0.55)" stroke-width="1.6" stroke-dasharray="5 6" stroke-linecap="round" />
    <circle cx="8" cy="32" r="3" fill="var(--color-accent-primary)" />
    <path d="M200 82 L 210 88 L 199 93" stroke="rgba(255, 107, 0, 0.8)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
  </svg>

  <!-- The deck it lands in -->
  <div class="ra-deck">
    <div class="ra-card ra-card--back-2" aria-hidden="true"></div>
    <div class="ra-card ra-card--back-1" aria-hidden="true"></div>
    <div class="ra-card">
      <span class="ra-card-label">Flashcard · from your misses</span>
      <p class="ra-card-q">What is “the hobgoblin of little minds”?</p>
      <p class="ra-card-a">A foolish consistency.</p>
      <div class="ra-sched" aria-label="Spaced review schedule">
        <span class="ra-sched-pill ra-sched-pill--now">today</span>
        <span class="ra-sched-sep"></span>
        <span class="ra-sched-pill">+4 days</span>
        <span class="ra-sched-sep"></span>
        <span class="ra-sched-pill">+12 days</span>
      </div>
    </div>
  </div>
</div>

<style>
  .ra-stage {
    position: relative;
    width: 100%;
    height: 100%;
    container-type: size;
    background:
      radial-gradient(55% 75% at 22% 20%, rgba(255, 107, 0, 0.06), transparent 70%),
      radial-gradient(50% 70% at 82% 85%, rgba(255, 143, 102, 0.05), transparent 70%);
  }

  .ra-dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: 22px 22px;
    mask-image: radial-gradient(70% 70% at 50% 50%, black, transparent);
    pointer-events: none;
  }

  /* ---------- the self-check ---------- */
  .ra-quiz {
    position: absolute;
    left: 6%;
    top: 12%;
    width: 41%;
    transform: rotate(-1.6deg);
    font-size: clamp(10px, 1.35cqw, 16px);
    background: linear-gradient(180deg, #17171b, #121216);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 0.8em;
    padding: 1.5em 1.7em;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.05) inset,
      0 30px 60px -24px rgba(0, 0, 0, 0.85);
  }

  .ra-quiz-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1em;
    padding-bottom: 1em;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .ra-quiz-title {
    font-family: var(--font-mono);
    font-size: 0.68em;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .ra-score {
    font-family: var(--font-mono);
    font-size: 0.68em;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--color-accent-primary);
    background-color: rgba(255, 107, 0, 0.09);
    border: 1px solid rgba(255, 107, 0, 0.22);
    border-radius: 999px;
    padding: 0.3em 0.85em;
  }

  .ra-q {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1em;
    padding: 1em 0.2em;
  }

  .ra-q + .ra-q {
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .ra-q-text {
    font-size: 0.92em;
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .ra-q--missed {
    margin: 0 -0.6em;
    padding-inline: 0.8em;
    border-radius: 0.5em;
    background-color: rgba(255, 107, 0, 0.06);
    border-top: none !important;
  }

  .ra-q--missed .ra-q-text {
    color: var(--color-text-primary);
  }

  .ra-mark {
    flex: 0 0 auto;
    font-size: 0.85em;
    font-weight: 700;
  }

  .ra-mark--right {
    color: #4ade80;
  }

  .ra-mark--wrong {
    color: #f87171;
  }

  .ra-quiz-note {
    font-family: var(--font-mono);
    font-size: 0.62em;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent-primary);
    margin: 1.1em 0 0 0;
  }

  /* ---------- the thread ---------- */
  .ra-thread {
    position: absolute;
    left: 42%;
    top: 30%;
    width: 24%;
    height: auto;
    overflow: visible;
  }

  /* ---------- the deck ---------- */
  .ra-deck {
    position: absolute;
    right: 6%;
    top: 34%;
    width: 33%;
    font-size: clamp(10px, 1.3cqw, 15px);
  }

  .ra-card {
    position: relative;
    background: linear-gradient(180deg, #1a1a1f, #141419);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 1em;
    padding: 1.4em 1.6em;
    box-shadow: 0 26px 52px -22px rgba(0, 0, 0, 0.9);
  }

  .ra-card--back-1,
  .ra-card--back-2 {
    position: absolute;
    inset: 0;
    padding: 0;
  }

  .ra-card--back-1 {
    transform: rotate(3deg) translate(0.7em, -0.5em);
    opacity: 0.7;
  }

  .ra-card--back-2 {
    transform: rotate(-3.4deg) translate(-0.8em, 0.6em);
    opacity: 0.45;
  }

  .ra-card-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.62em;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--color-accent-primary);
    margin-bottom: 1em;
  }

  .ra-card-q {
    font-family: var(--font-display);
    font-size: 1.08em;
    font-weight: 550;
    line-height: 1.35;
    letter-spacing: -0.014em;
    color: var(--color-text-primary);
    margin: 0 0 0.55em 0;
  }

  .ra-card-a {
    font-size: 0.9em;
    line-height: 1.4;
    color: #4ade80;
    margin: 0 0 1.2em 0;
  }

  .ra-sched {
    display: flex;
    align-items: center;
    gap: 0.55em;
    padding-top: 1em;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .ra-sched-pill {
    font-family: var(--font-mono);
    font-size: 0.6em;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
    background-color: rgba(255, 255, 255, 0.045);
    border-radius: 999px;
    padding: 0.4em 1em;
    white-space: nowrap;
  }

  .ra-sched-pill--now {
    color: var(--color-accent-primary);
    background-color: rgba(255, 107, 0, 0.09);
  }

  .ra-sched-sep {
    flex: 0 0 auto;
    width: 0.9em;
    height: 1px;
    background-color: rgba(255, 255, 255, 0.14);
  }

  /* ---------- compact stage (mobile peek): stack the deck under the quiz
       so both beats stay inside the visible sliver ---------- */
  @container (max-width: 700px) {
    .ra-quiz {
      left: 5%;
      top: 8%;
      width: 52%;
    }

    .ra-thread {
      left: 22%;
      top: 40%;
      width: 30%;
    }

    .ra-deck {
      right: auto;
      left: 20%;
      top: 49%;
      width: 46%;
    }
  }
</style>
