---
const steps = [
  {
    num: "01",
    tag: "INGEST",
    title: "Lorem ipsum dolor sit amet",
    subtext: "Consectetur adipiscing elit. Phasellus imperdiet, nulla et dictum interdum, nisi lorem egestas vitae.",
    mockTitle: "workspace_import.json"
  },
  {
    num: "02",
    tag: "INTERACT",
    title: "Sodales tempor convallis vel",
    subtext: "Curabitur vulputate porta dui vel finibus. Class aptent taciti sociosqu ad litora torquent per conubia nostra.",
    mockTitle: "socratic_dialogue.py"
  },
  {
    num: "03",
    tag: "RETAIN",
    title: "Aliquam erat volutpat suspendisse",
    subtext: "Integer elementum, lorem ut luctus hendrerit, ante sem rhoncus sem, ac sollicitudin ante lorem et magna.",
    mockTitle: "spaced_repetition.db"
  }
]
---

<div class="bento-layout-grid">
  <!-- Main visual stage (takes 2 columns) -->
  <div class="bento-card bento-hero-card">
    <div class="bento-text-top">
      <div class="step-meta">
        <span class="step-number" data-numeric>{steps[1].num}</span>
        <span class="step-tag">{steps[1].tag}</span>
      </div>
      <h3 class="bento-title">{steps[1].title}</h3>
      <p class="bento-desc">{steps[1].subtext}</p>
    </div>
    <div class="bento-visual-area">
      <div class="sticky-mockup-wrapper">
        <div class="mockup-header-bar">
          <div class="mockup-dots"><span></span><span></span><span></span></div>
          <div class="mockup-tab-title">{steps[1].mockTitle}</div>
        </div>
        <div class="mockup-viewport">
          <div class="mock-chat-box">
            <div class="chat-bubble bot">Lorem ipsum dolor sit amet?</div>
            <div class="chat-bubble user">Consectetur adipiscing elit.</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Side cards -->
  <div class="bento-card bento-side-card flex-col">
    <div class="bento-text-top">
      <div class="step-meta">
        <span class="step-number" data-numeric>{steps[0].num}</span>
        <span class="step-tag">{steps[0].tag}</span>
      </div>
      <h3 class="bento-title">{steps[0].title}</h3>
      <p class="bento-desc">{steps[0].subtext}</p>
    </div>
    <div class="bento-visual-area mini">
      <div class="mock-import-box">
        <div class="file-row">📄 textbook.pdf</div>
      </div>
    </div>
  </div>

  <div class="bento-card bento-side-card flex-col">
    <div class="bento-text-top">
      <div class="step-meta">
        <span class="step-number" data-numeric>{steps[2].num}</span>
        <span class="step-tag">{steps[2].tag}</span>
      </div>
      <h3 class="bento-title">{steps[2].title}</h3>
      <p class="bento-desc">{steps[2].subtext}</p>
    </div>
    <div class="bento-visual-area mini">
      <div class="mock-recall-box">
        <div class="recall-stats">
          <div class="stat-bar"><div class="fill" style="width: 85%"></div></div>
        </div>
      </div>
    </div>
  </div>
</div>

<style is:global>
  .bento-layout-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    grid-template-rows: auto auto;
    gap: var(--space-6);
    max-width: 960px;
    margin: 0 auto;
  }

  .bento-card {
    background-color: rgba(22, 19, 18, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    padding: var(--space-6);
    display: flex;
    gap: var(--space-6);
    overflow: hidden;
  }

  .bento-card.flex-col {
    flex-direction: column;
    justify-content: space-between;
  }

  .bento-hero-card {
    grid-column: 1 / 2;
    grid-row: 1 / 3;
    flex-direction: column;
    justify-content: space-between;
  }

  .bento-side-card {
    grid-column: 2 / 3;
  }

  .bento-title {
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 700;
    margin-bottom: var(--space-2);
    color: var(--color-text-primary);
  }

  .bento-desc {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    line-height: var(--leading-relaxed);
  }

  .bento-visual-area {
    flex: 1;
    margin-top: var(--space-4);
  }

  .bento-visual-area.mini {
    background-color: rgba(0, 0, 0, 0.15);
    border-radius: 8px;
    padding: var(--space-3);
    min-height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (max-width: 900px) {
    .bento-layout-grid {
      grid-template-columns: 1fr;
    }
    .bento-hero-card {
      grid-column: 1;
      grid-row: auto;
    }
    .bento-side-card {
      grid-column: 1;
    }
  }
</style>
