---
type Props = {
  narrative?: string
}

const { narrative } = Astro.props
---

<section class="features-section" data-analytics-section="features">
  <div class="container">
    {narrative && <p class="feature-narrative reveal">{narrative}</p>}
    <div class="bookend-cards-stack">
      <slot />
    </div>
  </div>
</section>

<style is:global>

  /* The thread that ties the four beats together: one unit, start to finish. */
  .feature-narrative {
    max-width: min(85vw, 1630px);
    margin: 0 auto var(--space-16) auto;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  @media (max-width: 960px) {
    .feature-narrative {
      max-width: 100%;
      margin-bottom: var(--space-10);
    }
  }

  .bookend-cards-stack {
    max-width: min(85vw, 1630px);
    width: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0;
    position: relative;
    padding-top: 0;
    padding-bottom: 0;
  }

  .bookend-card-wrapper {
    position: relative;
    top: 0;
    width: 100%;
    margin-bottom: 96px;
    padding-bottom: 96px;
  }

  .bookend-card-wrapper::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    height: 1px;
    background-color: var(--border);
  }

  .bookend-card-wrapper:last-child {
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .bookend-card-wrapper:last-child::after {
    display: none;
  }

  .bookend-card-body {
    background-color: transparent;
    border: none;
    border-radius: 0;
    padding: 0;
    width: 100%;
    max-width: 100%;
    aspect-ratio: auto;
    max-height: none;
    box-shadow: none;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 32px;
    overflow: visible;
  }

  .bookend-card-left {
    width: 100%;
    max-width: 800px;
    margin-left: 0;
    margin-right: auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    position: relative;
    z-index: 5;
  }

  .bookend-card-right {
    position: relative;
    width: 100%;
    max-width: 100%;
    margin-left: 0;
    margin-right: auto;
    z-index: 1;
    display: flex;
    justify-content: flex-start;
  }

  .step-title {
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    margin-top: 0;
    margin-bottom: var(--space-4);
    color: var(--color-text-primary);
  }

  @media (max-width: 992px) {
    .step-title {
      font-size: 28px;
    }
  }

  @media (max-width: 576px) {
    .step-title {
      font-size: 22px;
    }
  }

  .step-desc {
    color: var(--color-text-tertiary);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    max-width: 55ch;
  }

  /* Shared Mockup Styles */
  .sticky-mockup-wrapper {
    background-color: #0b0b0d; /* Slate black bezel frame */
    border: 1px solid var(--border); /* Outer bezel outline */
    border-radius: calc(var(--radius) + 6px); /* Rounded bezel frame matching concentric math */
    padding: 6px; /* Even thinner gutter around the mock */
    overflow: hidden;
    width: 100%;
    aspect-ratio: 16 / 10;
    box-shadow: var(--shadow-card);
    transition: transform 0.4s var(--ease-out);
  }

  .sticky-mockup-wrapper:hover {
    transform: translateY(-6px);
  }

  .mockup-header-bar {
    display: flex;
    align-items: center;
    height: 36px;
    background-color: rgba(0, 0, 0, 0.2);
    border-bottom: 1px solid var(--border-weak);
    padding-inline: var(--space-4);
    gap: var(--space-4);
  }

  .mockup-dots {
    display: flex;
    gap: 6px;
  }

  .mockup-dots span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--surface-high);
  }

  .mockup-tab-title {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text-muted);
  }

  .mockup-viewport {
    height: 100% !important;
    padding: 0; /* Removed padding completely to let canvas draw edge-to-edge */
    position: relative;
    border-radius: var(--radius); /* Curved inner mockup corners matching standard radius variable */
    overflow: hidden; /* Clips the mockup to the inner rounded corners */
    background-color: var(--color-mock-bg);
  }

  .mockup-viewport .swap {
    position: absolute !important;
    inset: 0 !important;
    height: 100% !important;
  }

  .mock-import-box, .mock-chat-box, .mock-recall-box {
    display: flex;
    flex-direction: column;
    height: 100%;
    gap: var(--space-4);
  }

  .mock-drag-zone {
    flex: 1;
    border: 1px dashed var(--border-base);
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .mock-file-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .file-row {
    background-color: var(--surface-base);
    border: 1px solid var(--border-weak);
    border-radius: 6px;
    padding: 8px 12px;
    font-size: var(--text-xs);
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--color-text-secondary);
  }

  .file-row .size {
    color: var(--color-text-muted);
  }

  .active-upload {
    border-color: rgba(255, 107, 0, 0.2) !important;
    background-color: rgba(255, 107, 0, 0.02) !important;
    display: flex;
    flex-direction: column;
    align-items: stretch !important;
    gap: 6px;
  }

  .upload-info {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    width: 100%;
  }

  .upload-info .pct {
    color: var(--color-accent-primary);
    font-weight: 600;
  }

  .upload-progress-bar {
    height: 4px;
    background-color: var(--surface-raised);
    border-radius: 99px;
    overflow: hidden;
    width: 100%;
  }

  .upload-progress-bar .fill {
    height: 100%;
    background-color: var(--color-accent-primary);
  }

  .chat-bubble {
    padding: 8px 12px;
    border-radius: 8px;
    font-size: var(--text-xs);
    max-width: 80%;
  }

  .chat-bubble.bot {
    background-color: var(--surface-base);
    align-self: flex-start;
    color: var(--color-text-secondary);
  }

  .chat-bubble.user {
    background-color: rgba(255, 107, 0, 0.1);
    color: var(--color-accent-primary);
    align-self: flex-end;
  }

  .chat-input-line {
    margin-top: auto;
    border: 1px solid var(--border-base);
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 6px;
    padding: 8px 12px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .chat-input-line kbd {
    background-color: var(--surface-raised);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 9px;
  }

  .flashcard-preview {
    flex: 1;
    border: 1px solid var(--border-weak);
    border-radius: 8px;
    background-color: var(--surface-base);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--space-4);
    text-align: center;
  }

  .flashcard-preview p {
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .flashcard-options {
    margin-top: auto;
    width: 100%;
  }

  .card-option-btn {
    width: 100%;
    background-color: var(--surface-base);
    border: 1px solid var(--border-base);
    color: var(--color-text-primary);
    border-radius: 6px;
    padding: 8px 16px;
    font-size: var(--text-xs);
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s var(--ease-out);
  }

  .card-option-btn:hover {
    background-color: rgba(255, 107, 0, 0.1);
    border-color: rgba(255, 107, 0, 0.25);
    color: var(--color-accent-primary);
  }

  .badge-mini {
    font-size: 8px;
    color: var(--color-accent-primary);
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.1em;
    display: block;
    margin-bottom: 6px;
  }

  .recall-stats {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .stat-row-flex {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: 4px;
  }

  .stat-item {
    flex: 1;
    background-color: var(--surface-base);
    border: 1px solid var(--border-weak);
    border-radius: 6px;
    padding: 8px;
    text-align: center;
  }

  .stat-val {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .stat-lbl {
    font-size: 8px;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 2px;
  }

  .stat-progress-bar {
    height: 4px;
    background-color: var(--surface-raised);
    border-radius: 99px;
    overflow: hidden;
    width: 100%;
  }

  .stat-progress-bar .fill {
    height: 100%;
    background-color: var(--color-accent-cool);
  }

  .step-tag-wrapper {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    margin-bottom: var(--space-2);
  }

  .step-tag {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 700;
    color: var(--color-accent-primary);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .step-num {
    color: var(--color-text-muted);
    margin-right: var(--space-2);
  }

  .step-num::after {
    content: "·";
    margin-left: var(--space-2);
    color: var(--color-text-muted);
  }

  /* Artifact stage — drafted handouts shown as-is, no app bezel */
  .sticky-mockup-wrapper--stage {
    background-color: transparent;
    border-color: transparent;
    box-shadow: none;
    padding: 0;
  }

  .sticky-mockup-wrapper--stage .mockup-viewport {
    background-color: transparent;
  }

  @media (max-width: 960px) {
    .bookend-cards-stack {
      width: 100%;
      max-width: 100%;
      padding-top: 0;
      gap: 0;
    }
    .bookend-tab-leaf {
      display: none !important;
    }
    .bookend-card-body {
      background-color: transparent !important;
      border: none !important;
      border-radius: 0 !important;
      box-shadow: none !important;
      backdrop-filter: none !important;
      padding: 0 !important;
      aspect-ratio: auto !important;
      display: flex;
      flex-direction: column-reverse; /* Screenshot at top, text at bottom */
      gap: var(--space-4);
      width: 100%;
      overflow: visible !important;
    }
    .bookend-card-left {
      width: 100%;
      transform: none !important;
      transition: none !important;
    }
    .bookend-card-right {
      position: relative;
      top: auto !important;
      left: auto !important;
      bottom: auto !important;
      right: auto !important;
      /* App mocks stay aligned with the text column and bleed to the right
         edge only, so the rounded bezel and right-side fade read as a peek. */
      width: calc(100% + var(--space-6));
      margin-left: 0;
      margin-right: calc(-1 * var(--space-6));
      transform: none !important;
      transition: none !important;
      overflow: hidden;
      display: flex;
      justify-content: flex-start;
      padding-top: var(--space-4);
      padding-bottom: 0;
      background: none !important;
    }
    /* Staged artifacts are bezel-free sheets sized wider than the screen;
       they bleed both edges so the sheet insets land on the text gutter. */
    .bookend-card-right--stage {
      width: calc(100% + var(--space-6) * 2);
      margin-left: calc(-1 * var(--space-6));
      margin-right: calc(-1 * var(--space-6));
    }
    /* Feathers the two edges where the oversized sheet bleeds past the viewport.
       Two failure modes to stay between: start the ramp too early (this began at 50% of
       the height and 65% of the width) and the page background buries half the artifact —
       unnoticeable on a dark mock, ruinous on the teacher's cream paper. Ramp too fast and
       it stops reading as a fade and becomes a black bar down the edge. So: start late,
       but keep the runway long enough to actually look like a fade. */
    .bookend-card-right::after {
      content: '' !important;
      position: absolute !important;
      inset: 0 !important;
      background:
        linear-gradient(to bottom, transparent 86%, var(--color-bg) 100%),
        linear-gradient(to right, transparent 84%, var(--color-bg) 100%) !important;
      pointer-events: none !important;
      z-index: 10 !important;
    }
    .sticky-mockup-wrapper {
      width: 480px !important;
      min-width: 480px !important;
      max-width: none !important;
      height: auto !important;
      padding: 0 !important;
      aspect-ratio: auto !important;
      box-shadow: none !important;
      border-radius: 12px !important;
      transition: none !important;
    }
    .sticky-mockup-wrapper:hover {
      transform: none !important;
    }
    .mockup-viewport {
      height: 460px !important;
      padding: 0 !important;
      border-radius: var(--radius);
      background-color: var(--color-mock-bg);
    }
    .sticky-mockup-wrapper--stage {
      width: 680px !important;
      min-width: 680px !important;
      background-color: transparent !important;
      border-color: transparent !important;
      border-radius: 0 !important;
    }
    .sticky-mockup-wrapper--stage .mockup-viewport {
      height: 440px !important;
      background-color: transparent !important;
      border-radius: 0 !important;
    }
    [data-analytics-feature="feature_3"] .sticky-mockup-wrapper--stage .mockup-viewport {
      height: 340px !important;
    }

    .bookend-card-wrapper {
      position: relative;
      top: 0 !important;
      margin-bottom: var(--space-12) !important; /* Spacious margin between flush sections */
      padding-bottom: var(--space-12);
      border-bottom: none;
    }
    .bookend-card-wrapper::before {
      content: '';
      position: absolute;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 100vw;
      height: 1px;
      background-color: var(--border);
    }
    .bookend-card-wrapper::after {
      display: none !important;
    }
    .bookend-card-wrapper:last-child {
      margin-bottom: 0 !important;
      padding-bottom: 0;
    }
    .bookend-card-wrapper:last-child::before {
      display: none;
    }
    .scroll-gap {
      display: none;
    }
  }

  @media (max-width: 768px) {
    /* Keep the visual's left edge on the same gutter as its copy while allowing the
       oversized mock to peek through the right viewport edge. */
    .bookend-card-right,
    .bookend-card-right--stage {
      width: auto !important;
      max-width: none !important;
      margin-left: 0 !important;
      margin-right: calc(-1 * var(--space-5)) !important;
    }
  }

  @media (max-width: 576px) {
    .bookend-card-body {
      gap: var(--space-6);
    }
    .mockup-viewport {
      height: 360px !important;
      padding: 0 !important;
      overflow: hidden;
      position: relative;
    }
    .sticky-mockup-wrapper {
      width: 100% !important;
      min-width: 0 !important;
    }
    /* Educator artifacts use absolute positioning designed for wide containers.
       Render at desktop-like proportions and let the parent's overflow + gradient
       create a "peek" — same pattern as hero and learner mocks on mobile. */
    .sticky-mockup-wrapper--stage {
      width: 680px !important;
      min-width: 680px !important;
    }
    .sticky-mockup-wrapper--stage .mockup-viewport {
      height: 440px !important;
    }
    [data-analytics-feature-learners="connect"]
      .sticky-mockup-wrapper--stage
      .mockup-viewport {
      height: 320px !important;
    }
    [data-analytics-feature="feature_3"] .sticky-mockup-wrapper--stage .mockup-viewport {
      height: 340px !important;
    }
    .mockup-viewport::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 48px;
      background: linear-gradient(to bottom, transparent, var(--color-bg));
      pointer-events: none;
      z-index: 5;
    }
    .step-title {
      margin-top: 0 !important;
      font-size: 24px !important;
      line-height: 1.25 !important;
    }
    .mockup-header-bar {
      height: 28px;
      padding-inline: var(--space-3);
    }
    .mockup-dots span {
      width: 6px;
      height: 6px;
    }
    .mockup-tab-title {
      font-size: 9px;
    }
  }
</style>
