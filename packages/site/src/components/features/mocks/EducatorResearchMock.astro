---
// Component: EducatorResearchMock
---

<div class="edu-mock" data-research-mock>
  <div class="edu-feed">
    <!-- User message -->
    <div class="user-bubble">Find primary sources on the Indus Valley for grade 6.</div>

    <!-- Tool call: web search -->
    <div class="tool-row">
      <span class="tool-icon">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
      </span>
      <span class="tool-action" data-tool-action>Search</span>
      <span class="tool-subject" data-tool-subject>5 sources</span>
    </div>

    <!-- Assistant response: cited sources list -->
    <div class="assistant-text" data-assistant-text>
      <p>5 sources, reading-level filtered for grade 6:</p>
      <ul>
        <li data-source-row>
          <code>[1]</code>
          <span class="source-title">"The Urban Revolution"</span>
          <span class="source-meta">bbc.co.uk · 8 min</span>
        </li>
        <li data-source-row>
          <code>[2]</code>
          <span class="source-title">"Mohenjo-daro Seal Collection"</span>
          <span class="source-meta">harappa.com · 5 min</span>
        </li>
        <li data-source-row>
          <code>[3]</code>
          <span class="source-title">"Discovering the Indus"</span>
          <span class="source-meta">nationalgeographic.com · 12 min</span>
        </li>
      </ul>
    </div>
  </div>
</div>

<style>
  .edu-mock {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background-color: #0a0908;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
    color: var(--color-text-primary);
    font-family: var(--font-body);
  }

  .edu-feed {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-3);
  }

  /* User message bubble */
  .user-bubble {
    align-self: flex-end;
    max-width: 80%;
    width: fit-content;
    background-color: rgba(255, 255, 255, 0.045);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 14px;
    border-bottom-right-radius: 3px;
    padding: 7px 13px;
    font-size: 12.5px;
    font-weight: 500;
    line-height: 1.4;
    color: var(--color-text-secondary);
  }

  /* Tool call row */
  .tool-row {
    display: flex;
    align-items: center;
    gap: 7px;
    min-width: 0;
  }

  .tool-icon {
    flex-shrink: 0;
    display: flex;
    color: var(--color-text-muted);
  }

  .tool-action {
    flex-shrink: 0;
    font-size: 12px;
    font-weight: 600;
    color: var(--color-text-tertiary);
  }

  .tool-action.running {
    color: transparent;
    background-image: linear-gradient(
      90deg,
      var(--color-text-tertiary) 0%,
      var(--color-text-tertiary) 42%,
      var(--color-text-primary) 50%,
      var(--color-text-tertiary) 58%,
      var(--color-text-tertiary) 100%
    );
    background-size: 250% 100%;
    background-position: 100% 0;
    background-repeat: no-repeat;
    -webkit-background-clip: text;
    background-clip: text;
    animation: shimmer-sweep 1.3s linear infinite;
  }

  @keyframes shimmer-sweep {
    to {
      background-position: -150% 0;
    }
  }

  .tool-subject {
    min-width: 0;
    font-size: 11.5px;
    color: var(--color-text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    opacity: 0;
    transform: translateY(2px);
    transition: opacity 0.3s var(--ease-out), transform 0.3s var(--ease-out);
  }

  .tool-subject.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Assistant response */
  .assistant-text {
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--color-text-tertiary);
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.4s var(--ease-out), transform 0.4s var(--ease-out);
  }

  .assistant-text.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .assistant-text ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 7px;
    margin-top: 8px;
  }

  .assistant-text li {
    display: flex;
    align-items: baseline;
    gap: 7px;
    flex-wrap: wrap;
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.35s var(--ease-out), transform 0.35s var(--ease-out);
  }

  .assistant-text li.visible {
    opacity: 1;
    transform: translateX(0);
  }

  .assistant-text code {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    color: var(--color-text-muted);
  }

  .source-title {
    font-size: 12px;
    color: var(--color-text-secondary);
    font-weight: 500;
  }

  .source-meta {
    flex-basis: 100%;
    margin-left: 22px;
    font-size: 10.5px;
    color: var(--color-text-muted);
  }

  /* Mobile scaling */
  @media (max-width: 576px) {
    .edu-mock {
      padding: var(--space-4) !important;
    }
    .edu-feed {
      gap: var(--space-2) !important;
    }
    .user-bubble {
      font-size: 11px !important;
      padding: 6px 11px !important;
    }
    .tool-action {
      font-size: 10.5px !important;
    }
    .tool-subject {
      font-size: 10px !important;
    }
    .assistant-text {
      font-size: 11px !important;
    }
    .source-title {
      font-size: 10.5px !important;
    }
    .source-meta {
      font-size: 9.5px !important;
    }
  }
</style>

<script>
  document.querySelectorAll("[data-research-mock]").forEach((container) => {
    const toolAction = container.querySelector("[data-tool-action]") as HTMLElement | null;
    const toolSubject = container.querySelector("[data-tool-subject]") as HTMLElement | null;
    const assistantText = container.querySelector("[data-assistant-text]") as HTMLElement | null;
    const rows = Array.from(container.querySelectorAll("[data-source-row]")) as HTMLElement[];

    if (!toolAction || !toolSubject || !assistantText || rows.length === 0) return;

    let isUserInteracting = false;
    let animationTimeout: any = null;

    const stopAutoplay = () => {
      isUserInteracting = true;
      if (animationTimeout) {
        clearTimeout(animationTimeout);
        animationTimeout = null;
      }
    };

    container.addEventListener("click", stopAutoplay);

    const delay = (ms: number) => new Promise(resolve => {
      animationTimeout = setTimeout(resolve, ms);
    });

    const runTimeline = async () => {
      if (isUserInteracting) return;

      // Reset
      toolAction.classList.add("running");
      toolSubject.classList.remove("visible");
      assistantText.classList.remove("visible");
      rows.forEach((row) => row.classList.remove("visible"));

      await delay(1300);
      if (isUserInteracting) return;

      toolAction.classList.remove("running");
      toolSubject.classList.add("visible");
      await delay(400);
      if (isUserInteracting) return;

      assistantText.classList.add("visible");
      await delay(300);
      if (isUserInteracting) return;

      for (const row of rows) {
        row.classList.add("visible");
        await delay(280);
        if (isUserInteracting) return;
      }
    };

    setTimeout(runTimeline, 1000);
  });
</script>
