---
// Component: EducatorPlanMock
---

<div class="edu-mock" data-plan-mock>
  <div class="edu-feed">
    <!-- User message -->
    <div class="user-bubble">Plan a 5-day unit on photosynthesis using the 5E model.</div>

    <!-- Subagent card (matches the real delegated-task pattern) -->
    <div class="subagent-card">
      <div class="subagent-header">
        <span class="subagent-icon" data-subagent-icon>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="10" rx="2"></rect><circle cx="12" cy="5" r="2"></circle><path d="M12 7v4"></path><line x1="8" y1="16" x2="8" y2="16"></line><line x1="16" y1="16" x2="16" y2="16"></line></svg>
        </span>
        <div class="subagent-title-group">
          <span class="subagent-title">Writing your unit plan</span>
          <span class="subagent-activity" data-subagent-activity>Working…</span>
        </div>
        <span class="subagent-pill">goal-writer</span>
      </div>

      <div class="subagent-body" data-subagent-body>
        <ol>
          <li data-plan-row>
            <strong>Engage</strong> — why do leaves look green?
            <em>Remember · DOK 1</em>
          </li>
          <li data-plan-row>
            <strong>Explore</strong> — investigate light &amp; CO₂ in a hands-on lab
            <em>Apply · DOK 2</em>
          </li>
          <li data-plan-row>
            <strong>Explain</strong> — model the light and dark reactions
            <em>Understand · DOK 2</em>
          </li>
          <li data-plan-row>
            <strong>Elaborate</strong> — compare photosynthesis across plant types
            <em>Analyze · DOK 3</em>
          </li>
          <li data-plan-row>
            <strong>Evaluate</strong> — summative: design your own experiment
            <em>Create · DOK 4</em>
          </li>
        </ol>
      </div>
    </div>
  </div>
</div>

<style>
  .edu-mock {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background-color: #0a0908;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
    color: var(--color-text-primary);
    font-family: var(--font-body);
  }

  .edu-feed {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-3);
  }

  /* User message bubble: sharp bottom-right corner, matches the real chat pattern */
  .user-bubble {
    align-self: flex-end;
    max-width: 82%;
    width: fit-content;
    background-color: rgba(255, 255, 255, 0.045);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 14px;
    border-bottom-right-radius: 3px;
    padding: 7px 13px;
    font-size: 12.5px;
    font-weight: 500;
    line-height: 1.4;
    color: var(--color-text-secondary);
  }

  /* Subagent card */
  .subagent-card {
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    background-color: rgba(255, 255, 255, 0.02);
    overflow: hidden;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }

  .subagent-header {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 12px;
  }

  .subagent-icon {
    flex-shrink: 0;
    display: flex;
    color: var(--color-text-muted);
    transition: color 0.3s ease;
  }

  .subagent-icon.done {
    color: #10b981;
  }

  .subagent-title-group {
    min-width: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .subagent-title {
    font-size: 12px;
    font-weight: 600;
    color: var(--color-text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .subagent-activity {
    font-size: 10.5px;
    color: var(--color-text-muted);
  }

  .subagent-activity.running {
    color: transparent;
    background-image: linear-gradient(
      90deg,
      var(--color-text-muted) 0%,
      var(--color-text-muted) 42%,
      var(--color-text-tertiary) 50%,
      var(--color-text-muted) 58%,
      var(--color-text-muted) 100%
    );
    background-size: 250% 100%;
    background-position: 100% 0;
    background-repeat: no-repeat;
    -webkit-background-clip: text;
    background-clip: text;
    animation: shimmer-sweep 1.3s linear infinite;
  }

  @keyframes shimmer-sweep {
    to {
      background-position: -150% 0;
    }
  }

  .subagent-pill {
    flex-shrink: 0;
    font-size: 10px;
    font-weight: 600;
    color: var(--color-text-muted);
    background-color: rgba(255, 255, 255, 0.05);
    padding: 2px 7px;
    border-radius: 5px;
  }

  .subagent-body {
    flex-shrink: 1;
    min-height: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding: 10px 12px;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.4s var(--ease-out), transform 0.4s var(--ease-out);
  }

  .subagent-body.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .subagent-body ol {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 7px;
    counter-reset: plan-step;
  }

  .subagent-body li {
    counter-increment: plan-step;
    font-size: 12px;
    line-height: 1.5;
    color: var(--color-text-tertiary);
    padding-left: 16px;
    position: relative;
    opacity: 0;
    transform: translateY(3px);
    transition: opacity 0.35s var(--ease-out), transform 0.35s var(--ease-out);
  }

  .subagent-body li.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .subagent-body li::before {
    content: counter(plan-step);
    position: absolute;
    left: 0;
    top: 1px;
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 700;
    color: var(--color-text-muted);
  }

  .subagent-body strong {
    color: var(--color-text-secondary);
    font-weight: 650;
  }

  .subagent-body em {
    display: block;
    font-style: normal;
    font-size: 10.5px;
    color: var(--color-text-muted);
    margin-top: 1px;
  }

  /* Mobile scaling */
  @media (max-width: 576px) {
    .edu-mock {
      padding: var(--space-4) !important;
    }
    .edu-feed {
      gap: var(--space-2) !important;
    }
    .user-bubble {
      font-size: 11px !important;
      padding: 6px 11px !important;
    }
    .subagent-title {
      font-size: 10.5px !important;
    }
    .subagent-activity {
      font-size: 9.5px !important;
    }
    .subagent-body li {
      font-size: 10.5px !important;
    }
    .subagent-body em {
      font-size: 9.5px !important;
    }
  }
</style>

<script>
  document.querySelectorAll("[data-plan-mock]").forEach((container) => {
    const icon = container.querySelector("[data-subagent-icon]") as HTMLElement | null;
    const activity = container.querySelector("[data-subagent-activity]") as HTMLElement | null;
    const body = container.querySelector("[data-subagent-body]") as HTMLElement | null;
    const rows = Array.from(container.querySelectorAll("[data-plan-row]")) as HTMLElement[];

    if (!icon || !activity || !body || rows.length === 0) return;

    let isUserInteracting = false;
    let animationTimeout: any = null;

    const stopAutoplay = () => {
      isUserInteracting = true;
      if (animationTimeout) {
        clearTimeout(animationTimeout);
        animationTimeout = null;
      }
    };

    container.addEventListener("click", stopAutoplay);

    const delay = (ms: number) => new Promise(resolve => {
      animationTimeout = setTimeout(resolve, ms);
    });

    const runTimeline = async () => {
      if (isUserInteracting) return;

      // Reset
      icon.classList.remove("done");
      activity.classList.add("running");
      activity.textContent = "Working…";
      body.classList.remove("visible");
      rows.forEach((row) => row.classList.remove("visible"));

      await delay(1400);
      if (isUserInteracting) return;

      // Subagent completes
      icon.classList.add("done");
      activity.classList.remove("running");
      activity.textContent = "Done";
      body.classList.add("visible");
      await delay(300);
      if (isUserInteracting) return;

      for (const row of rows) {
        row.classList.add("visible");
        await delay(260);
        if (isUserInteracting) return;
      }
    };

    setTimeout(runTimeline, 1000);
  });
</script>
