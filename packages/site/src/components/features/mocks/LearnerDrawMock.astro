---
// Component: LearnerDrawMock
//
// The board works an argument out, it does not present a concept map. A hub with four
// labelled boxes around it was the same picture as the CONNECT note graph and, in silhouette,
// as the REMEMBER cards — three features, one shape. A derivation shares its shape with
// nothing else on the page, and it is the literal reading of this section's own copy:
// untangle a proof.
//
// The sequence is the pitch, so the chat and the board are one timeline. Buddy lays out the
// two premises; the reader pushes back with the common reading; that line gets written down,
// struck out, and rewritten. The user's question is what changes the drawing — which is the
// difference between a whiteboard and a picture of one.
//
// Strokes carry pathLength="1" so a 30px caret and a 400px strike take the same beat. Order
// comes from data-step, and PHASE_ONE_LAST_STEP is where the board waits for the reader.
---

<div class="draw-mock-container" data-draw-mock>
  <!-- Drawing Board / Canvas Area -->
  <div class="whiteboard-canvas">
    <div class="wb-drawings">
      <!-- viewBox is cropped to the ink plus a margin, not a round 600×380: the drawing area
           is only ~420px wide once the chat panel takes its 320, and on a phone the board is
           ~344px across, so every unused column in the canvas came straight off the size of
           the handwriting. The margin is not optional — the figure is width-bound at both
           sizes, so a box cropped flush to the ink puts the text against the bezel. -->
      <svg class="wb-svg" viewBox="-14 42 500 308" fill="none" preserveAspectRatio="xMidYMid meet">
        <!-- The givens, braced -->
        <path
          class="stroke-chalk"
          data-step="1"
          pathLength="1"
          d="M62 66 C 50 70, 54 116, 46 140 C 54 164, 50 226, 62 230"
          stroke-width="2"
          stroke-linecap="round"
        />
        <text class="hand dim" data-step="1" x="12" y="150" font-size="14">given</text>

        <text class="hand dim" data-step="2" x="82" y="98" font-size="18">1</text>
        <text class="hand ink" data-step="2" x="112" y="98" font-size="21">
          Every man has a genius of his own.
        </text>

        <text class="hand dim" data-step="3" x="82" y="152" font-size="18">2</text>
        <text class="hand ink" data-step="3" x="112" y="152" font-size="21">
          Imitation borrows another&#8217;s.
        </text>

        <!-- Everything below waits for the reader's question -->
        <text class="hand dim" data-step="4" x="82" y="206" font-size="18">3</text>
        <text class="hand dim" data-step="4" x="112" y="206" font-size="21">
          so imitation is the safe road
        </text>

        <path
          class="stroke-wrong"
          data-step="5"
          pathLength="1"
          d="M106 199 C 190 203, 290 195, 388 200"
          stroke-width="2.4"
          stroke-linecap="round"
        />

        <path
          class="stroke-agent"
          data-step="6"
          pathLength="1"
          d="M118 228 L128 214 L138 228"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <text class="hand agent" data-step="6" x="146" y="240" font-size="21">
          so nothing of your own is added
        </text>
        <text class="hand dim" data-step="7" x="146" y="262" font-size="14">step 3, rewritten</text>

        <path
          class="stroke-agent"
          data-step="8"
          pathLength="1"
          d="M92 288 C 200 282, 340 292, 452 286 C 458 300, 454 314, 452 328 C 340 334, 200 324, 92 330 C 86 314, 90 302, 92 288 Z"
          stroke-width="2.4"
          stroke-linecap="round"
        />
        <text class="hand agent" data-step="9" x="112" y="318" font-size="24">&#8756;</text>
        <text class="hand ink" data-step="9" x="146" y="318" font-size="24">Trust thyself.</text>
      </svg>
    </div>

    <!-- Floating Chat Box (Desktop only, hidden on mobile) -->
    <div class="wb-chat-popup">
      <div class="wb-chat-body">
        <!-- First chat message is already visible by default on load -->
        <div class="chat-message buddy m1 visible">
          I&#39;ve put Emerson&#39;s argument on the board — the two premises &#39;Self-Reliance&#39;
          starts from.
        </div>
        <div class="chat-message user m2"></div>
        <div class="chat-message buddy m3"></div>
      </div>

      <div class="wb-chat-input-area">
        <div class="wb-chat-input-placeholder">Ask Buddy...</div>
        <div class="wb-chat-input-footer">
          <div class="dropdowns">
            <span class="dd-pill">DeepSeek V4 Pro</span>
            <span class="dd-pill">Default</span>
          </div>
          <button class="chat-send-btn" aria-label="Send message">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="22" y1="2" x2="11" y2="13"></line>
              <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* Base wrapper */
  .draw-mock-container {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background-color: var(--color-mock-bg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
  }

  /* Canvas area with dot grid */
  .whiteboard-canvas {
    flex: 1;
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    flex-direction: row; /* SIBLING ROW FLOW: drawing stays left, chat stays right */
    justify-content: space-between;
    padding: var(--space-4) var(--space-6) 0 var(--space-6);
    background-color: var(--board-base);
    background-image: radial-gradient(var(--board-grid) 1px, transparent 1px);
    background-size: 30px 30px;
    overflow: hidden;
  }

  /* Drawings container: constrained to the left to absolutely prevent overlapping */
  .wb-drawings {
    flex: 1; /* occupy remaining left width */
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    overflow: hidden;
  }

  /* SVG Vector Drawing scaled to fit left pane without overlap */
  .wb-svg {
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
  }

  /* ═══ Ink ═══ */
  .hand {
    font-family: "Architects Daughter", cursive, sans-serif;
    user-select: none;
  }

  .ink {
    fill: var(--board-ink);
  }

  .dim {
    fill: var(--board-ink-weak);
  }

  .agent {
    fill: var(--agent-base);
  }

  .stroke-chalk {
    stroke: var(--board-ink-weak);
    fill: none;
  }

  .stroke-agent {
    stroke: var(--agent-base);
    fill: none;
  }

  .stroke-wrong {
    stroke: #f87171;
    fill: none;
  }

  /* ═══ The draw ═══
     pathLength="1" normalises every stroke to one beat, whatever its length. Text can't be
     dash-drawn, so it fades on the same beat — which is close to how a word lands when
     someone writes it fast. */
  .wb-svg path[data-step] {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 0.55s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .wb-svg path[data-step].is-drawn {
    stroke-dashoffset: 0;
  }

  .wb-svg text[data-step] {
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .wb-svg text[data-step].is-shown {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .wb-svg path[data-step],
    .wb-svg text[data-step] {
      stroke-dashoffset: 0;
      opacity: 1;
      transition: none;
    }
  }

  /* Floating Chat Box Popup (matches screenshot exactly) - Header-Free */
  .wb-chat-popup {
    width: 320px;
    background-color: var(--color-mock-panel);
    border: 1px solid var(--border-weak);
    border-bottom: none;
    border-radius: 12px 12px 0 0;
    box-shadow: var(--shadow-raised);
    display: flex;
    flex-direction: column;
    z-index: 20;
    overflow: hidden;
    backdrop-filter: blur(8px);
    flex-shrink: 0; /* Keep static width */
    margin-left: var(--space-4);
    align-self: flex-end; /* Align flush to bottom */
  }

  /* Message log layout with natural flow (no bubbles for Buddy!) - TALLER height */
  .wb-chat-body {
    flex: 1;
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    min-height: 240px; /* Made taller as requested */
    max-height: 300px;
    overflow-y: auto;
  }

  .chat-message {
    font-size: 11px;
    line-height: 1.5;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  .chat-message.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Buddy messages: clean flowing text (matching screenshot) */
  .chat-message.buddy {
    align-self: flex-start;
    background: none !important;
    border: none !important;
    padding: 0 !important;
    color: var(--fg-base);
    max-width: 100% !important;
    text-align: left;
  }

  /* User messages: clean pill on the right */
  .chat-message.user {
    align-self: flex-end;
    background-color: var(--chrome-raised);
    border: 1px solid var(--border-weak);
    color: var(--fg-base);
    padding: var(--space-2) var(--space-3);
    border-radius: 12px;
    max-width: 85%;
    text-align: left;
  }

  /* Bottom chat prompt input box (matches screenshot) */
  .wb-chat-input-area {
    margin: 12px;
    margin-top: 4px;
    padding: 10px;
    border: 1px solid var(--border-base);
    border-radius: 8px;
    background-color: var(--chrome-base);
    display: flex;
    flex-direction: column;
  }

  .wb-chat-input-placeholder {
    color: var(--fg-weaker);
    font-size: 11px;
    padding-bottom: 12px;
    text-align: left;
    min-height: 14px;
  }

  .wb-chat-input-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .dropdowns {
    display: flex;
    gap: 4px;
  }

  .dd-pill {
    font-size: 8px;
    color: var(--fg-weaker);
    background-color: var(--chrome-base);
    border: 1px solid var(--border-weak);
    padding: 2px 5px;
    border-radius: 3px;
  }

  .chat-send-btn {
    background-color: var(--chrome-raised);
    border: 1px solid var(--border-weak);
    color: var(--fg-weaker);
    height: 18px;
    width: 18px;
    border-radius: 3px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .chat-send-btn.active {
    background-color: var(--aurora-base);
    color: #0b0a0c;
    border-color: var(--aurora-base);
  }

  /* Mobile Query block */
  @media (max-width: 576px) {
    .whiteboard-canvas {
      padding: var(--space-3) !important;
      justify-content: center !important;
    }
    .wb-drawings {
      width: 100% !important; /* Take full width on mobile */
      padding-left: 0 !important;
      justify-content: center !important;
    }
    .wb-svg {
      max-width: 100% !important;
      max-height: 310px !important;
    }
    .wb-chat-popup {
      display: none !important; /* Hide the chat popup on mobile as requested */
    }
  }
</style>

<script>
  /** One beat per step: long enough to read as drawing, short enough to finish in a scroll. */
  const STEP_MS = 480
  /** The board stops here and waits for the reader. Everything after is the correction. */
  const PHASE_ONE_LAST_STEP = 3
  const TYPE_MS = 15
  const STREAM_MS = 10

  const READER_QUESTION = "Isn't imitation just the safe road, then?"
  const BUDDY_REPLY =
    "Fair — let's put it on the board as line 3 and test it. It is safe. That's the problem: nothing of your own gets added."
  const INPUT_PLACEHOLDER = "Ask Buddy..."

  type Beat = {
    readonly step: number
    readonly marks: readonly SVGElement[]
  }

  const beatsOf = (root: Element): readonly Beat[] => {
    const byStep = new Map<number, SVGElement[]>()
    for (const mark of root.querySelectorAll<SVGElement>("[data-step]")) {
      const step = Number(mark.dataset.step)
      byStep.set(step, [...(byStep.get(step) ?? []), mark])
    }
    return [...byStep.entries()]
      .sort(([a], [b]) => a - b)
      .map(([step, marks]) => ({ step, marks }))
  }

  document.querySelectorAll("[data-draw-mock]").forEach((container) => {
    const beats = beatsOf(container)
    const m2 = container.querySelector<HTMLElement>(".chat-message.m2")
    const m3 = container.querySelector<HTMLElement>(".chat-message.m3")
    const input = container.querySelector<HTMLElement>(".wb-chat-input-placeholder")
    const sendBtn = container.querySelector<HTMLElement>(".chat-send-btn")

    let isUserInteracting = false
    let timer: number | null = null

    const stopAutoplay = () => {
      isUserInteracting = true
      if (timer !== null) {
        window.clearTimeout(timer)
        timer = null
      }
    }

    container.addEventListener("click", stopAutoplay)

    const delay = (ms: number) =>
      new Promise<void>((resolve) => {
        timer = window.setTimeout(resolve, ms)
      })

    /** Character-by-character, the way the real transcript arrives. */
    const streamText = async (element: HTMLElement, text: string, speed: number) => {
      element.classList.add("visible")
      element.textContent = ""
      for (const character of text) {
        if (isUserInteracting) return
        element.textContent += character
        await delay(speed)
      }
    }

    const clearBoard = () => {
      for (const beat of beats) {
        for (const mark of beat.marks) mark.classList.remove("is-drawn", "is-shown")
      }
    }

    const drawThrough = async (from: number, to: number) => {
      for (const beat of beats) {
        if (beat.step < from || beat.step > to) continue
        if (isUserInteracting) return
        for (const mark of beat.marks) {
          mark.classList.add(mark.tagName === "path" ? "is-drawn" : "is-shown")
        }
        await delay(STEP_MS)
      }
    }

    const lastStep = beats.length === 0 ? 0 : beats[beats.length - 1].step

    const runTimeline = async () => {
      if (isUserInteracting) return

      clearBoard()
      if (m2) {
        m2.classList.remove("visible")
        m2.textContent = ""
      }
      if (m3) {
        m3.classList.remove("visible")
        m3.textContent = ""
      }
      if (input) input.textContent = INPUT_PLACEHOLDER
      sendBtn?.classList.remove("active")

      await delay(300)

      // ── The givens ──────────────────────────────────────────────
      await drawThrough(1, PHASE_ONE_LAST_STEP)
      await delay(700)
      if (isUserInteracting) return

      // ── The reader pushes back ──────────────────────────────────
      if (m2 && input && sendBtn) {
        let typed = ""
        for (const character of READER_QUESTION) {
          if (isUserInteracting) return
          typed += character
          input.textContent = typed
          await delay(TYPE_MS)
        }

        await delay(200)
        sendBtn.classList.add("active")
        await delay(250)

        input.textContent = ""
        sendBtn.classList.remove("active")
        m2.textContent = READER_QUESTION
        m2.classList.add("visible")

        await delay(500)
        if (isUserInteracting) return
      } else {
        // Phone: no chat panel, so the pause stands in for the exchange.
        await delay(1500)
      }

      if (m3) {
        await streamText(m3, BUDDY_REPLY, STREAM_MS)
        await delay(400)
        if (isUserInteracting) return
      }

      // ── Written down, struck out, rewritten ─────────────────────
      await drawThrough(PHASE_ONE_LAST_STEP + 1, lastStep)

      if (input) input.textContent = INPUT_PLACEHOLDER
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue
          observer.unobserve(container)
          void runTimeline()
        }
      },
      { rootMargin: "0px 0px -25% 0px", threshold: 0 },
    )
    observer.observe(container)
  })
</script>
