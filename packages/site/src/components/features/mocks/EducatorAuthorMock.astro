---
// Component: EducatorAuthorMock (merged PLAN + CREATE)
// One prompt, one hero artifact: the lesson timing blocks in, then the
// worksheet opens with its three reading levels as tabs — a cursor clicks
// Support -> Core -> Challenge and the same questions morph at each level.
// Real flow: write tool -> photosynthesis-lesson.md, standard cited from
// search_standards, levels ladder worked example -> guided -> independent.
---

<div class="author-mock" data-author-mock>
  <div class="stage">
    <!-- The one ask -->
    <div class="ask-bubble">Plan a grade 8 photosynthesis lesson — worksheet at three reading levels, exit ticket for Friday.</div>

    <!-- Work row: write tool activity -->
    <div class="work-row">
      <span class="work-icon">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><path d="M14 2v6h6"></path><line x1="9" y1="15" x2="15" y2="15"></line><line x1="9" y1="11" x2="15" y2="11"></line></svg>
      </span>
      <span class="work-activity" data-activity>Reading the grade 8 science standards…</span>
    </div>

    <!-- Lesson identity: title + cited standard + objective (revealed after the standards read) -->
    <div class="doc-head" data-doc-head>
      <div class="doc-title-row">
        <span class="doc-title">Photosynthesis — Grade 8 Lesson</span>
        <span class="doc-std">NGSS MS-LS1-6</span>
      </div>
      <span class="doc-objective">Objective: explain how light, water, and CO₂ become glucose and oxygen.</span>
    </div>

    <!-- The plan: lesson timing as a colored timeline strip -->
    <div class="plan-strip" data-plan-strip>
      <div class="plan-seg seg-donow" style="--i: 0"><span class="seg-name">Do now</span><span class="seg-mins">5′</span></div>
      <div class="plan-seg seg-mini" style="--i: 1"><span class="seg-name">Mini-lesson</span><span class="seg-mins">15′</span></div>
      <div class="plan-seg seg-lab" style="--i: 2"><span class="seg-name">Lab</span><span class="seg-mins">20′</span></div>
      <div class="plan-seg seg-exit" style="--i: 3"><span class="seg-name">Exit ticket</span><span class="seg-mins">5′</span></div>
    </div>

    <!-- The hero: the worksheet with three reading-level tabs -->
    <div class="sheet lvl-support" data-sheet>
      <div class="sheet-accent"></div>
      <div class="level-tabs">
        <button class="level-tab tab-support" data-level-tab="0" type="button">Support</button>
        <button class="level-tab tab-core" data-level-tab="1" type="button">Core</button>
        <button class="level-tab tab-challenge" data-level-tab="2" type="button">Challenge</button>
      </div>
      <div class="sheet-body" data-sheet-body>
        <p class="sheet-q"><span class="q-num">1</span><span class="q-text" data-q-text="0"></span></p>
        <p class="sheet-q"><span class="q-num">2</span><span class="q-text" data-q-text="1"></span></p>
        <p class="sheet-q"><span class="q-num">3</span><span class="q-text" data-q-text="2"></span></p>
      </div>
      <div class="sheet-exit">Exit ticket · Friday — 3 questions, answer key attached</div>
    </div>
  </div>

  <!-- Simulated cursor -->
  <div class="simulated-cursor" data-cursor>
    <div class="cursor-dot"></div>
    <svg class="cursor-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="1.5" stroke-linejoin="round">
      <path d="M4 4l7.07 17 2.51-7.39L21 11.07z" fill="white" stroke="black" stroke-width="1.5" stroke-linejoin="round"/>
    </svg>
    <div class="click-pulse"></div>
  </div>
</div>

<style>
  .author-mock {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background-color: var(--color-mock-bg);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-5);
    color: var(--color-text-primary);
    font-family: var(--font-body);
  }

  .stage {
    width: 100%;
    max-width: min(94%, 980px);
    display: flex;
    flex-direction: column;
    gap: clamp(12px, 1.5vw, 24px);
  }

  /* The ask: user bubble, sharp corner, real chat pattern */
  .ask-bubble {
    align-self: flex-start;
    max-width: 82%;
    width: fit-content;
    background-color: var(--chrome-raised);
    border: 1px solid var(--border-weak);
    border-radius: 14px;
    border-bottom-right-radius: 3px;
    padding: clamp(8px, 0.8vw, 12px) clamp(12px, 1.1vw, 17px);
    font-size: clamp(11.5px, 1vw, 15px);
    font-weight: 500;
    line-height: 1.4;
    color: var(--color-text-secondary);
  }

  /* Work row: write tool activity */
  .work-row {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .work-icon {
    flex-shrink: 0;
    display: flex;
    color: var(--color-text-muted);
  }

  .work-icon svg {
    width: clamp(13px, 1vw, 16px);
    height: auto;
  }

  .work-activity {
    flex: 1;
    min-width: 0;
    font-size: clamp(11px, 0.95vw, 14px);
    font-weight: 600;
    color: var(--color-text-tertiary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .work-activity.running {
    color: transparent;
    background-image: linear-gradient(
      90deg,
      var(--color-text-tertiary) 0%,
      var(--color-text-tertiary) 42%,
      var(--color-text-primary) 50%,
      var(--color-text-tertiary) 58%,
      var(--color-text-tertiary) 100%
    );
    background-size: 250% 100%;
    background-position: 100% 0;
    background-repeat: no-repeat;
    -webkit-background-clip: text;
    background-clip: text;
    animation: tool-shimmer 1.1s linear infinite;
  }

  @keyframes tool-shimmer {
    to {
      background-position: -150% 0;
    }
  }

  /* The plan: a colored timeline strip of classroom blocks */
  .plan-strip {
    display: flex;
    gap: 6px;
    height: clamp(44px, 4.6vw, 74px);
  }

  .plan-seg {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2px;
    padding: 0 clamp(10px, 1.2vw, 18px);
    border-radius: 10px;
    min-width: 0;
    opacity: 0;
    transform: scaleX(0.6);
    transform-origin: left;
    transition: opacity 0.35s var(--ease-out), transform 0.35s var(--ease-out);
    transition-delay: calc(var(--i, 0) * 140ms);
  }

  .plan-strip.visible .plan-seg {
    opacity: 1;
    transform: scaleX(1);
  }

  .seg-name {
    font-size: clamp(10px, 0.95vw, 15px);
    font-weight: 650;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .seg-mins {
    font-family: var(--font-mono);
    font-size: clamp(9px, 0.8vw, 12.5px);
    opacity: 0.75;
  }

  .seg-donow {
    flex: 5;
    background-color: var(--aurora-weak);
    border: 1px solid var(--aurora-border);
    color: var(--aurora-base);
  }

  .seg-mini {
    flex: 15;
    background-color: var(--aurora-weak);
    border: 1px solid var(--aurora-border);
    color: var(--aurora-base);
  }

  .seg-lab {
    flex: 20;
    background-color: var(--aurora-weak);
    border: 1px solid var(--aurora-border);
    color: var(--aurora-base);
  }

  .seg-exit {
    flex: 5;
    background-color: var(--accent-weak);
    border: 1px solid var(--accent-border);
    color: var(--accent-base);
  }

  /* The hero worksheet sheet */
  .sheet {
    position: relative;
    border: 1px solid var(--border-base);
    border-radius: 16px;
    background-color: var(--chrome-base);
    box-shadow: var(--shadow-raised);
    padding: clamp(14px, 1.8vw, 30px);
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.4s var(--ease-out), transform 0.4s var(--ease-out);
    overflow: hidden;
  }

  .sheet.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Colored accent bar, re-tinted per active level */
  .sheet-accent {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    transition: background-color 0.3s ease;
  }

  .sheet.lvl-support .sheet-accent {
    background-color: var(--aurora-base);
    box-shadow: 0 0 18px var(--aurora-border);
  }

  .sheet.lvl-core .sheet-accent {
    background-color: var(--aurora-base);
    box-shadow: 0 0 18px var(--aurora-border);
  }

  .sheet.lvl-challenge .sheet-accent {
    background-color: var(--aurora-base);
    box-shadow: 0 0 18px var(--aurora-border);
  }

  /* Lesson identity, revealed when the standard is cited */
  .doc-head {
    display: flex;
    flex-direction: column;
    gap: 5px;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.35s var(--ease-out), transform 0.35s var(--ease-out);
  }

  .doc-head.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .doc-title-row {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }

  .doc-title {
    font-size: clamp(15px, 1.7vw, 27px);
    font-weight: 650;
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .doc-std {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: clamp(9.5px, 0.85vw, 12.5px);
    font-weight: 600;
    color: var(--color-text-tertiary);
    border: 1px solid var(--border-base);
    border-radius: 6px;
    padding: 3px 9px;
  }

  .doc-objective {
    font-size: clamp(10.5px, 0.95vw, 14.5px);
    color: var(--color-text-muted);
  }

  /* Reading-level tabs */
  .level-tabs {
    display: flex;
    gap: 8px;
    margin-bottom: clamp(10px, 1.2vw, 18px);
  }

  .level-tab {
    font-family: var(--font-body);
    font-size: clamp(10.5px, 0.95vw, 15px);
    font-weight: 650;
    color: var(--color-text-muted);
    background: none;
    border: 1px solid var(--border-base);
    border-radius: 999px;
    padding: clamp(4px, 0.5vw, 7px) clamp(12px, 1.3vw, 20px);
    cursor: pointer;
    transition: color 0.25s ease, background-color 0.25s ease, border-color 0.25s ease;
  }

  .sheet.lvl-support .tab-support {
    color: var(--aurora-base);
    background-color: var(--aurora-weak);
    border-color: var(--aurora-border);
  }

  .sheet.lvl-core .tab-core {
    color: var(--aurora-base);
    background-color: var(--aurora-weak);
    border-color: var(--aurora-border);
  }

  .sheet.lvl-challenge .tab-challenge {
    color: var(--aurora-base);
    background-color: var(--aurora-weak);
    border-color: var(--aurora-border);
  }

  /* Question rows morph when the level changes */
  .sheet-body {
    display: flex;
    flex-direction: column;
    gap: clamp(7px, 0.9vw, 14px);
    min-height: clamp(76px, 8.4vw, 136px);
    transition: opacity 0.18s ease, transform 0.18s ease;
  }

  .sheet-body.swapping {
    opacity: 0;
    transform: translateY(4px);
  }

  .sheet-q {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0;
  }

  .q-num {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: clamp(10px, 0.9vw, 14px);
    font-weight: 700;
    transition: color 0.25s ease;
  }

  .sheet.lvl-support .q-num {
    color: var(--aurora-base);
  }

  .sheet.lvl-core .q-num {
    color: var(--aurora-base);
  }

  .sheet.lvl-challenge .q-num {
    color: var(--aurora-base);
  }

  .q-text {
    font-size: clamp(11.5px, 1.15vw, 19px);
    line-height: 1.45;
    color: var(--color-text-secondary);
  }

  .sheet-exit {
    margin-top: clamp(10px, 1.2vw, 18px);
    padding-top: clamp(9px, 1vw, 15px);
    border-top: 1px solid var(--border-weak);
    font-size: clamp(10px, 0.9vw, 13.5px);
    color: var(--color-text-muted);
  }

  /* Simulated cursor (same pattern as the learner mocks) */
  .simulated-cursor {
    position: absolute;
    width: 28px;
    height: 28px;
    pointer-events: none;
    z-index: 999;
    opacity: 0;
    margin-top: -4px;
    margin-left: -4px;
    transition: top 0.4s cubic-bezier(0.25, 1, 0.5, 1),
                left 0.4s cubic-bezier(0.25, 1, 0.5, 1),
                opacity 0.2s ease;
  }

  .cursor-dot {
    display: none;
  }

  .cursor-arrow {
    display: block;
    filter: drop-shadow(0 2px 5px rgba(0, 0, 0, 0.45));
    transition: transform 0.12s ease;
  }

  .simulated-cursor.clicking .cursor-arrow {
    transform: scale(0.85);
  }

  .click-pulse {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0);
    width: 36px;
    height: 36px;
    border: 2px solid var(--color-accent-primary);
    border-radius: 50%;
    opacity: 0;
  }

  .simulated-cursor.clicking .click-pulse {
    animation: pulse 0.45s ease-out;
  }

  @keyframes pulse {
    0% {
      transform: translate(-50%, -50%) scale(0);
      opacity: 0.9;
    }
    100% {
      transform: translate(-50%, -50%) scale(1.4);
      opacity: 0;
    }
  }

  /* Mobile scaling */
  @media (max-width: 576px) {
    .author-mock {
      padding: var(--space-4) !important;
    }
    .ask-bubble {
      max-width: 96% !important;
      font-size: 10.5px !important;
    }
    .plan-strip {
      height: 36px !important;
    }
    .plan-seg {
      padding: 0 6px !important;
    }
    .seg-name {
      font-size: 8.5px !important;
    }
    .seg-mins {
      font-size: 8px !important;
    }
    .sheet {
      padding: 10px 12px !important;
    }
    .sheet-body {
      min-height: 66px !important;
    }
    .q-text {
      font-size: 9.5px !important;
    }
    .sheet-exit {
      font-size: 8.5px !important;
    }
    .simulated-cursor {
      transform: translate(-50%, -50%) !important;
      margin: 0 !important;
    }
    .cursor-dot {
      display: block !important;
      width: 14px !important;
      height: 14px !important;
      background-color: #ffffff !important;
      border: 2px solid #000000 !important;
      border-radius: 50% !important;
      box-shadow: var(--shadow-raised);
    }
    .cursor-arrow {
      display: none !important;
    }
  }
</style>

<script>
  // The three reading levels of the same worksheet (worked example -> guided
  // -> independent, Buddy's scaffolding vocabulary)
  const LEVELS = [
    {
      questions: [
        "Label the leaf diagram: chloroplast, stomata, vein.",
        "Fill in: sunlight + water + ___ → food.",
        "Warm-up: name two things a plant needs to make food.",
      ],
    },
    {
      questions: [
        "Explain photosynthesis in your own words.",
        "6CO₂ + 6H₂O → C₆H₁₂O₆ + 6O₂ — what does each side show?",
        "Why do bubbles on pondweed count as evidence?",
      ],
    },
    {
      questions: [
        "Design an experiment: how does light intensity change the rate?",
        "Predict the rate under blue-only light. Justify your answer.",
        "Critique the claim: “Plants get their food from the soil.”",
      ],
    },
  ];

  const LEVEL_CLASSES = ["lvl-support", "lvl-core", "lvl-challenge"];

  document.querySelectorAll("[data-author-mock]").forEach((container) => {
    const activity = container.querySelector("[data-activity]") as HTMLElement | null;
    const docHead = container.querySelector("[data-doc-head]") as HTMLElement | null;
    const planStrip = container.querySelector("[data-plan-strip]") as HTMLElement | null;
    const sheet = container.querySelector("[data-sheet]") as HTMLElement | null;
    const body = container.querySelector("[data-sheet-body]") as HTMLElement | null;
    const cursor = container.querySelector("[data-cursor]") as HTMLElement | null;
    const tabs = Array.from(container.querySelectorAll("[data-level-tab]")) as HTMLElement[];
    const qTexts = Array.from(container.querySelectorAll("[data-q-text]")) as HTMLElement[];

    if (!activity || !docHead || !planStrip || !sheet || !body || !cursor || tabs.length === 0 || qTexts.length === 0) return;

    let isUserInteracting = false;
    let animationTimeout: ReturnType<typeof setTimeout> | null = null;

    const stopAutoplay = () => {
      isUserInteracting = true;
      if (animationTimeout) {
        clearTimeout(animationTimeout);
        animationTimeout = null;
      }
    };

    container.addEventListener("click", stopAutoplay);

    const delay = (ms: number) => new Promise<void>((resolve) => {
      animationTimeout = setTimeout(resolve, ms);
    });

    const setActivity = (text: string) => {
      activity.textContent = text;
    };

    const getTargetCoordinates = (element: HTMLElement) => {
      const rect = element.getBoundingClientRect();
      const containerRect = container.getBoundingClientRect();
      if (rect.width === 0 || rect.height === 0) {
        return { x: 260, y: 150 };
      }
      const y = (rect.top - containerRect.top) + rect.height * 0.5;
      const x = (rect.left - containerRect.left) + rect.width * 0.5;
      return { x, y };
    };

    const fillQuestions = (levelIndex: number) => {
      qTexts.forEach((el, qi) => {
        el.textContent = LEVELS[levelIndex]?.questions[qi] ?? "";
      });
    };

    // Switch the active level: re-tint the sheet, morph the questions
    const applyLevel = async (levelIndex: number) => {
      sheet.classList.remove(...LEVEL_CLASSES);
      sheet.classList.add(LEVEL_CLASSES[levelIndex] ?? "lvl-support");
      body.classList.add("swapping");
      await delay(190);
      if (isUserInteracting) return;
      fillQuestions(levelIndex);
      body.classList.remove("swapping");
    };

    // Glide the cursor to a tab and click it
    const clickTab = async (tabIndex: number) => {
      const tab = tabs[tabIndex];
      if (!tab) return;
      const target = getTargetCoordinates(tab);
      cursor.style.top = `${target.y}px`;
      cursor.style.left = `${target.x}px`;
      await delay(500);
      if (isUserInteracting) return;

      cursor.classList.add("clicking");
      await applyLevel(tabIndex);
      await delay(200);
      cursor.classList.remove("clicking");
    };

    const runTimeline = async () => {
      if (isUserInteracting) return;

      // Reset
      docHead.classList.remove("visible");
      planStrip.classList.remove("visible");
      sheet.classList.remove("visible");
      sheet.classList.remove(...LEVEL_CLASSES);
      sheet.classList.add("lvl-support");
      fillQuestions(0);
      body.classList.remove("swapping");
      cursor.style.opacity = "0";
      cursor.style.top = "72%";
      cursor.style.left = "78%";
      cursor.classList.remove("clicking");
      activity.classList.add("running");
      setActivity("Reading the grade 8 science standards…");

      await delay(1200);
      if (isUserInteracting) return;

      // Standards read: the lesson gets its identity, objective, and citation
      docHead.classList.add("visible");
      await delay(700);
      if (isUserInteracting) return;

      // The plan: timing blocks in
      setActivity("Blocking the lesson timing…");
      planStrip.classList.add("visible");
      await delay(1300);
      if (isUserInteracting) return;

      // The materials: worksheet sheet opens on Support
      setActivity("Writing the three reading levels…");
      sheet.classList.add("visible");
      await delay(1000);
      if (isUserInteracting) return;

      // Write completes: from here on the teacher is reviewing the draft
      activity.classList.remove("running");
      setActivity("wrote photosynthesis-lesson.md");
      await delay(600);
      if (isUserInteracting) return;

      // The review: cursor clicks through the reading levels
      cursor.style.opacity = "1";
      await clickTab(1);
      if (isUserInteracting) return;
      await delay(1300);
      if (isUserInteracting) return;

      await clickTab(2);
      if (isUserInteracting) return;
      await delay(1600);
      if (isUserInteracting) return;

      cursor.style.opacity = "0";
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            observer.unobserve(container);
            runTimeline();
          }
        });
      },
      { rootMargin: "0px 0px -25% 0px", threshold: 0 }
    );
    observer.observe(container);
  });
</script>
