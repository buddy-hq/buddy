---
import { content } from "../content/site"
const { philosophy } = content
---

<div class="philosophy-section">
  <div class="container">
    <div class="staggered-layout">
      
      <div class="header-zone">
        <h2 class="section-title">{philosophy.headline}</h2>
        {philosophy.subtext && <p class="section-subtext">{philosophy.subtext}</p>}
      </div>
      
      <div class="columns-zone">
        {philosophy.items.map((item, idx) => (
          <div class={`stagger-column col-${idx}`}>
            
            <!-- Glassmorphic Card Accent Icon -->
            <!-- Glassmorphic Card Accent Icon -->
            <div class={`card-hero-visual hero-visual-${idx}`}>
              {idx === 0 && (
                <svg viewBox="0 0 240 200" fill="none" stroke="currentColor" stroke-width="2" style="width: 100%; height: 260px;">
                  <!-- Outer rotating dashed ring -->
                  <g>
                    <animateTransform
                      attributeName="transform"
                      type="rotate"
                      from="0 120 100"
                      to="360 120 100"
                      dur="20s"
                      repeatCount="indefinite"
                    />
                    <circle cx="120" cy="100" r="75" stroke="var(--color-accent-primary)" stroke-width="1.5" stroke-dasharray="6 4" fill="none" opacity="0.4" />
                  </g>

                  <!-- Inner orbit path -->
                  <circle cx="120" cy="100" r="52" stroke="currentColor" stroke-width="1" stroke-dasharray="3 3" opacity="0.15" fill="none" />

                  <!-- Orbiting data particles (staying within user space) - slow, smooth speed -->
                  <circle r="3.5" fill="var(--color-accent-primary)" stroke="none">
                    <animateMotion
                      path="M 120,48 A 52,52 0 1,1 119.9,48 Z"
                      dur="8s"
                      repeatCount="indefinite"
                    />
                  </circle>
                  <circle r="2.5" fill="var(--color-accent-primary)" stroke="none" opacity="0.6">
                    <animateMotion
                      path="M 120,48 A 52,52 0 1,1 119.9,48 Z"
                      dur="8s"
                      repeatCount="indefinite"
                      begin="4s"
                    />
                  </circle>

                  <!-- Central User Avatar representing local ownership -->
                  <circle cx="120" cy="88" r="14" stroke="currentColor" stroke-width="2" fill="var(--color-bg)" />
                  <path d="M 96,124 C 96,112 106,106 120,106 C 134,106 144,112 144,124" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" />
                </svg>
              )}
              {idx === 1 && (
                <svg viewBox="0 0 240 200" fill="none" stroke="currentColor" stroke-width="2" style="width: 100%; height: 260px;">
                  <path fill="var(--color-accent-primary)" fill-opacity="0.05" stroke="var(--color-accent-primary)" stroke-width="2.5" stroke-linecap="round">
                    <animate 
                      attributeName="d" 
                      dur="6s" 
                      repeatCount="indefinite"
                      values="
                        M 120,40 C 160,40 190,70 190,100 C 190,130 160,160 120,160 C 80,160 50,130 50,100 C 50,70 80,40 120,40 Z;
                        M 120,50 C 180,50 210,80 210,100 C 210,120 180,150 120,150 C 60,150 30,120 30,100 C 30,80 60,50 120,50 Z;
                        M 120,30 C 150,30 170,60 170,100 C 170,140 150,170 120,170 C 90,170 70,140 70,100 C 70,60 90,30 120,30 Z;
                        M 120,40 C 160,40 190,70 190,100 C 190,130 160,160 120,160 C 80,160 50,130 50,100 C 50,70 80,40 120,40 Z
                      " 
                    />
                  </path>
                  <path opacity="0.1" stroke-dasharray="3 3">
                    <animate 
                      attributeName="d" 
                      dur="6s" 
                      repeatCount="indefinite"
                      values="
                        M 120,20 C 180,20 220,60 220,100 C 220,140 180,180 120,180 C 60,180 20,140 20,100 C 20,60 60,20 120,20 Z;
                        M 120,10 C 200,10 240,50 240,100 C 240,150 200,190 120,190 C 40,190 0,150 0,100 C 0,50 40,10 120,10 Z;
                        M 120,20 C 180,20 220,60 220,100 C 220,140 180,180 120,180 C 60,180 20,140 20,100 C 20,60 60,20 120,20 Z
                      " 
                    />
                  </path>
                </svg>
              )}
              {idx === 2 && (
                <svg viewBox="0 0 240 200" fill="none" stroke="currentColor" stroke-width="2" style="width: 100%; height: 260px;">
                  <!-- Incoming track -->
                  <path d="M 20,100 L 100,100" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.3" />

                  <!-- Branching paths -->
                  <path class="flow-path-upper" d="M 100,100 C 130,86 170,50 220,50" stroke-linecap="round" />
                  <path class="flow-path-lower" d="M 100,100 C 130,114 170,150 220,150" stroke-linecap="round" />

                  <!-- Sparkles (Particles) - natural speed dur="3s" -->
                  <circle class="control-sparkle-up" r="4" fill="var(--color-accent-primary)" stroke="none">
                    <animateMotion
                      dur="3s"
                      repeatCount="indefinite"
                      path="M 20,100 L 100,100 C 130,86 170,50 220,50"
                    />
                  </circle>
                  <circle class="control-sparkle-down" r="4" fill="var(--color-accent-primary)" stroke="none">
                    <animateMotion
                      dur="3s"
                      repeatCount="indefinite"
                      path="M 20,100 L 100,100 C 130,114 170,150 220,150"
                    />
                  </circle>

                  <!-- Control Router Hub & Needle -->
                  <g transform="translate(100, 100)">
                    <g class="control-rudder-inner">
                      <!-- Pointer Arm Shape -->
                      <path d="M -10,0 C -2,-5 10,-5 20,0 C 10,5 -2,5 -10,0 Z" fill="var(--color-bg)" stroke="currentColor" stroke-width="1.8" />
                      <!-- Pivot Hub circles -->
                      <circle cx="0" cy="0" r="4.5" fill="var(--color-bg)" stroke="currentColor" stroke-width="1.8" />
                      <circle cx="0" cy="0" r="2" fill="var(--color-accent-primary)" />
                    </g>
                  </g>
                </svg>
              )}
            </div>

            <h3 class="label">{item.label}</h3>
            <p class="detail">{item.detail}</p>
          </div>
        ))}
      </div>

    </div>
  </div>
</div>

<style is:global>
  .philosophy-section {
    padding: var(--space-16) 0 var(--space-24) 0;
    width: 100%;
    background: radial-gradient(circle at 90% 95%, rgba(255, 107, 0, 0.02) 0%, transparent 40%);
  }

  .philosophy-section .staggered-layout {
    display: flex;
    flex-direction: column;
    width: 100%;
    gap: 96px;
  }

  .philosophy-section .header-zone {
    max-width: 700px;
  }

  .philosophy-section .section-title {
    margin: 0 0 var(--space-3);
  }

  .philosophy-section .section-subtext {
    font-size: var(--text-base);
    font-weight: 450;
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    opacity: 0.88;
    letter-spacing: var(--tracking-snug);
    margin: 0;
  }

  .philosophy-section .columns-zone {
    display: flex;
    gap: var(--space-6);
  }

  .philosophy-section .stagger-column {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: var(--space-6);
    border-radius: 15px;
  }

  /* Card Hero Visual styling */
  .philosophy-section .card-hero-visual {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 260px;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-8);
    transition: all 0.3s var(--ease-out);
    position: relative;
    filter: grayscale(100%) opacity(0.4);
  }

  /* Only the SVG visual container highlights on active, the card containers remain static */
  .philosophy-section .stagger-column.active .card-hero-visual {
    color: var(--color-accent-primary) !important;
    filter: grayscale(0%) opacity(1) drop-shadow(0 8px 24px rgba(255, 107, 0, 0.3)) !important;
  }

  /* Direction-based styles for Card 3 (Controllability) */
  .philosophy-section .hero-visual-2 .control-sparkle-up,
  .philosophy-section .hero-visual-2 .control-sparkle-down {
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .philosophy-section .hero-visual-2.dir-up .control-sparkle-up {
    opacity: 1;
  }

  .philosophy-section .hero-visual-2.dir-down .control-sparkle-down {
    opacity: 1;
  }

  .philosophy-section .hero-visual-2 .flow-path-upper,
  .philosophy-section .hero-visual-2 .flow-path-lower {
    transition: all 0.4s ease;
  }

  .philosophy-section .hero-visual-2.dir-up .flow-path-upper {
    opacity: 0.8;
    stroke: var(--color-accent-primary);
    stroke-width: 2.5px;
  }

  .philosophy-section .hero-visual-2.dir-up .flow-path-lower {
    opacity: 0.25;
    stroke: currentColor;
    stroke-width: 1.5px;
  }

  .philosophy-section .hero-visual-2.dir-down .flow-path-lower {
    opacity: 0.8;
    stroke: var(--color-accent-primary);
    stroke-width: 2.5px;
  }

  .philosophy-section .hero-visual-2.dir-down .flow-path-upper {
    opacity: 0.25;
    stroke: currentColor;
    stroke-width: 1.5px;
  }

  /* Smooth mechanical transition for the flipper switch needle */
  .philosophy-section .hero-visual-2 .control-rudder-inner {
    transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1);
    transform-origin: 0 0;
  }

  .philosophy-section .hero-visual-2.dir-up .control-rudder-inner {
    transform: rotate(-25deg);
  }

  .philosophy-section .hero-visual-2.dir-down .control-rudder-inner {
    transform: rotate(25deg);
  }

  .philosophy-section .label {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 750;
    color: var(--color-text-primary);
    margin: 0;
  }

  .philosophy-section .detail {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  @media (max-width: 768px) {
    .philosophy-section .columns-zone {
      flex-direction: column;
      gap: var(--space-6);
    }

    .philosophy-section .staggered-layout {
      gap: 48px;
    }

    .philosophy-section .section-title {
      font-size: 24px !important; /* Scale heading down on mobile */
    }

    .philosophy-section .section-subtext {
      font-size: var(--text-sm) !important; /* Scale subheading down on mobile */
    }

    .philosophy-section .header-zone {
      max-width: 100%;
    }

    .philosophy-section .card-hero-visual {
      height: 180px;
      margin-bottom: var(--space-4);
    }

    .philosophy-section .card-hero-visual svg {
      height: 180px !important;
    }

    .philosophy-section .stagger-column {
      padding: var(--space-5);
    }
  }
</style>

<script>
  const cards = document.querySelectorAll('.philosophy-section .stagger-column');
  
  if (cards.length > 0) {
    let activeIndex = 0;
    let intervalId: any = null;
    let dirUp = true; // Toggle direction for Card 3

    const setActiveCard = (index: number) => {
      cards.forEach((card, idx) => {
        const svg = card.querySelector('.card-hero-visual svg') as SVGSVGElement | null;
        const visualContainer = card.querySelector('.card-hero-visual') as HTMLDivElement | null;
        
        if (idx === index) {
          card.classList.add('active');
          if (svg) {
            try {
              svg.setCurrentTime(0);
              svg.unpauseAnimations();
            } catch (e) {}
          }
          
          // Alternate direction only when Card 3 becomes active
          if (idx === 2 && visualContainer) {
            dirUp = !dirUp;
            if (dirUp) {
              visualContainer.classList.add('dir-up');
              visualContainer.classList.remove('dir-down');
            } else {
              visualContainer.classList.add('dir-down');
              visualContainer.classList.remove('dir-up');
            }
          }
        } else {
          card.classList.remove('active');
          if (svg) {
            try {
              svg.pauseAnimations();
              svg.setCurrentTime(0);
            } catch (e) {}
          }
        }
      });
    };

    const startCycle = () => {
      if (intervalId) clearInterval(intervalId);
      intervalId = setInterval(() => {
        activeIndex = (activeIndex + 1) % cards.length;
        setActiveCard(activeIndex);
      }, 6000);
    };

    // Initial state
    setActiveCard(0);
    startCycle();

    // Event listeners for hover behavior
    cards.forEach((card, idx) => {
      card.addEventListener('mouseenter', () => {
        if (intervalId) clearInterval(intervalId);
        activeIndex = idx;
        setActiveCard(idx);
      });

      card.addEventListener('mouseleave', () => {
        startCycle();
      });
    });
  }
</script>

