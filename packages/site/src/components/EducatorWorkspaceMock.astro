    function loadReaderPage(notebookKey: NotebookKey, pageIndex: number) {
      const data = educatorNotebooks[notebookKey];
      if (!data || !data.pages || !data.pages[pageIndex]) return;

      const page = data.pages[pageIndex];
      if (readerQuoteText) readerQuoteText.textContent = page.quote;
      if (readerBodyText) readerBodyText.textContent = page.body;

      const next = data.pages[pageIndex + 1];
      if (readerQuoteText2) {
        readerQuoteText2.textContent = next ? next.quote : "";
        readerQuoteText2.style.display = next ? "" : "none";
      }
      if (readerBodyText2) {
        readerBodyText2.textContent = next ? next.body : "";
        readerBodyText2.style.display = next ? "" : "none";
      }
      if (readerRule) readerRule.style.display = next ? "" : "none";

      if (readerSigText) readerSigText.textContent = page.signature;
      if (readerLocationText) readerLocationText.textContent = page.location;
    }

