---
// Component for the Educator (Teacher) workspace mockup
import { getImage } from "astro:assets";
import MockWhiteboard from "./MockWhiteboard.astro";
import MockSidebar from "./MockSidebar.astro";
import MockChat from "./MockChat.astro";
import MockReader from "./MockReader.astro";
import MockWidget from "./MockWidget.astro";
import MockNotebook from "./MockNotebook.astro";
import { AUDIENCE_EDUCATORS } from "../lib/constants";
import "./WorkspaceMock.css";
---

<div class="buddy-window" data-audience={AUDIENCE_EDUCATORS}>
  <!-- Workspace layout with macOS unified titlebar split -->
  <div class="workspace-body sidebar-closed right-pane-collapsed">
    
    <!-- Surface 1: Sidebar -->
    <MockSidebar audience={AUDIENCE_EDUCATORS} />

    <!-- Surface 2: Chat Pane -->
    <MockChat audience={AUDIENCE_EDUCATORS} />

    <!-- Surface 3: Document Reader (Warm Cream paper) -->
    <MockReader audience={AUDIENCE_EDUCATORS} />

    <!-- Surface 5: Whiteboard Pane -->
    <MockWhiteboard audience={AUDIENCE_EDUCATORS} />

    <!-- Surface 6: HTML Widget Pane -->
    <MockWidget audience={AUDIENCE_EDUCATORS} />

    <!-- Surface 7: Notebook Pane (MDX Worksheet Editor) -->
    <MockNotebook audience={AUDIENCE_EDUCATORS} />

    <!-- Surface 8: Skills Pane (Dynamic Installed Skills) -->
    <div class="buddy-surface surface-skills">
      <div class="bench-header">
        <div class="bench-title-area">
          <span class="bench-icon">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
              <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
              <line x1="12" y1="22.08" x2="12" y2="12"></line>
            </svg>
          </span>
          <span class="bench-title">Skills Catalog</span>
        </div>
      </div>
      
      <div class="skills-pane-body">
        <div class="skills-list-view">
          <div class="skills-list-header">
            <span class="skills-count-badge">9 Installed Skills</span>
          </div>
          
          <div class="skills-rows-container">
            <div class="skill-row-item" data-skill="align-teaching-topics-to-grade-level-and-age">
              <div class="skill-row-clickable">
                <span class="skill-row-title">Developmental Aligner</span>
                <span class="skill-row-desc">Align teaching topics to developmental readiness, cognitive stages, grade bands, and age levels.</span>
              </div>
              <div class="skill-row-control">
                <label class="mock-switch">
                  <input type="checkbox" checked />
                  <span class="switch-slider"></span>
                </label>
              </div>
            </div>

            <div class="skill-row-item" data-skill="assess">
              <div class="skill-row-clickable">
                <span class="skill-row-title">Assessment Scaffolder</span>
                <span class="skill-row-desc">Diagnostic testing, student assessments, rubrics, and feedback loops.</span>
              </div>
              <div class="skill-row-control">
                <label class="mock-switch">
                  <input type="checkbox" checked />
                  <span class="switch-slider"></span>
                </label>
              </div>
            </div>

            <div class="skill-row-item" data-skill="find-indian-education-resources">
              <div class="skill-row-clickable">
                <span class="skill-row-title">Curriculum Resource Locator</span>
                <span class="skill-row-desc">Search and locate textbooks, NCERT guidelines, CBSE board syllabus, and state curriculum resources.</span>
              </div>
              <div class="skill-row-control">
                <label class="mock-switch">
                  <input type="checkbox" checked />
                  <span class="switch-slider"></span>
                </label>
              </div>
            </div>

            <div class="skill-row-item" data-skill="fetch-indian-competition-papers">
              <div class="skill-row-clickable">
                <span class="skill-row-title">Exam Paper Retriever</span>
                <span class="skill-row-desc">Retrieve competitive exam questions, syllabus grids, and state public service commission papers.</span>
              </div>
              <div class="skill-row-control">
                <label class="mock-switch">
                  <input type="checkbox" checked />
                  <span class="switch-slider"></span>
                </label>
              </div>
            </div>

            <div class="skill-row-item" data-skill="obsidian">
              <div class="skill-row-clickable">
                <span class="skill-row-title">Obsidian Vault Sync</span>
                <span class="skill-row-desc">Vault root compatibility and markdown synchronisation for Obsidian vaults.</span>
              </div>
              <div class="skill-row-control">
                <label class="mock-switch">
                  <input type="checkbox" checked />
                  <span class="switch-slider"></span>
                </label>
              </div>
            </div>

            <div class="skill-row-item" data-skill="teach-mathematics">
              <div class="skill-row-clickable">
                <span class="skill-row-title">Math Concept Scaffolder</span>
                <span class="skill-row-desc">Mathematics teaching, equation builders, and conceptual progressions.</span>
              </div>
              <div class="skill-row-control">
                <label class="mock-switch">
                  <input type="checkbox" checked />
                  <span class="switch-slider"></span>
                </label>
              </div>
            </div>

            <div class="skill-row-item" data-skill="analogy">
              <div class="skill-row-clickable">
                <span class="skill-row-title">Analogy Builder</span>
                <span class="skill-row-desc">Analogies, structural mapping, and conceptual schema links.</span>
              </div>
              <div class="skill-row-control">
                <label class="mock-switch">
                  <input type="checkbox" checked />
                  <span class="switch-slider"></span>
                </label>
              </div>
            </div>

            <div class="skill-row-item" data-skill="reading">
              <div class="skill-row-clickable">
                <span class="skill-row-title">Reading Passage Builder</span>
                <span class="skill-row-desc">Reading materials, text passages, and comprehension questions.</span>
              </div>
              <div class="skill-row-control">
                <label class="mock-switch">
                  <input type="checkbox" checked />
                  <span class="switch-slider"></span>
                </label>
              </div>
            </div>

            <div class="skill-row-item" data-skill="buddy-help">
              <div class="skill-row-clickable">
                <span class="skill-row-title">Workspace Assistant</span>
                <span class="skill-row-desc">Help and usage guidelines for Buddy's agentic workspace loops.</span>
              </div>
              <div class="skill-row-control">
                <label class="mock-switch">
                  <input type="checkbox" checked />
                  <span class="switch-slider"></span>
                </label>
              </div>
            </div>
          </div>
        </div>

        <div class="skills-detail-view" id="skills-detail-view">
          <button class="skills-back-btn" id="skills-back-btn">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
            <span>Back to catalog</span>
          </button>
          
          <div class="skills-detail-content" id="skills-detail-content">
            <!-- Populated via script -->
          </div>
        </div>
      </div>
    </div>

    <!-- Surface 4: Action Toolbar -->
    <aside class="surface-actions">
      <div class="action-icons">
        <button class="action-btn active" title="Notebook">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="9" y1="9" x2="15" y2="9"></line>
            <line x1="9" y1="13" x2="15" y2="13"></line>
          </svg>
        </button>
        <button class="action-btn" title="Skills">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
            <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
            <line x1="12" y1="22.08" x2="12" y2="12"></line>
          </svg>
        </button>
      </div>
    </aside>
  </div>

  <!-- Toast Notification -->
  <div class="mock-toast" id="workspace-toast">
    <div class="toast-content">
      <svg class="toast-success-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
        <polyline points="22 4 12 14.01 9 11.01"></polyline>
      </svg>
      <span class="toast-message">Saved PDF to the notebook.</span>
    </div>
    <button class="toast-action-btn" type="button">Open</button>
  </div>

  <!-- Simulated Click/Select Cursor -->
  <div class="simulated-cursor">
    <div class="cursor-dot"></div>
    <svg class="cursor-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="1.5" stroke-linejoin="round">
      <path d="M4 4l7.07 17 2.51-7.39L21 11.07z" fill="white" stroke="black" stroke-width="1.5" stroke-linejoin="round"/>
    </svg>
    <div class="click-pulse"></div>
  </div>
</div>

<script>
  type MockMessage = {
    sender: string;
    text?: string;
    action?: string;
    subject?: string;
    icon?: string;
  };

  type NotebookData = {
    title: string;
    session: string;
    readerTitle: string;
    pages: {
      quote: string;
      body: string;
      signature: string;
      location: string;
    }[];
    messages: MockMessage[];
    whiteboardHtml: string;
  };

  // Data for notebooks matching real app structure (Educators/Teachers)
  const educatorNotebooks: Record<string, NotebookData> = {
    "lesson-planning": {
      title: "differentiate a task",
      session: "Grade 8 Seasons Activity",
      readerTitle: "Seasons Curriculum Guide",
      pages: [
        {
          quote: "Standard: NGSS MS-ESS1-1 - Earth's Place in the Universe.",
          body: "Focus: Develop and use a model of the Earth-sun-moon system to describe the cyclic patterns of lunar phases, eclipses of the sun and moon, and seasons. Objective: Students will explain how Earth's 23.5° axial tilt and orbital revolution combine to cause seasonal temperature variations.",
          signature: "Next Generation Science Standards",
          location: "NGSS ESS1 · PAGE 4 / 18"
        },
        {
          quote: "Differentiation Strategy: Misconception Debunking",
          body: "Provide visual representations of solar angle of incidence. Support: Label solstice configurations. On-level: Contrast direct vs indirect solar rays. Extension: Tackle the distance misconception using orbit data (aphelion vs perihelion).",
          signature: "Differentiation in Science",
          location: "DIFFERENTIATION · PAGE 3 / 10"
        }
      ],
      messages: [
        { sender: "user", text: "Can you write a Grade 8 worksheet on Earth's seasons with three tiered tasks (support, on-level, extension) in a markdown doc?" },
        { sender: "tool", action: "Draft Seasons Activity", subject: "Creating seasons-outline.md", icon: "file" },
        { sender: "buddy", text: "Sure! I've created 'seasons-outline.md' in your editor. I set up solstices for Task A, solar concentration for Task B, and orbit distance critique for Task C." },
        { sender: "user", text: "Great. Can you add a clear orbit and tilt diagram right below the header?" },
        { sender: "tool", action: "Generate Infographic", subject: "seasons-diagram.png", icon: "image" },
        { sender: "buddy", text: "Generated. I've embedded the orbital diagram under the standards banner. Take a look!" },
        { sender: "user", text: "Looks good. Can you update Task A to include the exact dates for solstices and equinoxes?" },
        { sender: "buddy", text: "Done. I updated Task A to include those date ranges (e.g., June 20-22 and Dec 21-23)." },
        { sender: "user", text: "Perfect. Can you align these sections to the NGSS standards?" },
        { sender: "tool", action: "Search Standards", subject: "Found 1 standard", icon: "search" },
        { sender: "buddy", text: "Aligned. I've updated the worksheet tasks to map directly to the MS-ESS1-1 performance expectation (covering axial tilt, solar ray intensity, and orbital geometry) and tagged the standard at the top." },
        { sender: "user", text: "Excellent. Can you compile a quick 2-slide presentation deck to introduce this activity?" },
        { sender: "tool", action: "Create Presentation", subject: "seasons-presentation.pptx", icon: "slides" },
        { sender: "buddy", text: "Done! I have generated the presentation slide deck for the seasons activity. You can download or preview it here:<br><br><div class='buddy-file-card'><div class='file-icon-area'><svg class='pptx-svg-icon' width='22' height='22' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z'></path><polyline points='14 2 14 8 20 8'></polyline><line x1='8' y1='13' x2='16' y2='13'></line><line x1='8' y1='17' x2='16' y2='17'></line><line x1='10' y1='9' x2='8' y2='9'></line></svg></div><div class='file-details'><span class='file-title'>seasons-presentation.pptx</span><span class='file-meta'>PowerPoint Presentation · 1.4 MB</span></div><div class='file-action-btn'><svg width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4'></path><polyline points='7 10 12 15 17 10'></polyline><line x1='12' y1='15' x2='12' y2='3'></line></svg></div></div>" }
      ],
      whiteboardHtml: ""
    },
    "quiz-generation": {
      title: "quiz generation",
      session: "Photosynthesis formative test",
      readerTitle: "Photosynthesis Assessment",
      pages: [
        {
          quote: "Taxonomy Check: Recall vs Analysis",
          body: "To assess understanding of the light-dependent reactions of photosynthesis, avoid simple recall questions. Instead, ask students to predict the effect of decreasing carbon dioxide concentration or light intensity on oxygen release.",
          signature: "Formative Assessment Design",
          location: "ASSESSMENT DESIGN · PAGE 1"
        }
      ],
      messages: [
        { sender: "user", text: "generate a quiz on photosynthesis aligned to Bloom's taxonomy" },
        { sender: "buddy", text: "I've drafted a 5-question formative assessment targeting both retrieval and conceptual application.<br><br>Want to preview the assessment guidelines?" },
        { sender: "user", text: "yes" },
        { sender: "buddy", text: "<div class='illustration-card state-skeleton'><div class='ill-cover-fallback bio'><div class='fallback-cover-text'>Biology</div></div><div class='ill-text'><span class='ill-title'>Photosynthesis Unit</span><span class='ill-author'>Formative Assessment</span></div></div><br><br>I've opened the assessment guide in the reader and highlighted the Bloom's levels." },
        { sender: "user", text: "show me the standard alignments" },
        { sender: "buddy", text: "<div class='wb-chat-card state-skeleton'><div class='wb-chat-icon'><svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5'><path d='M2 3h20'></path><path d='M21 3v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V3'></path><path d='m7 21 5-5 5 5'></path></svg></div><div class='wb-chat-title-group'><div class='wb-chat-title'>Whiteboard</div><div class='wb-chat-subtitle'>Standards Map</div></div></div><br><br>Sure, I've mapped the learning objectives to Bloom's Taxonomy levels on your whiteboard." }
      ],
      whiteboardHtml: ""
    },
    "curriculum-mapping": {
      title: "curriculum mapping",
      session: "DIKSHA NCERT mapping",
      readerTitle: "DIKSHA NCERT Mapping Guide",
      pages: [
        {
          quote: "NCERT Class 10: Science Chapter 6 - Life Processes",
          body: "Mapping target: Align Indian national curriculum learning objectives to digital interactive resources on the DIKSHA platform. Life Processes includes nutrition, respiration, transportation, and excretion.",
          signature: "NCERT Curriculum Guide",
          location: "NCERT MAPPING · PAGE 8"
        }
      ],
      messages: [
        { sender: "user", text: "map the NCERT Class 10 Science syllabus to DIKSHA digital resources" },
        { sender: "buddy", text: "I've mapped the 'Life Processes' chapter to digital resource links on DIKSHA.<br><br>Ready to view the mapping guidelines?" },
        { sender: "user", text: "yes" },
        { sender: "buddy", text: "<div class='illustration-card state-skeleton'><div class='ill-cover-fallback ncert'><div class='fallback-cover-text'>NCERT</div></div><div class='ill-text'><span class='ill-title'>Life Processes</span><span class='ill-author'>NCERT Class 10</span></div></div><br><br>Loaded NCERT Class 10 Science Chapter 6. I've highlighted the core topics and resources." },
        { sender: "user", text: "explain the resource mapping timeline" },
        { sender: "buddy", text: "<div class='wb-chat-card state-skeleton'><div class='wb-chat-icon'><svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5'><path d='M2 3h20'></path><path d='M21 3v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V3'></path><path d='m7 21 5-5 5 5'></path></svg></div><div class='wb-chat-title-group'><div class='wb-chat-title'>Whiteboard</div><div class='wb-chat-subtitle'>NCERT DIKSHA Map</div></div></div><br><br>I've mapped the NCERT syllabus units to DIKSHA platform QR codes on your whiteboard." }
      ],
      whiteboardHtml: ""
    }
  };

  type NotebookKey = "lesson-planning" | "quiz-generation" | "curriculum-mapping";

  let activeNotebook: NotebookKey = "lesson-planning";
  let currentPageIndices: Record<string, number> = {
    "lesson-planning": 0,
    "quiz-generation": 0,
    "curriculum-mapping": 0
  };

  let currentStreamId = 0;
  let activeSidebarPromise = Promise.resolve();
  let isGenerating = false;
  let currentSlide = 1;

  // Scoped element selectors
  const buddyWindow = document.querySelector('.buddy-window[data-audience="educators"]') as HTMLElement;
  if (buddyWindow) {
    const chatFeed = buddyWindow.querySelector(".chat-feed") as HTMLElement | null;
    const windowActiveNotebook = buddyWindow.querySelector(".window-active-notebook") as HTMLElement | null;
    const windowActiveSession = buddyWindow.querySelector(".window-active-session") as HTMLElement | null;
    const readerTabTitle = buddyWindow.querySelector("#reader-tab-title") as HTMLElement | null;
    const readerQuoteText = buddyWindow.querySelector("#reader-quote-text") as HTMLElement | null;
    const readerBodyText = buddyWindow.querySelector("#reader-body-text") as HTMLElement | null;
    const readerQuoteText2 = buddyWindow.querySelector("#reader-quote-text-2") as HTMLElement | null;
    const readerBodyText2 = buddyWindow.querySelector("#reader-body-text-2") as HTMLElement | null;
    const readerRule = buddyWindow.querySelector(".reader-rule") as HTMLElement | null;
    const readerSigText = buddyWindow.querySelector("#reader-sig-text") as HTMLElement | null;
    const readerLocationText = buddyWindow.querySelector("#reader-location-text") as HTMLElement | null;
    const fontToggleBtn = buddyWindow.querySelector("#font-toggle-btn") as HTMLElement | null;
    const readerContentPane = buddyWindow.querySelector("#reader-content-pane") as HTMLElement | null;
    const chatForm = buddyWindow.querySelector("#mockup-chat-form") as HTMLFormElement | null;
    const chatInput = buddyWindow.querySelector("#mockup-chat-input") as HTMLTextAreaElement | null;
    const chatSubmitBtn = buddyWindow.querySelector("#chat-submit-btn") as HTMLButtonElement | null;
    
    const wbDrawings = buddyWindow.querySelector(".wb-drawings") as HTMLElement | null;
    
    const libraryRailBtn = buddyWindow.querySelector('.action-btn[title="Library"]') as HTMLButtonElement | null;
    const whiteboardRailBtn = buddyWindow.querySelector('.action-btn[title="Whiteboard"]') as HTMLButtonElement | null;
    const widgetRailBtn = buddyWindow.querySelector('.action-btn[title="HTML Widget"]') as HTMLButtonElement | null;
    const flashcardsRailBtn = buddyWindow.querySelector('.action-btn[title="Notebook"]') as HTMLButtonElement | null;
    const skillsRailBtn = buddyWindow.querySelector('.action-btn[title="Skills"]') as HTMLButtonElement | null;
    const workspaceBody = buddyWindow.querySelector('.workspace-body') as HTMLElement | null;

    function setGenerating(gen: boolean) {
      isGenerating = gen;
      if (!chatSubmitBtn) return;
      
      const sendIcon = chatSubmitBtn.querySelector(".icon-send") as HTMLElement | null;
      const stopIcon = chatSubmitBtn.querySelector(".icon-stop") as HTMLElement | null;
      
      if (gen) {
        chatSubmitBtn.classList.add("generating");
        if (sendIcon) sendIcon.style.display = "none";
        if (stopIcon) stopIcon.style.display = "block";
      } else {
        chatSubmitBtn.classList.remove("generating");
        if (sendIcon) sendIcon.style.display = "block";
        if (stopIcon) stopIcon.style.display = "none";
      }
    }

    async function animateWhiteboard(notebookKey: NotebookKey, streamId: number) {
      if (!wbDrawings) return;
      wbDrawings.innerHTML = "";

      if (notebookKey === "lesson-planning") {
        const hi = document.createElement("div");
        hi.className = "wb-handwriting-hi";
        wbDrawings.appendChild(hi);
        await typeWbHtml(hi, "Photosynthesis Map", streamId, 30);
        if (streamId !== currentStreamId) return;
        await new Promise(resolve => setTimeout(resolve, 200));

        const arrow = document.createElement("div");
        arrow.className = "wb-doodle-arrow";
        arrow.innerHTML = `
          <svg width="40" height="20" viewBox="0 0 40 20" fill="none" stroke="currentColor" style="color: var(--aurora-base)" stroke-width="2">
            <path d="M20,2 L20,18 M15,13 L20,18 L25,13" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        `;
        wbDrawings.appendChild(arrow);
        await new Promise(resolve => setTimeout(resolve, 50));
        arrow.classList.add("visible");
        await new Promise(resolve => setTimeout(resolve, 200));
        if (streamId !== currentStreamId) return;

        const grid = document.createElement("div");
        grid.className = "wb-split-grid";
        wbDrawings.appendChild(grid);

        const targetCard = document.createElement("div");
        targetCard.className = "wb-card integrity";
        targetCard.innerHTML = `<div class="wb-card-title">Target Standard</div><div class="wb-card-body"></div>`;
        grid.appendChild(targetCard);

        const prereqCard = document.createElement("div");
        prereqCard.className = "wb-card conformity";
        prereqCard.innerHTML = `<div class="wb-card-title">Key Pathways</div><div class="wb-card-body"></div>`;
        grid.appendChild(prereqCard);

        await new Promise(resolve => setTimeout(resolve, 50));
        targetCard.classList.add("visible");
        prereqCard.classList.add("visible");
        await new Promise(resolve => setTimeout(resolve, 400));
        if (streamId !== currentStreamId) return;

        const targetBody = targetCard.querySelector(".wb-card-body") as HTMLElement;
        await typeWbHtml(targetBody, "- NGSS MS-LS1-6<br>- Cycling of matter<br>- Energy flow", streamId, 18);
        if (streamId !== currentStreamId) return;

        const prereqBody = prereqCard.querySelector(".wb-card-body") as HTMLElement;
        await typeWbHtml(prereqBody, "- Light reactions<br>- Calvin cycle<br>- Chemical equation", streamId, 18);
        if (streamId !== currentStreamId) return;

        const conclusionCard = document.createElement("div");
        conclusionCard.className = "wb-sketch-node bottom-conclusion";
        conclusionCard.style.opacity = "0";
        conclusionCard.style.transform = "scale(0.8) rotate(1deg)";
        conclusionCard.style.transition = "all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1)";
        conclusionCard.style.marginTop = "15px";
        conclusionCard.style.width = "100%";
        conclusionCard.style.maxWidth = "280px";
        wbDrawings.appendChild(conclusionCard);

        await new Promise(resolve => setTimeout(resolve, 80));
        conclusionCard.style.opacity = "1";
        conclusionCard.style.transform = "scale(1) rotate(1deg)";
        await new Promise(resolve => setTimeout(resolve, 350));
        if (streamId !== currentStreamId) return;

        await typeWbHtml(conclusionCard, "Matter & Energy Cycle", streamId, 25);
      }
      else if (notebookKey === "quiz-generation") {
        const hi = document.createElement("div");
        hi.className = "wb-handwriting-hi";
        wbDrawings.appendChild(hi);
        await typeWbHtml(hi, "Bloom's Objective Map", streamId, 30);
        if (streamId !== currentStreamId) return;
        await new Promise(resolve => setTimeout(resolve, 200));

