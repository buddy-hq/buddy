    function loadNotebook(key: NotebookKey) {
      activeNotebook = key;
      activeSidebarPromise = Promise.resolve();
      const data = educatorNotebooks[key];
      if (!data) return;

      if (windowActiveNotebook) windowActiveNotebook.textContent = data.title;
      if (windowActiveSession) windowActiveSession.textContent = data.session;
      if (readerTabTitle) readerTabTitle.textContent = data.readerTitle;

      if (readerQuoteText) readerQuoteText.textContent = "";
      if (readerBodyText) readerBodyText.textContent = "Waiting for document load command...";
      if (readerSigText) readerSigText.textContent = "";
      if (readerLocationText) readerLocationText.textContent = "";
      if (wbDrawings) wbDrawings.innerHTML = '<div class="wb-welcome-text" style="opacity: 0.3; font-family: var(--font-body); font-size: 13px; padding: 20px;">Whiteboard ready...</div>';
      
      const chip = buddyWindow.querySelector("#chat-selection-chip") as HTMLElement | null;
      if (chip) chip.style.display = "none";

      const shell = buddyWindow.querySelector(".editor-bench-shell");
      if (shell) shell.classList.remove("pdf-mode");

      const paper = buddyWindow.querySelector("#worksheet-editor-paper");
      if (paper) {
        paper.innerHTML = `
          <div class="editor-drafting-placeholder">
            <span class="drafting-text">No active session. Start a chat request to draft a document.</span>
          </div>
        `;
      }

      // Reset slideshow active states
      if (buddyWindow) {
        buddyWindow.classList.remove("show-slides");
      }
      currentSlide = 1;
      const slideCard1 = buddyWindow ? buddyWindow.querySelector("#slide-card-1") as HTMLElement | null : null;
      const slideCard2 = buddyWindow ? buddyWindow.querySelector("#slide-card-2") as HTMLElement | null : null;
      const slidePrevBtn = buddyWindow ? buddyWindow.querySelector("#slide-prev-btn") as HTMLButtonElement | null : null;
      const slideNextBtn = buddyWindow ? buddyWindow.querySelector("#slide-next-btn") as HTMLButtonElement | null : null;
      const slideNavIndicator = buddyWindow ? buddyWindow.querySelector("#slide-nav-indicator") as HTMLElement | null : null;
      if (slideCard1 && slideCard2 && slidePrevBtn && slideNextBtn && slideNavIndicator) {
        slideCard1.style.display = "flex";
