    async function typeMessage(container: HTMLElement, htmlText: string, streamId: number, notebookKey: NotebookKey, messageIndex: number) {
      const parts = htmlText.split("<br><br>");
      for (let partIdx = 0; partIdx < parts.length; partIdx++) {
        if (streamId !== currentStreamId) return;
        const part = parts[partIdx];
        
        const isCard = part.includes("widget-chat-card") || part.includes("illustration-card") || part.includes("wb-chat-card") || part.includes("tool-row") || part.includes("buddy-file-card");
        
        if (isCard) {
          // Render card instantly
          const cardDiv = document.createElement("div");
          cardDiv.style.display = "contents";
          cardDiv.innerHTML = part;
          
          // Add skeleton state on creation
          const cardEl = cardDiv.firstElementChild;
          if (cardEl && !cardEl.classList.contains("buddy-file-card")) {
            cardEl.classList.add("state-skeleton");
          }
          
          container.appendChild(cardDiv);
          if (chatFeed) chatFeed.scrollTop = chatFeed.scrollHeight;

          // Trigger opening of sidebar!
          if (messageIndex !== -1) {
            triggerSidebarOpen(notebookKey, messageIndex);
            activeSidebarPromise = resolveCardSkeleton(notebookKey, messageIndex, streamId);
          }

          await new Promise(resolve => setTimeout(resolve, 100));
        } else {
          // Typewriter text
          const textSpan = document.createElement("span");
          container.appendChild(textSpan);
          await typeMessageInner(textSpan, part, streamId);
        }

        if (partIdx < parts.length - 1) {
          const nextPart = parts[partIdx + 1];
          const nextIsCard = nextPart.includes("widget-chat-card") || nextPart.includes("illustration-card") || nextPart.includes("wb-chat-card") || nextPart.includes("tool-row");
          
          if (!isCard && !nextIsCard) {
            // Double break between text paragraphs
            container.appendChild(document.createElement("br"));
            container.appendChild(document.createElement("br"));
          } else {
            // Tight spacing between card and text
