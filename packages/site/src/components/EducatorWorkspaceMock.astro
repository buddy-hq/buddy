    async function typeWbHtml(container: HTMLElement, htmlText: string, streamId: number, speed = 20) {
      const parts = htmlText.split(/(<[^>]+>)/g);
      let currentText = "";

      for (const chunk of parts) {
        if (streamId !== currentStreamId) return;
        currentText += chunk;
        container.innerHTML = currentText;
        const delay = chunk.startsWith('<') ? 0 : (Math.random() * (speed / 2) + (speed / 2));
        await new Promise(resolve => setTimeout(resolve, delay));
      }
    }

