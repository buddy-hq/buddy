    };

    function showMockToast(message: string) {
      const toastEl = buddyWindow.querySelector("#workspace-toast") as HTMLElement | null;
      if (toastEl) {
        const textEl = toastEl.querySelector(".toast-message");
        if (textEl) textEl.textContent = message;
        toastEl.classList.add("visible");
        setTimeout(() => {
          toastEl.classList.remove("visible");
        }, 2500);
      }
    }

    if (skillsRailBtn) {
      skillsRailBtn.addEventListener('click', () => {
        buddyWindow.querySelectorAll('.action-btn').forEach(btn => btn.classList.remove('active'));
        skillsRailBtn.classList.add('active');
        buddyWindow.classList.remove('show-whiteboard', 'show-widget', 'show-notes', 'show-slides');
        buddyWindow.classList.add('show-skills');
        
        if (windowActiveNotebook) windowActiveNotebook.textContent = "Skills";
        if (windowActiveSession) windowActiveSession.textContent = "Installed Skills";

        if (workspaceBody) {
          workspaceBody.classList.remove('right-pane-collapsed');
        }
      });
    }

    if (flashcardsRailBtn) {
      flashcardsRailBtn.addEventListener('click', () => {
        buddyWindow.querySelectorAll('.action-btn').forEach(btn => btn.classList.remove('active'));
        flashcardsRailBtn.classList.add('active');
        buddyWindow.classList.remove('show-whiteboard', 'show-widget', 'show-skills');
        buddyWindow.classList.add('show-notes');
        
        const shell = buddyWindow.querySelector(".editor-bench-shell") as HTMLElement | null;
        if (shell) shell.classList.remove("slides-mode");
        
        if (windowActiveNotebook) windowActiveNotebook.textContent = "Editor";
        if (windowActiveSession) windowActiveSession.textContent = "seasons-outline.md";

        if (workspaceBody) {
          workspaceBody.classList.remove('right-pane-collapsed');
        }
      });
    }

    // Set up skills list item clicks & toggle switches
    const skillRows = buddyWindow.querySelectorAll('.skill-row-item');
    const detailView = buddyWindow.querySelector('#skills-detail-view');
    const detailContent = buddyWindow.querySelector('#skills-detail-content');
    const backBtn = buddyWindow.querySelector('#skills-back-btn');

    skillRows.forEach(row => {
      const clickable = row.querySelector('.skill-row-clickable');
      if (clickable) {
        clickable.addEventListener('click', () => {
          const skillKey = row.getAttribute('data-skill') || '';
          const skillData = buddySkillsCatalog[skillKey];
          if (skillData && detailContent && detailView) {
            detailContent.innerHTML = `
              <h3 class="skills-detail-title">${skillData.displayName}</h3>
              <p class="skills-detail-desc">${skillData.description}</p>
              <div class="skills-fields-list">
                <div class="skills-field-item">
                  <span class="skills-field-label">Version</span>
                  <span class="skills-field-value">${skillData.version}</span>
                </div>
                 <div class="skills-field-item">
                  <span class="skills-field-label">Source</span>
                  <span class="skills-field-value">${skillData.source}</span>
                </div>
                <div class="skills-field-item">
                  <span class="skills-field-label">Scope</span>
                  <span class="skills-field-value">${skillData.scope}</span>
                </div>
                <div class="skills-field-item">
                  <span class="skills-field-label">Status</span>
                  <span class="skills-field-value">${row.querySelector('input')?.checked ? 'Enabled' : 'Disabled'}</span>
                </div>
              </div>
              <div class="skills-md-content">
                ${skillData.instructions}
              </div>
            `;
            detailView.classList.add('show-detail');
          }
        });
      }

      const checkbox = row.querySelector('input[type="checkbox"]') as HTMLInputElement | null;
      if (checkbox) {
        checkbox.addEventListener('change', (e) => {
          e.stopPropagation();
          const skillKey = row.getAttribute('data-skill') || '';
          const isChecked = checkbox.checked;
          showMockToast(`${isChecked ? 'Enabled' : 'Disabled'} skill: ${skillKey}`);
        });
      }
    });

    if (backBtn && detailView) {
      backBtn.addEventListener('click', () => {
        detailView.classList.remove('show-detail');
      });
    }

    // Minimal HTML Widget Logic
    const wSlider = buddyWindow.querySelector('#widget-pressure') as HTMLInputElement | null;
    const wValInward = buddyWindow.querySelector('#val-inward') as HTMLElement | null;
    const wValCrowd = buddyWindow.querySelector('#val-crowd') as HTMLElement | null;
    const wQuote = buddyWindow.querySelector('#widget-quote') as HTMLElement | null;
    const wExplain = buddyWindow.querySelector('#widget-explain') as HTMLElement | null;
    const wVisualZone = buddyWindow.querySelector('#visual-zone') as HTMLElement | null;

    function updateMinimalWidget() {
      if (!wSlider || !wValInward || !wValCrowd || !wQuote || !wExplain) return;
      
      const crowdVal = Number(wSlider.value);
      
      if (wVisualZone) {
        wVisualZone.style.setProperty('--pressure', String(crowdVal / 100));
      }

      const inwardVal = 100 - crowdVal;

      wValInward.textContent = inwardVal + '%';
      wValCrowd.textContent = crowdVal + '%';

      let quoteText = '';
      let explainText = '';

      if (crowdVal <= 35) {
        quoteText = 'Worked Example: Show the entire path.';
        explainText = 'Provides a complete step-by-step solved problem. Ideal for introducing new topics.';
      } else if (crowdVal <= 70) {
        quoteText = 'Guided Practice: Bridge the gap with hints.';
        explainText = 'Scaffolds student work with structural prompts, leading questions, and partial answers.';
      } else {
        quoteText = 'Independent Transfer: Apply in new contexts.';
        explainText = 'Challenges students to apply the concept to a real-world scenario with zero scaffolds.';
      }

      wQuote.textContent = quoteText;
      wExplain.textContent = explainText;

      buddyWindow.querySelectorAll('.mode-btn').forEach(btn => {
        const val = Number(btn.getAttribute('data-val'));
        if (val === crowdVal) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });
    }

    if (wSlider) {
      wSlider.addEventListener('input', updateMinimalWidget);

      buddyWindow.querySelectorAll('.mode-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const val = btn.getAttribute('data-val');
          if (val !== null) {
            wSlider.value = val;
            updateMinimalWidget();
          }
        });
      });

      updateMinimalWidget();
    }

    buddyWindow.querySelectorAll(".wb-tool-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        buddyWindow.querySelectorAll(".wb-tool-btn").forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
      });
    });

    const zoomOutBtn = buddyWindow.querySelector("#wb-zoom-out") as HTMLElement | null;
    const zoomInBtn = buddyWindow.querySelector("#wb-zoom-in") as HTMLElement | null;
    const zoomValue = buddyWindow.querySelector("#wb-zoom-value") as HTMLElement | null;
    let currentZoom = 130;

    if (zoomOutBtn && zoomInBtn && zoomValue) {
      zoomOutBtn.addEventListener("click", () => {
        if (currentZoom > 50) {
          currentZoom -= 10;
          zoomValue.textContent = `${currentZoom}%`;
        }
      });
      zoomInBtn.addEventListener("click", () => {
        if (currentZoom < 200) {
          currentZoom += 10;
          zoomValue.textContent = `${currentZoom}%`;
        }
      });
    }

    // Whiteboard panning logic
    const wbCanvas = buddyWindow.querySelector(".whiteboard-canvas") as HTMLElement | null;
    if (wbCanvas) {
      let isPanning = false;
      let startX = 0;
      let startY = 0;
      let panX = 0;
      let panY = 0;

      wbCanvas.addEventListener("mousedown", (e) => {
        if ((e.target as HTMLElement).closest("button, input, select, textarea")) return;
        isPanning = true;
        startX = e.clientX - panX;
        startY = e.clientY - panY;
      });

      window.addEventListener("mousemove", (e) => {
        if (!isPanning) return;
        panX = e.clientX - startX;
        panY = e.clientY - startY;
        wbCanvas.style.setProperty("--pan-x", `${panX}px`);
        wbCanvas.style.setProperty("--pan-y", `${panY}px`);
      });

      window.addEventListener("mouseup", () => {
        isPanning = false;
      });
    }

    const toastOpenBtn = buddyWindow.querySelector('.toast-action-btn') as HTMLElement | null;
    const toastEl = buddyWindow.querySelector("#workspace-toast") as HTMLElement | null;
    if (toastOpenBtn && toastEl) {
      toastOpenBtn.addEventListener('click', () => {
        toastEl.classList.remove('visible');
      });
    }

    // Slide deck viewer logic
    let currentSlide = 1;
    const totalSlides = 2;
    const slidePrevBtn = buddyWindow.querySelector("#slide-prev-btn") as HTMLButtonElement | null;
    const slideNextBtn = buddyWindow.querySelector("#slide-next-btn") as HTMLButtonElement | null;
    const slideNavIndicator = buddyWindow.querySelector("#slide-nav-indicator") as HTMLElement | null;
    const slideCard1 = buddyWindow.querySelector("#slide-card-1") as HTMLElement | null;
    const slideCard2 = buddyWindow.querySelector("#slide-card-2") as HTMLElement | null;
    const slidesPresentBtn = buddyWindow.querySelector("#slides-present-btn") as HTMLButtonElement | null;

    function updateSlides() {
      if (!slidePrevBtn || !slideNextBtn || !slideNavIndicator || !slideCard1 || !slideCard2) return;
      
      // Toggle active slides
      if (currentSlide === 1) {
        slideCard1.style.display = "flex";
        slideCard2.style.display = "none";
        slidePrevBtn.disabled = true;
        slideNextBtn.disabled = false;
      } else {
        slideCard1.style.display = "none";
        slideCard2.style.display = "flex";
        slidePrevBtn.disabled = false;
        slideNextBtn.disabled = true;
      }
      
      slideNavIndicator.textContent = `Slide ${currentSlide} of ${totalSlides}`;
    }

    if (slidePrevBtn) {
      slidePrevBtn.addEventListener("click", () => {
        if (currentSlide > 1) {
          currentSlide--;
          updateSlides();
        }
      });
    }

    if (slideNextBtn) {
      slideNextBtn.addEventListener("click", () => {
        if (currentSlide < totalSlides) {
          currentSlide++;
          updateSlides();
        }
      });
    }

    if (slidesPresentBtn) {
      slidesPresentBtn.addEventListener("click", () => {
        const shell = buddyWindow.querySelector(".slides-content-area");
        if (shell) {
          shell.classList.toggle("fullscreen");
          const btnText = slidesPresentBtn.querySelector("span");
          if (btnText) {
            btnText.textContent = shell.classList.contains("fullscreen") ? "Exit" : "Present";
          }
        }
      });
    }

    // Bind slide keys (Left/Right arrow, Space) when slides-mode is active
    window.addEventListener("keydown", (e) => {
      const benchShell = buddyWindow.querySelector(".editor-bench-shell");
      if (e.key === "Escape") {
        const shell = buddyWindow.querySelector(".slides-content-area");
        if (shell && shell.classList.contains("fullscreen")) {
          shell.classList.remove("fullscreen");
          const btnText = slidesPresentBtn ? slidesPresentBtn.querySelector("span") : null;
          if (btnText) btnText.textContent = "Present";
        }
      }
      if (!benchShell || !benchShell.classList.contains("slides-mode")) return;
      if (e.key === "ArrowRight" || e.key === " ") {
        if (currentSlide < totalSlides) {
          currentSlide++;
          updateSlides();
        }
      } else if (e.key === "ArrowLeft") {
        if (currentSlide > 1) {
          currentSlide--;
          updateSlides();
        }
      }
    });

    setTimeout(() => {
      loadNotebook("lesson-planning");
    }, 800);
  }
</script>
