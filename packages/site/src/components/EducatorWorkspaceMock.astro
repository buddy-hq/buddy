      if (chatFeed) {
        chatFeed.innerHTML = "";
      }

      runChatStream(key, streamId);
    }

    function getToolStatusText(action: string, isDone: boolean): string {
      if (action.startsWith("Draft")) {
        return isDone ? action.replace("Draft", "Drafted") : action.replace("Draft", "Drafting");
      }
      if (action.startsWith("Search")) {
        return isDone ? action.replace("Search", "Searched") : action.replace("Search", "Searching");
      }
      if (action.startsWith("Generate")) {
        return isDone ? action.replace("Generate", "Generated") : action.replace("Generate", "Generating");
      }
      if (action.startsWith("Create")) {
        return isDone ? action.replace("Create", "Created") : action.replace("Create", "Creating");
      }
      return action;
    }

