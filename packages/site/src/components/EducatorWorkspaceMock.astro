        slidePrevBtn.disabled = true;
        slideNextBtn.disabled = false;
        slideNavIndicator.textContent = "Slide 1 of 2";
      }

      if (libraryRailBtn) {
        buddyWindow.querySelectorAll('.action-btn').forEach(btn => btn.classList.remove('active'));
        libraryRailBtn.classList.add('active');
