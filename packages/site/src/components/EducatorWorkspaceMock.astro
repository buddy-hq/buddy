    async function typeMessageInner(container: HTMLElement, htmlText: string, streamId: number) {
      const chunks: string[] = [];
      let i = 0;
      while (i < htmlText.length) {
        if (htmlText[i] === '<') {
          const closingIndex = htmlText.indexOf('>', i);
          if (closingIndex !== -1) {
            chunks.push(htmlText.substring(i, closingIndex + 1));
            i = closingIndex + 1;
            continue;
          }
        }
        chunks.push(htmlText[i]);
        i++;
      }

      let currentText = "";
      for (const chunk of chunks) {
        if (streamId !== currentStreamId) return;
        currentText += chunk;
        container.innerHTML = currentText;
        if (chatFeed) chatFeed.scrollTop = chatFeed.scrollHeight;
        
        const delay = chunk.startsWith('<') ? 0 : (Math.random() * 6 + 4);
        await new Promise(resolve => setTimeout(resolve, delay));
      }
    }

