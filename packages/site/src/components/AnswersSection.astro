---
// The closing argument, as a ledger. Privacy, price, and "what's the catch"
// are the same conversation for every audience — so they get one section:
// the questions a skeptic would actually ask, answered straight, in order.
import type { Audience } from "../content/site"
import { content } from "../content/site"
import { AUDIENCE_EDUCATORS } from "../lib/constants"

type Props = {
  initialAudience?: Audience
}

const { initialAudience } = Astro.props
const isEducator = initialAudience === AUDIENCE_EDUCATORS
const answers = isEducator ? content.educatorAnswers : content.learnerAnswers
---

<section
  class="answers-section"
  aria-labelledby="answers-heading"
  data-analytics-section="answers"
>
  <div class="container">
    <header class="answers-header reveal">
      <span class="answers-eyebrow">{answers.eyebrow}</span>
      <h2 id="answers-heading" class="answers-headline">{answers.headline}</h2>
    </header>

    <dl class="answers-ledger">
      {answers.items.map((item, i) => (
        <div class="answers-row reveal">
          <dt class="answers-q">
            <span class="answers-num">{String(i + 1).padStart(2, "0")}</span>
            {item.q}
          </dt>
          <dd class="answers-a">
            <p>{item.a}</p>
            {item.chips && (
              <ul class="answers-chips">
                {item.chips.map((chip) => (
                  <li>{chip}</li>
                ))}
              </ul>
            )}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .answers-section {
    padding: var(--space-24) 0;
  }

  .answers-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin-bottom: var(--space-12);
  }

  .answers-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent-primary);
    margin-bottom: var(--space-5);
  }

  .answers-headline {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 510;
    line-height: 1.1;
    letter-spacing: -0.022em;
    color: var(--color-text-primary);
    text-wrap: balance;
    margin: 0;
  }

  .answers-ledger {
    margin: 0;
  }

  .answers-row {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: var(--space-6) var(--space-16);
    padding: var(--space-8) 0;
  }

  .answers-row + .answers-row {
    border-top: 1px solid var(--border);
  }

  /* cascade the ledger in */
  .answers-row:nth-child(2) {
    transition-delay: 70ms;
  }

  .answers-row:nth-child(3) {
    transition-delay: 140ms;
  }

  .answers-row:nth-child(4) {
    transition-delay: 210ms;
  }

  .answers-q {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.9vw, 1.625rem);
    font-weight: 550;
    line-height: 1.25;
    letter-spacing: -0.018em;
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  .answers-num {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 0.55em;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .answers-a {
    margin: 0;
  }

  .answers-a p {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    font-weight: 300;
    line-height: 1.7;
    letter-spacing: -0.011em;
    color: var(--color-text-secondary);
    max-width: 58ch;
    text-wrap: pretty;
    margin: 0;
  }

  .answers-chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-5) 0 0 0;
    padding: 0;
  }

  .answers-chips li {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
    background-color: rgba(255, 255, 255, 0.045);
    border-radius: 999px;
    padding: 7px 14px;
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .answers-section {
      padding: var(--space-12) 0;
    }

    .answers-header {
      margin-bottom: var(--space-8);
    }

    .answers-row {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3);
      padding: var(--space-6) 0;
    }
  }

  @media (max-width: 576px) {
    .answers-headline {
      font-size: 1.75rem;
    }

    .answers-q {
      font-size: 1.125rem;
      gap: var(--space-2);
    }

    .answers-num {
      display: none;
    }

    .answers-a p {
      font-size: 1rem;
    }

    .answers-row {
      padding: var(--space-5) 0;
    }
  }
</style>
