---
import { content } from "../content/site"
import BYOOption from "./BYOOption.astro"
import ollamaIcon from "../assets/ollama-icon.svg?raw"

const { bringYourOwn } = content
const byoOptions = bringYourOwn.options

const openaiIconPath =
  "M22.2819 9.8211a5.9847 5.9847 0 0 0-.5157-4.9108 6.0462 6.0462 0 0 0-6.5098-2.9A6.0651 6.0651 0 0 0 4.9807 4.1818a5.9847 5.9847 0 0 0-3.9977 2.9 6.0462 6.0462 0 0 0 .7427 7.0966 5.98 5.98 0 0 0 .511 4.9107 6.051 6.051 0 0 0 6.5146 2.9001A5.9847 5.9847 0 0 0 13.2599 24a6.0557 6.0557 0 0 0 5.7718-4.2058 5.9894 5.9894 0 0 0 3.9977-2.9001 6.0557 6.0557 0 0 0-.7475-7.0729zm-9.022 12.6081a4.4755 4.4755 0 0 1-2.8764-1.0408l.1419-.0804 4.7783-2.7582a.7948.7948 0 0 0 .3927-.6813v-6.7369l2.02 1.1686a.071.071 0 0 1 .038.052v5.5826a4.504 4.504 0 0 1-4.4945 4.4944zm-9.6607-4.1254a4.4708 4.4708 0 0 1-.5346-3.0137l.142.0852 4.783 2.7582a.7712.7712 0 0 0 .7806 0l5.8428-3.3685v2.3324a.0804.0804 0 0 1-.0332.0615L9.74 19.9502a4.4992 4.4992 0 0 1-6.1408-1.6464zM2.3408 7.8956a4.485 4.485 0 0 1 2.3655-1.9728V11.6a.7664.7664 0 0 0 .3879.6765l5.8144 3.3543-2.0201 1.1685a.0757.0757 0 0 1-.071 0l-4.8303-2.7865A4.504 4.504 0 0 1 2.3408 7.8956zm16.5963 3.8558L13.1038 8.364l2.0201-1.1638a.0757.0757 0 0 1 .071 0l4.8303 2.7913a4.4944 4.4944 0 0 1-.6765 8.1042v-5.6772a.79.79 0 0 0-.407-.667zm2.0107-3.0231l-.142-.0852-4.7735-2.7818a.7759.7759 0 0 0-.7854 0L9.409 9.2297V6.8974a.0662.0662 0 0 1 .0284-.0615l4.8303-2.7866a4.4992 4.4992 0 0 1 6.6802 4.66zM8.3065 12.863l-2.02-1.1638a.0804.0804 0 0 1-.038-.0567V6.0742a4.4992 4.4992 0 0 1 7.3757-3.4537l-.142.0805L8.704 5.459a.7948.7948 0 0 0-.3927.6813zm1.0976-2.3654l2.602-1.4998 2.6069 1.4998v2.9994l-2.5974 1.4997-2.6067-1.4997z"
---

<div class="bring-your-own">
  <div class="container">

    <div class="section-header">
      <h2 class="section-title">{bringYourOwn.headline}</h2>
      <p class="section-subtext">{bringYourOwn.subtext}</p>
    </div>

    <div class="byo-card">
      <div class="byo-card-inner">
        <BYOOption title={byoOptions[0].title} description={byoOptions[0].description}>
          <svg slot="marker" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 7v14"></path>
            <path d="M20 11v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-8"></path>
            <path d="M7.5 7a1 1 0 0 1 0-5A4.8 8 0 0 1 12 7a4.8 8 0 0 1 4.5-5 1 1 0 0 1 0 5"></path>
            <rect x="3" y="7" width="18" height="4" rx="1"></rect>
          </svg>
        </BYOOption>

        <div class="sep"></div>

        <BYOOption title={byoOptions[1].title} description={byoOptions[1].description}>
          <svg slot="marker" viewBox="0 0 24 24" fill="currentColor">
            <path d={openaiIconPath} />
          </svg>
        </BYOOption>

        <div class="sep"></div>

        <BYOOption title={byoOptions[2].title} description={byoOptions[2].description}>
          <svg slot="marker" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 11v6"></path>
            <path d="M19 13h2"></path>
            <path d="M2 21a8 8 0 0 1 12.868-6.349"></path>
            <circle cx="10" cy="8" r="5"></circle>
            <circle cx="19" cy="19" r="2"></circle>
          </svg>
        </BYOOption>

        <div class="sep"></div>

        <BYOOption title={byoOptions[3].title} description={byoOptions[3].description}>
          <span slot="marker" class="byo-option-marker-svg" set:html={ollamaIcon} />
        </BYOOption>
      </div>
    </div>

  </div>
</div>

<style is:global>
  .bring-your-own {
    padding: var(--space-24) 0;
    width: 100%;
  }

  .bring-your-own .container {
    max-width: min(75vw, 1436px);
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  .bring-your-own .section-header {
    text-align: left;
    max-width: 700px;
    margin: 0 0 96px;
  }

  .bring-your-own .section-title {
    font-family: var(--font-display);
    font-size: 48px;
    font-weight: 510;
    color: var(--color-text-primary);
    line-height: 1;
    letter-spacing: -0.022em;
    margin: 0 0 var(--space-3);
  }

  .bring-your-own .section-subtext {
    color: var(--color-text-secondary);
    opacity: 0.88;
  }

  .bring-your-own .byo-card {
    overflow: hidden;
    background-color: var(--color-card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
  }

  .bring-your-own .byo-card-inner {
    display: grid;
    grid-template-columns: 1fr 1px 1fr 1px 1fr 1px 1fr;
    align-items: stretch;
  }

  .bring-your-own .sep {
    background-color: rgba(255, 255, 255, 0.06);
    min-height: 100px;
    align-self: center;
  }

  @media (max-width: 992px) {
    .bring-your-own .section-title {
      font-size: 40px;
    }
  }

  @media (max-width: 860px) {
    .bring-your-own .byo-card-inner {
      grid-template-columns: 1fr;
    }
    .bring-your-own .sep {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .bring-your-own .section-header {
      margin-bottom: 48px;
      max-width: 100%;
    }
    .bring-your-own .section-title {
      font-size: 24px !important;
    }
    .bring-your-own .section-subtext {
      font-size: var(--text-sm) !important; /* Scale subtext down on mobile */
    }
    .bring-your-own .container {
      max-width: 100%;
      padding: 0 var(--space-5);
    }
  }
</style>
