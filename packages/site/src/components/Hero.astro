---
import BuddyWorkspaceMock from "./BuddyWorkspaceMock.astro"
import VideoLightbox from "./VideoLightbox.astro"
import { content, type Audience } from "../content/site"
import {
  AUDIENCE_EDUCATORS,
  LAUNCH_VIDEO_EMBED_URL,
  LAUNCH_VIDEO_WATCH_URL,
  VIDEO_LIGHTBOX,
} from "../lib/constants"

type Props = {
  audience: Audience
}

const { audience } = Astro.props
const { launchVideo } = content
---

<section class:list={["hero animate-in", { "hero--educator": audience === AUDIENCE_EDUCATORS }]} data-analytics-section="hero">
  <div class="hero-bg-gradient" aria-hidden="true"></div>
  <div class="container">

    <!-- Hero Header -->
    <div class="hero-header-section">
      <slot name="heading" />
      <div class="hero-header-row">
        <div class="hero-header-left">
          <slot name="subtext" />
        </div>
        <div class="hero-header-right">
          <a
            class="hero-video-chip"
            href={LAUNCH_VIDEO_WATCH_URL}
            {...{ [VIDEO_LIGHTBOX.openAttribute]: "" }}
          >
            <span class="hero-video-chip-badge">{launchVideo.badge}</span>
            <span class="hero-video-chip-label">{launchVideo.label}</span>
            <span class="hero-video-chip-arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Centered Workspace Mockup -->
    <div class="hero-visual">
      <div class="mockup-glow"></div>
      <div class="app-mockup-wrapper">
        <BuddyWorkspaceMock {audience} />
      </div>
      <div class="mockup-reflection"></div>
    </div>

  </div>

  <VideoLightbox embedUrl={LAUNCH_VIDEO_EMBED_URL} title={launchVideo.title} />
</section>

<style is:global>
  /* Hero Install CTA (Mobile only) */


  /* === Hero Base === */
  /* The air above the headline is the first thing the page says. The floor
     (8rem) is the phone value and the cap (12.5rem) is the desktop one, which
     lands within ~15px of the reference at every width between them. */
  .hero {
    position: relative;
    padding: clamp(8rem, 16vw, 12.5rem) 0 var(--space-32) 0;
    overflow: hidden;
  }

  /* Educator hero leads with a short, single-line headline, so it needs
     less breathing room up top than the taller two-line learner headline.
     Held at roughly two thirds of the learner hero's air. */
  .hero--educator {
    padding-top: clamp(5rem, 10vw, 8rem);
  }

  /* A pool of light rising from behind the product shot, so the mock sits in
     something instead of on a flat ground.

     Aurora rather than accent: the accent is orange and already spoken for by
     the download button, so a wash in it would read as more CTA. Violet is the
     other hue the theme already owns, and it reads as atmosphere rather than
     as another thing to click.

     One layer, centred at 68% — roughly the top third of the mock — and fully
     faded by ~70% of its radius, so it never reaches the section's clipped
     bottom edge and band there. `--aurora-weak` carries its own alpha, so the
     strength is the theme's call, not a hard-coded opacity here. */
  /* The section-wide accent wash is gone — the page ground is the theme's job now. */
  .hero-bg-gradient {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }

  .hero .container {
    position: relative;
    z-index: 1;
  }


  /* --- Hero Header Section --- */
  .hero-header-section {
    margin-bottom: 96px;
    position: relative;
  }

  /* The hero arrives in the order it is read: headline, then the line under it,
     then the video link, then the product shot. Animating the header as one
     block (what this did before) lands all three pieces of type at once, which
     reads as a page that popped rather than one that resolved.

     `backwards` holds the first frame during the delay, so nothing flashes at
     full opacity before its turn. */
  /* Each piece resolves out of a blur rather than just sliding up — the type
     comes into focus, which is what makes the reveal read as the page settling
     instead of the page moving. The rise is deliberately small (8px); with the
     blur doing the work, a large travel just looks like a slide.

     No `opacity: 0` on the elements themselves. `backwards` already holds the
     first keyframe through the delay, and hard-coding the hidden state means a
     browser that never runs the animation renders an empty hero. */
  @keyframes hero-reveal {
    from {
      opacity: 0;
      filter: blur(8px);
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      filter: blur(0);
      transform: translateY(0);
    }
  }

  .hero-title,
  .hero-header-left,
  .hero-header-right,
  .hero-visual {
    animation: hero-reveal 1600ms var(--ease-out) backwards;
  }

  .hero-title {
    animation-delay: 0ms;
  }

  .hero-header-left {
    animation-delay: 220ms;
  }

  .hero-header-right {
    animation-delay: 440ms;
  }

  .hero-visual {
    animation-delay: 660ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-title,
    .hero-header-left,
    .hero-header-right,
    .hero-visual {
      animation: none;
      opacity: 1;
      filter: none;
      transform: none;
    }
  }

  @media (max-width: 576px) {
    .hero-header-section {
      margin-bottom: 48px;
    }
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: 64px;
    font-weight: 510;
    line-height: 1.06;
    letter-spacing: -0.022em;
    margin-bottom: var(--space-8);
    color: var(--color-text-primary);
    text-wrap: balance;
    max-width: 100%;
  }

  @media (max-width: 992px) {
    .hero-title {
      font-size: 54px;
      font-weight: 500; /* Not bold in mobile */
    }
  }

  @media (max-width: 576px) {
    .hero-title {
      font-size: 38px;
      font-weight: 500;
      margin-bottom: var(--space-5);
    }
  }

  .hero-accent {
    color: var(--accent-base);
  }

  .hero-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-8);
  }

  .hero-header-left {
    max-width: 68ch;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  /* Kept a step above the reference's 15px on purpose: this subtext is a full
     sentence carrying five capabilities, not a six-word tagline, and our
     headline does not tower over it the way a two-line one does. */
  .hero-subtitle {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-weight: 400;
    line-height: 1.6;
    letter-spacing: -0.012em;
    color: var(--color-text-secondary);
    opacity: 0.88;
    /* Wraps well before the headline does, so the block narrows as it
       descends instead of running the full width of the h1 above it. */
    max-width: 52ch;
    text-wrap: pretty;
  }

  @media (max-width: 992px) {
    .hero-subtitle {
      font-size: var(--text-base);
    }
  }

  @media (max-width: 576px) {
    .hero-subtitle {
      font-size: 0.9375rem;
      line-height: 1.6;
      letter-spacing: -0.011em;
    }
  }

  /* Actions buttons */
  .hero-actions {
    display: flex;
    gap: var(--space-4);
  }

  .hero-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: var(--accent-fill);
    border: 1px solid var(--border-weak);
    border-radius: var(--radius);
    padding: 12px 24px;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--accent-ink);
    text-decoration: none;
    cursor: pointer;
    box-shadow: var(--shadow-raised);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    letter-spacing: var(--tracking-wide);
  }

  .hero-btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background-color: var(--surface-base);
    border: 1px solid var(--border-weak);
    border-radius: var(--radius);
    padding: 12px 24px;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-primary);
    text-decoration: none;
    cursor: pointer;
    box-shadow: var(--shadow-raised);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    letter-spacing: var(--tracking-wide);
  }

  .hero-btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-overlay);
    background: var(--accent-base);
  }

  .hero-btn-secondary:hover {
    background-color: var(--surface-raised);
    border-color: var(--border-base);
    transform: translateY(-2px);
  }

  .hero-btn-primary:active,
  .hero-btn-secondary:active {
    transform: translateY(0) scale(0.97);
  }

  /* Launch video chip — the far end of the subtext row.
     Kept off the top of the headline on purpose: the h1 keeps first position,
     and the chip takes space that was empty. */
  .hero-header-right {
    display: flex;
    align-items: center;
  }

  /* No pill. A bordered capsule next to a bare line of subtext reads as a
     stray button floating in the margin; as plain type it sits in the row as
     a third piece of text, which is what it is. The last line of the subtext
     and this line share a bottom edge — that shared edge is the alignment. */
  .hero-video-chip {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    flex-shrink: 0;
    padding: 0;
    border: none;
    background: none;
    font-size: var(--text-sm);
    line-height: 1.6;
    letter-spacing: var(--tracking-snug);
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
  }

  .hero-video-chip-badge {
    font-weight: 510;
    color: var(--color-text-primary);
  }

  .hero-video-chip-label,
  .hero-video-chip-arrow {
    font-weight: 400;
    color: var(--color-text-tertiary);
    transition: color 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-video-chip-arrow {
    display: inline-block;
    transition:
      transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      color 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-video-chip:hover .hero-video-chip-label,
  .hero-video-chip:hover .hero-video-chip-arrow {
    color: var(--color-text-primary);
  }

  .hero-video-chip:hover .hero-video-chip-arrow {
    transform: translateX(3px);
  }

  /* --- Mockup Stage --- */
  /* Reveal timing lives with the rest of the stagger further up, not here. */
  .hero-visual {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-top: 0;
  }

  /* The floor the mock stands on.

     This is a tall gradient panel sitting *behind* the mock, and the mock is
     opaque — so all that shows is the strip below its bottom edge. That is the
     whole trick: the light reads as a thin bright sliver under the window
     rather than a violet slab, and it needs no separate element to clip it.

     Violet rather than accent: orange is spent on the download button, and a
     wash in it would read as more CTA. This is atmosphere, not an action.

     Geometry follows the reference, which hides the panel behind its frame and
     lets only the bottom strip show (its frame is 720px inside a 748px box).
     The strip height here is the one number worth tuning by eye — the
     reference's own reads taller than a literal port of its 28px.

     The panel is full width — the falloff is vertical only, plus a wide radial
     that dims just the outer corners. A tighter radial turns the band into a
     curved blob, which is the failure mode here.

     The stops mirror it too: page ground at 10%, brightest at 100%, so the 28px
     that actually shows is the very end of the ramp. */
  .mockup-glow {
    position: absolute;
    top: 0;
    bottom: -56px;
    /* Edge to edge, not container width. The mock lives inside the centred
       container, but the light it stands on spans the whole viewport — same as
       the reference, whose clip box starts at -7px in a 1153px window. The
       hero's `overflow: hidden` clips the bleed, so 100vw costs no scrollbar. */
    left: 50%;
    width: 100vw;
    transform: translateX(-50%);
    height: auto;
    z-index: -1;
    pointer-events: none;
    filter: none;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    background:
      radial-gradient(
        52.5% 57.5% at 50% 100%,
        transparent 0%,
        color-mix(in oklab, var(--surface-page) 50%, transparent) 100%
      ),
      linear-gradient(
        to bottom,
        var(--surface-page) 10%,
        color-mix(in oklab, var(--aurora-base) 62%, var(--surface-page)) 100%
      );
  }

  .app-mockup-wrapper {
    width: 100%;
    max-width: 100%;
    background-color: var(--chrome-base); /* Bezel frame around the app mock */
    border: 1px solid var(--border); /* Outer bezel outline */
    border-radius: calc(var(--radius) + 6px); /* Rounded bezel frame matching concentric math */
    padding: 6px; /* Gutter around the mock */
    /* The shared tokens are sized for cards a few hundred pixels wide; on an
       object this size `0 1px 2px` is invisible and the mock reads as a flat
       rectangle pasted onto the page. Contact at the edge plus a mid falloff —
       and no wide ambient pool, because a 96px spread of black underneath would
       smother the 28px of lit floor the mock is meant to be standing on. */
    box-shadow:
      0 2px 4px rgb(0 0 0 / 0.2),
      0 12px 28px -12px rgb(0 0 0 / 0.4);
    overflow: hidden;
  }

  /* Superseded by the ambient layer of the shadow above — keeping both stacked
     a dark smudge directly under the bezel. */
  .mockup-reflection {
    display: none;
  }

  /* --- Responsive --- */
  @media (max-width: 992px) {
    .hero {
      padding-bottom: var(--space-6) !important; /* Decrease spacing under the mockup on mobile */
    }

    .hero-header-row {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-6);
    }

    .hero-header-right {
      align-self: flex-start;
    }

    .hero-visual {
      display: block !important; /* Prevent browser flexbox overflow alignment bugs on mobile */
      /* Tall enough to show the whole mock uncropped, plus roughly 30px of
         slack under it — that slack is what the lit floor shows through, so
         every height below is really "mock height + strip". */
      height: 440px;
      overflow: hidden;
      position: relative;
      background-color: transparent;
      /* Full bleed, so this box clips at the viewport edges instead of the
         container's. The mock already ran off the right; what this buys is a
         floor behind it that can reach both edges — clipped in here, it never
         could.

         `100vw` counts the scrollbar and the page does not, so an exact bleed
         lands a pixel or two off centre and leaves a bare sliver down one side.
         Overshoot instead and let `.hero`'s own clip trim it: the edges come
         out exact by construction. The padding puts the mock back where the
         container would have started it, and since it cancels the margin term
         for term, the mock does not move by even a pixel. */
      --hero-visual-bleed-slack: 24px;
      width: calc(100vw + 2 * var(--hero-visual-bleed-slack));
      margin-left: calc(50% - 50vw - var(--hero-visual-bleed-slack));
      margin-right: calc(50% - 50vw - var(--hero-visual-bleed-slack));
      padding-left: calc(50vw - 50% + var(--hero-visual-bleed-slack));
    }

    .hero-visual .app-mockup-wrapper {
      position: relative;
      left: 4px !important; /* Prevent browser crop boundary from clipping the left border */
      top: 4px !important;  /* Prevent browser crop boundary from clipping the top border */
      width: 880px;
      min-width: 880px;
      transform: scale(0.8) translateZ(0);
      will-change: transform;
      transform-origin: top left;
      z-index: 5;
      padding: 0 !important; /* No gutters on mobile */
    }

    /* Keep the mockup grid open and styled as desktop mock */
    .hero-visual .workspace-body {
      grid-template-columns: 160px 1.25fr 1.15fr 40px !important;
      grid-template-rows: 100% !important;
      height: 500px !important;
      overflow: hidden !important;
    }

    .hero-visual .workspace-body.right-pane-collapsed {
      grid-template-columns: 160px 1.25fr 1.15fr 40px !important;
    }

    .hero-visual .surface-sidebar {
      display: flex !important;
      grid-column: 1 !important;
      grid-row: 1 !important;
    }

    .hero-visual .surface-chat {
      grid-column: 2 !important;
      grid-row: 1 !important;
      height: 100% !important;
      align-self: stretch !important;
    }

    .hero-visual .surface-actions {
      display: flex !important;
      grid-column: 4 !important;
      grid-row: 1 !important;
      height: 100% !important;
      align-self: stretch !important;
    }

    .hero-visual .buddy-window {
      pointer-events: auto !important;
      border: 1px solid var(--border) !important;
      box-shadow: none !important;
    }

    /* Kill all animations inside hero on mobile */
    .hero-visual .pulse-slow,
    .hero-visual [class*="pulse"] {
      animation: none !important;
    }

    .hero-visual::after {
      content: none !important; /* Remove bottom fade overlay */
    }

    .mockup-reflection {
      display: none;
    }

    /* The stage is already full bleed here, so the panel just fills it — the
       `100vw` the desktop rule needs would only reintroduce the scrollbar skew
       the stage went to some trouble to cancel.

       Bottom flush too: the stage clips, unlike on desktop where the panel is
       free to hang past it, and the gradient's bright end has to land on the
       clip edge or the strip under the mock shows a dimmer part of the ramp. */
    .mockup-glow {
      left: 0;
      width: 100%;
      transform: none;
      bottom: 0;
    }
  }

  @media (max-width: 768px) {
    .hero-visual {
      height: 455px;
    }
    .hero-visual .app-mockup-wrapper {
      transform: scale(0.75) translateZ(0);
    }

    /* Keep the mockup grid open and styled as desktop mock */
    .hero-visual .workspace-body {
      grid-template-columns: 0px 0.9fr 1.3fr 44px !important;
      grid-template-rows: 100% !important;
      height: 560px !important; /* Taller workspace to see more content vertically */
      overflow: hidden !important;
    }

    .hero-visual .workspace-body.right-pane-collapsed {
      grid-template-columns: 0px 0.9fr 1.3fr 44px !important;
    }

    .hero-visual .surface-sidebar {
      display: none !important;
    }

    .hero-visual .surface-chat {
      grid-column: 2 !important;
      grid-row: 1 !important;
      height: 100% !important;
      align-self: stretch !important;
    }

    .hero-visual .surface-whiteboard,
    .hero-visual .surface-reader,
    .hero-visual .surface-widget,
    .hero-visual .surface-notes {
      grid-column: 3 !important;
      grid-row: 1 !important;
      height: 100% !important;
      align-self: stretch !important;
      transform: none !important;
      display: none !important; /* Hidden by default unless active */
    }

    /* Force active right-pane display states on mobile viewports */
    .hero-visual .buddy-window.show-whiteboard .surface-whiteboard,
    .hero-visual .buddy-window:not(.show-whiteboard):not(.show-widget):not(.show-notes) .workspace-body:not(.right-pane-collapsed) .surface-reader,
    .hero-visual .buddy-window.show-widget .surface-widget,
    .hero-visual .buddy-window.show-notes .surface-notes {
      display: flex !important;
      opacity: 1 !important;
      visibility: visible !important;
    }

    /* Decrease padding on the left and right of the whiteboard drawings container */
    .hero-visual .wb-layout-container {
      max-width: 440px !important;
    }

    .hero-visual .whiteboard-canvas {
      padding: 8px !important;
    }

    .hero-visual .surface-actions {
      display: flex !important;
      grid-column: 4 !important;
      grid-row: 1 !important;
      height: 100% !important;
      align-self: stretch !important;
    }
  }

  @media (max-width: 580px) {
    .hero-visual {
      height: 416px;
    }
    .hero-visual .app-mockup-wrapper {
      transform: scale(0.68) translateZ(0);
    }
  }

  @media (max-width: 480px) {
    .hero-visual {
      height: 381px;
    }
    .hero-visual .app-mockup-wrapper {
      transform: scale(0.62) translateZ(0);
    }
  }

  @media (max-width: 380px) {
    .hero-visual {
      height: 342px;
    }
    .hero-visual .app-mockup-wrapper {
      transform: scale(0.55) translateZ(0);
    } 
  }

  @media (max-width: 576px) {
    .hero-actions {
      flex-direction: column;
      width: 100%;
    }

    .hero-btn-primary,
    .hero-btn-secondary {
      width: 100%;
    }

    .hero-header-left {
      max-width: 100%;
    }
  }
</style>
