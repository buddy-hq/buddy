---
import BuddyWorkspaceMock from "./BuddyWorkspaceMock.astro"
import type { Audience } from "../content/site"
import { AUDIENCE_EDUCATORS } from "../lib/constants"

type Props = {
  audience: Audience
}

const { audience } = Astro.props
---

<section class:list={["hero animate-in", { "hero--educator": audience === AUDIENCE_EDUCATORS }]} data-analytics-section="hero">
  <div class="hero-bg-gradient" aria-hidden="true"></div>
  <div class="container">

    <!-- Hero Header -->
    <div class="hero-header-section">
      <slot name="heading" />
      <div class="hero-header-row">
        <div class="hero-header-left">
          <slot name="subtext" />
        </div>
      </div>
    </div>

    <!-- Centered Workspace Mockup -->
    <div class="hero-visual">
      <div class="mockup-glow"></div>
      <div class="app-mockup-wrapper">
        <BuddyWorkspaceMock {audience} />
      </div>
      <div class="mockup-reflection"></div>
    </div>

  </div>
</section>

<style is:global>
  /* Hero Install CTA (Mobile only) */


  /* === Hero Base === */
  .hero {
    position: relative;
    padding: clamp(5rem, 10vw, 7rem) 0 clamp(4rem, 8vw, 6rem) 0;
    overflow: hidden;
  }

  /* Educator hero leads with a short, single-line headline, so it needs
     less breathing room up top than the taller two-line learner headline. */
  .hero--educator {
    padding-top: clamp(3rem, 6vw, 4.5rem);
  }

  /* The section-wide accent wash is gone — the page ground is the theme's job now. */
  .hero-bg-gradient {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }

  .hero .container {
    position: relative;
    z-index: 1;
  }

  /* --- Hero Header Section --- */
  .hero-header-section {
    margin-bottom: 96px;
    animation: fadeInUp 400ms var(--ease-out) forwards;
    position: relative;
  }

  @media (max-width: 576px) {
    .hero-header-section {
      margin-bottom: 48px;
    }
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: 64px;
    font-weight: 510;
    line-height: 1.06;
    letter-spacing: -0.022em;
    margin-bottom: var(--space-6);
    color: var(--color-text-primary);
    text-wrap: balance;
    max-width: 100%;
  }

  @media (max-width: 992px) {
    .hero-title {
      font-size: 54px;
      font-weight: 500; /* Not bold in mobile */
    }
  }

  @media (max-width: 576px) {
    .hero-title {
      font-size: 38px;
      font-weight: 500;
    }
  }

  .hero-accent {
    color: var(--accent-base);
  }

  .hero-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-8);
  }

  .hero-header-left {
    max-width: 68ch;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .hero-subtitle {
    font-family: var(--font-body);
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 1.33;
    letter-spacing: -0.012em;
    color: var(--color-text-secondary);
    opacity: 0.88;
    max-width: 68ch;
    text-wrap: pretty;
  }

  @media (max-width: 992px) {
    .hero-subtitle {
      font-size: 1.25rem;
    }
  }

  @media (max-width: 576px) {
    .hero-subtitle {
      font-size: 0.9375rem;
      line-height: 1.6;
      letter-spacing: -0.011em;
    }
  }

  /* Actions buttons */
  .hero-actions {
    display: flex;
    gap: var(--space-4);
  }

  .hero-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: var(--accent-fill);
    border: 1px solid var(--border-weak);
    border-radius: var(--radius);
    padding: 12px 24px;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--accent-ink);
    text-decoration: none;
    cursor: pointer;
    box-shadow: var(--shadow-raised);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    letter-spacing: var(--tracking-wide);
  }

  .hero-btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background-color: var(--surface-base);
    border: 1px solid var(--border-weak);
    border-radius: var(--radius);
    padding: 12px 24px;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-primary);
    text-decoration: none;
    cursor: pointer;
    box-shadow: var(--shadow-raised);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    letter-spacing: var(--tracking-wide);
  }

  .hero-btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-overlay);
    background: var(--accent-base);
  }

  .hero-btn-secondary:hover {
    background-color: var(--surface-raised);
    border-color: var(--border-base);
    transform: translateY(-2px);
  }

  .hero-btn-primary:active,
  .hero-btn-secondary:active {
    transform: translateY(0) scale(0.97);
  }

  /* Right Announcement Link */
  .hero-header-right {
    display: flex;
    align-items: center;
  }

  .hero-announcement-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: var(--accent-weak);
    border: 1px solid var(--accent-border);
    border-radius: 99px;
    padding: 6px 14px 6px 8px;
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-text-secondary);
    text-decoration: none;
    box-shadow: var(--shadow-raised);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-announcement-link:hover {
    border-color: var(--accent-border);
    background-color: var(--accent-weak);
    transform: translateY(-1px);
    color: var(--fg-strong);
  }

  .announcement-badge {
    background: var(--accent-fill);
    color: var(--accent-ink);
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 99px;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* --- Mockup Stage --- */
  .hero-visual {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-top: 0;
    animation: fadeInUp 500ms var(--ease-out) 0.15s forwards;
    opacity: 0;
  }

  /* The accent glow behind the mockup is gone — elevation comes from the shadow, not a wash. */
  .mockup-glow {
    position: absolute;
    width: 90%;
    height: 90%;
    z-index: -1;
    pointer-events: none;
    filter: blur(50px);
  }

  .app-mockup-wrapper {
    width: 100%;
    max-width: 100%;
    background-color: var(--chrome-base); /* Bezel frame around the app mock */
    border: 1px solid var(--border); /* Outer bezel outline */
    border-radius: calc(var(--radius) + 6px); /* Rounded bezel frame matching concentric math */
    padding: 6px; /* Gutter around the mock */
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }

  .mockup-reflection {
    width: 75%;
    height: 40px;
    background: radial-gradient(ellipse, rgba(0, 0, 0, 0.8) 0%, transparent 80%);
    margin-top: -16px;
    z-index: -1;
    filter: blur(8px);
    pointer-events: none;
  }

  /* --- Responsive --- */
  @media (max-width: 992px) {
    .hero {
      padding-bottom: var(--space-6) !important; /* Decrease spacing under the mockup on mobile */
    }

    .hero-header-row {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-6);
    }

    .hero-header-right {
      align-self: flex-start;
    }

    .hero-visual {
      display: block !important; /* Prevent browser flexbox overflow alignment bugs on mobile */
      height: 440px; /* Taller visual stage to show full mockup without vertical cropping */
      overflow: hidden;
      position: relative;
      background-color: transparent;
      width: calc(100% + var(--space-6));
      margin-left: 0;
      margin-right: calc(-1 * var(--space-6));
      padding-left: 0;
    }

    .hero-visual .app-mockup-wrapper {
      position: relative;
      left: 4px !important; /* Prevent browser crop boundary from clipping the left border */
      top: 4px !important;  /* Prevent browser crop boundary from clipping the top border */
      width: 880px;
      min-width: 880px;
      transform: scale(0.8) translateZ(0);
      will-change: transform;
      transform-origin: top left;
      z-index: 5;
      padding: 0 !important; /* No gutters on mobile */
    }

    /* Keep the mockup grid open and styled as desktop mock */
    .hero-visual .workspace-body {
      grid-template-columns: 160px 1.25fr 1.15fr 40px !important;
      grid-template-rows: 100% !important;
      height: 500px !important;
      overflow: hidden !important;
    }

    .hero-visual .workspace-body.right-pane-collapsed {
      grid-template-columns: 160px 1.25fr 1.15fr 40px !important;
    }

    .hero-visual .surface-sidebar {
      display: flex !important;
      grid-column: 1 !important;
      grid-row: 1 !important;
    }

    .hero-visual .surface-chat {
      grid-column: 2 !important;
      grid-row: 1 !important;
      height: 100% !important;
      align-self: stretch !important;
    }

    .hero-visual .surface-actions {
      display: flex !important;
      grid-column: 4 !important;
      grid-row: 1 !important;
      height: 100% !important;
      align-self: stretch !important;
    }

    .hero-visual .buddy-window {
      pointer-events: auto !important;
      border: 1px solid var(--border) !important;
      box-shadow: none !important;
    }

    /* Kill all animations inside hero on mobile */
    .hero-visual .pulse-slow,
    .hero-visual [class*="pulse"] {
      animation: none !important;
    }

    .hero-visual::after {
      content: none !important; /* Remove bottom fade overlay */
    }

    .mockup-reflection {
      display: none;
    }

    .mockup-glow {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .hero-visual {
      width: calc(100% + var(--space-5)) !important;
      margin-right: calc(-1 * var(--space-5)) !important;
      height: 455px;
    }
    .hero-visual .app-mockup-wrapper {
      transform: scale(0.75) translateZ(0);
    }

    /* Keep the mockup grid open and styled as desktop mock */
    .hero-visual .workspace-body {
      grid-template-columns: 0px 0.9fr 1.3fr 44px !important;
      grid-template-rows: 100% !important;
      height: 560px !important; /* Taller workspace to see more content vertically */
      overflow: hidden !important;
    }

    .hero-visual .workspace-body.right-pane-collapsed {
      grid-template-columns: 0px 0.9fr 1.3fr 44px !important;
    }

    .hero-visual .surface-sidebar {
      display: none !important;
    }

    .hero-visual .surface-chat {
      grid-column: 2 !important;
      grid-row: 1 !important;
      height: 100% !important;
      align-self: stretch !important;
    }

    .hero-visual .surface-whiteboard,
    .hero-visual .surface-reader,
    .hero-visual .surface-widget,
    .hero-visual .surface-notes {
      grid-column: 3 !important;
      grid-row: 1 !important;
      height: 100% !important;
      align-self: stretch !important;
      transform: none !important;
      display: none !important; /* Hidden by default unless active */
    }

    /* Force active right-pane display states on mobile viewports */
    .hero-visual .buddy-window.show-whiteboard .surface-whiteboard,
    .hero-visual .buddy-window:not(.show-whiteboard):not(.show-widget):not(.show-notes) .workspace-body:not(.right-pane-collapsed) .surface-reader,
    .hero-visual .buddy-window.show-widget .surface-widget,
    .hero-visual .buddy-window.show-notes .surface-notes {
      display: flex !important;
      opacity: 1 !important;
      visibility: visible !important;
    }

    /* Decrease padding on the left and right of the whiteboard drawings container */
    .hero-visual .wb-layout-container {
      max-width: 440px !important;
    }

    .hero-visual .whiteboard-canvas {
      padding: 8px !important;
    }

    .hero-visual .surface-actions {
      display: flex !important;
      grid-column: 4 !important;
      grid-row: 1 !important;
      height: 100% !important;
      align-self: stretch !important;
    }
  }

  @media (max-width: 580px) {
    .hero-visual {
      height: 410px;
    }
    .hero-visual .app-mockup-wrapper {
      transform: scale(0.68) translateZ(0);
    }
  }

  @media (max-width: 480px) {
    .hero-visual {
      height: 374px;
    }
    .hero-visual .app-mockup-wrapper {
      transform: scale(0.62) translateZ(0);
    }
  }

  @media (max-width: 380px) {
    .hero-visual {
      height: 332px;
    }
    .hero-visual .app-mockup-wrapper {
      transform: scale(0.55) translateZ(0);
    } 
  }

  @media (max-width: 576px) {
    .hero-actions {
      flex-direction: column;
      width: 100%;
    }

    .hero-btn-primary,
    .hero-btn-secondary {
      width: 100%;
    }

    .hero-header-left {
      max-width: 100%;
    }
  }
</style>
