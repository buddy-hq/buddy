---
import { MAC_INSTALL_CMD, WIN_INSTALL_CMD } from "../lib/constants"
---

<section id="install" class="install-section reveal">
  <div class="container">
    <div class="install-header">
      <h2 class="section-title">Install Buddy</h2>
      <div class="install-platform">
        <button class="platform-btn active" data-os="mac">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.08 1.85-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09l.01-.01zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"></path></svg>
          <span>macOS</span>
        </button>
        <button class="platform-btn" data-os="win">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.9-1.899"></path></svg>
          <span>Windows</span>
        </button>
      </div>
    </div>

    <div class="install-command-wrapper">
      <span class="install-cmd-prefix" id="cmd-prefix">$</span>
      <code class="install-command" id="install-command">{MAC_INSTALL_CMD}</code>
      <button class="install-copy-btn" id="install-copy-btn" data-copy={MAC_INSTALL_CMD} aria-label="Copy install command">
        <svg class="copy-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
        <svg class="check-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
      </button>
    </div>

    <div class="install-steps">
      <div class="install-step">
        <span class="step-num">1</span>
        <span class="step-text">Copy</span>
      </div>
      <span class="step-arrow">→</span>
      <div class="install-step">
        <span class="step-num">2</span>
        <span class="step-text">Paste in terminal</span>
      </div>
      <span class="step-arrow">→</span>
      <div class="install-step">
        <span class="step-num">3</span>
        <span class="step-text">Launch Buddy</span>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .install-section {
    padding-block: clamp(3.5rem, 8vw, 6rem);
    border-top: 1px solid var(--color-card-border);
    position: relative;
    text-align: center;
  }

  /* Header — title + toggle stacked */
  .install-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
    margin-bottom: var(--space-12);
  }



  /* Platform toggle */
  .install-platform {
    display: inline-flex;
    gap: 2px;
    background-color: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 999px;
    padding: 3px;
  }

  .platform-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: none;
    border: none;
    border-radius: 999px;
    padding: 6px 16px;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: color 0.25s var(--ease-out), background-color 0.25s var(--ease-out);
  }

  .platform-btn.active {
    background-color: rgba(255, 255, 255, 0.06);
    color: var(--color-text-primary);
  }

  .platform-btn svg { opacity: 0.55; }
  .platform-btn.active svg { opacity: 1; }

  @media (hover: hover) and (pointer: fine) {
    .platform-btn:hover:not(.active) {
      color: var(--color-text-secondary);
    }
  }

  /* Command bar — truncated, with inline copy */
  .install-command-wrapper {
    display: flex;
    align-items: center;
    max-width: 600px;
    margin: 0 auto var(--space-8);
    background-color: rgba(0, 0, 0, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
  }

  .install-cmd-prefix {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: #10b981;
    padding: 14px 0 14px 16px;
    user-select: none;
    flex-shrink: 0;
  }

  .install-command {
    flex: 1;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    padding: 14px 8px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    line-height: 1.5;
    min-width: 0;
    text-align: left;
  }

  .install-copy-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.04);
    border: none;
    border-left: 1px solid rgba(255, 255, 255, 0.06);
    color: var(--color-text-secondary);
    cursor: pointer;
    padding: 0 16px;
    align-self: stretch;
    transition: background-color 0.15s var(--ease-out), color 0.15s var(--ease-out);
  }

  .install-copy-btn:active { transform: scale(0.96); }

  .install-copy-btn .check-icon { display: none; }
  .install-copy-btn.copied {
    background-color: rgba(45, 212, 191, 0.12);
    color: #2dd4bf;
  }
  .install-copy-btn.copied .copy-icon { display: none; }
  .install-copy-btn.copied .check-icon { display: block; }

  @media (hover: hover) and (pointer: fine) {
    .install-copy-btn:hover {
      background-color: rgba(255, 255, 255, 0.08);
      color: var(--color-text-primary);
    }
  }

  /* Steps */
  .install-steps {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }

  .install-step {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .step-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 10px;
    font-weight: 700;
    color: var(--color-text-tertiary);
    flex-shrink: 0;
  }

  .step-text {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .step-arrow {
    color: var(--color-text-muted);
    opacity: 0.3;
    font-size: var(--text-xs);
  }

  @media (max-width: 640px) {
    .install-steps {
      flex-direction: column;
      gap: var(--space-3);
    }
    .step-arrow { transform: rotate(90deg); }
  }
</style>

<script define:vars={{ MAC_INSTALL_CMD, WIN_INSTALL_CMD }}>
  const commands = {
    mac: { cmd: MAC_INSTALL_CMD, prefix: "$" },
    win: { cmd: WIN_INSTALL_CMD, prefix: "PS>" },
  }

  const cmdEl = document.getElementById("install-command")
  const cmdPrefix = document.getElementById("cmd-prefix")
  const copyBtn = document.getElementById("install-copy-btn")
  const platformBtns = document.querySelectorAll(".platform-btn")

  function setOS(os) {
    const data = commands[os]
    if (!data) return
    cmdEl.textContent = data.cmd
    cmdPrefix.textContent = data.prefix
    copyBtn.setAttribute("data-copy", data.cmd)
    platformBtns.forEach((b) => b.classList.remove("active"))
    document.querySelector(`.platform-btn[data-os="${os}"]`)?.classList.add("active")
  }

  platformBtns.forEach((btn) => {
    btn.addEventListener("click", () => setOS(btn.getAttribute("data-os")))
  })

  const isWindows = navigator.userAgent.includes("Win")
  setOS(isWindows ? "win" : "mac")

  copyBtn.addEventListener("click", async () => {
    const text = copyBtn.getAttribute("data-copy")
    if (!text) return
    try {
      await navigator.clipboard.writeText(text)
      copyBtn.classList.add("copied")
      setTimeout(() => copyBtn.classList.remove("copied"), 2000)
    } catch (err) {
      console.error("Copy failed:", err)
    }
  })
</script>
