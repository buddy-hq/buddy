---
import { content } from "../content/site"
import { MAC_INSTALL_CMD, WIN_INSTALL_CMD } from "../lib/constants"

const { learners, educators } = content
---

<section id="install" class="install-section reveal">
  <div class="container">
    <div class="install-card">
      <div class="swap swap-content swap-audience-learners active">
        <p class="install-subtitle">{learners.download.tagline}</p>
        <h2 class="install-title">made for you</h2>
      </div>
      <div class="swap swap-content swap-audience-educators">
        <p class="install-subtitle">{educators.download.tagline}</p>
        <h2 class="install-title">made for you</h2>
      </div>

      <div class="install-command-wrapper">
        <span class="install-cmd-prefix" id="cmd-prefix">$</span>
        <code class="install-command" id="install-command">{MAC_INSTALL_CMD}</code>
        <button class="install-copy-btn" id="install-copy-btn" data-copy={MAC_INSTALL_CMD} aria-label="Copy download command">
          <svg class="copy-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          <svg class="check-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
        </button>
      </div>

      <div class="install-platform">
        <button class="platform-btn active" data-os="mac">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.08 1.85-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09l.01-.01zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"></path></svg>
          <span>macOS</span>
        </button>
        <button class="platform-btn" data-os="win">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.9-1.899"></path></svg>
          <span>Windows</span>
        </button>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .install-section {
    padding-block: clamp(3.5rem, 8vw, 6rem);
    position: relative;
    text-align: center;
  }

  .install-card {
    width: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
    position: relative;
  }

  .install-card .swap {
    width: 100%;
    text-align: center;
  }

  .install-title {
    font-family: var(--font-display);
    font-size: 4.5rem;
    font-weight: 510;
    line-height: 1;
    letter-spacing: -0.022em;
    color: var(--color-text-primary);
    text-wrap: balance;
    text-align: center;
  }

  @media (max-width: 992px) {
    .install-title {
      font-size: 3rem;
    }
  }

  @media (max-width: 576px) {
    .install-title {
      font-size: 2rem;
    }
  }

  .install-subtitle {
    font-family: var(--font-display);
    font-size: 4.5rem;
    font-weight: 510;
    line-height: 1;
    letter-spacing: -0.022em;
    color: var(--color-text-primary);
    text-wrap: balance;
    text-align: center;
    white-space: nowrap;
  }

  @media (max-width: 992px) {
    .install-subtitle {
      font-size: 3rem;
    }
  }

  @media (max-width: 576px) {
    .install-subtitle {
      font-size: 2rem;
    }
  }

  /* Command bar */
  .install-command-wrapper {
    display: flex;
    align-items: center;
    width: 100%;
    max-width: 560px;
    background-color: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    overflow: hidden;
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.3),
      0 0 0 1px rgba(255, 255, 255, 0.02) inset;
  }

  .install-cmd-prefix {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: #10b981;
    padding: 16px 0 16px 18px;
    user-select: none;
    flex-shrink: 0;
  }

  .install-command {
    flex: 1;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    padding: 16px 10px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    line-height: 1.5;
    min-width: 0;
    text-align: left;
  }

  .install-copy-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.03);
    border: none;
    border-left: 1px solid rgba(255, 255, 255, 0.06);
    color: var(--color-text-secondary);
    cursor: pointer;
    padding: 0 18px;
    align-self: stretch;
    transition: background-color 0.15s var(--ease-out), color 0.15s var(--ease-out);
  }

  .install-copy-btn:active { transform: scale(0.96); }

  .install-copy-btn .check-icon { display: none; }
  .install-copy-btn.copied {
    background-color: rgba(45, 212, 191, 0.12);
    color: #2dd4bf;
  }
  .install-copy-btn.copied .copy-icon { display: none; }
  .install-copy-btn.copied .check-icon { display: block; }

  @media (hover: hover) and (pointer: fine) {
    .install-copy-btn:hover {
      background-color: rgba(255, 255, 255, 0.08);
      color: var(--color-text-primary);
    }
  }

  /* Platform toggle */
  .install-platform {
    display: inline-flex;
    gap: 2px;
    background-color: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 999px;
    padding: 3px;
  }

  .platform-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: none;
    border: none;
    border-radius: 999px;
    padding: 6px 16px;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: color 0.25s var(--ease-out), background-color 0.25s var(--ease-out);
  }

  .platform-btn.active {
    background-color: rgba(255, 255, 255, 0.06);
    color: var(--color-text-primary);
  }

  .platform-btn svg { opacity: 0.5; }
  .platform-btn.active svg { opacity: 1; }

  @media (hover: hover) and (pointer: fine) {
    .platform-btn:hover:not(.active) {
      color: var(--color-text-secondary);
    }
  }

  @media (max-width: 576px) {
    .install-command-wrapper {
      border-radius: 10px;
    }
    .install-cmd-prefix {
      padding: 14px 0 14px 14px;
      font-size: var(--text-xs);
    }
    .install-command {
      font-size: 11px;
      padding: 14px 8px;
    }
    .install-copy-btn {
      padding: 0 14px;
    }
  }
</style>

<script define:vars={{ MAC_INSTALL_CMD, WIN_INSTALL_CMD }}>
  const commands = {
    mac: { cmd: MAC_INSTALL_CMD, prefix: "$" },
    win: { cmd: WIN_INSTALL_CMD, prefix: "PS>" },
  }

  const cmdEl = document.getElementById("install-command")
  const cmdPrefix = document.getElementById("cmd-prefix")
  const copyBtn = document.getElementById("install-copy-btn")
  const platformBtns = document.querySelectorAll(".platform-btn")

  function setOS(os) {
    const data = commands[os]
    if (!data) return
    cmdEl.textContent = data.cmd
    cmdPrefix.textContent = data.prefix
    copyBtn.setAttribute("data-copy", data.cmd)
    platformBtns.forEach((b) => b.classList.remove("active"))
    document.querySelector(`.platform-btn[data-os="${os}"]`)?.classList.add("active")
  }

  platformBtns.forEach((btn) => {
    btn.addEventListener("click", () => setOS(btn.getAttribute("data-os")))
  })

  const isWindows = navigator.userAgent.includes("Win")
  setOS(isWindows ? "win" : "mac")

  copyBtn.addEventListener("click", async () => {
    const text = copyBtn.getAttribute("data-copy")
    if (!text) return
    try {
      await navigator.clipboard.writeText(text)
      copyBtn.classList.add("copied")
      setTimeout(() => copyBtn.classList.remove("copied"), 2000)
    } catch (err) {
      console.error("Copy failed:", err)
    }
  })
</script>
