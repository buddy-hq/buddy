---
import { MAC_INSTALL_CMD, WIN_INSTALL_CMD, DOCS_PATH } from "../lib/constants"
---

<section id="install" class="install-section reveal">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Install Buddy</h2>
    </div>

    <div class="terminal-mockup">
      <div class="terminal-header">
        <div class="terminal-dots">
          <div class="terminal-dot terminal-dot-red"></div>
          <div class="terminal-dot terminal-dot-yellow"></div>
          <div class="terminal-dot terminal-dot-green"></div>
        </div>
        <div class="terminal-tabs" role="tablist">
          <button id="tab-mac" class="terminal-tab-btn active" role="tab" aria-selected="true" aria-controls="cmd-mac">macOS</button>
          <button id="tab-win" class="terminal-tab-btn" role="tab" aria-selected="false" aria-controls="cmd-win">Windows</button>
        </div>
      </div>
      <div class="terminal-body">
        <!-- macOS -->
        <div id="cmd-mac" class="cmd-container active" role="tabpanel" aria-labelledby="tab-mac">
          <div class="cmd-line">
            <span class="cmd-prefix">$</span>{MAC_INSTALL_CMD}
          </div>
          <button class="copy-btn" data-copy={MAC_INSTALL_CMD} aria-label="Copy macOS install command">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
            <span>Copy</span>
          </button>
        </div>

        <!-- Windows -->
        <div id="cmd-win" class="cmd-container" role="tabpanel" aria-labelledby="tab-win">
          <div class="cmd-line">
            <span class="cmd-prefix">PS&gt;</span>{WIN_INSTALL_CMD}
          </div>
          <button class="copy-btn" data-copy={WIN_INSTALL_CMD} aria-label="Copy Windows install command">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
            <span>Copy</span>
          </button>
        </div>
      </div>
    </div>

    <p class="install-note">
      Requires macOS 12+ or Windows 10+. See <a href={DOCS_PATH}>installation docs</a> for details.
    </p>
  </div>
</section>

<style is:global>
  /* === Install section === */
  .install-section {
    background: radial-gradient(circle at 50% 50%, rgba(255, 107, 0, 0.06) 0%, transparent 60%);
    padding-block: clamp(3.5rem, 8vw, 6rem);
    border-top: 1px solid var(--color-card-border);
  }

  .terminal-mockup {
    background-color: #0c0a09;
    border: 1px solid var(--color-card-border);
    border-radius: 16px;
    max-width: 720px;
    margin: 0 auto;
    overflow: hidden;
    box-shadow: 0 25px 50px rgba(0, 0, 0, 0.4);
  }

  .terminal-header {
    background-color: rgba(255, 255, 255, 0.02);
    border-bottom: 1px solid var(--color-card-border);
    padding: 12px var(--space-6);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* Scoped terminal dots (no conflict with mockup dots) */
  .terminal-dots {
    display: flex;
    gap: 8px;
  }

  .terminal-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .terminal-dot-red { background-color: #ef4444; }
  .terminal-dot-yellow { background-color: #f59e0b; }
  .terminal-dot-green { background-color: #10b981; }

  .terminal-tabs {
    display: flex;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 6px;
    padding: 2px;
    border: 1px solid var(--color-card-border);
  }

  .terminal-tab-btn {
    background: none;
    border: none;
    color: var(--color-text-secondary);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 5px 12px;
    border-radius: 4px;
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .terminal-tab-btn.active {
    background-color: rgba(255, 255, 255, 0.08);
    color: var(--color-text-primary);
  }

  .terminal-body {
    padding: var(--space-6);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    position: relative;
    min-height: 120px;
  }

  /* Visibility-based tab transition */
  .cmd-container {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    opacity: 0;
    visibility: hidden;
    position: absolute;
    top: var(--space-6);
    left: var(--space-6);
    right: var(--space-6);
    pointer-events: none;
    transition: opacity 0.2s var(--ease-out), visibility 0.2s var(--ease-out);
  }

  .cmd-container.active {
    opacity: 1;
    visibility: visible;
    position: relative;
    top: auto;
    left: auto;
    right: auto;
    pointer-events: auto;
  }

  .cmd-line {
    color: #f59e0b;
    word-break: break-all;
    padding-top: 4px;
    font-weight: 500;
    line-height: 1.5;
  }

  .cmd-prefix {
    color: #10b981;
    user-select: none;
    margin-right: 8px;
  }

  .copy-btn {
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--color-card-border);
    border-radius: 6px;
    color: var(--color-text-secondary);
    cursor: pointer;
    padding: 6px 12px;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease, transform 0.1s ease;
  }

  .copy-btn:active { transform: scale(0.95); }

  .copy-btn.copied {
    background-color: rgba(255, 107, 0, 0.15);
    border-color: rgba(255, 107, 0, 0.3);
    color: #ff6b00;
  }

  @media (hover: hover) and (pointer: fine) {
    .copy-btn:hover {
      background-color: rgba(255, 255, 255, 0.1);
      border-color: var(--color-card-hover-border);
      color: var(--color-text-primary);
    }
  }

  .install-note {
    text-align: center;
    margin-top: var(--space-6);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .install-note a {
    color: var(--color-accent-primary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .install-note a:hover {
    color: var(--color-text-primary);
  }
</style>

<script>
  // OS tab switching
  const macTab = document.getElementById("tab-mac")
  const winTab = document.getElementById("tab-win")
  const macCmd = document.getElementById("cmd-mac")
  const winCmd = document.getElementById("cmd-win")

  function switchTerminalTab(
    active: HTMLElement,
    inactive: HTMLElement,
    activePanel: HTMLElement,
    inactivePanel: HTMLElement,
  ) {
    if (active.classList.contains("active")) return

    active.classList.add("active")
    active.setAttribute("aria-selected", "true")
    inactive.classList.remove("active")
    inactive.setAttribute("aria-selected", "false")

    inactivePanel.classList.remove("active")
    activePanel.classList.add("active")
  }

  if (macTab && winTab && macCmd && winCmd) {
    macTab.addEventListener("click", () =>
      switchTerminalTab(macTab, winTab, macCmd, winCmd),
    )
    winTab.addEventListener("click", () =>
      switchTerminalTab(winTab, macTab, winCmd, macCmd),
    )
  }

  // Copy buttons
  document.querySelectorAll(".copy-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const text = btn.getAttribute("data-copy")
      if (!text) return
      try {
        await navigator.clipboard.writeText(text)
        const original = btn.innerHTML
        btn.innerHTML = `
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
          <span>Copied!</span>
        `
        btn.classList.add("copied")
        setTimeout(() => {
          btn.innerHTML = original
          btn.classList.remove("copied")
        }, 2000)
      } catch (err) {
        console.error("Copy failed:", err)
      }
    })
  })
</script>
