      const target = targetEl.closest(".doc-tag, .wb-tag, .system-status, .widget-chat-card, .illustration-card, .wb-chat-card") as HTMLElement | null;
      if (!target) return;

      if (target.classList.contains("doc-tag") || target.classList.contains("illustration-card")) {
        if (libraryRailBtn) libraryRailBtn.click();
      } else if (target.classList.contains("wb-tag") || target.classList.contains("wb-chat-card")) {
        if (whiteboardRailBtn) whiteboardRailBtn.click();
      } else if (target.classList.contains("widget-chat-card")) {
        if (widgetRailBtn) widgetRailBtn.click();
      } else if (target.classList.contains("system-status")) {
        const text = target.textContent || "";
        if (text.toLowerCase().includes("widget")) {
          if (widgetRailBtn) widgetRailBtn.click();
        } else if (
          text.toLowerCase().includes("derivatives") ||
          text.toLowerCase().includes("equations") ||
          text.toLowerCase().includes("timeline") ||
          text.toLowerCase().includes("whiteboard")
        ) {
          if (whiteboardRailBtn) whiteboardRailBtn.click();
        }
      }
    });
  }

  // Whiteboard panning logic
  const wbCanvas = document.querySelector(".whiteboard-canvas") as HTMLElement | null;
  if (wbCanvas) {
    let isPanning = false;
    let startX = 0;
    let startY = 0;
    let panX = 0;
    let panY = 0;

    wbCanvas.addEventListener("mousedown", (e) => {
      if ((e.target as HTMLElement).closest("button, input, select, textarea")) return;
      isPanning = true;
      startX = e.clientX - panX;
      startY = e.clientY - panY;
    });

    window.addEventListener("mousemove", (e) => {
      if (!isPanning) return;
      panX = e.clientX - startX;
      panY = e.clientY - startY;
      wbCanvas.style.setProperty("--pan-x", `${panX}px`);
      wbCanvas.style.setProperty("--pan-y", `${panY}px`);
    });

    window.addEventListener("mouseup", () => {
      isPanning = false;
    });
  }

  // Pre-populate the mock instantly with the final state on mobile for a static product shot
  function loadNotebookStatic(key: NotebookKey) {
    activeNotebook = key;
    const data = notebookData[key];
    if (!data) return;

    if (windowActiveNotebook) windowActiveNotebook.textContent = data.title;
    if (windowActiveSession) windowActiveSession.textContent = data.session;
    if (readerTabTitle) readerTabTitle.textContent = data.readerTitle;

    // Load reader page
    loadReaderPage(key, currentPageIndices[key]);

    // Populate chat feed instantly
    if (chatFeed) {
      chatFeed.innerHTML = "";
      data.messages.forEach((msg) => {
        appendMessage(msg.sender, msg.text);
      });
      // Remove skeleton classes from cards
      document.querySelectorAll(".wb-chat-card, .illustration-card, .widget-chat-card").forEach(el => {
        el.classList.remove("state-skeleton");
      });
    }

    // Populate whiteboard instantly with final elements
    if (wbDrawings) {
      wbDrawings.innerHTML = "";
      if (key === "self-reliance") {
        wbDrawings.innerHTML = `
          <div class="wb-handwriting-hi visible">Trust Thyself</div>
          <div class="wb-welcome-text visible">"every heart vibrates to that iron string."</div>
          <div class="wb-doodle-arrow visible">
            <svg width="40" height="20" viewBox="0 0 40 20" fill="none" stroke="#3b82f6" stroke-width="2">
              <path d="M20,2 L20,18 M15,13 L20,18 L25,13" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div class="wb-split-grid">
            <div class="wb-card integrity visible">
              <div class="wb-card-title">✓ Integrity</div>
              <div class="wb-card-body">- Inward Conviction<br>- Self-Trust<br>- Originality</div>
            </div>
            <div class="wb-card conformity visible">
              <div class="wb-card-title">✗ Conformity</div>
              <div class="wb-card-body">- Social Pressure<br>- Imitation = Suicide<br>- Joint-stock company</div>
            </div>
          </div>
          <div class="wb-sketch-node bottom-conclusion" style="opacity: 1; transform: scale(1) rotate(1deg); margin-top: 15px; width: 100%; max-width: 280px;">
            Inward Conviction ➔ Universal Truth
          </div>
        `;
      }
    }

    // Set active tab (e.g. show whiteboard)
    if (buddyWindow && whiteboardRailBtn) {
      document.querySelectorAll('.action-btn').forEach(btn => btn.classList.remove('active'));
      whiteboardRailBtn.classList.add('active');
      buddyWindow.classList.add('show-whiteboard');
      buddyWindow.classList.remove('show-widget', 'show-notes');
    }

    // Expand the right pane
    if (workspaceBody) {
      workspaceBody.classList.remove('right-pane-collapsed');
    }

    setGenerating(false);
  }

  setTimeout(() => {
    loadNotebook("self-reliance");
  }, 2000);
</script>

