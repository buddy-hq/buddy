---
// Component for the real Buddy workspace mockup
import MockWhiteboard from "./MockWhiteboard.astro";
import MockSidebar from "./MockSidebar.astro";
import MockChat from "./MockChat.astro";
import MockReader from "./MockReader.astro";
import MockWidget from "./MockWidget.astro";
import MockNotebook from "./MockNotebook.astro";
---

<div class="buddy-window">
  <!-- Workspace layout with macOS unified titlebar split -->
  <div class="workspace-body right-pane-collapsed">
    
    <!-- Surface 1: Sidebar -->
    <MockSidebar />

    <!-- Surface 2: Chat Pane -->
    <MockChat />

    <!-- Surface 3: Document Reader (Warm Cream paper) -->
    <MockReader />

    <!-- Surface 5: Whiteboard Pane -->
    <MockWhiteboard />

    <!-- Surface 6: HTML Widget Pane -->
    <MockWidget />

    <!-- Surface 7: Notebook Pane -->
    <MockNotebook />

    <!-- Surface 4: Action Toolbar -->
    <aside class="surface-actions">
      <div class="action-icons">
        <button class="action-btn active" title="Library">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
          </svg>
        </button>
        <button class="action-btn" title="Notebook">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="9" y1="9" x2="15" y2="9"></line>
            <line x1="9" y1="13" x2="15" y2="13"></line>
          </svg>
        </button>
        <button class="action-btn" title="HTML Widget">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="16 18 22 12 16 6"></polyline>
            <polyline points="8 6 2 12 8 18"></polyline>
          </svg>
        </button>
        <button class="action-btn" title="Whiteboard">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 3h20"></path>
            <path d="M21 3v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V3"></path>
            <path d="m7 21 5-5 5 5"></path>
          </svg>
        </button>
      </div>
    </aside>

  </div>
</div>

<script>
  // Data for notebooks matching real app structure
  const notebookData = {
    "self-reliance": {
