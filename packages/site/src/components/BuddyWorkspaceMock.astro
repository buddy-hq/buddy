---
// Component for routing the real Buddy workspace mockup to Learner or Educator mocks server-side
import { AUDIENCE_EDUCATORS, AUDIENCE_LEARNERS } from "../lib/constants";
import type { Audience } from "../content/site";
import LearnerWorkspaceMock from "./LearnerWorkspaceMock.astro";
import EducatorWorkspaceMock from "./EducatorWorkspaceMock.astro";

type Props = {
  audience?: Audience;
}

const { audience = AUDIENCE_LEARNERS } = Astro.props;
const isEducators = audience === AUDIENCE_EDUCATORS;
---

{isEducators ? (
  <EducatorWorkspaceMock />
) : (
  <LearnerWorkspaceMock />
)}
