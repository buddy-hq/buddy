          location: "LOCATION 49 / 90"
        }
      ],
      messages: [
        { sender: "user", text: "why did so many countries get pulled into ww1 so quickly?" },
        { sender: "buddy", text: "The rigid network of mutual defense alliances escalated a local Balkan conflict into a global war within weeks.<br><br>Ready to check the diplomatic crisis text?" },
        { sender: "user", text: "yes" },
        { sender: "buddy", text: "<div class='illustration-card'><div class='ill-cover-fallback wh'><div class='fallback-cover-text'>World History</div></div><div class='ill-text'><span class='ill-title'>World History</span><span class='ill-author'>Modern History Press</span><span class='ill-meta'>Ch 22 · 15.1k words</span></div></div><br><br>Loaded Chapter 22. It outlines how Austria-Hungary's declaration of war triggered Russia, Germany, and France." },
        { sender: "user", text: "explain the alliance timeline" },
        { sender: "buddy", text: "<div class='wb-chat-card'><div class='wb-chat-icon'><svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5'><path d='M2 3h20'></path><path d='M21 3v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V3'></path><path d='m7 21 5-5 5 5'></path></svg></div><div class='wb-chat-title-group'><div class='wb-chat-title'>Whiteboard</div><div class='wb-chat-subtitle'>Alliance Timeline</div></div></div><br><br>I've mapped the diplomatic communications of July 1914 on your whiteboard." }
      ],
      whiteboardHtml: ""
    }
  };

  type NotebookKey = "self-reliance" | "deep-learning" | "world-history";

  let activeNotebook: NotebookKey = "self-reliance";
  let currentPageIndices: Record<NotebookKey, number> = {
    "self-reliance": 0,
    "deep-learning": 0,
    "world-history": 0
  };

  const chatFeed = document.getElementById("chat-feed-container");
  const windowActiveNotebook = document.querySelector(".window-active-notebook");
  const windowActiveSession = document.querySelector(".window-active-session");
  const readerTabTitle = document.getElementById("reader-tab-title");
  const readerQuoteText = document.getElementById("reader-quote-text");
  const readerBodyText = document.getElementById("reader-body-text");
  const readerSigText = document.getElementById("reader-sig-text");
  const readerLocationText = document.getElementById("reader-location-text");
  const fontToggleBtn = document.getElementById("font-toggle-btn");
  const readerContentPane = document.getElementById("reader-content-pane");
  const chatForm = document.getElementById("mockup-chat-form");
  const chatInput = document.getElementById("mockup-chat-input") as HTMLTextAreaElement;
  
  const readerPrevBtn = document.getElementById("reader-prev-btn");
  const readerNextBtn = document.getElementById("reader-next-btn");
  const wbDrawings = document.querySelector(".wb-drawings") as HTMLElement | null;

  let currentStreamId = 0;
  let isGenerating = false;
  let activeSidebarPromise = Promise.resolve();
  const chatSubmitBtn = document.getElementById("chat-submit-btn");

  function setGenerating(generating: boolean) {
    isGenerating = generating;
    if (chatSubmitBtn) {
      if (generating) {
        chatSubmitBtn.classList.add("generating");
      } else {
        chatSubmitBtn.classList.remove("generating");
      }
    }
    
    // Stop pulsing if generation is over
    if (!generating) {
      const pulsingItem = document.querySelector('.session-item.pulse-slow');
      if (pulsingItem) {
        pulsingItem.classList.remove('pulse-slow');
      }
    }
  }

  async function typeWbHtml(container: HTMLElement, htmlText: string, streamId: number, speed = 30) {
    const chunks: string[] = [];
    let i = 0;
    while (i < htmlText.length) {
      if (htmlText[i] === '<') {
        const closingIndex = htmlText.indexOf('>', i);
        if (closingIndex !== -1) {
          chunks.push(htmlText.substring(i, closingIndex + 1));
          i = closingIndex + 1;
          continue;
        }
      }
      chunks.push(htmlText[i]);
      i++;
    }

    let currentText = "";
    for (const chunk of chunks) {
      if (streamId !== currentStreamId) return;
      currentText += chunk;
      container.innerHTML = currentText;
      const delay = chunk.startsWith('<') ? 0 : (Math.random() * (speed / 2) + (speed / 2));
      await new Promise(resolve => setTimeout(resolve, delay));
    }
  }

  async function animateWhiteboard(notebookKey: NotebookKey, streamId: number) {
    if (!wbDrawings) return;
    
    // Clear and set to initial blank state
    wbDrawings.innerHTML = "";

    if (notebookKey === "self-reliance") {
      // Title
      const hi = document.createElement("div");
      hi.className = "wb-handwriting-hi";
      wbDrawings.appendChild(hi);
      await typeWbHtml(hi, "Trust Thyself", streamId, 45);
      if (streamId !== currentStreamId) return;
      await new Promise(resolve => setTimeout(resolve, 300));

      // Quote
      const quote = document.createElement("div");
      quote.className = "wb-welcome-text";
      wbDrawings.appendChild(quote);
      await typeWbHtml(quote, '"every heart vibrates to that iron string."', streamId, 25);
      if (streamId !== currentStreamId) return;
      await new Promise(resolve => setTimeout(resolve, 300));

      // Doodle arrow down
      const arrow = document.createElement("div");
      arrow.className = "wb-doodle-arrow";
      arrow.innerHTML = `
        <svg width="40" height="20" viewBox="0 0 40 20" fill="none" stroke="#3b82f6" stroke-width="2">
          <path d="M20,2 L20,18 M15,13 L20,18 L25,13" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      `;
      wbDrawings.appendChild(arrow);
      await new Promise(resolve => setTimeout(resolve, 50));
      arrow.classList.add("visible");
      await new Promise(resolve => setTimeout(resolve, 300));
      if (streamId !== currentStreamId) return;

      // Comparative Grid
      const grid = document.createElement("div");
      grid.className = "wb-split-grid";
      wbDrawings.appendChild(grid);

      // Create Integrity Card (empty body)
      const integrityCard = document.createElement("div");
      integrityCard.className = "wb-card integrity";
      integrityCard.innerHTML = `<div class="wb-card-title">✓ Integrity</div><div class="wb-card-body"></div>`;
      grid.appendChild(integrityCard);

      // Create Conformity Card (empty body)
      const conformityCard = document.createElement("div");
      conformityCard.className = "wb-card conformity";
      conformityCard.innerHTML = `<div class="wb-card-title">✗ Conformity</div><div class="wb-card-body"></div>`;
      grid.appendChild(conformityCard);

      // Animate card borders appearing
      await new Promise(resolve => setTimeout(resolve, 50));
      integrityCard.classList.add("visible");
      conformityCard.classList.add("visible");
      await new Promise(resolve => setTimeout(resolve, 600)); // Let transition finish
      if (streamId !== currentStreamId) return;

      // Stream text inside cards
      const integrityBody = integrityCard.querySelector(".wb-card-body") as HTMLElement;
      await typeWbHtml(integrityBody, "- Inward Conviction<br>- Self-Trust<br>- Originality", streamId, 25);
      if (streamId !== currentStreamId) return;

      const conformityBody = conformityCard.querySelector(".wb-card-body") as HTMLElement;
      await typeWbHtml(conformityBody, "- Social Pressure<br>- Imitation = Suicide<br>- Joint-stock company", streamId, 25);
      if (streamId !== currentStreamId) return;

      // Bottom Conclusion Card
      const conclusionCard = document.createElement("div");
      conclusionCard.className = "wb-sketch-node bottom-conclusion";
      conclusionCard.style.opacity = "0";
      conclusionCard.style.transform = "scale(0.8) rotate(1deg)";
      conclusionCard.style.transition = "all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1)";
      conclusionCard.style.marginTop = "15px";
      conclusionCard.style.width = "100%";
      conclusionCard.style.maxWidth = "280px";
      wbDrawings.appendChild(conclusionCard);

      // Animate bottom box coming
      await new Promise(resolve => setTimeout(resolve, 100));
      conclusionCard.style.opacity = "1";
      conclusionCard.style.transform = "scale(1) rotate(1deg)";
      await new Promise(resolve => setTimeout(resolve, 500));
      if (streamId !== currentStreamId) return;

      await typeWbHtml(conclusionCard, "Inward Conviction ➔ Universal Truth", streamId, 30);
    } 
    else if (notebookKey === "deep-learning") {
      // Title
      const hi = document.createElement("div");
      hi.className = "wb-handwriting-hi";
      hi.style.color = "#3b82f6";
      wbDrawings.appendChild(hi);
      await typeWbHtml(hi, "Backprop Chain Rule", streamId, 45);
      if (streamId !== currentStreamId) return;
      await new Promise(resolve => setTimeout(resolve, 300));

      // Neural graph sketch
      const graph = document.createElement("div");
      graph.className = "wb-neural-graph";
      graph.innerHTML = `
        <div class="wb-neural-node" id="node-x">x</div>
        <div class="wb-neural-edge">
          <svg width="30" height="10" viewBox="0 0 30 10">
            <path d="M0,5 L28,5 M24,2 L28,5 L24,8" stroke="#3b82f6" stroke-width="1.5" fill="none" />
          </svg>
          <span class="wb-edge-weight">w1</span>
        </div>
        <div class="wb-neural-node" id="node-h">h</div>
        <div class="wb-neural-edge">
          <svg width="30" height="10" viewBox="0 0 30 10">
            <path d="M0,5 L28,5 M24,2 L28,5 L24,8" stroke="#3b82f6" stroke-width="1.5" fill="none" />
          </svg>
          <span class="wb-edge-weight">w2</span>
        </div>
        <div class="wb-neural-node" id="node-y">y</div>
      `;
      wbDrawings.appendChild(graph);
      await new Promise(resolve => setTimeout(resolve, 50));
      graph.classList.add("visible");

      // Animate node circles popping in order
      const nodes = graph.querySelectorAll(".wb-neural-node");
      for (let idx = 0; idx < nodes.length; idx++) {
        await new Promise(resolve => setTimeout(resolve, 150));
        nodes[idx].classList.add("visible");
        const edge = nodes[idx].nextElementSibling;
        if (edge && edge.classList.contains("wb-neural-edge")) {
          edge.classList.add("visible");
        }
      }
      await new Promise(resolve => setTimeout(resolve, 400));
      if (streamId !== currentStreamId) return;

      // Block container
      const block = document.createElement("div");
      block.className = "wb-equation-block";
      wbDrawings.appendChild(block);

      // Equation Box 1 (empty body)
      const eqCard1 = document.createElement("div");
      eqCard1.className = "wb-card integrity";
      eqCard1.style.width = "220px";
      eqCard1.style.textAlign = "center";
      eqCard1.innerHTML = `<div class="wb-card-body"></div>`;
      block.appendChild(eqCard1);

      // Animate Equation Card 1 appearing
      await new Promise(resolve => setTimeout(resolve, 50));
      eqCard1.classList.add("visible");
      await new Promise(resolve => setTimeout(resolve, 500));
      if (streamId !== currentStreamId) return;

      const eqBody1 = eqCard1.querySelector(".wb-card-body") as HTMLElement;
      await typeWbHtml(eqBody1, "∂L / ∂w<sub>i</sub> = (∂L / ∂y) · (∂y / ∂z) · (∂z / ∂w<sub>i</sub>)", streamId, 25);
      if (streamId !== currentStreamId) return;
      await new Promise(resolve => setTimeout(resolve, 400));

      // Sketched Arrow
      const arrow = document.createElement("div");
      arrow.className = "wb-timeline-arrow";
      arrow.style.color = "#3b82f6";
      arrow.style.opacity = "0";
      arrow.style.transform = "translateY(-10px)";
      arrow.style.transition = "all 0.5s ease";
      block.appendChild(arrow);
      arrow.innerHTML = "↓";

      // Animate arrow
      await new Promise(resolve => setTimeout(resolve, 50));
      arrow.style.opacity = "1";
      arrow.style.transform = "translateY(0)";
      await new Promise(resolve => setTimeout(resolve, 400));
      if (streamId !== currentStreamId) return;

      // Equation Box 2 (empty body)
      const eqCard2 = document.createElement("div");
      eqCard2.className = "wb-card conformity";
      eqCard2.style.width = "220px";
      eqCard2.style.textAlign = "center";
      eqCard2.innerHTML = `<div class="wb-card-body" style="color: #10b981;"></div>`;
      block.appendChild(eqCard2);

      // Animate Equation Card 2 appearing
      await new Promise(resolve => setTimeout(resolve, 50));
      eqCard2.classList.add("visible");
      await new Promise(resolve => setTimeout(resolve, 500));
      if (streamId !== currentStreamId) return;

      const eqBody2 = eqCard2.querySelector(".wb-card-body") as HTMLElement;
      await typeWbHtml(eqBody2, "δ<sup>(l)</sup> = ((W<sup>(l+1)</sup>)<sup>T</sup> δ<sup>(l+1)</sup>) ⊙ f'(z<sup>(l)</sup>)", streamId, 25);
    } 
    else if (notebookKey === "world-history") {
      // Title
      const hi = document.createElement("div");
      hi.className = "wb-handwriting-hi";
      hi.style.color = "#f59e0b";
      wbDrawings.appendChild(hi);
      await typeWbHtml(hi, "WWI Alliance Timeline", streamId, 45);
      if (streamId !== currentStreamId) return;
      await new Promise(resolve => setTimeout(resolve, 300));

      // Timeline container
      const flow = document.createElement("div");
      flow.className = "wb-timeline-flow";
      wbDrawings.appendChild(flow);

      const steps = [
        { date: "June 28", event: "Franz Ferdinand assassinated 💥", class: "integrity" },
        { date: "July 28", event: "Austria-Hungary declares war", class: "conformity" },
        { date: "Aug 1-3", event: "General European mobilization ➔ Ignite!", class: "conformity" }
      ];

      for (let k = 0; k < steps.length; k++) {
        if (streamId !== currentStreamId) return;
        const stepData = steps[k];

        // Create step card empty
        const card = document.createElement("div");
        card.className = `wb-timeline-step-card ${stepData.class}`;
        card.innerHTML = `<div class="step-header">${stepData.date}</div><div class="step-body"></div>`;
        flow.appendChild(card);

        // Animate card appearing
        await new Promise(resolve => setTimeout(resolve, 50));
        card.classList.add("visible");
        await new Promise(resolve => setTimeout(resolve, 400));
        if (streamId !== currentStreamId) return;

        // Type inside card body
        const bodyEl = card.querySelector(".step-body") as HTMLElement;
        await typeWbHtml(bodyEl, stepData.event, streamId, 25);
        if (streamId !== currentStreamId) return;

        if (k < steps.length - 1) {
          const arrow = document.createElement("div");
          arrow.className = "wb-flow-arrow";
          arrow.innerHTML = "↓";
          flow.appendChild(arrow);
          
          await new Promise(resolve => setTimeout(resolve, 50));
          arrow.classList.add("visible");
          await new Promise(resolve => setTimeout(resolve, 200));
        }
      }
    }
  }

  function loadNotebook(key: NotebookKey) {
    activeNotebook = key;
    activeSidebarPromise = Promise.resolve();
    const data = notebookData[key];
    if (!data) return;

    if (windowActiveNotebook) windowActiveNotebook.textContent = data.title;
    if (windowActiveSession) windowActiveSession.textContent = data.session;
    if (readerTabTitle) readerTabTitle.textContent = data.readerTitle;

    // Reset components to initial states before streaming
    if (readerQuoteText) readerQuoteText.textContent = "";
    if (readerBodyText) readerBodyText.textContent = "Waiting for document load command...";
    if (readerSigText) readerSigText.textContent = "";
    if (readerLocationText) readerLocationText.textContent = "";
    if (wbDrawings) wbDrawings.innerHTML = '<div class="wb-welcome-text" style="opacity: 0.3; font-family: var(--font-body); font-size: 13px; padding: 20px;">Whiteboard ready...</div>';
    if (libraryRailBtn) {
      document.querySelectorAll('.action-btn').forEach(btn => btn.classList.remove('active'));
      libraryRailBtn.classList.add('active');
      const buddyWindow = document.querySelector('.buddy-window');
      if (buddyWindow) {
        buddyWindow.classList.remove('show-whiteboard');
        buddyWindow.classList.remove('show-widget');
        buddyWindow.classList.remove('show-notes');
      }
    }

    // Collapse right pane initially on loading/switching notebook
    const workspaceBody = document.querySelector('.workspace-body');
    if (workspaceBody) {
      workspaceBody.classList.add('right-pane-collapsed');
    }

    // Add pulse animation back to the active session item
    const activeSessionItem = document.querySelector('.sessions-list .session-item.active');
    if (activeSessionItem) {
      activeSessionItem.classList.add('pulse-slow');
    }

    currentStreamId++;
    const streamId = currentStreamId;

    if (chatFeed) {
      chatFeed.innerHTML = "";
    }

    // Start streaming simulation
    runChatStream(key, streamId);
  }

  async function runChatStream(key: NotebookKey, streamId: number) {
    const data = notebookData[key];
    if (!data) return;

    setGenerating(true);

    try {
      for (let i = 0; i < data.messages.length; i++) {
        if (streamId !== currentStreamId) return;

        const msg = data.messages[i];
        if (msg.sender === "user") {
          await new Promise(resolve => setTimeout(resolve, i === 0 ? 300 : 800));
          if (streamId !== currentStreamId) return;

          if (chatInput) {
            chatInput.value = "";
            for (let charIndex = 0; charIndex < msg.text.length; charIndex++) {
              if (streamId !== currentStreamId) return;
              chatInput.value += msg.text[charIndex];
              chatInput.style.height = "auto";
              chatInput.style.height = (chatInput.scrollHeight) + "px";
              const delay = msg.text.length > 30 ? 20 : 30;
              await new Promise(resolve => setTimeout(resolve, delay));
            }
          }

          await new Promise(resolve => setTimeout(resolve, 250));
          if (streamId !== currentStreamId) return;

          if (chatSubmitBtn) {
            chatSubmitBtn.classList.add("simulated-click");
          }
          await new Promise(resolve => setTimeout(resolve, 150));
          if (streamId !== currentStreamId) return;
          if (chatSubmitBtn) {
            chatSubmitBtn.classList.remove("simulated-click");
          }

          if (chatInput) {
            chatInput.value = "";
            chatInput.style.height = "auto";
          }
          appendMessage("user", msg.text);
        } else {
          await new Promise(resolve => setTimeout(resolve, 400));
          if (streamId !== currentStreamId) return;

          // Show typing indicator
          const typingIndicator = document.createElement("div");
          typingIndicator.className = "mock-chat-bubble buddy typing";
          typingIndicator.innerHTML = `
            <div class="typing-dots">
              <span></span>
              <span></span>
              <span></span>
            </div>
          `;
          if (chatFeed) {
            chatFeed.appendChild(typingIndicator);
            chatFeed.scrollTop = chatFeed.scrollHeight;
          }

          await new Promise(resolve => setTimeout(resolve, 800));
          if (streamId !== currentStreamId) return;
          typingIndicator.remove();

          // Create message bubble
          const bubble = document.createElement("div");
          bubble.className = `mock-chat-bubble buddy`;
          const inner = document.createElement("div");
          inner.className = "bubble-content";
          bubble.appendChild(inner);
          if (chatFeed) {
            chatFeed.appendChild(bubble);
            chatFeed.scrollTop = chatFeed.scrollHeight;
          }

          await typeMessage(inner, msg.text, streamId, key, i);
          if (streamId !== currentStreamId) return;

          // Await activeSidebarPromise to resolve completely (e.g. whiteboard animation finishes)
          await activeSidebarPromise;
          if (streamId !== currentStreamId) return;

          // Stay on that state for 1 second before proceeding to the next message
          await new Promise(resolve => setTimeout(resolve, 1000));
        }
      }
    } finally {
      if (streamId === currentStreamId) {
        setGenerating(false);
      }
    }
  }

  async function typeMessage(container: HTMLElement, htmlText: string, streamId: number, notebookKey: NotebookKey, messageIndex: number) {
    const parts = htmlText.split("<br><br>");
    for (let partIdx = 0; partIdx < parts.length; partIdx++) {
      if (streamId !== currentStreamId) return;
      const part = parts[partIdx];
      
      const isCard = part.includes("widget-chat-card") || part.includes("illustration-card") || part.includes("wb-chat-card");
      
      if (isCard) {
        // Render card instantly
        const cardDiv = document.createElement("div");
        cardDiv.style.display = "contents";
        cardDiv.innerHTML = part;
        
        // Add skeleton state on creation
        const cardEl = cardDiv.firstElementChild;
        if (cardEl) {
          cardEl.classList.add("state-skeleton");
        }
        
        container.appendChild(cardDiv);
        if (chatFeed) chatFeed.scrollTop = chatFeed.scrollHeight;

        // Trigger opening of sidebar!
        if (messageIndex !== -1) {
          triggerSidebarOpen(notebookKey, messageIndex);
          activeSidebarPromise = resolveCardSkeleton(notebookKey, messageIndex, streamId);
        }

        await new Promise(resolve => setTimeout(resolve, 150));
      } else {
        // Typewriter text
        const textSpan = document.createElement("span");
        container.appendChild(textSpan);
        await typeMessageInner(textSpan, part, streamId);
      }

      if (partIdx < parts.length - 1) {
        const nextPart = parts[partIdx + 1];
        const nextIsCard = nextPart.includes("widget-chat-card") || nextPart.includes("illustration-card") || nextPart.includes("wb-chat-card");
        
        if (!isCard && !nextIsCard) {
          // Double break between text paragraphs
          container.appendChild(document.createElement("br"));
          container.appendChild(document.createElement("br"));
        } else {
          // Tight spacing between card and text
          const spacer = document.createElement("div");
          spacer.style.height = "8px";
          container.appendChild(spacer);
        }
        if (chatFeed) chatFeed.scrollTop = chatFeed.scrollHeight;
      }
    }
  }

  async function typeMessageInner(container: HTMLElement, htmlText: string, streamId: number) {
    const chunks: string[] = [];
    let i = 0;
    while (i < htmlText.length) {
      if (htmlText[i] === '<') {
        const closingIndex = htmlText.indexOf('>', i);
        if (closingIndex !== -1) {
          chunks.push(htmlText.substring(i, closingIndex + 1));
          i = closingIndex + 1;
          continue;
        }
      }
      chunks.push(htmlText[i]);
      i++;
    }

    let currentText = "";
    for (const chunk of chunks) {
      if (streamId !== currentStreamId) return;
      currentText += chunk;
      container.innerHTML = currentText;
      if (chatFeed) chatFeed.scrollTop = chatFeed.scrollHeight;
      
      const delay = chunk.startsWith('<') ? 0 : (Math.random() * 12 + 6);
      await new Promise(resolve => setTimeout(resolve, delay));
    }
  }

