---
import { Image } from "astro:assets"
import { content } from "../content/site"
import buddyAppIcon from "../assets/buddy-app-icon.png"
import { LEARNER_PATH } from "../lib/constants"

const { header: headerContent } = content
---

<header class="site-header">
  <div class="container nav-wrapper">
    <a href={LEARNER_PATH} class="logo-group">
      <Image
        src={buddyAppIcon}
        alt={`${headerContent.brandName} Logo`}
        class="logo-icon"
        width={64}
        height={64}
      />
      <span class="logo-text">{headerContent.brandName}</span>
    </a>


    <div class="nav-actions">
      <!-- Download button that dynamically opens the installation modal for the user's detected OS -->
      <button
        class="nav-install-btn"
        id="header-download-btn"
        aria-label={`Download ${headerContent.brandName}`}
      >
        <span class="btn-os-icon" id="header-os-icon"></span>
        <span>{headerContent.downloadLabel}</span>
      </button>
    </div>
  </div>
</header>

<style is:global>
  /* === Sticky header === */
  .site-header {
    position: -webkit-sticky; /* Support for iOS Safari */
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    background-color: var(--surface-sticky);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 1px 0 var(--border-weak), var(--shadow-overlay);
    z-index: 100;
  }

  .nav-wrapper {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 64px;
  }

  .logo-group {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    transition: opacity 200ms var(--ease-out);
  }

  .logo-icon {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    object-fit: cover;
  }

  .logo-text {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-text-primary);
    letter-spacing: var(--tracking-tight);
  }


  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  /* === Download button — same invert treatment as InstallSection === */
  .nav-install-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--invert-fill);
    border: 1px solid var(--border-weak);
    color: var(--invert-ink);
    border-radius: var(--radius) !important;
    padding: 0 18px !important;
    font-family: var(--font-body);
    font-size: var(--text-sm) !important;
    font-weight: 550 !important;
    height: 38px !important; /* Perfect pixel alignment with logo */
    box-sizing: border-box !important;
    box-shadow: var(--shadow-raised);
    transition: background-color 0.2s var(--ease-out), box-shadow 0.2s var(--ease-out), transform 0.1s var(--ease-out), filter 0.2s var(--ease-out) !important;
    cursor: pointer;
  }

  .nav-install-btn .btn-os-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .nav-install-btn:hover {
    background-color: var(--invert-fill);
    filter: brightness(1.06);
    box-shadow: var(--shadow-overlay);
  }

  .nav-install-btn:active {
    transform: scale(0.97) !important;
  }

  @media (hover: hover) and (pointer: fine) {
    .logo-group:hover {
      opacity: 0.9;
    }
  }

  @media (max-width: 640px) {
    /* Hide the download button from the header on mobile viewports */
    .nav-install-btn {
      display: none !important;
    }

    /* Keep the logo text visible */
    .logo-text {
      display: block;
    }
  }
</style>

<script>
  // Detect OS to dynamically inject corresponding icon into the header button
  const isWindows = navigator.userAgent.includes("Win")
  const autoOs = isWindows ? "win" : "mac"

  const osIconContainer = document.getElementById("header-os-icon")
  if (osIconContainer) {
    osIconContainer.innerHTML = autoOs === "win"
      ? `<svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" style="margin-right: 8px;"><path d="M0 0h11v11H0zM13 0h11v11H13zM0 13h11v11H0zM13 13h11v11H13z"></path></svg>`
      : `<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" style="margin-right: 8px;"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.08 1.85-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09l.01-.01zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"></path></svg>`
  }

  // Hook up button click callback
  const headerDownloadBtn = document.getElementById("header-download-btn")
  if (headerDownloadBtn) {
    headerDownloadBtn.addEventListener("click", () => {
      // Call global function defined in InstallSection.astro
      if (typeof (window as any).openBuddyDownloadModal === "function") {
        (window as any).openBuddyDownloadModal(autoOs, "header")
      }
    })
  }
</script>
