      const bubble = document.createElement("div");
      bubble.className = `mock-chat-bubble ${sender}`;

      const inner = document.createElement("div");
      inner.className = "bubble-content";
      inner.innerHTML = text;

      bubble.appendChild(inner);
      chatFeed.appendChild(bubble);
      chatFeed.scrollTop = chatFeed.scrollHeight;
    }

    /** Appends an empty Buddy bubble and hands back the node its content streams into. */
    function appendBuddyBubble() {
      const bubble = document.createElement("div");
      bubble.className = "mock-chat-bubble buddy";
      const inner = document.createElement("div");
      inner.className = "bubble-content";
      bubble.appendChild(inner);
      if (chatFeed) {
        chatFeed.appendChild(bubble);
        chatFeed.scrollTop = chatFeed.scrollHeight;
      }
      return inner;
    }

