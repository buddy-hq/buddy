    // Minimal HTML Widget Logic
    const wSlider = buddyWindow.querySelector('#widget-pressure') as HTMLInputElement | null;
    const wValInward = buddyWindow.querySelector('#val-inward') as HTMLElement | null;
    const wValCrowd = buddyWindow.querySelector('#val-crowd') as HTMLElement | null;
    const wQuote = buddyWindow.querySelector('#widget-quote') as HTMLElement | null;
    const wExplain = buddyWindow.querySelector('#widget-explain') as HTMLElement | null;
    const wVisualZone = buddyWindow.querySelector('#visual-zone') as HTMLElement | null;

    function updateMinimalWidget() {
      if (!wSlider || !wValInward || !wValCrowd || !wQuote || !wExplain) return;
      
      const crowdVal = Number(wSlider.value);
      
      if (wVisualZone) {
        wVisualZone.style.setProperty('--pressure', String(crowdVal / 100));
      }

      const inwardVal = 100 - crowdVal;

      wValInward.textContent = inwardVal + '%';
      wValCrowd.textContent = crowdVal + '%';

      let quoteText = '';
      let explainText = '';

      if (crowdVal <= 35) {
        quoteText = 'Nothing is at last sacred but the integrity of your own mind.';
        explainText = 'Trust your own honest conscience and independent judgment above all else.';
      } else if (crowdVal <= 70) {
        quoteText = 'To be great is to be misunderstood.';
        explainText = 'Maintaining your integrity while in society requires constant, balanced resolve.';
      } else {
        quoteText = 'Imitation is suicide.';
        explainText = 'Copying the crowd keeps you from discovering what only you can accomplish.';
      }

      wQuote.textContent = quoteText;
      wExplain.textContent = explainText;

      buddyWindow.querySelectorAll('.mode-btn').forEach(btn => {
        const val = Number(btn.getAttribute('data-val'));
        if (val === crowdVal) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });
    }

    if (wSlider) {
      wSlider.addEventListener('input', updateMinimalWidget);

      buddyWindow.querySelectorAll('.mode-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const val = btn.getAttribute('data-val');
          if (val !== null) {
            wSlider.value = val;
            updateMinimalWidget();
          }
        });
      });

      updateMinimalWidget();
    }

