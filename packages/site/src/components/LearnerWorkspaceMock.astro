      });

      window.addEventListener("mousemove", (e) => {
        if (!isPanning) return;
        panX = e.clientX - startX;
        panY = e.clientY - startY;
        wbCanvas.style.setProperty("--pan-x", `${panX}px`);
        wbCanvas.style.setProperty("--pan-y", `${panY}px`);
      });

      window.addEventListener("mouseup", () => {
        isPanning = false;
      });
    }

    setTimeout(() => {
      loadNotebook("self-reliance");
    }, 800);
  }
</script>
