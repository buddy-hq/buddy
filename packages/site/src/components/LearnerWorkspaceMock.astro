    async function typeWbHtml(container: HTMLElement, htmlText: string, streamId: number, speed = 20) {
      const parts = htmlText.split(/(<[^>]+>)/g);
      let currentText = "";

      for (const chunk of parts) {
        if (streamId !== currentStreamId) return;
        currentText += chunk;
        container.innerHTML = currentText;
        const delay = chunk.startsWith('<') ? 0 : (Math.random() * (speed / 2) + (speed / 2));
        await new Promise(resolve => setTimeout(resolve, delay));
      }
    }

    async function resolveCardSkeleton(notebookKey: NotebookKey, messageIndex: number, streamId: number) {
      if (notebookKey === "self-reliance") {
        if (messageIndex === 3) {
          const sk = buddyWindow.querySelector(".illustration-card.state-skeleton");
          if (sk) sk.classList.remove("state-skeleton");
        }
      } else if (notebookKey === "deep-learning") {
        if (messageIndex === 1) {
          const sk = buddyWindow.querySelector(".illustration-card.state-skeleton");
          if (sk) sk.classList.remove("state-skeleton");
        } else if (messageIndex === 5) {
          const sk = buddyWindow.querySelector(".wb-chat-card.state-skeleton");
          if (sk) sk.classList.remove("state-skeleton");
          await animateWhiteboard("deep-learning", streamId);
        }
      } else if (notebookKey === "world-history") {
        if (messageIndex === 3) {
          const sk = buddyWindow.querySelector(".illustration-card.state-skeleton");
          if (sk) sk.classList.remove("state-skeleton");
        } else if (messageIndex === 5) {
          const sk = buddyWindow.querySelector(".wb-chat-card.state-skeleton");
          if (sk) sk.classList.remove("state-skeleton");
          await animateWhiteboard("world-history", streamId);
        }
      }
    }

    /**
     * Renders the passages as one continuous column rather than a paginated page, so the
     * reader shows real reading length instead of a single stanza behind arrows.
     */
    function loadReaderPage(notebookKey: NotebookKey, pageIndex: number) {
      const data = learnerNotebooks[notebookKey];
      if (!data || !data.pages || !data.pages[pageIndex]) return;

      const page = data.pages[pageIndex];
      if (readerQuoteText) readerQuoteText.textContent = page.quote;
      if (readerBodyText) readerBodyText.innerHTML = page.body;

      const next = data.pages[pageIndex + 1];
      if (readerQuoteText2) {
        readerQuoteText2.textContent = next ? next.quote : "";
        readerQuoteText2.style.display = next ? "" : "none";
      }
      if (readerBodyText2) {
        readerBodyText2.innerHTML = next ? next.body : "";
        readerBodyText2.style.display = next ? "" : "none";
      }
      if (readerRule) readerRule.style.display = next ? "" : "none";

      if (readerSigText) readerSigText.textContent = page.signature;
      if (readerLocationText) readerLocationText.textContent = page.location;
    }

    function appendMessage(sender: string, text: string) {
