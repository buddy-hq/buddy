---
// Component for the Learner (Student) workspace mockup
import { getImage } from "astro:assets";
import MockWhiteboard from "./MockWhiteboard.astro";
import MockSidebar from "./MockSidebar.astro";
import MockChat from "./MockChat.astro";
import MockReader from "./MockReader.astro";
import selfRelianceCover from "../assets/self-reliance.webp";
import { AUDIENCE_LEARNERS } from "../lib/constants";
import "./WorkspaceMock.css";

const selfRelianceChatCover = await getImage({
  src: selfRelianceCover,
  width: 88,
  format: "webp",
});
---

<!-- Boots in the state the demo opens in: right pane already showing the whiteboard. The
     script only takes over at 800ms, so anything staged here as collapsed would flash. -->
<div class="buddy-window show-whiteboard" data-self-reliance-cover={selfRelianceChatCover.src} data-audience={AUDIENCE_LEARNERS}>
  <!-- Workspace layout with macOS unified titlebar split -->
  <div class="workspace-body sidebar-closed">
    
    <!-- Surface 1: Sidebar -->
    <MockSidebar audience={AUDIENCE_LEARNERS} />

    <!-- Surface 2: Chat Pane -->
    <MockChat audience={AUDIENCE_LEARNERS} />

    <!-- Surface 3: Document Reader (Warm Cream paper) -->
    <MockReader audience={AUDIENCE_LEARNERS} />

    <!-- Surface 5: Whiteboard Pane -->
    <MockWhiteboard audience={AUDIENCE_LEARNERS} />

    <!-- Surface 4: Action Toolbar -->
    <aside class="surface-actions">
      <div class="action-icons">
        <button class="action-btn" title="Library">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
          </svg>
        </button>
        <button class="action-btn active" title="Whiteboard">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 3h20"></path>
            <path d="M21 3v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V3"></path>
            <path d="m7 21 5-5 5 5"></path>
          </svg>
        </button>
      </div>
    </aside>
  </div>

  <!-- The learner demo drives no simulated cursor: it opens mid-conversation with the
       board already requested, so there is no click to stage. -->
</div>

<script>
  const selfRelianceCoverSrc =
    document.querySelector("[data-self-reliance-cover]")?.getAttribute("data-self-reliance-cover") ?? "";

  // Data for notebooks matching real app structure (Learners/Students)
  const learnerNotebooks = {
    "self-reliance": {
      title: "self reliance",
      session: "Understanding self-reliance meaning",
      readerTitle: "Self Reliance",
      pages: [
        {
          quote: "Whoso would be a man must be a nonconformist.",
          body: "There is a time in every man's education when he arrives at the conviction that envy is ignorance; that imitation is suicide; that he must take himself for better, for worse, as his portion; that though the wide universe is full of good, no kernel of nourishing corn can come to him but through his toil bestowed on that plot of ground which is given to him to till.<br><br>Is non-conformity required for everyone? Probably not. But to be courageous—to be \"a man\" as Emerson is in a time of different language—you must first be willing to think for yourself. And as Martin Luther King, Jr. (another inspiring non-conformist) said years later, \"Nothing pains some people more than having to think.\" If you can think for yourself, and put those thoughts into meaningful action that improves the state of the world, you're well on the way to a courageous, remarkable life.",
          signature: "Ralph Waldo Emerson",
          location: "ESSAY · PAGE 4 / 24"
        },
        {
          quote: "A foolish consistency is the hobgoblin of little minds.",
          body: "Emerson points out that we often worry about staying consistent with what we've said or done in the past, or with what others have come to expect of us. But real growth requires the willingness to change your mind when you meet a better argument.<br><br>To conform to your own past is just as limiting as conforming to the crowd, and it is harder to notice, because it wears your own face. Speak what you think today in hard words, and tomorrow speak what tomorrow thinks in hard words again, though it contradict every thing you said today.",
          signature: "Ralph Waldo Emerson",
          location: "ESSAY · PAGE 4-8 / 24"
        }
      ],
      messages: [
        { sender: "user", text: "what is Emerson's main argument in Self-Reliance?" },
        { sender: "buddy", text: "Emerson argues you should trust your own mind instead of conforming to what the crowd or your past self expects.<br><br><div class='wb-chat-card state-skeleton'><div class='wb-chat-icon'><svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5'><path d='M2 3h20'></path><path d='M21 3v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V3'></path><path d='m7 21 5-5 5 5'></path></svg></div><div class='wb-chat-title-group'><div class='wb-chat-title'>Trust Thyself</div><div class='wb-chat-subtitle'>Whiteboard</div></div></div><br><br>I've sketched a quick summary on your whiteboard." },
        { sender: "user", text: "load the text so we can dig into it" },
        { sender: "buddy", text: `<div class='illustration-card state-skeleton'><div class='ill-cover' style='background-image: url(${selfRelianceCoverSrc});'></div><div class='ill-text'><span class='ill-title'>Self Reliance</span><span class='ill-author'>Ralph Waldo Emerson</span></div></div><br><br>Loaded. I've highlighted his core thesis on non-conformity in the e-reader.` }
      ],
      whiteboardHtml: ""
    },
    "deep-learning": {
      title: "deep learning",
      session: "Backpropagation chain rule",
      readerTitle: "Deep Learning (Ch 6)",
      pages: [
        {
          quote: "The chain rule is used to compute derivatives of functions formed by composing other functions...",
          body: "In deep learning, backpropagation is simply the application of the chain rule to compute the gradient of the loss function with respect to the weights of the network. We compute derivatives layer by layer, starting from the output and moving backwards.",
          signature: "Goodfellow et al.",
          location: "BEGIN READING · LOCATION 112 / 310"
        }
      ],
      messages: [
        { sender: "user", text: "explain the math behind backpropagation" },
        { sender: "buddy", text: "At its core, backpropagation uses the calculus chain rule to calculate gradients. It multiplies partial derivatives layer-by-layer starting from the loss output.<br><br>Want to preview the textbook chapter?" },
        { sender: "user", text: "yes" },
        { sender: "buddy", text: "<div class='illustration-card state-skeleton'><div class='ill-cover-fallback math'><div class='fallback-cover-text'>Deep Learning</div></div><div class='ill-text'><span class='ill-title'>Deep Learning Book</span><span class='ill-author'>Goodfellow et al.</span></div></div><br><br>Loaded. I've opened the optimization chapter and highlighted the chain rule formulas." },
        { sender: "user", text: "show me the derivative steps" },
        { sender: "buddy", text: "<div class='wb-chat-card state-skeleton'><div class='wb-chat-icon'><svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5'><path d='M2 3h20'></path><path d='M21 3v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V3'></path><path d='m7 21 5-5 5 5'></path></svg></div><div class='wb-chat-title-group'><div class='wb-chat-title'>Backprop derivatives</div><div class='wb-chat-subtitle'>Whiteboard</div></div></div><br><br>Sure, I'll calculate and render the derivatives on your whiteboard." }
      ],
      whiteboardHtml: ""
    },
    "world-history": {
      title: "world history",
      session: "Causes of World War I",
      readerTitle: "World History (Ch 22)",
      pages: [
        {
          quote: "The assassination was the spark that ignited the European powder keg.",
          body: "Although the assassination of Archduke Franz Ferdinand in June 1914 was the immediate catalyst, the war's root causes lay in imperialism, militarism, nationalist rivalries, and the rigid alliance network. The secret mutual defense pacts quickly turned a local Balkan conflict into a global catastrophe.",
          signature: "Modern History Press",
          location: "BEGIN READING · LOCATION 48 / 90"
        },
        {
          quote: "The alliance network transformed a localized conflict into a global tragedy.",
          body: "By early August 1914, the major European powers had fully mobilized. Mobilization schedules were extremely rigid, meaning that once one nation began the process, its neighbors felt compelled to do the same to avoid being caught unprepared.",
          signature: "A. J. P. Taylor",
          location: "LOCATION 49 / 90"
        }
      ],
      messages: [
        { sender: "user", text: "why did so many countries get pulled into ww1 so quickly?" },
        { sender: "buddy", text: "The rigid network of mutual defense alliances escalated a local Balkan conflict into a global war within weeks.<br><br>Ready to check the diplomatic crisis text?" },
        { sender: "user", text: "yes" },
        { sender: "buddy", text: "<div class='illustration-card state-skeleton'><div class='ill-cover-fallback wh'><div class='fallback-cover-text'>World History</div></div><div class='ill-text'><span class='ill-title'>World History</span><span class='ill-author'>Modern History Press</span></div></div><br><br>Loaded Chapter 22. It outlines how Austria-Hungary's declaration of war triggered Russia, Germany, and France." },
        { sender: "user", text: "explain the alliance timeline" },
        { sender: "buddy", text: "<div class='wb-chat-card state-skeleton'><div class='wb-chat-icon'><svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5'><path d='M2 3h20'></path><path d='M21 3v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V3'></path><path d='m7 21 5-5 5 5'></path></svg></div><div class='wb-chat-title-group'><div class='wb-chat-title'>Alliance Timeline</div><div class='wb-chat-subtitle'>Whiteboard</div></div></div><br><br>I've mapped the diplomatic communications of July 1914 on your whiteboard." }
      ],
      whiteboardHtml: ""
    }
  };

  type NotebookKey = "self-reliance" | "deep-learning" | "world-history";

  let activeNotebook: NotebookKey = "self-reliance";
  let currentPageIndices: Record<string, number> = {
    "self-reliance": 0,
    "deep-learning": 0,
    "world-history": 0
  };

  let currentStreamId = 0;
  let activeSidebarPromise = Promise.resolve();
  let isGenerating = false;

  // Scoped element selectors
  const buddyWindow = document.querySelector('.buddy-window[data-audience="learners"]') as HTMLElement;
  if (buddyWindow) {
    const chatFeed = buddyWindow.querySelector(".chat-feed") as HTMLElement | null;
    const windowActiveNotebook = buddyWindow.querySelector(".window-active-notebook") as HTMLElement | null;
    const windowActiveSession = buddyWindow.querySelector(".window-active-session") as HTMLElement | null;
    const readerTabTitle = buddyWindow.querySelector("#reader-tab-title") as HTMLElement | null;
    const readerQuoteText = buddyWindow.querySelector("#reader-quote-text") as HTMLElement | null;
    const readerBodyText = buddyWindow.querySelector("#reader-body-text") as HTMLElement | null;
    const readerQuoteText2 = buddyWindow.querySelector("#reader-quote-text-2") as HTMLElement | null;
    const readerBodyText2 = buddyWindow.querySelector("#reader-body-text-2") as HTMLElement | null;
    const readerRule = buddyWindow.querySelector(".reader-rule") as HTMLElement | null;
    const readerSigText = buddyWindow.querySelector("#reader-sig-text") as HTMLElement | null;
    const readerLocationText = buddyWindow.querySelector("#reader-location-text") as HTMLElement | null;
    const fontToggleBtn = buddyWindow.querySelector("#font-toggle-btn") as HTMLElement | null;
    const readerContentPane = buddyWindow.querySelector("#reader-content-pane") as HTMLElement | null;
    const chatForm = buddyWindow.querySelector("#mockup-chat-form") as HTMLFormElement | null;
    const chatInput = buddyWindow.querySelector("#mockup-chat-input") as HTMLTextAreaElement | null;
    const chatSubmitBtn = buddyWindow.querySelector("#chat-submit-btn") as HTMLButtonElement | null;
    
    const wbDrawings = buddyWindow.querySelector(".wb-drawings") as HTMLElement | null;
    
    const libraryRailBtn = buddyWindow.querySelector('.action-btn[title="Library"]') as HTMLButtonElement | null;
    const whiteboardRailBtn = buddyWindow.querySelector('.action-btn[title="Whiteboard"]') as HTMLButtonElement | null;
    const widgetRailBtn = buddyWindow.querySelector('.action-btn[title="HTML Widget"]') as HTMLButtonElement | null;
    const flashcardsRailBtn = buddyWindow.querySelector('.action-btn[title="Notebook"]') as HTMLButtonElement | null;
    const workspaceBody = buddyWindow.querySelector('.workspace-body') as HTMLElement | null;

    function setGenerating(gen: boolean) {
      isGenerating = gen;
      if (!chatSubmitBtn) return;
      
      const sendIcon = chatSubmitBtn.querySelector(".icon-send") as HTMLElement | null;
      const stopIcon = chatSubmitBtn.querySelector(".icon-stop") as HTMLElement | null;
      
      if (gen) {
        chatSubmitBtn.classList.add("generating");
        if (sendIcon) sendIcon.style.display = "none";
        if (stopIcon) stopIcon.style.display = "block";
      } else {
        chatSubmitBtn.classList.remove("generating");
        if (sendIcon) sendIcon.style.display = "block";
        if (stopIcon) stopIcon.style.display = "none";
      }
    }

    async function animateWhiteboard(notebookKey: NotebookKey, streamId: number) {
      if (!wbDrawings) return;
      wbDrawings.innerHTML = "";

      if (notebookKey === "self-reliance") {
        const hi = document.createElement("div");
        hi.className = "wb-handwriting-hi";
        wbDrawings.appendChild(hi);
        await typeWbHtml(hi, "Trust Thyself", streamId, 30);
        if (streamId !== currentStreamId) return;
        await new Promise(resolve => setTimeout(resolve, 200));

        const quote = document.createElement("div");
        quote.className = "wb-welcome-text";
        wbDrawings.appendChild(quote);
        await typeWbHtml(quote, '"every heart vibrates to that iron string."', streamId, 18);
        if (streamId !== currentStreamId) return;
        await new Promise(resolve => setTimeout(resolve, 200));

        const arrow = document.createElement("div");
        arrow.className = "wb-doodle-arrow";
        arrow.innerHTML = `
          <svg width="40" height="20" viewBox="0 0 40 20" fill="none" stroke="currentColor" style="color: var(--aurora-base)" stroke-width="2">
            <path d="M20,2 L20,18 M15,13 L20,18 L25,13" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        `;
        wbDrawings.appendChild(arrow);
        await new Promise(resolve => setTimeout(resolve, 50));
        arrow.classList.add("visible");
        await new Promise(resolve => setTimeout(resolve, 200));
        if (streamId !== currentStreamId) return;

        const grid = document.createElement("div");
        grid.className = "wb-split-grid";
        wbDrawings.appendChild(grid);

        const integrityCard = document.createElement("div");
        integrityCard.className = "wb-card integrity";
        integrityCard.innerHTML = `<div class="wb-card-title">✓ Integrity</div><div class="wb-card-body"></div>`;
        grid.appendChild(integrityCard);

        const conformityCard = document.createElement("div");
        conformityCard.className = "wb-card conformity";
        conformityCard.innerHTML = `<div class="wb-card-title">✗ Conformity</div><div class="wb-card-body"></div>`;
        grid.appendChild(conformityCard);

        await new Promise(resolve => setTimeout(resolve, 50));
        integrityCard.classList.add("visible");
        conformityCard.classList.add("visible");
        await new Promise(resolve => setTimeout(resolve, 400));
        if (streamId !== currentStreamId) return;

        const integrityBody = integrityCard.querySelector(".wb-card-body") as HTMLElement;
        await typeWbHtml(integrityBody, "- Inward Conviction<br>- Self-Trust<br>- Originality", streamId, 18);
        if (streamId !== currentStreamId) return;

        const conformityBody = conformityCard.querySelector(".wb-card-body") as HTMLElement;
        await typeWbHtml(conformityBody, "- Crowd Clamor<br>- Consistency Trap<br>- Copying Others", streamId, 18);
        if (streamId !== currentStreamId) return;

        const conclusionCard = document.createElement("div");
        conclusionCard.className = "wb-sketch-node bottom-conclusion";
        conclusionCard.style.opacity = "0";
        conclusionCard.style.transform = "scale(0.8) rotate(1deg)";
        conclusionCard.style.transition = "all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1)";
        conclusionCard.style.marginTop = "15px";
        conclusionCard.style.width = "100%";
        conclusionCard.style.maxWidth = "280px";
        wbDrawings.appendChild(conclusionCard);

        await new Promise(resolve => setTimeout(resolve, 80));
        conclusionCard.style.opacity = "1";
        conclusionCard.style.transform = "scale(1) rotate(1deg)";
        await new Promise(resolve => setTimeout(resolve, 350));
        if (streamId !== currentStreamId) return;

        await typeWbHtml(conclusionCard, "Self-Reliance = Outward Non-conformity", streamId, 25);
      }
      else if (notebookKey === "deep-learning") {
        const hi = document.createElement("div");
        hi.className = "wb-handwriting-hi";
        wbDrawings.appendChild(hi);
        await typeWbHtml(hi, "Calculus Chain Rule", streamId, 30);
        if (streamId !== currentStreamId) return;
        await new Promise(resolve => setTimeout(resolve, 200));

        const graph = document.createElement("div");
        graph.className = "wb-neural-graph";
        graph.innerHTML = `
          <div class="neuron-col">
            <div class="neuron" style="opacity: 0; transform: scale(0.5); transition: all 0.3s ease;">x</div>
          </div>
          <div class="neuron-col">
            <div class="neuron" style="opacity: 0; transform: scale(0.5); transition: all 0.3s ease;">h</div>
          </div>
          <div class="neuron-col">
            <div class="neuron" style="opacity: 0; transform: scale(0.5); transition: all 0.3s ease;">y</div>
          </div>
        `;
        wbDrawings.appendChild(graph);
        const neurons = graph.querySelectorAll(".neuron");
        
        await new Promise(resolve => setTimeout(resolve, 80));
        (neurons[0] as HTMLElement).style.opacity = "1";
        (neurons[0] as HTMLElement).style.transform = "scale(1)";
        await new Promise(resolve => setTimeout(resolve, 150));
        (neurons[1] as HTMLElement).style.opacity = "1";
        (neurons[1] as HTMLElement).style.transform = "scale(1)";
        await new Promise(resolve => setTimeout(resolve, 150));
        (neurons[2] as HTMLElement).style.opacity = "1";
        (neurons[2] as HTMLElement).style.transform = "scale(1)";
        await new Promise(resolve => setTimeout(resolve, 300));
        if (streamId !== currentStreamId) return;

        const block = document.createElement("div");
        block.className = "wb-math-deriv-block";
        wbDrawings.appendChild(block);

        const eqCard1 = document.createElement("div");
        eqCard1.className = "wb-math-card";
        eqCard1.innerHTML = `
          <div class="math-expr">
            <span class="numerator">∂y</span>
            <span class="fraction-line"></span>
            <span class="denominator">∂x</span>
            <span class="equals">=</span>
            <span class="numerator">∂y</span>
            <span class="fraction-line"></span>
            <span class="denominator">∂h</span>
            <span class="multiply">·</span>
            <span class="numerator">∂h</span>
            <span class="fraction-line"></span>
            <span class="denominator">∂x</span>
          </div>
        `;
        block.appendChild(eqCard1);
        await new Promise(resolve => setTimeout(resolve, 50));
        eqCard1.classList.add("visible");
        await new Promise(resolve => setTimeout(resolve, 400));
        if (streamId !== currentStreamId) return;

        const arrow = document.createElement("div");
        arrow.className = "wb-doodle-arrow horizontal";
        arrow.innerHTML = `
          <svg width="20" height="40" viewBox="0 0 20 40" fill="none" stroke="#e5e7eb" stroke-width="2">
            <path d="M2,20 L18,20 M13,15 L18,20 L13,25" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        `;
        block.appendChild(arrow);
        await new Promise(resolve => setTimeout(resolve, 50));
        arrow.classList.add("visible");
        await new Promise(resolve => setTimeout(resolve, 300));
        if (streamId !== currentStreamId) return;

        const eqCard2 = document.createElement("div");
        eqCard2.className = "wb-math-card forward";
        eqCard2.innerHTML = `<div class="math-label">Backpropagation Step</div>`;
        block.appendChild(eqCard2);
        await new Promise(resolve => setTimeout(resolve, 50));
        eqCard2.classList.add("visible");
        await new Promise(resolve => setTimeout(resolve, 350));
        if (streamId !== currentStreamId) return;

        await typeWbHtml(eqCard2, `<div class="math-label" style="font-size:11px; margin-bottom:4px; font-weight:600;">Backpropagation Step</div><div class="math-expr small">δⱼ = f'(zⱼ) ∑ wₖⱼ δₖ</div>`, streamId, 18);
      }
      else if (notebookKey === "world-history") {
        const hi = document.createElement("div");
        hi.className = "wb-handwriting-hi";
        wbDrawings.appendChild(hi);
        await typeWbHtml(hi, "Causes of World War I", streamId, 30);
        if (streamId !== currentStreamId) return;
        await new Promise(resolve => setTimeout(resolve, 200));

        const flow = document.createElement("div");
        flow.className = "wb-history-timeline";
        wbDrawings.appendChild(flow);

        const events = [
          "<strong>June 28</strong>: Archduke assassinated",
          "<strong>July 23</strong>: Austria ultimatum to Serbia",
          "<strong>July 28</strong>: Austria-Hungary declares war",
          "<strong>July 30</strong>: Russia mobilizes forces",
          "<strong>Aug 1 & 3</strong>: Germany declares war on Rus/Fra",
          "<strong>Aug 4</strong>: UK enters after Belgium breach"
        ];

        for (let i = 0; i < events.length; i++) {
          const card = document.createElement("div");
          card.className = "wb-history-card";
          card.innerHTML = events[i];
          flow.appendChild(card);
          
          await new Promise(resolve => setTimeout(resolve, 50));
          card.classList.add("visible");
          await new Promise(resolve => setTimeout(resolve, 200));
          if (streamId !== currentStreamId) return;

          if (i < events.length - 1) {
            const arrow = document.createElement("div");
            arrow.className = "wb-timeline-arrow";
            arrow.innerHTML = `↓`;
            flow.appendChild(arrow);
            await new Promise(resolve => setTimeout(resolve, 50));
            arrow.classList.add("visible");
            await new Promise(resolve => setTimeout(resolve, 150));
          }
        }
      }
    }

    function loadNotebook(key: NotebookKey) {
      activeNotebook = key;
      activeSidebarPromise = Promise.resolve();
      const data = learnerNotebooks[key];
      if (!data) return;

      if (windowActiveNotebook) windowActiveNotebook.textContent = data.title;
      if (windowActiveSession) windowActiveSession.textContent = data.session;
      if (readerTabTitle) readerTabTitle.textContent = data.readerTitle;

      if (readerQuoteText) readerQuoteText.textContent = "";
      if (readerBodyText) readerBodyText.textContent = "Waiting for document load command...";
      // The second passage is part of the same reset. Skipping it leaves the previous
      // notebook's text sitting underneath the new notebook's placeholder.
      if (readerQuoteText2) readerQuoteText2.textContent = "";
      if (readerBodyText2) readerBodyText2.textContent = "";
      if (readerRule) readerRule.style.display = "none";
      if (readerSigText) readerSigText.textContent = "";
      if (readerLocationText) readerLocationText.textContent = "";

      buddyWindow.querySelectorAll('.action-btn').forEach(btn => btn.classList.remove('active'));
      buddyWindow.classList.remove('show-whiteboard', 'show-widget', 'show-notes');

      // The learner story opens on a board being drawn, so self-reliance starts with the
      // right pane already showing an empty whiteboard — the pane appearing is not the
      // reveal, the drawing is. Every other notebook opens collapsed and reveals its pane
      // when the document actually loads, rather than parking the viewer in front of
      // "waiting for document load command".
      if (key === "self-reliance") {
        if (wbDrawings) wbDrawings.innerHTML = "";
        if (whiteboardRailBtn) whiteboardRailBtn.classList.add('active');
        buddyWindow.classList.add('show-whiteboard');
        if (windowActiveNotebook) windowActiveNotebook.textContent = "Whiteboard";
        if (windowActiveSession) windowActiveSession.textContent = "Current board";
        if (workspaceBody) workspaceBody.classList.remove('right-pane-collapsed');
      } else {
        if (wbDrawings) wbDrawings.innerHTML = '<div class="wb-welcome-text" style="opacity: 0.3; font-family: var(--font-body); font-size: 13px; padding: 20px;">Whiteboard ready...</div>';
        if (libraryRailBtn) libraryRailBtn.classList.add('active');
        if (workspaceBody) workspaceBody.classList.add('right-pane-collapsed');
      }

      const activeSessionItem = buddyWindow.querySelector('.sessions-list .session-item.active');
      if (activeSessionItem) {
        activeSessionItem.classList.add('pulse-slow');
      }

      currentStreamId++;
      const streamId = currentStreamId;

      if (chatFeed) {
        chatFeed.innerHTML = "";
      }

      runChatStream(key, streamId);
    }

    async function runChatStream(key: NotebookKey, streamId: number) {
      const data = learnerNotebooks[key];
      if (!data) return;

      setGenerating(true);

      try {
        // Open mid-conversation. The question, Buddy's answer and the whiteboard card are
        // already on screen — resolved, not skeletons, because they have already happened.
        // The first thing that moves is the board drawing itself, which is the whole pitch;
        // it should not sit behind a typewriter preamble the viewer has to wait out.
        const seedCount = key === "self-reliance" ? 2 : 0;
        for (let s = 0; s < seedCount; s++) {
          if (streamId !== currentStreamId) return;
          const seed = data.messages[s];
          if (seed.sender === "user") {
            appendMessage("user", seed.text);
          } else {
            await typeMessage(appendBuddyBubble(), seed.text, streamId, key, s, true);
          }
        }

        if (key === "self-reliance") {
          await animateWhiteboard("self-reliance", streamId);
          if (streamId !== currentStreamId) return;
          await new Promise(resolve => setTimeout(resolve, 700));
          if (streamId !== currentStreamId) return;
        }

        for (let i = seedCount; i < data.messages.length; i++) {
          if (streamId !== currentStreamId) return;

          const msg = data.messages[i];
          if (msg.sender === "user") {
            await new Promise(resolve => setTimeout(resolve, i === 0 ? 300 : 400));
            if (streamId !== currentStreamId) return;

            if (chatInput) {
              chatInput.value = "";
              for (let charIndex = 0; charIndex < msg.text.length; charIndex++) {
                if (streamId !== currentStreamId) return;
                chatInput.value += msg.text[charIndex];
                chatInput.style.height = "auto";
                chatInput.style.height = (chatInput.scrollHeight) + "px";
                const delay = msg.text.length > 30 ? 12 : 15;
                await new Promise(resolve => setTimeout(resolve, delay));
              }
            }

            await new Promise(resolve => setTimeout(resolve, 150));
            if (streamId !== currentStreamId) return;

            if (chatSubmitBtn) {
              chatSubmitBtn.classList.add("simulated-click");
            }
            await new Promise(resolve => setTimeout(resolve, 100));
            if (streamId !== currentStreamId) return;
            if (chatSubmitBtn) {
              chatSubmitBtn.classList.remove("simulated-click");
            }

            if (chatInput) {
              chatInput.value = "";
              chatInput.style.height = "auto";
            }
            appendMessage("user", msg.text);
          } else {
            await new Promise(resolve => setTimeout(resolve, 250));
            if (streamId !== currentStreamId) return;

            const typingIndicator = document.createElement("div");
            typingIndicator.className = "mock-chat-bubble buddy typing";
            typingIndicator.innerHTML = `
              <div class="typing-dots">
                <span></span>
                <span></span>
                <span></span>
              </div>
            `;
            if (chatFeed) {
              chatFeed.appendChild(typingIndicator);
              chatFeed.scrollTop = chatFeed.scrollHeight;
            }

            await new Promise(resolve => setTimeout(resolve, 400));
            if (streamId !== currentStreamId) return;
            typingIndicator.remove();

            await typeMessage(appendBuddyBubble(), msg.text, streamId, key, i);
            if (streamId !== currentStreamId) return;

            await activeSidebarPromise;
            if (streamId !== currentStreamId) return;

            await new Promise(resolve => setTimeout(resolve, 500));
          }
        }

        if (streamId !== currentStreamId) return;
        await new Promise(resolve => setTimeout(resolve, 1000));
        if (streamId !== currentStreamId) return;

        // Learners rest on whiteboard
        if (whiteboardRailBtn) {
          buddyWindow.querySelectorAll('.action-btn').forEach(btn => btn.classList.remove('active'));
          whiteboardRailBtn.classList.add('active');
          buddyWindow.classList.add('show-whiteboard');
          buddyWindow.classList.remove('show-widget', 'show-notes');
          if (windowActiveNotebook) windowActiveNotebook.textContent = "Whiteboard";
          if (windowActiveSession) windowActiveSession.textContent = "Current board";
          if (workspaceBody) {
            workspaceBody.classList.remove('right-pane-collapsed');
          }
        }
      } finally {
        if (streamId === currentStreamId) {
          setGenerating(false);
        }
      }
    }

    /**
     * `instant` replays a message that has already happened: same markup and same spacing
     * as the streamed path, but no typewriter, no skeleton, and no pane reveal — seeded
     * history must not re-fire the side effects of its own arrival.
     */
    async function typeMessage(container: HTMLElement, htmlText: string, streamId: number, notebookKey: NotebookKey, messageIndex: number, instant = false) {
      const parts = htmlText.split("<br><br>");
      for (let partIdx = 0; partIdx < parts.length; partIdx++) {
        if (streamId !== currentStreamId) return;
        const part = parts[partIdx];

        const isCard = part.includes("widget-chat-card") || part.includes("illustration-card") || part.includes("wb-chat-card");

        if (isCard) {
          // Render card instantly
          const cardDiv = document.createElement("div");
          cardDiv.style.display = "contents";
          cardDiv.innerHTML = part;

          const cardEl = cardDiv.firstElementChild;
          if (cardEl) {
            cardEl.classList.toggle("state-skeleton", !instant);
          }

          container.appendChild(cardDiv);
          if (chatFeed) chatFeed.scrollTop = chatFeed.scrollHeight;

          // Trigger opening of sidebar!
          if (!instant && messageIndex !== -1) {
            triggerSidebarOpen(notebookKey, messageIndex);
            activeSidebarPromise = resolveCardSkeleton(notebookKey, messageIndex, streamId);
          }

          if (!instant) await new Promise(resolve => setTimeout(resolve, 100));
        } else {
          const textSpan = document.createElement("span");
          container.appendChild(textSpan);
          if (instant) {
            textSpan.innerHTML = part;
          } else {
            await typeMessageInner(textSpan, part, streamId);
          }
        }

        if (partIdx < parts.length - 1) {
          const nextPart = parts[partIdx + 1];
          const nextIsCard = nextPart.includes("widget-chat-card") || nextPart.includes("illustration-card") || nextPart.includes("wb-chat-card");
          
          if (!isCard && !nextIsCard) {
            // Double break between text paragraphs
            container.appendChild(document.createElement("br"));
            container.appendChild(document.createElement("br"));
          } else {
            // Tight spacing between card and text
            const spacer = document.createElement("div");
            spacer.style.height = "8px";
            container.appendChild(spacer);
          }
          if (chatFeed) chatFeed.scrollTop = chatFeed.scrollHeight;
        }
      }
    }

    async function typeMessageInner(container: HTMLElement, htmlText: string, streamId: number) {
      const chunks: string[] = [];
      let i = 0;
      while (i < htmlText.length) {
        if (htmlText[i] === '<') {
          const closingIndex = htmlText.indexOf('>', i);
          if (closingIndex !== -1) {
            chunks.push(htmlText.substring(i, closingIndex + 1));
            i = closingIndex + 1;
            continue;
          }
        }
        chunks.push(htmlText[i]);
        i++;
      }

      let currentText = "";
      for (const chunk of chunks) {
        if (streamId !== currentStreamId) return;
        currentText += chunk;
        container.innerHTML = currentText;
        if (chatFeed) chatFeed.scrollTop = chatFeed.scrollHeight;
        
        const delay = chunk.startsWith('<') ? 0 : (Math.random() * 6 + 4);
        await new Promise(resolve => setTimeout(resolve, delay));
      }
    }

