---
type Props = {
  readonly primary: readonly string[]
  readonly primaryLabel: string
  readonly secondary: readonly string[]
  readonly secondaryLabel: string
}

const { primary, primaryLabel, secondary, secondaryLabel } = Astro.props
---

<div class="marquee" aria-hidden="true">
  <div class="marquee-row">
    <div class="marquee-track">
      {[...primary, ...primary].map((chip) => (
        <span class="marquee-chip marquee-chip--primary">{chip}</span>
      ))}
    </div>
  </div>
  <div class="marquee-row">
    <div class="marquee-track marquee-track--reverse">
      {[...secondary, ...secondary].map((chip) => (
        <span class="marquee-chip">{chip}</span>
      ))}
    </div>
  </div>
</div>

<p class="marquee-a11y-list">
  {primaryLabel}: {primary.join(", ")}. {secondaryLabel}: {secondary.join(", ")}.
</p>

<style>
  /* The two rows carry different type sizes, so a tight gap collapsed them into
     one dense band. This sits between the header gap above and the section
     padding around it, keeping the rhythm stepping down rather than jumping. */
  .marquee {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    mask-image: linear-gradient(90deg, transparent, black 12%, black 88%, transparent);
  }

  .marquee-row {
    overflow: hidden;
  }

  /* Chips packed at 1rem read as a solid band rather than a row of items —
     the density is what makes the section feel cramped, not the margins. */
  .marquee-track {
    display: inline-flex;
    align-items: center;
    gap: var(--space-6);
    padding-right: var(--space-6);
    width: max-content;
    animation: marquee-scroll 44s linear infinite;
  }

  .marquee-track--reverse {
    animation-duration: 58s;
    animation-direction: reverse;
  }

  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }

  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .marquee-chip {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 10px 20px;
    white-space: nowrap;
  }

  .marquee-chip--primary {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 510;
    letter-spacing: -0.01em;
    text-transform: none;
    color: var(--color-text-primary);
    background-color: var(--accent-weak);
    border-color: var(--accent-border);
    padding: 12px 28px;
  }

  .marquee-a11y-list {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }

  @media (max-width: 768px) {
    .marquee-chip--primary {
      font-size: 1.0625rem;
      padding: 10px 22px;
    }
  }
</style>
