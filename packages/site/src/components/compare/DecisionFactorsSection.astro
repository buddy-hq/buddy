---
import type { CompareSection } from "../../lib/compare"
import SectionHeader from "./SectionHeader.astro"

type Props = {
  readonly section: Extract<CompareSection, { readonly type: "decision-factors" }>
}

const { section } = Astro.props
const headingId = `compare-section-${section.type}`
---

<section data-compare-section={section.type} aria-labelledby={headingId}>
  <SectionHeader
    id={headingId}
    label="How they differ"
    heading={section.heading}
    intro={section.intro}
  />
  <ol class="factor-list">
    {section.factors.map((factor, index) => (
      <li>
        <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
        <div>
          <h3>{factor.heading}</h3>
          <p>{factor.explanation}</p>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .factor-list {
    margin-top: var(--space-6);
    list-style: none;
    counter-reset: factor;
  }

  li {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    gap: var(--space-6);
    padding-block: var(--space-8);
    border-top: 1px solid var(--color-card-border);
  }

  li:last-child {
    border-bottom: 1px solid var(--color-card-border);
  }

  li > span {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 560;
    line-height: 1;
    letter-spacing: var(--tracking-tight);
    color: color-mix(in oklch, var(--color-accent-secondary) 55%, transparent);
  }

  h3 {
    font-size: var(--text-xl);
    font-weight: 560;
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-snug);
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  p {
    max-width: 62ch;
    margin-top: var(--space-3);
    line-height: 1.75;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  @media (max-width: 640px) {
    li {
      grid-template-columns: 2.75rem minmax(0, 1fr);
      gap: var(--space-4);
      padding-block: var(--space-6);
    }

    li > span {
      font-size: var(--text-2xl);
    }
  }
</style>
