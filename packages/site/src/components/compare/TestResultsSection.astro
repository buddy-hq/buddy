---
import type { CompareSection } from "../../lib/compare"
import SectionHeader from "./SectionHeader.astro"

type Props = {
  readonly competitor: string
  readonly section: Extract<CompareSection, { readonly type: "test-results" }>
}

const { competitor, section } = Astro.props
const headingId = `compare-section-${section.type}`
---

<section data-compare-section={section.type} aria-labelledby={headingId}>
  <SectionHeader
    id={headingId}
    label="Test results"
    heading={section.heading}
    intro={section.intro}
  />
  <aside class="test-method" aria-label="Test method">
    <span>Method</span>
    <p>{section.method}</p>
  </aside>
  {section.visual && (
    <figure>
      <img
        src={section.visual.src}
        alt={section.visual.alt}
        width={section.visual.width}
        height={section.visual.height}
        loading="lazy"
      />
      <figcaption>{section.visual.caption}</figcaption>
    </figure>
  )}
  <div class="results" role="table" aria-label={`Test results for Buddy and ${competitor}`}>
    <div class="results-heading" role="row">
      <span role="columnheader"></span>
      <span class="results-column-buddy" role="columnheader">Buddy</span>
      <span role="columnheader">{competitor}</span>
    </div>
    {section.results.map((result) => (
      <div class="result-row" role="row">
        <strong role="rowheader">{result.measure}</strong>
        <p role="cell"><span class="mobile-label results-column-buddy">Buddy</span>{result.buddy}</p>
        <p role="cell"><span class="mobile-label">{competitor}</span>{result.competitor}</p>
      </div>
    ))}
  </div>
  <p class="test-caveat"><strong>Caveat</strong>{section.caveat}</p>
</section>

<style>
  .test-method {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    gap: var(--space-4);
    margin-top: var(--space-10);
    padding: var(--space-5) var(--space-6);
    border-left: 2px solid var(--color-accent-primary);
    background: var(--color-card-bg);
  }

  .test-method span {
    padding-top: 0.15rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-accent-secondary);
  }

  .test-method p,
  .result-row p {
    font-size: var(--text-sm);
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  figure {
    margin-top: var(--space-6);
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--color-card-border);
  }

  figcaption {
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .results {
    margin-top: var(--space-8);
  }

  .results-heading,
  .result-row {
    display: grid;
    grid-template-columns: minmax(7rem, 0.55fr) repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
  }

  .results-heading {
    padding-bottom: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .results-heading [role="columnheader"] {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .results-column-buddy {
    color: var(--color-accent-secondary);
  }

  .results-column-buddy::before {
    content: "";
    width: 0.375rem;
    height: 0.375rem;
    background: var(--color-accent-primary);
  }

  .result-row {
    padding-block: var(--space-5);
    border-top: 1px solid var(--color-card-border);
  }

  .result-row > strong {
    font-size: var(--text-sm);
    font-weight: 560;
    line-height: 1.6;
    color: var(--color-text-primary);
  }

  .mobile-label {
    display: none;
  }

  .test-caveat {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-6);
    font-size: var(--text-sm);
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  .test-caveat strong {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-text-tertiary);
  }

  .test-caveat strong::after {
    content: ":";
  }

  @media (max-width: 640px) {
    .test-method {
      grid-template-columns: 1fr;
      gap: var(--space-2);
      padding: var(--space-4) var(--space-5);
    }

    .results-heading {
      display: none;
    }

    .result-row {
      grid-template-columns: 1fr;
      gap: var(--space-4);
      padding-block: var(--space-6);
    }

    .result-row p + p {
      padding-top: var(--space-4);
      border-top: 1px dashed var(--color-card-border);
    }

    .mobile-label {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      margin-bottom: var(--space-2);
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      letter-spacing: var(--tracking-wider);
      text-transform: uppercase;
      color: var(--color-text-muted);
    }
  }
</style>
