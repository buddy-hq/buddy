---
import type { CompareSection } from "../../lib/compare"
import SectionHeader from "./SectionHeader.astro"

type Props = {
  readonly competitor: string
  readonly section: Extract<CompareSection, { readonly type: "pricing" }>
}

const { competitor, section } = Astro.props
const headingId = `compare-section-${section.type}`
---

<section data-compare-section={section.type} aria-labelledby={headingId}>
  <SectionHeader id={headingId} label="Cost" heading={section.heading} intro={section.intro} />
  <div class="pricing-pair">
    <article class="pricing-buddy">
      <h3>Buddy</h3>
      <p>{section.buddy}</p>
    </article>
    <article>
      <h3>{competitor}</h3>
      <p>{section.competitor}</p>
    </article>
  </div>
</section>

<style>
  .pricing-pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
    margin-top: var(--space-10);
  }

  article {
    padding: var(--space-6);
    border: 1px solid var(--color-card-border);
    background: var(--color-card-bg);
  }

  .pricing-buddy {
    border-color: var(--color-card-hover-border);
    background:
      linear-gradient(180deg, var(--color-accent-primary-glow), transparent 55%),
      var(--color-card-bg);
  }

  h3 {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-text-primary);
  }

  h3::before {
    content: "";
    width: 0.375rem;
    height: 0.375rem;
    background: var(--color-text-muted);
  }

  .pricing-buddy h3::before {
    background: var(--color-accent-primary);
  }

  article p {
    margin-top: var(--space-4);
    line-height: 1.75;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  @media (max-width: 720px) {
    .pricing-pair {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    article {
      padding: var(--space-5);
    }
  }
</style>
