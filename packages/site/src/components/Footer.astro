---
import { formatCopyrightLabel } from "@buddy/script/branding"
import {
  COMPARE_PATH,
  DOCS_PATH,
  EDUCATOR_PATH,
  LEARNER_PATH,
} from "../lib/constants"

const footerCopyrightLabel = formatCopyrightLabel()
---

<footer class="site-footer">
  <div class="container footer-inner">
    <nav class="footer-nav" aria-label="Footer navigation">
      <a href={LEARNER_PATH} class="footer-link">For Learners</a>
      <a href={EDUCATOR_PATH} class="footer-link">For Teachers</a>
      <a href={COMPARE_PATH} class="footer-link">Compare</a>
      <a href={DOCS_PATH} class="footer-link">Docs</a>
    </nav>
    <p class="footer-copy">&copy; {footerCopyrightLabel}</p>
  </div>
</footer>

<style is:global>
  .site-footer {
    border-top: 1px solid var(--color-card-border);
    padding: var(--space-8) 0;
    color: var(--color-text-muted);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    text-align: center;
  }

  .footer-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-6);
  }

  .footer-link {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.15s var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .footer-link:hover {
      color: var(--color-text-primary);
    }
  }

  .footer-copy {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    opacity: 0.75;
    margin: 0;
  }

  @media (min-width: 640px) {
    .footer-inner {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }
</style>
