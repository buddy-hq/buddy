---
import { content } from "../content/site"
import { AUDIENCE_EDUCATORS } from "../lib/constants"
import Hero from "./Hero.astro"

const hero = content.educators.hero
---

<Hero audience={AUDIENCE_EDUCATORS}>
  <h1 slot="heading" class="hero-title hero-title--educator">
    {hero.headlineLines[0] + " "}<span class="hero-accent">{hero.headlineLines[1]}</span>
  </h1>
  <p slot="subtext" class="hero-subtitle">{hero.subtext}</p>
</Hero>
