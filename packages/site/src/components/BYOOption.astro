---
interface Props {
  title: string
  description: string
}

const { title, description } = Astro.props
const titleSegments = title.split(" · ")
---

<div class="byo-option">
  <div class="byo-option-row">
    <div class="byo-option-marker">
      <slot name="marker" />
    </div>
    <h3 class="byo-option-title">
      {titleSegments.map((segment, index) => (
        <>
          {index > 0 ? <span class="byo-option-separator">·</span> : null}
          {segment}
        </>
      ))}
    </h3>
  </div>
  <p class="byo-option-description">{description}</p>
</div>

<style is:global>
  .byo-option {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: var(--space-8);
  }

  .byo-option-row {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .byo-option-marker {
    width: 45px;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 2px;
  }

  .byo-option-marker-text {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 600;
    color: var(--color-text-muted);
    line-height: 1;
    white-space: nowrap;
  }

  .byo-option-title {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 510;
    line-height: 1.4;
    letter-spacing: -0.012em;
    color: var(--color-text-primary);
    margin: 0;
  }

  .byo-option-separator {
    margin: 0 0.4em;
  }

  .byo-option-description {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 300;
    color: var(--color-text-secondary);
    line-height: 22px;
    letter-spacing: -0.011em;
    opacity: 0.8;
    max-width: 440px;
    margin: 0;
    margin-left: calc(45px + var(--space-3));
  }

  .byo-option-marker svg {
    width: 28px;
    height: 28px;
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .byo-option {
      padding: var(--space-6) var(--space-4);
    }
  }
</style>
