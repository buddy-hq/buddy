---
import { content } from "../content/site"
import MarqueeRows from "./MarqueeRows.astro"

const capabilities = content.learnerCapabilities
---

<section
  class="learner-capabilities-section"
  aria-labelledby="learner-capabilities-heading"
  data-analytics-section="learner_capabilities"
>
  <div class="container">
    <header class="learner-capabilities-header reveal">
      <h2 id="learner-capabilities-heading" class="learner-capabilities-headline">
        {capabilities.headline}
      </h2>
      <p class="learner-capabilities-subtext">{capabilities.subtext}</p>
    </header>
  </div>

  <div class="reveal">
    <MarqueeRows
      primary={capabilities.primary}
      primaryLabel="Learning tools"
      secondary={capabilities.secondary}
      secondaryLabel="Agent capabilities"
    />
  </div>
</section>

<style>
  .learner-capabilities-section {
    padding: var(--space-24) 0;
    overflow: clip;
  }

  .learner-capabilities-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: var(--space-16);
  }

  .learner-capabilities-headline {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 510;
    line-height: 1.1;
    letter-spacing: -0.022em;
    color: var(--color-text-primary);
    text-wrap: balance;
    max-width: 24ch;
    margin: 0 0 var(--space-5) 0;
  }

  .learner-capabilities-subtext {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    font-weight: 300;
    color: var(--color-text-secondary);
    line-height: 1.7;
    letter-spacing: -0.011em;
    max-width: 52ch;
    text-wrap: pretty;
    margin: 0;
  }

  /* Mobile still needs the breathing room — at 3rem this section was the most
     cramped on the page, since the chips wrap into an even denser block on a
     narrow screen. */
  @media (max-width: 768px) {
    .learner-capabilities-section {
      padding: clamp(6.5rem, 18vw, 8rem) 0;
    }

    .learner-capabilities-header {
      margin-bottom: clamp(3.5rem, 10vw, 4.5rem);
    }
  }
</style>
