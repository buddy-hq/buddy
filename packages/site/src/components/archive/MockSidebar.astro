---
// Sidebar sub-pane for BuddyWorkspaceMock
---
<!-- Surface 1: Sidebar -->
<aside class="surface-sidebar">
  <!-- Sidebar top controls (split titlebar) -->
  <div class="sidebar-header">
    <div class="window-dots">
      <span class="win-dot red"></span>
      <span class="win-dot yellow"></span>
      <span class="win-dot green"></span>
    </div>
    <div class="sidebar-header-actions">
      <button type="button" class="circle-btn" title="Toggle Sidebar">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="9" y1="3" x2="9" y2="21"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Sidebar Brand section -->
  <div class="sidebar-brand-section">
    <svg class="brand-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="m12 3-1.912 5.886L4.202 10.8 10.088 12.7 12 18.588l1.912-5.886 5.886-1.912-5.886-1.912z"></path>
    </svg>
    <span>Skills</span>
  </div>

  <div class="sidebar-scrollable">
    <div class="sidebar-section">
      <ul class="notebooks-list">
        
        <li class="notebook-item expanded" data-notebook="self-reliance">
          <div class="notebook-header">
            <!-- BookOpenIcon -->
            <svg class="icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
            <span>self reliance</span>
          </div>
          <div class="sessions-list-wrapper">
            <ul class="sessions-list">
              <li class="session-item">Casual check-in greeting</li>
              <li class="session-item active">Understanding self-reliance meaning</li>
              <li class="session-item">Emerson quotes</li>
              <li class="session-item">Notes on non-conformity</li>
            </ul>
          </div>
        </li>
      </ul>
    </div>
  </div>

  <div class="sidebar-footer">
    <button class="settings-btn">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="3"></circle>
        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.6 15H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9v.18a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
      </svg>
      <span>Settings</span>
    </button>
  </div>
</aside>
