{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"]
    },
    "moduleResolution": "bundler",
    "composite": false,
    "noEmit": true,
    "types": ["bun", "vite/client"]
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "happydom.ts",
    "playwright.config.ts",
    "scripts/**/*.ts",
    "e2e/**/*.ts"
  ],
  "references": [{ "path": "../sdk" }]
}
