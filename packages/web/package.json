{
  "name": "@buddy/web",
  "version": "0.0.63",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.tsx",
    "./app": "./src/app.tsx",
    "./context/platform": "./src/context/platform.tsx",
    "./context/server": "./src/context/server.tsx",
    "./vite": "./vite.ts"
  },
  "scripts": {
    "dev": "vite",
    "predev": "bun run prepare:web && bun run typecheck",
    "prepare:web": "bun ./scripts/prepare.ts full",
    "prepare:web:typecheck": "bun ./scripts/prepare.ts typecheck",
    "prebuild": "bun run prepare:web",
    "lint": "bun ../../node_modules/oxlint/bin/oxlint",
    "build": "tsc -p tsconfig.app.json && vite build",
    "typecheck": "bun ../../script/typecheck-lock.ts -- bun run typecheck:raw",
    "typecheck:raw": "bun run prepare:web:typecheck && bun ../../node_modules/@typescript/native-preview/bin/tsgo.js -b",
    "preview": "vite preview",
    "test": "node ./scripts/test-isolated.mjs",
    "test:contracts": "bun test --preload ./happydom.ts test/parity",
    "stress:chemistry-renderer": "bun ./scripts/stress-chemistry-renderer.ts"
  },
  "dependencies": {
    "@buddy/browser-contract": "workspace:*",
    "@buddy/opencode-adapter": "workspace:*",
    "@buddy/reader-contract": "workspace:*",
    "@buddy/sdk": "workspace:*",
    "@buddy/ui": "workspace:*",
    "@buddy/workspace-file-policy": "workspace:*",
    "@codemirror/language": "6.12.3",
    "@codemirror/state": "6.6.0",
    "@codemirror/view": "6.43.1",
    "@excalidraw/excalidraw": "0.18.1",
    "@hugeicons/core-free-icons": "^4.2.2",
    "@hugeicons/react": "^1.1.9",
    "@lezer/highlight": "1.2.3",
    "@mdxeditor/editor": "4.0.3",
    "@monaco-editor/react": "^4.7.0",
    "@opencode-ai/sdk": "workspace:*",
    "@pierre/diffs": "catalog:",
    "@shikijs/stream": "^4.2.0",
    "@tanstack/react-form": "^1.29.1",
    "@tanstack/react-hotkeys": "^0.9.1",
    "@tanstack/react-query": "^5.99.0",
    "@tanstack/react-query-devtools": "^5.99.0",
    "@tanstack/react-router": "^1.168.22",
    "@tanstack/react-router-devtools": "^1.166.13",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "3.14.2",
    "@uiw/file-icons": "^1.3.2",
    "diff": "catalog:",
    "dompurify": "^3.3.1",
    "es6-promise-pool": "2.5.0",
    "foliate-js": "github:johnfactotum/foliate-js#399248a67a8862ffb5e6463a33f9d52b317ca2eb",
    "fuzzysort": "catalog:",
    "immer": "^11.1.4",
    "indigo-ketcher": "1.43.0",
    "katex": "^0.16.22",
    "lexical": "0.35.0",
    "lottie-react": "^2.4.1",
    "marked": "^17.0.1",
    "marked-shiki": "^1.2.1",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-math": "3.0.0",
    "mermaid": "^11.12.0",
    "micromark-extension-math": "3.1.0",
    "micromark-util-types": "2.0.2",
    "monaco-editor": "^0.52.2",
    "morphdom": "^2.7.8",
    "motion": "^12.38.0",
    "pdfjs-dist": "5.5.207",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^15.0.0",
    "remend": "^1.3.0",
    "shiki": "^4.2.0",
    "zod": "4.1.8",
    "yaml": "2.9.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.0.11",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/router-plugin": "^1.167.22",
    "@types/bun": "catalog:",
    "@types/dompurify": "^3.2.0",
    "@types/mdast": "4.0.4",
    "@types/node": "22.13.9",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "7.1.4"
  }
}
