{
  "name": "@buddy/web",
  "version": "0.0.27",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.tsx",
    "./app": "./src/app.tsx",
    "./context/platform": "./src/context/platform.tsx",
    "./context/server": "./src/context/server.tsx",
    "./vite": "./vite.ts"
  },
  "scripts": {
    "dev": "vite",
    "predev": "bun run prepare:web && bun run typecheck",
    "prepare:web": "bun ./scripts/prepare.ts full",
    "prepare:web:typecheck": "bun ./scripts/prepare.ts typecheck",
    "prebuild": "bun run prepare:web",
    "lint": "oxlint",
    "build": "tsc -p tsconfig.app.json && vite build",
    "pretypecheck": "bun run prepare:web:typecheck",
    "typecheck": "tsgo -b",
    "preview": "vite preview",
    "test": "bun test --preload ./happydom.ts test",
    "test:contracts": "bun test --preload ./happydom.ts test/parity"
  },
  "dependencies": {
    "@buddy/opencode-adapter": "workspace:*",
    "@buddy/sdk": "workspace:*",
    "@buddy/ui": "workspace:*",
    "@monaco-editor/react": "^4.7.0",
    "@opencode-ai/sdk": "workspace:*",
    "@tanstack/react-form": "^1.29.1",
    "@tanstack/react-hotkeys": "^0.9.1",
    "@tanstack/react-query": "^5.99.0",
    "@tanstack/react-query-devtools": "^5.99.0",
    "@tanstack/react-router": "^1.168.22",
    "@tanstack/react-router-devtools": "^1.166.13",
    "@tanstack/react-virtual": "^3.13.23",
    "diff": "catalog:",
    "dompurify": "^3.3.1",
    "foliate-js": "github:johnfactotum/foliate-js#399248a67a8862ffb5e6463a33f9d52b317ca2eb",
    "immer": "^11.1.4",
    "katex": "^0.16.22",
    "lucide-react": "^0.574.0",
    "marked": "^17.0.1",
    "marked-katex-extension": "^5.1.5",
    "marked-shiki": "^1.2.1",
    "mermaid": "^11.12.0",
    "monaco-editor": "^0.52.2",
    "morphdom": "^2.7.8",
    "motion": "^12.38.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^15.0.0",
    "shiki": "^3.20.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.0.11",
    "@storybook/react-vite": "catalog:",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/router-plugin": "^1.167.22",
    "@types/bun": "catalog:",
    "@types/dompurify": "^3.2.0",
    "@types/node": "22.13.9",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "storybook": "catalog:",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "7.1.4"
  }
}
