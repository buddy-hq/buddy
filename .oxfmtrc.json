{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    "dist",
    ".turbo",
    ".buddy-runtime",
    ".opencode",
    "vendor",
    "node_modules",
    "bun.lock",
    "*.tsbuildinfo",
    "**/routeTree.gen.ts",
    "**/bindings.ts",
    "**/*.md",
    "**/*.txt",
    "packages/web/e2e/playwright-report",
    "packages/web/e2e/test-results",
    ".agent/**",
    ".agents/**",
    ".antigravitycli/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".devin/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "tools/oxlint/anti-slop/**"
