{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "dist",
    ".turbo",
    ".buddy-runtime",
    ".opencode",
    "vendor",
    "node_modules",
    "bun.lock",
    "*.tsbuildinfo",
    "**/routeTree.gen.ts",
    "**/bindings.ts",
    "packages/desktop-electron/resources/backend",
    "packages/desktop-electron/resources/migrations",
    "packages/desktop/src-tauri/resources/backend",
    "packages/desktop/src-tauri/resources/migrations",
    "packages/web/e2e/playwright-report",
    "packages/web/e2e/test-results"
  ],
  "plugins": ["eslint", "oxc", "react", "unicorn", "typescript"],
  "categories": {
    "correctness": "warn",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "react-in-jsx-scope": "off",
    "eslint/no-shadow": "off",
    "eslint/no-await-in-loop": "off"
  }
}
