{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "buddy",
  "private": true,
  "description": "Buddy monorepo",
  "workspaces": {
    "packages": [
      "packages/*",
      "vendor/opencode/packages/*",
      "vendor/opencode/packages/console/*",
      "vendor/opencode/packages/sdk/js"
    ],
    "catalog": {
      "@cloudflare/workers-types": "4.20251008.0",
      "@effect/opentelemetry": "4.0.0-beta.66",
      "@effect/platform-node": "4.0.0-beta.66",
      "@effect/sql-sqlite-bun": "4.0.0-beta.66",
      "@hono/zod-validator": "0.4.2",
      "@kobalte/core": "0.13.11",
      "@lydell/node-pty": "1.2.0-beta.10",
      "@npmcli/arborist": "9.4.0",
      "@octokit/rest": "22.0.0",
      "@openauthjs/openauth": "0.0.0-20250322224806",
      "@opentui/core": "0.2.15",
      "@opentui/keymap": "0.2.15",
      "@opentui/solid": "0.2.15",
      "@pierre/diffs": "1.1.0-beta.18",
      "@playwright/test": "1.59.1",
      "@sentry/solid": "10.36.0",
      "@sentry/vite-plugin": "4.6.0",
      "@solid-primitives/storage": "4.3.3",
      "@solidjs/meta": "0.29.4",
      "@solidjs/router": "0.15.4",
      "@solidjs/start": "https://pkg.pr.new/@solidjs/start@dfb2020",
      "@storybook/react-vite": "10.3.4",
      "@tailwindcss/vite": "4.1.11",
      "@tanstack/react-query": "^5.99.0",
      "@tsconfig/bun": "1.0.9",
      "@tsconfig/node22": "22.0.2",
      "@types/bun": "1.3.13",
      "@types/cross-spawn": "6.0.6",
      "@types/luxon": "3.7.1",
      "@types/mime-types": "3.0.1",
      "@types/node": "24.12.2",
      "@types/semver": "7.7.1",
      "@typescript/native-preview": "7.0.0-dev.20251207.1",
      "ai": "6.0.168",
      "cross-spawn": "7.0.6",
      "diff": "8.0.2",
      "dompurify": "3.3.1",
      "drizzle-kit": "1.0.0-rc.2",
      "drizzle-orm": "1.0.0-rc.2",
      "effect": "4.0.0-beta.66",
      "fuzzysort": "3.1.0",
      "hono": "4.10.7",
      "hono-openapi": "1.1.2",
      "luxon": "3.6.1",
      "marked": "17.0.1",
      "marked-shiki": "1.2.1",
      "opentui-spinner": "0.0.6",
      "remeda": "2.26.0",
      "remend": "1.3.0",
      "semver": "7.7.4",
      "shiki": "3.20.0",
      "solid-js": "1.9.10",
      "solid-list": "0.3.0",
      "storybook": "10.3.4",
      "tailwindcss": "4.1.11",
      "typescript": "5.8.2",
      "ulid": "3.0.1",
      "virtua": "0.49.1",
      "vite": "7.1.4",
      "vite-plugin-solid": "2.11.10",
      "zod": "4.1.8"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=.env run --cwd packages/buddy dev",
    "smoke": "bun run --cwd packages/buddy smoke",
    "dev:web": "bun run --cwd packages/web dev",
    "dev:storybook": "bun run --cwd packages/storybook storybook",
    "dev:desktop": "bun run --cwd packages/desktop-electron dev",
    "dev:desktop:electron": "bun run --cwd packages/desktop-electron dev",
    "dev:all": "(bun run dev & BACKEND_PID=$!; trap \"kill $BACKEND_PID\" EXIT INT TERM; bun run dev:web)",
    "worktree:create": "bun ./script/worktree-create.ts",
    "worktree:list": "bun ./script/worktree-list.ts",
    "build": "bun ./node_modules/turbo/bin/turbo run build --filter='@buddy/*' --only --output-logs=errors-only",
    "build:desktop": "bun run --cwd packages/desktop-electron build",
    "build:desktop:electron": "bun run --cwd packages/desktop-electron build",
    "build:knowledge-graph": "bun run --cwd packages/buddy update:knowledge-graph",
    "update:knowledge-graph": "bun run --cwd packages/buddy update:knowledge-graph",
    "verify:knowledge-graph": "bun run --cwd packages/buddy verify:knowledge-graph",
    "build:installable": "bun run --cwd packages/desktop-electron build:installable",
    "build:installable:electron": "bun run --cwd packages/desktop-electron build:installable",
    "serve:update:mac-local": "bun run --cwd packages/desktop-electron serve:update:mac-local",
    "start:built": "bun run build && (bun run --cwd packages/buddy start & BACKEND_PID=$!; trap \"kill $BACKEND_PID\" EXIT INT TERM; bun run --cwd packages/web preview --host --port 1420 --strictPort)",
    "typecheck": "bun ./node_modules/turbo/bin/turbo run typecheck --filter='@buddy/*' --filter='!@buddy/opencode-adapter' --only --concurrency=1 --output-logs=errors-only",
    "test": "bun run test:contracts && bun ./node_modules/turbo/bin/turbo run test --filter='@buddy/*' --only --output-logs=errors-only",
    "test:contracts": "bun run --cwd packages/buddy test:contracts && bun run --cwd packages/web test:contracts",
    "check:contracts": "bun run test:contracts",
    "check:vendor": "bun run typecheck && bun run test",
    "vendor:sync-catalog": "bun ./script/sync-opencode-catalog.ts",
    "vendor:check-catalog": "bun ./script/sync-opencode-catalog.ts --check",
    "vendor:sync": "git subtree pull --prefix vendor/opencode opencode-upstream dev --squash -m \"chore(vendor): sync opencode mirror\"",
    "hooks:install": "git config core.hooksPath .githooks",
    "lint": "bun ./script/vendor-guard.ts --worktree && bun ./script/check-import-contract.ts && bun run theme:audit && bun ./node_modules/oxlint/bin/oxlint --config ./.oxlintrc.json --format unix --report-unused-disable-directives",
    "spellcheck": "cspell --no-progress --no-summary",
    "fmt": "node ./node_modules/oxfmt/dist/cli.js",
    "fmt:check": "node ./node_modules/oxfmt/dist/cli.js --check",
    "sdk:generate": "bun run --cwd packages/sdk generate",
    "theme:tokens:generate": "bun ./script/generate-theme-tailwind-tokens.ts",
    "theme:tokens:check": "bun run theme:tokens:generate && git diff --exit-code -- packages/ui/src/generated/theme-tokens.css",
    "theme:audit": "bun ./script/theme-audit.ts",
    "release:tag": "bun ./script/cut-release.ts",
    "release:cut": "bun ./script/cut-release.ts",
    "release:cut:electron": "bun ./script/cut-release.ts",
    "release:notes": "bun ./script/changelog.ts",
    "release:version": "bun ./script/version.ts",
    "release:publish": "bun ./script/publish.ts",
    "install:release": "bash ./script/install-latest-release.sh"
  },
  "dependencies": {
    "@buddy/script": "workspace:*"
  },
  "devDependencies": {
    "@tanstack/eslint-plugin-query": "^5.99.0",
    "@tsconfig/node22": "catalog:",
    "@typescript/native-preview": "7.0.0-dev.20251207.1",
    "cspell": "^10.0.0",
    "oxfmt": "^0.40.0",
    "oxlint": "^1.55.0",
    "turbo": "^2.0.0"
  },
  "overrides": {
    "@types/node": "22.13.9"
  },
  "packageManager": "bun@1.3.11",
  "patchedDependencies": {
    "@ai-sdk/anthropic@3.0.64": "patches/@ai-sdk%2Fanthropic@3.0.64.patch",
    "@ai-sdk/provider-utils@4.0.21": "patches/@ai-sdk%2Fprovider-utils@4.0.21.patch",
    "@npmcli/agent@4.0.0": "patches/@npmcli%2Fagent@4.0.0.patch",
    "@standard-community/standard-json@0.3.5": "patches/@standard-community%2Fstandard-json@0.3.5.patch",
    "@standard-community/standard-openapi@0.2.9": "patches/@standard-community%2Fstandard-openapi@0.2.9.patch",
    "solid-js@1.9.10": "patches/solid-js@1.9.10.patch"
  }
}
