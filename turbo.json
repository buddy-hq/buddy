{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "globalPassThroughEnv": ["BUDDY_TYPECHECK_LOCK_TOKEN"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "@buddy/sdk#typecheck": {
      "dependsOn": ["transit", "@buddy/backend#transit"]
    },
    "lint": {}
  }
}
